#!/usr/bin/env bash
#
# CS193V container launcher.
#
# ONE script for macOS, native Ubuntu, and Windows (inside the WSL2 CS193V distro).
# There is no PowerShell twin: every supported platform has bash.
#
# MUST STAY BASH 3.2 COMPATIBLE — macOS ships bash 3.2. That means:
#   no associative arrays, no mapfile/readarray, no ${var,,}, no `read -t 0.5`,
#   no |& , no &>> .
# VERIFICATION.md §A.1 greps for all of these.
#
# It lives OUTSIDE the directory it mounts, so the container cannot see or rewrite it.
# That replaces the devcontainer's read-only .devcontainer bind mount, and closes a hole
# that trick leaves open: that mount and the writable workspace are two mounts of the
# SAME filesystem with files owned by the agent's own uid, so link(2) — which checks
# write permission only on the destination — yields a writable second name for the same
# inode, which the host then reads on the next rebuild.

set -u

# ─── where we are ──────────────────────────────────────────────────────────────
# Resolved from our own location, not the working directory, so `cs193v` works from
# anywhere and always mounts its own sibling projects/.
SELF="$0"
while [ -L "$SELF" ]; do
    _link="$(readlink "$SELF")"
    case "$_link" in
        /*) SELF="$_link" ;;
        *)  SELF="$(dirname "$SELF")/$_link" ;;
    esac
done
DIR="$(cd -- "$(dirname -- "$SELF")" && pwd -P)"

# The student's course directory holds only what they use: the launcher and projects/.
# Flag files live in .config/, and everything needed to build or maintain the image --
# including the message catalogue, which is script config rather than something a student
# reads -- lives in .private/. See issue #16.
CONFIG="$DIR/.config"
ARGS_FILE="$CONFIG/container.args"
LOCAL_ARGS_FILE="$CONFIG/local.args"
MESSAGES="$DIR/.private/messages.txt"
WORKSPACE="$DIR/projects"
# Build and maintenance files live in .private/, so a student's course directory holds only
# what they actually use: the launcher, the two flag files, messages.txt and projects/.
# See issue #16.
PRIVATE="$DIR/.private"
CONTAINERFILE="$PRIVATE/Containerfile"

# ─── the tunnel's files ────────────────────────────────────────────────────────
# Key material lives beside local.args in .config/, git-ignored, generated once per machine.
# The private halves NEVER enter the container; the public half and the host key are
# bind-mounted read-only, so a compromised container cannot alter who may log in.
TUNNEL_KEY="$CONFIG/tunnel-key"
TUNNEL_HOST_KEY="$CONFIG/tunnel-host-key"
TUNNEL_KNOWN_HOSTS="$CONFIG/tunnel-known-hosts"
# The name the tunnel connects to. Never resolved -- ProxyCommand replaces the connection
# entirely -- but it IS the key that known_hosts is looked up under, so it has to be stable.
TUNNEL_HOST="cs193v-tunnel"
# And the account inside the container, which MUST be stated explicitly. ssh otherwise
# defaults to the login name on the HOST -- so it would try to log in as whatever the
# student's macOS or Windows account is called, and sshd would refuse it (AllowUsers student,
# and the key is student's). The failure is a bare "Permission denied (publickey)" with
# nothing pointing at the cause, and it would happen on every machine whose user is not
# called "student" -- which is all of them.
TUNNEL_USER="student"
# Where the container's sshd finds its host key and config. Must match files/sshd_config's
# HostKey line and the Containerfile's install path.
TUNNEL_HOST_KEY_DST="/etc/ssh/cs193v_host_ed25519_key"
TUNNEL_SSHD_CONFIG="/etc/ssh/cs193v_sshd_config"
TUNNEL_AUTH_KEYS_DST="/home/student/.ssh/authorized_keys"

NAME="cs193v"
# NAME and DEV_IMAGE are not final: CS193V_INSTANCE suffixes both. See "developer
# instance" below.
# Where the student's projects/ directory appears inside the container. Under $HOME rather
# than at the root: the host directory is called projects/, so calling it anything else
# inside is a name mismatch a student has to hold in their head for ten weeks, and a
# top-level /workspaces is not where a Unix user looks for their own files. Defined once —
# the Containerfile's WORKDIR and pre-created directory must match it, which
# 10-static.sh :: launcher:mount-destination-matches-WORKDIR asserts.
MOUNT_DST="/home/student/projects"
DEV_IMAGE="localhost/cs193v:dev"
MIN_PODMAN="5.7.0"
ESC=$(printf '\033')

# ─── output helpers ────────────────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED=$(printf '\033[1;91m'); C_DIM=$(printf '\033[2m')
    C_CYAN=$(printf '\033[1;36m'); C_YEL=$(printf '\033[1;33m')
    C_OFF=$(printf '\033[0m')
else
    C_RED=''; C_DIM=''; C_CYAN=''; C_YEL=''; C_OFF=''
fi

info() { printf '%s\n' "$*"; }
note() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }

# A warning has to be ACKNOWLEDGED, not merely printed. The launcher's last act is
# `exec podman exec -it ... cs193v-shell`, and cs193v-shell attaches tmux, which switches
# the terminal to its alternate screen -- so every line printed beforehand is wiped from
# view before a student has read a word of it. The dev-image advisory, "the tunnel did not
# come up" and "these ports were already in use" were all displayed and none of them was
# readable: the student got a banner, a shell prompt, and no idea why their browser cannot
# reach their server. Issue #19.
#
# So warn() records, and open_shell waits for ENTER before the exec when anything was
# recorded. die() needs nothing of the sort -- it exits, so nothing ever starts tmux, and
# the red box stays on screen. Nor do the verbs: --rebuild, --update and friends return to
# the student's own shell with their output intact.
#
# The record is a FILE rather than a variable because tunnel_start runs
# `for port in $(tunnel_ports)`, and tunnel_ports warns about a malformed CS193V_PORTS
# entry from inside that command substitution -- a subshell, where an assignment would be
# discarded on return. The text reaches the terminal either way, since warn() writes to
# stderr and `$( )` does not capture it; it is exactly the record, the half that decides
# whether the student gets a chance to read it, that a variable would lose. $$ stays the
# parent shell's pid inside a subshell, so both halves agree on the path.
WARN_ACK="${TMPDIR:-/tmp}/cs193v-warned.$$"
# Pids are reused, so a file left behind by a crash could otherwise make a launch with
# nothing to say stop and ask to be acknowledged.
rm -f "$WARN_ACK"
trap 'rm -f "$WARN_ACK"' EXIT

warn() {
    printf '%s%s%s\n' "$C_YEL" "$*" "$C_OFF" >&2
    # An unwritable TMPDIR must not turn a warning into a failure: the student still sees
    # the text, they just do not get stopped for it.
    { : >> "$WARN_ACK"; } 2>/dev/null || true
}

# Hold the screen so anything warn() printed survives what comes next. See warn().
acknowledge_warnings() {
    local _ack
    [ -e "$WARN_ACK" ] || return 0
    rm -f "$WARN_ACK"
    # open_shell has already refused a non-terminal stdin, so this cannot normally fire --
    # but a prompt nobody can answer would turn "we printed a warning" into "the launcher
    # hangs", which is a worse bug than the one being fixed.
    [ -t 0 ] || return 0
    printf '\n'
    note "$(msg prompt.acknowledge-warnings)"
    IFS= read -r _ack || true
}

# The red STOP banner, in the same spirit as the devcontainer's .error.sh: a novice must
# be able to tell "this is course infrastructure, stop and contact staff" from "I typed
# something wrong."
die() {
    printf '\n%s┏━━ STOP ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓%s\n' "$C_RED" "$C_OFF" >&2
    while IFS= read -r _l; do
        printf '%s┃%s %s\n' "$C_RED" "$C_OFF" "$_l" >&2
    done <<EOF
$*
EOF
    printf '%s┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛%s\n\n' "$C_RED" "$C_OFF" >&2
    exit 1
}

# Student-facing prose lives in messages.txt so it can be reworded without touching
# logic. msg <key> [NAME=value ...]
msg() {
    local key="$1"; shift
    local out kv n v ph head tail
    [ -f "$MESSAGES" ] || { printf '(messages.txt missing)\n'; return 1; }
    out="$(awk -v k="[[$key]]" '
        $0 == k { found = 1; next }
        /^\[\[.*\]\]$/ { if (found) exit }
        found { print }
    ' "$MESSAGES")"
    if [ -z "$out" ]; then printf '(missing message: %s)\n' "$key"; return 1; fi
    for kv in "$@"; do
        n="${kv%%=*}"; v="${kv#*=}"
        ph="{{$n}}"
        # Substitution is done by literal split-and-rejoin. Both obvious alternatives are
        # wrong here, and both fail in ways that only show up in an error path:
        #
        #   sed "s|{{$n}}|$v|g"  — sed's replacement text cannot contain a newline, and
        #       err.create-failed and err.pull-failed both interpolate raw podman output,
        #       which is always multi-line. It printed "unterminated `s' command" and
        #       returned nothing, so die() drew an EMPTY red STOP box: the student got a
        #       blank banner at the exact moment they most needed the diagnosis.
        #
        #   ${out//"$ph"/$v}  — bash 5.2 and newer expand `&` in the replacement to the
        #       matched text, the way sed does, while bash 3.2 treats it literally. Any
        #       podman message containing & would therefore render differently on Linux
        #       than on macOS, which is worse than a bug that is wrong everywhere.
        #
        # `head` accumulates what is already substituted and `tail` is what is left to
        # scan, so a value that itself contains {{NAME}} is copied through instead of
        # being rescanned forever.
        head=''; tail="$out"
        while :; do
            case "$tail" in
                *"$ph"*) head="$head${tail%%"$ph"*}$v"; tail="${tail#*"$ph"}" ;;
                *)       break ;;
            esac
        done
        out="$head$tail"
    done
    printf '%s\n' "$out"
}

# ─── portable timeout ──────────────────────────────────────────────────────────
# GNU `timeout` is NOT on stock macOS, so this is hand-rolled with zero dependencies.
# Every podman probe goes through it: after a Mac wakes from sleep, `podman info` HANGS
# rather than fails (containers/podman#21675), and an unguarded probe makes the launcher
# look frozen with no output at all.
RT_OUT=''
run_timeout() {                       # run_timeout SECS CMD...  -> RT_OUT, returns rc
    local secs="$1"; shift
    local tmp pid i rc
    tmp="$(mktemp "${TMPDIR:-/tmp}/cs193v.XXXXXX")" || return 125
    ( "$@" >"$tmp" 2>&1 ) & pid=$!
    i=0; rc=124
    while [ "$i" -lt "$((secs * 10))" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then wait "$pid"; rc=$?; break; fi
        sleep 0.1
        i=$((i + 1))
    done
    if [ "$rc" -eq 124 ]; then kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; fi
    RT_OUT="$(cat "$tmp")"
    rm -f "$tmp"
    return "$rc"
}

pm()  { run_timeout 20 podman "$@"; }     # a podman call that should be quick
pmq() { run_timeout 20 podman "$@" >/dev/null 2>&1; }

# ─── arrow-key menu ────────────────────────────────────────────────────────────
# Never [y/N]: students do not know that convention this early in the quarter. The
# default is always the SAFE option and is visually highlighted rather than signalled by
# capitalisation. Falls back to the default when there is no tty.
MENU_CHOICE=0
menu() {                              # menu DEFAULT_INDEX opt1 opt2 ...
    local def="$1"; shift
    local opts n sel i key rest
    opts=( "$@" ); n=${#opts[@]}; sel="$def"

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        MENU_CHOICE="$def"
        printf '  (not a terminal; choosing "%s")\n' "${opts[$def]}"
        return 0
    fi

    while :; do
        i=0
        while [ "$i" -lt "$n" ]; do
            if [ "$i" -eq "$sel" ]; then
                printf '  %s▸ %s%s\n' "$C_CYAN" "${opts[$i]}" "$C_OFF"
            else
                printf '    %s\n' "${opts[$i]}"
            fi
            i=$((i + 1))
        done
        printf '\n  %s(use the up and down arrow keys, then press Enter)%s' "$C_DIM" "$C_OFF"

        IFS= read -rsn1 key
        if [ "$key" = "$ESC" ]; then IFS= read -rsn2 rest; key="$key$rest"; fi

        printf '\r%s[K' "$ESC"
        printf '%s[%dA%s[J' "$ESC" "$((n + 1))" "$ESC"

        case "$key" in
            "${ESC}[A"|k|K) sel=$(( (sel + n - 1) % n )) ;;
            "${ESC}[B"|j|J) sel=$(( (sel + 1) % n )) ;;
            ''|"$(printf '\n')") break ;;
            [1-9]) if [ "$key" -le "$n" ]; then sel=$((key - 1)); break; fi ;;
        esac
    done
    printf '  %s▸ %s%s\n\n' "$C_CYAN" "${opts[$sel]}" "$C_OFF"
    MENU_CHOICE="$sel"
}

confirm() {                           # confirm "no-text" "yes-text"  -> 0 if yes
    menu 0 "$1" "$2"
    [ "$MENU_CHOICE" -eq 1 ]
}

# ─── small utilities ───────────────────────────────────────────────────────────
version_lt() {                        # version_lt A B -> prints yes if A < B
    awk -v a="$1" -v b="$2" 'BEGIN{
        na = split(a, A, "."); nb = split(b, B, ".")
        for (i = 1; i <= 3; i++) {
            x = (i <= na ? A[i] + 0 : 0); y = (i <= nb ? B[i] + 0 : 0)
            if (x < y) { print "yes"; exit }
            if (x > y) { print "no";  exit }
        }
        print "no" }'
}

sha_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    else shasum -a 256 | awk '{print $1}'; fi
}

# podman forces TERM=xterm and does not copy the client's value
# (containers/podman#25683), which costs 256-colour support. But the image has a limited
# terminfo set, so forwarding an exotic TERM verbatim would leave a full-screen editor
# unable to start. Whitelist, and fall back to a safe 256-colour entry.
safe_term() {
    case "${TERM:-}" in
        xterm|xterm-256color|xterm-color|screen|screen-256color|tmux|tmux-256color|\
        vt100|vt220|linux|ansi|dumb|rxvt|rxvt-unicode-256color)
            printf '%s' "$TERM" ;;
        '') printf 'xterm-256color' ;;
        *)  printf 'xterm-256color' ;;    # kitty, ghostty, alacritty, wezterm, foot...
    esac
}

platform() {
    case "$(uname -s)" in
        Darwin) printf 'macos' ;;
        Linux)  if grep -qi microsoft /proc/version 2>/dev/null; then printf 'wsl'
                else printf 'linux'; fi ;;
        *)      printf 'other' ;;
    esac
}

has_machine() {                       # is a podman machine in play (macOS)?
    [ "$(platform)" = macos ] || return 1
    pmq machine list --format '{{.Name}}'
}

# ─── developer instance ────────────────────────────────────────────────────────
# CS193V_INSTANCE gives one computer several INDEPENDENT installations. It suffixes the
# container name, the dev image tag and all five volume names TOGETHER, which is the point:
# suffixing only some of them is worse than suffixing none, because `--full-rebuild` in one
# instance would still destroy the other instance's logins.
#
# This exists because two people developing the container on the same machine otherwise
# share every one of them silently: the container `cs193v`, the image `localhost/cs193v:dev`,
# and the volumes cs193v-claude and friends. The failure is not a clean collision but a slow
# one — whoever runs `--dev-build` last owns the container the other is about to shell into.
#
# A student never sets it. With it unset every name is byte-identical to what it was
# before, which is what keeps this from being a behaviour change for anyone but us.
#
# Deliberately NOT suffixed: MOUNT_DST, the workspace path, and the cs193v.dir label.
# Those are already per-directory, and ensure_container's owner-dir check keys off
# cs193v.dir, so two checkouts are distinguishable even with no instance set.
INSTANCE="${CS193V_INSTANCE:-}"
case "$INSTANCE" in
    '') : ;;
    # Anything outside this set would produce an invalid container or volume name, and
    # podman's own error for that names neither CS193V_INSTANCE nor this script. A literal
    # string rather than a messages.txt key, matching verb_dev_build: that catalogue is for
    # student-facing prose, and no student ever sets this.
    *[!A-Za-z0-9_-]*)
        die "CS193V_INSTANCE=$INSTANCE is not usable as a name.
Use only letters, digits, hyphens and underscores." ;;
    *)  NAME="$NAME-$INSTANCE"
        DEV_IMAGE="$DEV_IMAGE-$INSTANCE" ;;
esac

# ─── the tunnel's runtime paths ────────────────────────────────────────────────
# In TMPDIR, not .config/, for two reasons. A unix socket path is capped near 104 bytes on
# macOS and 108 on Linux, and this launcher already expects deep course directories with
# spaces in them (see the cs193v.dir label) -- so a socket under $DIR could simply be too
# long to bind. And these are per-boot runtime state, not configuration: leaving a stale
# socket in the student's course directory would be clutter that outlives its meaning.
#
# Keyed by a hash of $DIR so two checkouts never share a socket even with no instance set,
# which matters because the control socket IS the tunnel's identity for -O check/exit.
# run_timeout already uses ${TMPDIR:-/tmp}, so this is an existing idiom rather than a new
# assumption about the platform.
TUNNEL_ID="$(printf '%s\n' "$DIR" "$INSTANCE" | sha_stdin | cut -c1-12)"
TUNNEL_CTL="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.ctl"
TUNNEL_PID="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.pid"
TUNNEL_LOG="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.log"

# ─── argument files ────────────────────────────────────────────────────────────
ARGS=()
IMAGE=''
load_args() {
    local f line word
    ARGS=(); IMAGE=''
    [ -f "$ARGS_FILE" ] || die "$(msg err.no-args-file FILE="$ARGS_FILE")"
    for f in "$ARGS_FILE" "$LOCAL_ARGS_FILE"; do
        [ -f "$f" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%%#*}"
            # trim both ends without bash 4 features
            line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            [ -z "$line" ] && continue
            case "$line" in
                IMAGE=*) IMAGE="${line#IMAGE=}"; continue ;;
            esac
            for word in $line; do
                # The volume names live in container.args, not up here, so the instance
                # suffix has to be applied as they are read. `cs193v-claude:/path` becomes
                # `$NAME-claude:/path`, and since NAME is plain "cs193v" when no instance
                # is set, this is a no-op for a student. Matching on the trailing colon is
                # what keeps it off `--hostname cs193v-development`, the only other word
                # here that starts with the same eight characters.
                case "$word" in
                    cs193v-*:*) word="$NAME-${word#cs193v-}" ;;
                esac
                ARGS[${#ARGS[@]}]="$word"
            done
        done < "$f"
    done

    # command line and environment override the pin, for the instructor's dev loop
    [ -n "${CS193V_IMAGE:-}" ] && IMAGE="$CS193V_IMAGE"
    [ -n "${OVERRIDE_IMAGE:-}" ] && IMAGE="$OVERRIDE_IMAGE"
}

# The flags the launcher itself contributes: identity, the workspace mount, and the
# labels that make drift detectable.
RUN_ARGS=()
build_run_args() {
    local relabel=''
    # Relabel narrowly, and only where SELinux is actually enforcing. Never :Z, and
    # never on a home or system directory: it walks every inode and can break unrelated
    # host services.
    if command -v getenforce >/dev/null 2>&1; then
        [ "$(getenforce 2>/dev/null)" = "Enforcing" ] && relabel=',z'
    fi

    RUN_ARGS=( --name "$NAME" --detach )
    RUN_ARGS[${#RUN_ARGS[@]}]="--label"
    RUN_ARGS[${#RUN_ARGS[@]}]="cs193v.confighash=$(config_hash)"
    RUN_ARGS[${#RUN_ARGS[@]}]="--label"
    RUN_ARGS[${#RUN_ARGS[@]}]="cs193v.dir=$DIR"
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$WORKSPACE,dst=$MOUNT_DST,rw$relabel"
    # The tunnel's key material, read-only. Added here rather than in container.args because
    # the paths are absolute and machine-specific -- the same reason local.args exists.
    #
    # Appended one element at a time, NOT via $(some_function) with word splitting: the
    # course directory is allowed to contain spaces (see the cs193v.dir label) and a split
    # would silently tear such a path in half, exactly as it would for the workspace mount
    # immediately above.
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$TUNNEL_KEY.pub,dst=$TUNNEL_AUTH_KEYS_DST,ro"
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$TUNNEL_HOST_KEY,dst=$TUNNEL_HOST_KEY_DST,ro"
    local a
    # ${arr[@]+"${arr[@]}"}, not "${arr[@]}": expanding an EMPTY array under `set -u` is a
    # fatal "unbound variable" on bash < 4.4, which is every Mac. A container.args holding
    # only comments is exactly the mis-edited-file support case, and it must produce our
    # error message rather than a raw bash one. The guard still preserves elements
    # containing spaces, which matters for --label cs193v.dir=/home/me/My Course/cs193v.
    for a in ${ARGS[@]+"${ARGS[@]}"}; do RUN_ARGS[${#RUN_ARGS[@]}]="$a"; done
}

# Everything that would require a different container if it changed. `podman start`
# reuses the container's STORED config and ignores the image digest, the port list,
# keep-id and --memory alike — so without this, "exists -> start" would permanently
# freeze each student's flags at whatever they were on first run, and edits to
# container.args would never reach anyone.
config_hash() {
    # The dev-image fallback lives HERE rather than at each call site, so every caller
    # agrees by construction. verb_doctor resolved nothing and so hashed IMAGE="", while
    # the launch path and --dev-print-command both hashed the resolved dev image — which
    # made doctor report every dev-mode container as STALE and send people chasing a
    # recreate prompt that never appears. A local, so IMAGE is not mutated and doctor's
    # honest "<unset: dev mode>" line still reads correctly.
    local img="${IMAGE:-$DEV_IMAGE}"
    # MOUNT_DST is hashed as well as WORKSPACE. It used to be a constant baked into
    # build_run_args and never hashed at all — so when the mount moved from /workspaces to
    # ~/projects, every container already on a student's machine would have kept the old
    # path with no recreate prompt, and the docs would have described a directory nobody
    # was standing in.
    # The tunnel's mount destinations are hashed for exactly the reason MOUNT_DST is: they
    # are decided here rather than in container.args, so nothing else would notice if they
    # moved, and a container created without them cannot serve a tunnel at all -- sshd would
    # have no authorized_keys and no host key. Without this, a student whose container
    # predates the tunnel would get no recreate prompt and a tunnel that simply never works.
    { printf '%s\n' "$img" "$WORKSPACE" "$MOUNT_DST"
      printf '%s\n' "$TUNNEL_AUTH_KEYS_DST" "$TUNNEL_HOST_KEY_DST"
      printf '%s\n' ${ARGS[@]+"${ARGS[@]}"}; } | sha_stdin
}

# ─── preflight ─────────────────────────────────────────────────────────────────
preflight() {
    if [ "$(id -u)" -eq 0 ]; then die "$(msg err.running-as-root)"; fi

    if ! command -v podman >/dev/null 2>&1; then
        die "$(msg err.no-podman)"
    fi

    # The tunnel needs the ssh CLIENT on the host -- not a server. macOS ships it and so does
    # essentially every Linux; the realistic gap is a minimal WSL distro. Checked here rather
    # than at first use so the diagnosis arrives before a container exists, and names the
    # package rather than leaving a student to decode "ssh: command not found".
    if ! command -v ssh >/dev/null 2>&1 || ! command -v ssh-keygen >/dev/null 2>&1; then
        die "$(msg err.no-ssh)"
    fi

    if ! run_timeout 10 podman --version; then
        die "$(msg err.podman-hangs)"
    fi
    local ver
    ver="$(printf '%s' "$RT_OUT" | awk '{print $NF}')"
    if [ "$(version_lt "$ver" "$MIN_PODMAN")" = yes ]; then
        die "$(msg err.podman-too-old FOUND="$ver" NEED="$MIN_PODMAN")"
    fi

    if ! pm info --format '{{.Host.Security.Rootless}}'; then
        die "$(msg err.podman-unreachable)"
    fi
    if [ "$RT_OUT" != "true" ]; then
        die "$(msg err.rootful)"
    fi

    if ! grep -q "^$(id -un):" /etc/subuid 2>/dev/null; then
        case "$(platform)" in
            linux|wsl) die "$(msg err.no-subuid USER="$(id -un)")" ;;
        esac
    fi

    [ -d "$WORKSPACE" ] || mkdir -p "$WORKSPACE" || die "$(msg err.no-workspace DIR="$WORKSPACE")"
}

# ─── container state ───────────────────────────────────────────────────────────
state() {                             # -> absent | created | exited | running | ...
    if pm inspect "$NAME" --format '{{.State.Status}}'; then printf '%s' "$RT_OUT"
    else printf 'absent'; fi
}

label_of() { pm inspect "$NAME" --format "{{index .Config.Labels \"$1\"}}" && printf '%s' "$RT_OUT"; }
image_of() { pm inspect "$NAME" --format '{{.Image}}' && printf '%s' "$RT_OUT"; }

resolve_image() {
    if [ -z "$IMAGE" ]; then
        if pmq image exists "$DEV_IMAGE"; then
            IMAGE="$DEV_IMAGE"
            warn "$(msg warn.dev-mode IMAGE="$DEV_IMAGE")"
        else
            die "$(msg err.no-image FILE="$ARGS_FILE")"
        fi
    elif [ "$IMAGE" = "$DEV_IMAGE" ]; then
        warn "$(msg warn.dev-mode IMAGE="$DEV_IMAGE")"
    fi
}

create_container() {
    # BEFORE podman run, not just before the tunnel starts. The key material is bind-mounted,
    # and podman creates a missing bind-mount source as a DIRECTORY -- so a first run with no
    # keys yet would silently mount a directory over authorized_keys and the host key, and
    # sshd would then fail for a reason with no obvious connection to the cause.
    tunnel_keys
    build_run_args
    info "$(msg status.creating)"
    if ! run_timeout 180 podman run ${RUN_ARGS[@]+"${RUN_ARGS[@]}"} "$IMAGE"; then
        die "$(msg err.create-failed OUT="$RT_OUT")"
    fi
    # Every verb that makes a container funnels through here, so the tunnel is raised in one
    # place rather than at each of the six call sites where one could be forgotten. Failure is
    # deliberately NOT fatal: the container and the shell are still perfectly usable, only the
    # browser-facing ports are missing, and ensure_tunnel has already said so.
    ensure_tunnel || true
}

# The tunnel goes first, always. It holds every course port on the host's loopback, and those
# are bound by a process that outlives the container -- so removing the container without it
# leaves an ssh client holding all 46 ports against a pipe that no longer has anything on the
# far end, and the REPLACEMENT container's tunnel then cannot bind a single one of them. That
# turns a routine --rebuild into a total outage whose cause is invisible.
remove_container() { tunnel_down; pmq rm -f "$NAME"; }

# Base names, not full ones, so the instance suffix is applied in exactly one place and
# cannot drift from the rewrite in load_args. "$NAME-claude" is "cs193v-claude" for a
# student and "cs193v-<instance>-claude" for a developer, matching container.args either way.
remove_volumes() {
    local v
    for v in claude claude-json gh vercel playwright; do
        pmq volume rm "$NAME-$v"
    done
}

# ─── the loopback tunnel ───────────────────────────────────────────────────────
# What this is and why it exists: podman's port forwarder delivers to the container's eth0
# and never touches its lo, so a server bound to the container's own 127.0.0.1 was
# unreachable from the student's browser. Rather than publish ports, the launcher runs an ssh
# CLIENT on the host that binds each course port on the host's loopback and asks an sshd
# INSIDE the container to connect to the container's loopback for each arriving connection.
#
# The transport is a `podman exec` pipe, not a socket: sshd is started in inetd mode (-i), so
# nothing listens anywhere in the system and the only way to reach it is to be able to run
# `podman exec`, which already requires this user's own privileges. That choice is also what
# makes it portable -- `podman exec` is what open_shell already relies on for a shell on all
# three platforms, whereas --network=pasta:--host-lo-to-ns-lo was silently inert on macOS.
#
# One ssh process carries every forward: SSH multiplexes channels over one connection, so a
# new browser connection costs a new channel, not a new `podman exec`. Measured: forwarded
# throughput 322 MB/s and per-connection latency indistinguishable from a published port
# (12.1ms vs 12.6ms), against 158ms per connection for any relay that spawns podman exec
# per connection. That measurement is the whole reason this is ssh and not socat.

# Generated once per machine. Not in the image (that would ship one private key to every
# student) and not per container start (the host key would change on every --rebuild and
# greet students with REMOTE HOST IDENTIFICATION HAS CHANGED for no reason).
tunnel_keys() {
    [ -f "$TUNNEL_KEY" ] || {
        ssh-keygen -q -t ed25519 -N '' -C 'cs193v-tunnel' -f "$TUNNEL_KEY" </dev/null \
            || die "$(msg err.tunnel-keygen)"
    }
    [ -f "$TUNNEL_HOST_KEY" ] || {
        ssh-keygen -q -t ed25519 -N '' -C 'cs193v-tunnel-host' -f "$TUNNEL_HOST_KEY" </dev/null \
            || die "$(msg err.tunnel-keygen)"
    }
    # Pin the container's host key, so StrictHostKeyChecking=yes has something to check and a
    # student never sees an interactive "do you want to continue" prompt. Rewritten every
    # time rather than appended to, so a regenerated host key cannot leave two entries.
    printf '%s %s\n' "$TUNNEL_HOST" "$(cat "$TUNNEL_HOST_KEY.pub")" > "$TUNNEL_KNOWN_HOSTS"
    chmod 600 "$TUNNEL_KEY" "$TUNNEL_HOST_KEY" 2>/dev/null || true
}

# Every port to forward, one per line, from the CS193V_PORTS value in container.args. Derived
# rather than declared a second time: the in-container `ports` command compares listening
# sockets against the same value, and a mismatch would make it give confidently wrong advice.
# The LAST occurrence wins, matching podman's own last--e-wins behaviour, so local.args can
# move one developer's instance out of another's way.
tunnel_ports() {
    local a spec chunk lo hi p
    spec=''
    for a in ${ARGS[@]+"${ARGS[@]}"}; do
        case "$a" in CS193V_PORTS=*) spec="${a#CS193V_PORTS=}" ;; esac
    done
    [ -n "$spec" ] || return 0
    for chunk in $(printf '%s' "$spec" | tr ',' ' '); do
        case "$chunk" in
            *-*) lo="${chunk%%-*}"; hi="${chunk##*-}" ;;
            *)   lo="$chunk"; hi="$chunk" ;;
        esac
        # A malformed range must not spin forever, and must not be silently dropped either:
        # container.args is a file people edit.
        case "$lo$hi" in ''|*[!0-9]*) warn "$(msg warn.tunnel-bad-port CHUNK="$chunk")"; continue ;; esac
        [ "$lo" -le "$hi" ] || { warn "$(msg warn.tunnel-bad-port CHUNK="$chunk")"; continue; }
        p="$lo"
        while [ "$p" -le "$hi" ]; do printf '%s\n' "$p"; p=$((p + 1)); done
    done
}

# Is a tunnel alive for THIS course directory and instance? The control socket is the
# identity, and -O check is the only honest test: a socket file can outlive its process.
tunnel_alive() {
    [ -S "$TUNNEL_CTL" ] || return 1
    run_timeout 10 ssh -S "$TUNNEL_CTL" -O check "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1
}

tunnel_start() {
    local fwd port n
    fwd=''
    n=0
    for port in $(tunnel_ports); do
        fwd="$fwd -L 127.0.0.1:$port:127.0.0.1:$port"
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || { warn "$(msg warn.tunnel-no-ports FILE="$ARGS_FILE")"; return 1; }

    rm -f "$TUNNEL_CTL" "$TUNNEL_PID" "$TUNNEL_LOG"

    # Backgrounded with & and a pidfile rather than `ssh -f`. -f is the idiomatic way to
    # daemonize after authentication, but it forks and the pid we could capture is the parent
    # that immediately exits -- leaving nothing for --reset-tunnel to kill when the tunnel
    # wedges. Polling -O check below recovers the one thing -f was buying, which is finding
    # out synchronously whether authentication actually succeeded.
    #
    # nohup, not setsid: a backgrounded ssh is still in the terminal's session, so closing
    # the window can HUP it -- and setsid(1) DOES NOT EXIST on macOS. The log goes to TMPDIR
    # so nohup never drops a nohup.out in the student's course directory.
    #
    # -F none: ignore the student's own ~/.ssh/config AND the system one, so nothing they
    # have configured for other hosts can redirect or decorate this. NOT
    # ClearAllForwardings, which reads like it would help and would in fact delete every -L
    # below; see the invariants block in container.args.
    #
    # ExitOnForwardFailure is deliberately NOT set. With 46 forwards there are 46 chances one
    # host port is already busy, and either raw behaviour is bad for a novice: the default
    # loses one port silently, and =yes turns one unlucky port into a total outage. Instead
    # every forward is attempted and the failures are read back out of the log below, which
    # is the only way to report what ACTUALLY failed rather than what we predicted would.
    #
    # shellcheck disable=SC2086
    nohup ssh -N -M -S "$TUNNEL_CTL" -F none \
        -i "$TUNNEL_KEY" -o IdentitiesOnly=yes \
        -o "ProxyCommand=podman exec -i $NAME /usr/sbin/sshd -i -f $TUNNEL_SSHD_CONFIG" \
        -o "UserKnownHostsFile=$TUNNEL_KNOWN_HOSTS" -o StrictHostKeyChecking=yes \
        -o ForwardAgent=no -o ForwardX11=no -o PermitLocalCommand=no \
        -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
        $fwd "$TUNNEL_USER@$TUNNEL_HOST" >"$TUNNEL_LOG" 2>&1 </dev/null &
    printf '%s\n' "$!" > "$TUNNEL_PID"

    local i
    i=0
    while [ "$i" -lt 60 ]; do
        tunnel_alive && break
        # If the client is already gone, there is nothing to wait for: report now with the
        # log, rather than spending the remaining thirty seconds on a corpse.
        kill -0 "$(cat "$TUNNEL_PID" 2>/dev/null)" 2>/dev/null || break
        sleep 0.5
        i=$((i + 1))
    done
    if ! tunnel_alive; then
        warn "$(msg warn.tunnel-failed LOG="$TUNNEL_LOG" OUT="$(tail -5 "$TUNNEL_LOG" 2>/dev/null)")"
        return 1
    fi
    tunnel_report_busy_ports
    return 0
}

# Which forwards did not get their host port, according to ssh ITSELF rather than to a guess.
#
# The obvious alternative -- probe each port and see if something is listening -- is wrong in
# exactly the case that matters: a port held by ANOTHER program answers a probe, so a busy
# port would be counted as a working forward and the one thing this report exists to catch
# would be the one thing it missed. Measured: doctor said "46 of 46" while 3005 was squatted.
#
# Reading the log is authoritative because tunnel_start truncates it, so it always describes
# the tunnel that is running now. Both spellings are matched because the wording differs
# between the bind failure and the channel setup that follows it.
#
# Probing would also have connected to every one of the student's own dev servers 46 times
# per doctor run, which would show up in their logs as unexplained requests.
tunnel_busy_ports() {                 # -> space-separated ports ssh could not bind
    [ -f "$TUNNEL_LOG" ] || return 0
    sed -n -e 's/.*cannot listen to port: \([0-9]*\).*/\1/p' \
           -e 's/.*bind \[127\.0\.0\.1\]:\([0-9]*\).*/\1/p' "$TUNNEL_LOG" \
        | sort -u | tr '\n' ' ' | sed 's/ *$//'
}

tunnel_report_busy_ports() {
    local busy
    busy="$(tunnel_busy_ports)"
    [ -n "$busy" ] && warn "$(msg warn.tunnel-ports-busy PORTS="$busy")"
    return 0
}

ensure_tunnel() {
    tunnel_alive && return 0
    tunnel_keys
    tunnel_start || return 1
}

# Paired with remove_container, ALWAYS. A tunnel whose container is gone still holds every
# host port it bound, which would stop the replacement container's tunnel from binding them
# -- turning a routine --rebuild into a total outage with no visible cause.
tunnel_down() {
    if [ -S "$TUNNEL_CTL" ]; then
        run_timeout 10 ssh -S "$TUNNEL_CTL" -O exit "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1
    fi
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID"
}

# The state machine. Everything that can silently give a student the wrong container is
# checked here.
ensure_container() {
    local st want_hash have_hash have_image
    st="$(state)"

    if [ "$st" = absent ]; then
        create_container
        return
    fi

    # A container created from a DIFFERENT copy of the course directory. Without this
    # check, a student who downloads a fresh copy after breaking something silently gets
    # the old container with the old mount, and their edits appear to vanish.
    local owner_dir
    owner_dir="$(label_of cs193v.dir)"
    if [ -n "$owner_dir" ] && [ "$owner_dir" != "$DIR" ]; then
        die "$(msg err.other-directory INUSE="$owner_dir" YOURS="$DIR")"
    fi

    want_hash="$(config_hash)"
    have_hash="$(label_of cs193v.confighash)"
    have_image="$(image_of)"

    if [ -n "$have_hash" ] && [ "$have_hash" != "$want_hash" ]; then
        printf '\n'; msg prompt.config-changed
        if confirm "$(msg opt.keep-current)" "$(msg opt.recreate)"; then
            remove_container; create_container; return
        fi
    fi

    # Same prompt shape for a newer pinned image.
    if pmq image exists "$IMAGE"; then
        pm image inspect "$IMAGE" --format '{{.Id}}'
        local pinned_id="$RT_OUT"
        if [ -n "$pinned_id" ] && [ -n "$have_image" ] && [ "$pinned_id" != "$have_image" ]; then
            printf '\n'; msg prompt.newer-image
            if confirm "$(msg opt.keep-current-version)" "$(msg opt.update-now)"; then
                remove_container; create_container; return
            fi
        fi
    fi

    case "$st" in
        running) : ;;
        *) info "$(msg status.starting)"
           pmq start "$NAME" || { remove_container; create_container; return; } ;;
    esac

    # Reached only when the container was already there -- created-and-tunnelled paths above
    # all return. An existing container very often has no tunnel: the host rebooted, the
    # student logged out and back in, or podman was restarted. So this is where "the container
    # is fine but nothing reaches my server" gets fixed, and it is why ensure_tunnel has to be
    # idempotent and cheap rather than something only the create path does.
    ensure_tunnel || true
}

# Is this pid one of OUR exec clients, still alive on this machine?
#
# `kill -0` alone is not enough: pids are reused, and a recycled one would make us treat a
# stale session as live and hand the student a brand-new one instead of their tabs. Checking
# that the process is a podman is cheap and rules out essentially every reuse.
host_client_alive() {
    kill -0 "$1" 2>/dev/null || return 1
    ps -o args= -p "$1" 2>/dev/null | grep -q podman
}

# Detach tmux clients whose terminal window is gone.
#
# MEASURED, and it is the reason this function exists at all. Closing a terminal window does
# NOT kill the tmux client inside the container: conmon keeps the exec session's pty open,
# the client stays blocked reading it, and tmux goes on reporting the session as attached --
# indefinitely, not for a few seconds. Nothing inside the container can distinguish that from
# a live client; both ptys still exist and both are still writable.
#
# Left alone, that quietly breaks the behaviour the tabs exist for. cs193v-shell attaches to
# a session only if it has no client, so it would never find one, every launch would build a
# fresh session, and the student's real tabs would pile up unreachable behind a ghost.
#
# The host is the only side that CAN tell, because the client is a `podman exec` process it
# started, so cs193v-shell stamps each session with the pid that attached it and this prunes
# the ones whose process has gone. Cheap, and idempotent.
prune_stale_tmux_clients() {
    [ "$(state)" = running ] || return 0
    pm exec "$NAME" tmux -L cs193v list-sessions \
        -F '#{session_name} #{session_attached} #{@cs193v_host_pid}' 2>/dev/null || return 0
    printf '%s\n' "$RT_OUT" | while read -r _s _att _pid; do
        [ -n "$_s" ] || continue
        [ "${_att:-0}" = 0 ] && continue
        case "${_pid:-}" in ''|0) continue ;; esac
        host_client_alive "$_pid" && continue
        podman exec "$NAME" tmux -L cs193v detach-client -s "=$_s" >/dev/null 2>&1
    done
    return 0
}

open_shell() {
    local n
    # Refuse, rather than hang, when there is no terminal to open a shell on.
    #
    # `podman exec -it` allocates a pty, and a pty NEVER delivers EOF the way a pipe does —
    # so with a redirected stdin the container's `bash -l` waits forever for input that
    # cannot arrive, and the launcher looks wedged with no output. Redirecting from
    # /dev/null does not help; only sending a literal `exit` does. Measured: see
    # ERRORS.md B13.
    #
    # Checked here rather than in the dispatcher on purpose. Everything up to this point —
    # preflight, the drift prompts, creating or starting the container — is useful and
    # idempotent, so a script that gets this far has still done real work and the message
    # can say so.
    if [ ! -t 0 ]; then
        die "$(msg err.needs-a-terminal)"
    fi
    # A non-destructive nudge: many concurrent sessions is legitimate, but it is also how
    # an invisible memory problem starts.
    #
    # This counts tmux CLIENTS -- one per attached terminal window -- where it used to count
    # `bash` processes in `podman top`. It had to change with the landing point: every tab
    # is a bash now, so a process count would fire at six tabs in a single window, which is
    # ordinary use of the very thing the tab bar exists to encourage. Clients preserve what
    # the check originally meant, and therefore when it originally fired: "how many terminal
    # windows have you got pointed at this container".
    if pm exec "$NAME" tmux -L cs193v list-clients -F '#{client_tty}' 2>/dev/null; then
        n="$(printf '%s\n' "$RT_OUT" | grep -c . || true)"
        [ "${n:-0}" -gt 6 ] && warn "$(msg warn.many-shells N="$n")"
    fi
    # Must run BEFORE the exec, or the session the student should be getting back still
    # looks occupied and they get a new one instead.
    prune_stale_tmux_clients

    # LAST, so it covers everything printed on the way here -- including warn.many-shells
    # just above -- and so the warnings are still the newest thing on screen while the
    # student reads them. One line further down is `exec`, after which tmux's alternate
    # screen erases all of it. See warn().
    acknowledge_warnings

    # cs193v-shell puts the student inside tmux; see files/cs193v-shell. CS193V_CONTAINER is
    # passed because its failure path has to tell a student the exact `podman exec` line to
    # run, and nothing inside the container can work out the container's name --
    # CS193V_INSTANCE may have suffixed it, and the hostname is cs193v-development either way.
    #
    # CS193V_CLIENT_PID is this shell's own pid, which `exec` hands straight to podman -- so
    # it IS the pid of the client process, and it is what prune_stale_tmux_clients looks for
    # on the next launch.
    exec podman exec -it \
        -w "$MOUNT_DST" \
        -e "TERM=$(safe_term)" \
        -e "COLORTERM=${COLORTERM:-}" \
        -e "CS193V_CONTAINER=$NAME" \
        -e "CS193V_CLIENT_PID=$$" \
        "$NAME" cs193v-shell
}

# ─── verbs ─────────────────────────────────────────────────────────────────────
verb_ports() {
    [ "$(state)" = running ] || die "$(msg err.not-running)"
    exec podman exec -it -e "TERM=$(safe_term)" "$NAME" ports
}

verb_doctor() {
    printf '%sCS193V container report%s\n' "$C_CYAN" "$C_OFF"
    printf '%s\n' "-------------------------------------------------------------"
    printf '  %-16s %s\n' "platform" "$(platform) / $(uname -m)"
    printf '  %-16s %s\n' "course dir" "$DIR"

    if command -v podman >/dev/null 2>&1 && run_timeout 10 podman --version; then
        printf '  %-16s %s\n' "podman" "$(printf '%s' "$RT_OUT" | awk '{print $NF}')"
    else
        printf '  %-16s %s\n' "podman" "NOT FOUND or not responding"
        return 1
    fi

    if has_machine; then
        pm machine list --format '{{.Name}} {{.Running}}'
        printf '  %-16s %s\n' "machine" "${RT_OUT:-none}"
    fi

    if pm info --format '{{.Host.MemTotal}} {{.Host.CPUs}} {{.Host.RootlessNetworkCmd}}'; then
        printf '  %-16s %s\n' "podman sees" "$RT_OUT"
    else
        printf '  %-16s %s\n' "podman info" "TIMED OUT (a Mac that has slept can do this)"
    fi

    load_args
    printf '  %-16s %s\n' "pinned image" "${IMAGE:-<unset: dev mode>}"

    local st; st="$(state)"
    printf '  %-16s %s\n' "container" "$st"
    if [ "$st" != absent ]; then
        pm inspect "$NAME" --format '{{.State.StartedAt}}'
        printf '  %-16s %s\n' "started" "$RT_OUT"
        local hv hw; hv="$(label_of cs193v.confighash)"; hw="$(config_hash)"
        if [ "$hv" = "$hw" ]; then printf '  %-16s %s\n' "config" "matches container.args"
        else printf '  %-16s %s\n' "config" "STALE — run cs193v and accept the recreate prompt"; fi
        pm inspect "$NAME" --format "{{range .Mounts}}{{if eq .Destination \"$MOUNT_DST\"}}{{.Source}}{{end}}{{end}}"
        printf '  %-16s %s\n' "workspace" "${RT_OUT:-?}"
    fi

    if [ "$st" = running ]; then
        pm exec "$NAME" sh -c 'echo "$(id -u):$(id -g)"'
        printf '  %-16s %s (host is %s:%s)\n' "in-container uid" "$RT_OUT" "$(id -u)" "$(id -g)"
        pm exec "$NAME" sh -c 'cat /sys/fs/cgroup/memory.max 2>/dev/null'
        printf '  %-16s %s\n' "memory limit" "${RT_OUT:-unknown}"
        pm exec "$NAME" sh -c 'ps -eo stat --no-headers | grep -c Z'
        printf '  %-16s %s\n' "zombies" "${RT_OUT:-0}"
        tmux_doctor
        tunnel_doctor
        check_clock
    fi
    printf '%s\n' "-------------------------------------------------------------"
    printf '%s\n' "Paste all of the above when asking course staff for help."
}

# tmux is the landing point, so "what is my session doing" is now a support question. A
# student who says "my tabs vanished" or "I have two windows showing the same thing" is
# describing session state that nothing else in this report would show.
#
# Sessions and their window counts, plus how many clients are attached to each: a session
# with 0 clients is one waiting to be picked back up by the next `./cs193v`, which is normal
# and is what closing a terminal window leaves behind. Two clients on one session is the
# mirrored case, which is the benign race cs193v-shell documents.
tmux_doctor() {
    local out
    if pm exec "$NAME" tmux -L cs193v list-sessions \
           -F '#{session_name} #{session_windows}w #{session_attached} attached' 2>/dev/null; then
        out="$RT_OUT"
    else
        printf '  %-16s none (nobody is in the container right now)\n' "tmux sessions"
        return 0
    fi
    if [ -z "$out" ]; then
        printf '  %-16s none (nobody is in the container right now)\n' "tmux sessions"
        return 0
    fi
    printf '  %-16s %s\n' "tmux sessions" "$(printf '%s\n' "$out" | head -1)"
    printf '%s\n' "$out" | tail -n +2 | while IFS= read -r line; do
        [ -n "$line" ] && printf '  %-16s %s\n' "" "$line"
    done
}

# The tunnel's state is now the ONLY place host-side forwarding is visible, which makes this
# load-bearing for support rather than decorative. It replaced a `podman port` count, and the
# difference matters: the in-container `ports` command reads /proc/net/tcp and so cannot see
# whether a forward exists on the host at all. When a student says "ports says OK but my
# browser cannot reach it", this report is the answer, and nothing else is.
tunnel_doctor() {
    local want busy nbusy port pid
    if tunnel_alive; then
        pid="$(cat "$TUNNEL_PID" 2>/dev/null)"
        printf '  %-16s up (pid %s)\n' "tunnel" "${pid:-?}"
    else
        printf '  %-16s %sDOWN%s — run: cs193v --reset-tunnel\n' "tunnel" "$C_YEL" "$C_OFF"
        return 0
    fi

    want=0
    for port in $(tunnel_ports); do want=$((want + 1)); done
    busy="$(tunnel_busy_ports)"
    nbusy=0
    for port in $busy; do nbusy=$((nbusy + 1)); done

    if [ -z "$busy" ]; then
        printf '  %-16s %s of %s forwarded\n' "tunnel ports" "$want" "$want"
    else
        printf '  %-16s %s of %s forwarded  %sNOT:%s %s\n' \
            "tunnel ports" "$((want - nbusy))" "$want" "$C_YEL" "$C_OFF" "$busy"
        printf '  %-16s another program on this computer holds those\n' ""
    fi
}

# The container CANNOT fix its own wall clock: Linux time namespaces virtualise only
# CLOCK_MONOTONIC and CLOCK_BOOTTIME, never CLOCK_REALTIME; setting the clock needs
# CAP_SYS_TIME, which is not in podman's default set; and the kernel checks that
# capability against the INITIAL user namespace anyway. So detection here, remedy in
# the VM. Symptoms all look like network faults: TLS "certificate not yet valid", apt
# complaining about future-dated release files, auth failures.
check_clock() {
    local hs cs skew
    hs="$(date +%s)"
    pm exec "$NAME" date +%s || return 0
    cs="$RT_OUT"
    case "$cs" in ''|*[!0-9]*) return 0 ;; esac
    skew=$(( cs - hs )); [ "$skew" -lt 0 ] && skew=$(( -skew ))
    if [ "$skew" -le 5 ]; then
        printf '  %-16s %ss\n' "clock skew" "$skew"
        return 0
    fi
    printf '  %-16s %ss  %sPROBLEM%s\n' "clock skew" "$skew" "$C_YEL" "$C_OFF"
    has_machine || return 0
    printf '\n'; msg prompt.clock-drift SKEW="$skew"
    if confirm "$(msg opt.leave-clock)" "$(msg opt.restart-machine)"; then
        info "$(msg status.restarting-machine)"
        run_timeout 120 podman machine stop || true
        run_timeout 180 podman machine start || warn "$(msg warn.machine-restart-failed)"
        # Restarting the machine kills the tunnel with it: its transport is a `podman exec`
        # into a VM that just went away. Without this, the clock fix would silently cost the
        # student every forwarded port, and the next symptom would look unrelated to the
        # prompt they just accepted.
        tunnel_down
        ensure_tunnel || true
    fi
}

verb_rebuild() {
    preflight; load_args; resolve_image
    info "$(msg status.rebuilding)"
    remove_container
    create_container
    info "$(msg status.rebuilt)"
}

# The escape hatch for a tunnel that has stopped answering. Its whole reason for existing is
# the case where the tunnel is STUCK, so nothing in it may depend on the tunnel being healthy
# -- that is the difference between this and tunnel_down.
#
# Worth saying plainly, because the symptom is easy to misread: a wedged tunnel does NOT stop
# the container from starting. podman starts it regardless. What a stale tunnel blocks is the
# NEXT tunnel binding the host ports it is still holding, so the symptom is "my browser cannot
# reach my server", not "the container will not start".
verb_reset_tunnel() {
    preflight; load_args; resolve_image
    info "$(msg status.tunnel-resetting)"

    # 1. The clean way first, but TIME-BOXED. A wedged ssh may never answer -O exit, and
    #    waiting forever for it is precisely the failure this verb exists to break out of.
    if [ -S "$TUNNEL_CTL" ]; then
        run_timeout 10 ssh -S "$TUNNEL_CTL" -O exit "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1 || true
    fi

    # 2. Then force. SIGTERM, a moment to land, then SIGKILL -- a process stopped with SIGSTOP
    #    will never handle a TERM, and that is a realistic way to arrive here.
    local pid
    pid="$(cat "$TUNNEL_PID" 2>/dev/null)"
    case "${pid:-}" in
        ''|*[!0-9]*) : ;;
        *) if kill -0 "$pid" 2>/dev/null; then
               kill "$pid" 2>/dev/null || true
               sleep 1
               kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
           fi ;;
    esac

    # 3. A leftover socket makes the next -O check report a dead tunnel as live, which would
    #    make ensure_tunnel decide there was nothing to do.
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID" "$TUNNEL_LOG"

    # 4. Only now is it meaningful to ask who still holds the ports. Anything left is NOT ours
    #    -- it is another program on the student's computer -- and naming it is the difference
    #    between a fixable problem and a mystery.
    if [ "$(state)" != running ]; then
        warn "$(msg warn.tunnel-reset-not-running)"
        return 0
    fi
    ensure_tunnel || return 1
    info "$(msg status.tunnel-reset)"
}

verb_full_rebuild() {
    preflight; load_args; resolve_image
    printf '\n'; msg prompt.full-rebuild
    if ! confirm "$(msg opt.cancel)" "$(msg opt.full-rebuild-go)"; then
        info "$(msg status.cancelled)"; return 0
    fi
    remove_container
    remove_volumes
    create_container
    info "$(msg status.full-rebuilt)"
}

verb_update() {
    preflight; load_args; resolve_image
    if [ "$IMAGE" = "$DEV_IMAGE" ]; then die "$(msg err.update-in-dev-mode)"; fi
    info "$(msg status.pulling IMAGE="$IMAGE")"
    if ! run_timeout 1800 podman pull --retry 10 --retry-delay 5s "$IMAGE"; then
        die "$(msg err.pull-failed OUT="$RT_OUT")"
    fi
    remove_container
    create_container
    info "$(msg status.updated)"
}

verb_print_command() {
    load_args
    if [ -z "$IMAGE" ]; then IMAGE="$DEV_IMAGE"; fi
    build_run_args
    printf 'podman run'
    local a
    for a in ${RUN_ARGS[@]+"${RUN_ARGS[@]}"}; do printf ' %s' "$a"; done
    printf ' %s\n' "$IMAGE"
}

verb_dev_build() {
    preflight
    [ -f "$CONTAINERFILE" ] || die "$(msg err.no-containerfile FILE="$CONTAINERFILE")"
    local nocache=''
    [ "${1:-}" = "--no-cache" ] && nocache='--no-cache'
    info "building $DEV_IMAGE from $CONTAINERFILE"
    # shellcheck disable=SC2086
    podman build $nocache -t "$DEV_IMAGE" -f "$CONTAINERFILE" "$PRIVATE" || die "build failed"
    OVERRIDE_IMAGE="$DEV_IMAGE"
    load_args; resolve_image
    remove_container
    create_container
    open_shell
}

usage() {
    msg help.usage
}

# ─── dispatch ──────────────────────────────────────────────────────────────────
case "${1:-}" in
    '')                  preflight; load_args; resolve_image; ensure_container; open_shell ;;
    ports)               preflight; verb_ports ;;
    doctor)              verb_doctor ;;
    --rebuild)           verb_rebuild ;;
    --reset-tunnel)      verb_reset_tunnel ;;
    --full-rebuild)      verb_full_rebuild ;;
    --update)            verb_update ;;
    --dev-print-command) verb_print_command ;;
    --dev-build)         shift; verb_dev_build "${1:-}" ;;
    -h|--help|help)      usage ;;
    *)                   usage; exit 2 ;;
esac
