#!/usr/bin/env bash
#
# CS193V container launcher.
#
# ONE script for macOS, native Ubuntu, and Windows (inside the WSL2 CS193V distro).
# There is no PowerShell twin: every supported platform has bash.
#
# MUST STAY BASH 3.2 COMPATIBLE — macOS ships bash 3.2. That means:
#   no associative arrays, no mapfile/readarray, no ${var,,}, no `read -t 0.5`,
#   no |& , no &>> .
# VERIFICATION.md §A.1 greps for all of these.
#
# It lives OUTSIDE the directory it mounts, so the container cannot see or rewrite it.
# That replaces the devcontainer's read-only .devcontainer bind mount, and closes a hole
# that trick leaves open: that mount and the writable workspace are two mounts of the
# SAME filesystem with files owned by the agent's own uid, so link(2) — which checks
# write permission only on the destination — yields a writable second name for the same
# inode, which the host then reads on the next rebuild.

set -u

# ─── where we are ──────────────────────────────────────────────────────────────
# Resolved from our own location, not the working directory, so `cs193v` works from
# anywhere and always mounts its own sibling projects/.
SELF="$0"
while [ -L "$SELF" ]; do
    _link="$(readlink "$SELF")"
    case "$_link" in
        /*) SELF="$_link" ;;
        *)  SELF="$(dirname "$SELF")/$_link" ;;
    esac
done
DIR="$(cd -- "$(dirname -- "$SELF")" && pwd -P)"

# The student's course directory holds only what they use: the launcher and projects/.
# Flag files live in .config/, and everything needed to build or maintain the image --
# including the message catalogue, which is script config rather than something a student
# reads -- lives in .private/. See issue #16.
CONFIG="$DIR/.config"
ARGS_FILE="$CONFIG/container.args"
LOCAL_ARGS_FILE="$CONFIG/local.args"
MESSAGES="$DIR/.private/messages.txt"
WORKSPACE="$DIR/projects"
# Build and maintenance files live in .private/, so a student's course directory holds only
# what they actually use: the launcher, the two flag files, messages.txt and projects/.
# See issue #16.
PRIVATE="$DIR/.private"
CONTAINERFILE="$PRIVATE/Containerfile"

# ─── the tunnel's files ────────────────────────────────────────────────────────
# Key material lives beside local.args in .config/, git-ignored, generated once per machine.
# The private halves NEVER enter the container; the public half and the host key are
# bind-mounted read-only, so a compromised container cannot alter who may log in.
TUNNEL_KEY="$CONFIG/tunnel-key"
TUNNEL_HOST_KEY="$CONFIG/tunnel-host-key"
TUNNEL_KNOWN_HOSTS="$CONFIG/tunnel-known-hosts"
# The name the tunnel connects to. Never resolved -- ProxyCommand replaces the connection
# entirely -- but it IS the key that known_hosts is looked up under, so it has to be stable.
TUNNEL_HOST="cs193v-tunnel"
# And the account inside the container, which MUST be stated explicitly. ssh otherwise
# defaults to the login name on the HOST -- so it would try to log in as whatever the
# student's macOS or Windows account is called, and sshd would refuse it (AllowUsers student,
# and the key is student's). The failure is a bare "Permission denied (publickey)" with
# nothing pointing at the cause, and it would happen on every machine whose user is not
# called "student" -- which is all of them.
TUNNEL_USER="student"
# Where the container's sshd finds its host key and config. Must match files/sshd_config's
# HostKey line and the Containerfile's install path.
TUNNEL_HOST_KEY_DST="/etc/ssh/cs193v_host_ed25519_key"
TUNNEL_SSHD_CONFIG="/etc/ssh/cs193v_sshd_config"
TUNNEL_AUTH_KEYS_DST="/home/student/.ssh/authorized_keys"

NAME="cs193v"
# NAME and IMAGE are not final: CS193V_INSTANCE suffixes both. See "developer
# instance" below.
# Where the student's projects/ directory appears inside the container. Under $HOME rather
# than at the root: the host directory is called projects/, so calling it anything else
# inside is a name mismatch a student has to hold in their head for ten weeks, and a
# top-level /workspaces is not where a Unix user looks for their own files. Defined once —
# the Containerfile's WORKDIR and pre-created directory must match it, which
# 10-static.sh :: launcher:mount-destination-matches-WORKDIR asserts.
MOUNT_DST="/home/student/projects"
# The one image this launcher runs, and the one it builds. There is deliberately no way to
# point it somewhere else -- no flag, no environment variable, no line in container.args.
# .private/Containerfile is the distribution and every student builds it; see
# .config/container.args and README.md's "How the image reaches a student".
IMAGE="localhost/cs193v:local"
MIN_PODMAN="5.7.0"
ESC=$(printf '\033')

# ─── output helpers ────────────────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RED=$(printf '\033[1;91m'); C_DIM=$(printf '\033[2m')
    C_CYAN=$(printf '\033[1;36m'); C_YEL=$(printf '\033[1;33m')
    C_GRN=$(printf '\033[1;32m')
    C_OFF=$(printf '\033[0m')
else
    C_RED=''; C_DIM=''; C_CYAN=''; C_YEL=''; C_GRN=''; C_OFF=''
fi

info() { printf '%s\n' "$*"; }
note() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_OFF"; }

# A warning has to be ACKNOWLEDGED, not merely printed. The launcher's last act is
# `exec podman exec -it ... cs193v-shell`, and cs193v-shell attaches tmux, which switches
# the terminal to its alternate screen -- so every line printed beforehand is wiped from
# view before a student has read a word of it. The dev-image advisory, "the tunnel did not
# come up" and "these ports were already in use" were all displayed and none of them was
# readable: the student got a banner, a shell prompt, and no idea why their browser cannot
# reach their server. Issue #19.
#
# So warn() records, and open_shell waits for ENTER before the exec when anything was
# recorded. die() needs nothing of the sort -- it exits, so nothing ever starts tmux, and
# the red box stays on screen. Nor do the verbs: --rebuild, --stop and friends return to
# the student's own shell with their output intact.
#
# The record is a FILE rather than a variable because tunnel_start runs
# `for port in $(tunnel_ports)`, and tunnel_ports warns about a malformed CS193V_PORTS
# entry from inside that command substitution -- a subshell, where an assignment would be
# discarded on return. The text reaches the terminal either way, since warn() writes to
# stderr and `$( )` does not capture it; it is exactly the record, the half that decides
# whether the student gets a chance to read it, that a variable would lose. $$ stays the
# parent shell's pid inside a subshell, so both halves agree on the path.
WARN_ACK="${TMPDIR:-/tmp}/cs193v-warned.$$"
# Pids are reused, so a file left behind by a crash could otherwise make a launch with
# nothing to say stop and ask to be acknowledged.
rm -f "$WARN_ACK"
# meter_kill, not just rm: an animator left running would draw its next frame over
# whatever came after it -- a STOP box, a shell prompt -- 100ms after the launcher stopped
# caring. See meter_stop.
trap 'rm -f "$WARN_ACK" "$METER_STATE"; [ -n "${METER_PID:-}" ] && kill "$METER_PID" 2>/dev/null; :' EXIT

warn() {
    printf '%s%s%s\n' "$C_YEL" "$*" "$C_OFF" >&2
    # An unwritable TMPDIR must not turn a warning into a failure: the student still sees
    # the text, they just do not get stopped for it.
    { : >> "$WARN_ACK"; } 2>/dev/null || true
}

# Hold the screen so anything warn() printed survives what comes next. See warn().
acknowledge_warnings() {
    local _ack
    [ -e "$WARN_ACK" ] || return 0
    rm -f "$WARN_ACK"
    # open_shell has already refused a non-terminal stdin, so this cannot normally fire --
    # but a prompt nobody can answer would turn "we printed a warning" into "the launcher
    # hangs", which is a worse bug than the one being fixed.
    [ -t 0 ] || return 0
    printf '\n'
    note "$(msg prompt.acknowledge-warnings)"
    IFS= read -r _ack || true
}

# The STOP box, in display columns, corners included. 71 leaves a 67-column text field,
# which is what messages.txt is already hard-wrapped to (ERRORS.md A7) — so the box was
# widened by two rather than the 26 messages rewrapped by one.
#
# The borders are GENERATED from this number rather than typed out. They were typed out
# before, in four separate string literals across two scripts, and the copies in
# install-cs193v.sh had already drifted a column apart from each other without anyone
# noticing — which was easy, because while no box had a right edge there was nothing for a
# width to fail to line up with. See box().
BOX_W=71

# Draws a box around whatever it is given on stdin.
#   box [TITLE] [COLOUR] [INDENT]      defaults: STOP, red, none
#
# The title and colour are parameters because the build's success box (issue #22) is the
# first box here that is not an error, and a second renderer to draw a green one would put
# back exactly the duplication issue #21 removed.
#
# Duplicated verbatim in install-cs193v.sh, the way version_lt already is: the installer is
# curl-piped and standalone, so it cannot source anything from here. 20-messages.sh renders
# BOTH copies and asserts the same shape of both.
#
# awk, and LC_ALL=C awk in particular, because the padding has to be measured in DISPLAY
# COLUMNS and every other way of doing that is wrong somewhere we ship:
#
#   * bash's ${#s} counts characters only in a UTF-8 locale and BYTES in the C locale, so
#     a student with LC_ALL=C would see every line containing — or § padded two columns
#     short. Measured: 32 vs 34 for the same string.
#   * awk's own length() is not multibyte-aware in mawk (Ubuntu's default), which scores
#     the ━ border at 3× and is exactly how an earlier width check passed vacuously.
#
# Stripping UTF-8 continuation bytes (0x80-0xBF) and counting what is left turns a byte
# count into a character count with no locale involved at all. Verified identical under
# gawk, mawk and busybox awk. Everything the box ever contains is a narrow character;
# nothing here would survive CJK, and nothing routes CJK to it.
box() {
    LC_ALL=C awk -v w="$BOX_W" -v title="${1:-STOP}" -v red="${2-$C_RED}" \
                 -v ind="${3:-}" -v off="$C_OFF" '
        function dw(s,  t) { t = s; gsub(/[\200-\277]/, "", t); return length(t) }
        # The first n display columns of s, kept whole: a multibyte character is never
        # sliced down the middle, which is what a byte-wise substr would do.
        function dsub(s, n,  i, c, out, cnt) {
            out = ""; cnt = 0
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c ~ /[\200-\277]/) { out = out c; continue }
                if (cnt >= n) break
                cnt++; out = out c
            }
            return out
        }
        function rule(n,  s) { s = ""; while (n-- > 0) s = s "━"; return s }
        function row(text,  pad, n) {
            pad = ""; n = lim - dw(text)
            while (n-- > 0) pad = pad " "
            printf "%s%s┃%s %s%s %s┃%s\n", ind, red, off, text, pad, red, off
        }
        # Wrap rather than spill. err.create-failed interpolates raw podman output, which is
        # written to no width at all and cannot be hand-wrapped in messages.txt -- only here.
        # A line that already fits is emitted untouched, so the hand-chosen line breaks in
        # messages.txt survive exactly as written.
        function put(text,  lead, rest, chunk, k, brk) {
            # Continuation lines keep the original indent, so a wrapped "    cs193v doctor"
            # stays visibly one item rather than starting a new column.
            lead = text; sub(/[^ ].*$/, "", lead)
            if (dw(lead) >= lim) lead = ""
            rest = text
            while (dw(rest) > lim) {
                chunk = dsub(rest, lim)
                brk = 0
                for (k = length(chunk); k > length(lead); k--)
                    if (substr(chunk, k, 1) == " ") { brk = k; break }
                if (brk > 0) {
                    row(substr(chunk, 1, brk - 1))
                    rest = lead substr(rest, brk + 1)
                } else {
                    # No space to break at: a container id, a URL or a deep path. Broken
                    # hard, because the alternative is breaching the wall we just drew.
                    row(chunk)
                    rest = lead substr(rest, length(chunk) + 1)
                }
            }
            if (dw(rest) > dw(lead) || dw(text) <= lim) row(rest)
        }
        # "┏━━ " is four columns and " " plus "┓" is two, so the rule takes what a title of
        # this width leaves. Measured with dw() like everything else, so a title is free to
        # contain whatever the messages do.
        BEGIN {
            lim = w - 4
            printf "%s%s┏━━ %s %s┓%s\n", ind, red, title, rule(w - 6 - dw(title)), off
        }
        # A tab has no defined width inside a box, and podman emits them.
        { t = $0; gsub(/\t/, " ", t); put(t) }
        END { printf "%s%s┗%s┛%s\n", ind, red, rule(w - 2), off }
    '
}

# The red STOP banner, in the same spirit as the devcontainer's .error.sh: a novice must
# be able to tell "this is course infrastructure, stop and contact staff" from "I typed
# something wrong."
die() {
    printf '\n' >&2
    printf '%s\n' "$*" | box STOP "$C_RED" >&2
    printf '\n' >&2
    exit 1
}

# A green box, for the one thing here that is not a failure. Same renderer, same width.
celebrate() {                         # celebrate TITLE  <- body on stdin
    printf '\n'
    box "$1" "$C_GRN"
    printf '\n'
}

# ─── the progress meter ────────────────────────────────────────────────────────
# One line that moves, shared by everything slow enough to need it.
#
# WHY THIS IS A BACKGROUND PROCESS AND NOT JUST A printf. The bar advances when podman
# finishes a step, and the slow steps -- Playwright, Chromium, the apt layers -- hold a
# single frame for minutes. Drawing only on step boundaries therefore means a meter that
# sits perfectly still for minutes, which reads as a hang: exactly the impression this
# feature exists to remove. Something has to redraw while nothing is happening.
#
# It cannot be done in the reader. build_progress is an awk blocked on `read` between STEP
# lines -- no code of ours runs while it waits, so it cannot animate. So the reader only
# records state and an animator owns the line, ten frames a second, until it is told to stop.
#
# The two halves meet through a FILE rather than a variable because the animator is a
# background subshell: an assignment in either one is invisible to the other. Written whole
# on every update and re-read on every frame, so a torn read costs one frame and fixes
# itself 100ms later rather than corrupting anything.
METER_W=40

# Braille rather than the ASCII / - \ | this replaced. Eight frames of a dot pattern
# orbiting a 2x4 cell, which reads as motion at a glance instead of as a character
# flickering between four shapes -- and cannot be mistaken for punctuation in the output.
#
# A `case` rather than ${FRAMES:i:1}: substring extraction on a multibyte string is
# character-wise in a UTF-8 locale and BYTE-wise in the C locale, so indexing would slice
# these three-byte glyphs into fragments for anyone running LC_ALL=C. Same trap as box().
meter_glyph() {                       # meter_glyph N  -> the Nth frame, N in 0..7
    case "$1" in
        0) printf '⣾' ;; 1) printf '⣽' ;; 2) printf '⣻' ;; 3) printf '⢿' ;;
        4) printf '⡿' ;; 5) printf '⣟' ;; 6) printf '⣯' ;; *) printf '⣷' ;;
    esac
}

meter_write() {                       # meter_write CUR TOTAL LABEL
    printf '%s %s %s\n' "$1" "$2" "$3" > "$METER_STATE" 2>/dev/null || true
}

# One frame. Before the first STEP arrives the total is unknown, so there is no bar to draw
# and the label carries the line on its own -- which is what the base-image download is.
meter_draw() {                        # meter_draw FRAME CUR TOTAL LABEL
    local frame="$1" cur="$2" tot="$3" label="$4" filled n bar='' pad='' g
    g="$(meter_glyph "$frame")"
    if [ "${tot:-0}" -gt 0 ] 2>/dev/null; then
        filled=$(( METER_W * cur / tot ))
        [ "$filled" -gt "$METER_W" ] && filled="$METER_W"
        n="$filled";                  while [ "$n" -gt 0 ]; do bar="$bar█";  n=$((n - 1)); done
        n=$(( METER_W - filled ));    while [ "$n" -gt 0 ]; do pad="$pad░"; n=$((n - 1)); done
        printf '\r  %s [%s%s]  %s/%s  %s%s[K' "$g" "$bar" "$pad" "$cur" "$tot" "$label" "$ESC"
    else
        printf '\r  %s  %s%s[K' "$g" "$label" "$ESC"
    fi
}

# The animator. Stops when the state file goes away, which is how meter_stop ends it without
# depending on a signal arriving.
meter_animate() {
    local i=0 cur tot label
    while [ -f "$METER_STATE" ]; do
        cur=''; tot=''; label=''
        IFS=' ' read -r cur tot label < "$METER_STATE" 2>/dev/null || true
        meter_draw "$i" "${cur:-0}" "${tot:-0}" "${label:-}"
        i=$(( (i + 1) % 8 ))
        sleep 0.1
    done
}

# Nothing animates when stdout is not a terminal: \r cannot overdraw a pipe or a log file,
# and ten frames a second of it would be thousands of columns of noise in the file staff ask
# a student to send. Callers print plainly in that case.
meter_start() {                       # meter_start TOTAL LABEL
    [ -t 1 ] || return 0
    meter_write "0" "${1:-0}" "${2:-}"
    meter_animate &
    METER_PID=$!
}

meter_label() {                       # meter_label CUR TOTAL LABEL  -- update in place
    [ -n "$METER_PID" ] || return 0
    meter_write "$1" "$2" "$3"
}

# Leaves the line finished rather than mid-frame, and ALWAYS newlines, so whatever the caller
# prints next starts clean instead of landing inside the bar.
meter_stop() {                        # meter_stop [CUR TOTAL LABEL]
    [ -n "$METER_PID" ] || return 0
    local cur='' tot='' label=''
    # Read before deleting: with no arguments the closing frame is "whatever it had reached,
    # complete", so the line is left finished rather than stopped mid-fill.
    [ -f "$METER_STATE" ] && IFS=' ' read -r cur tot label < "$METER_STATE" 2>/dev/null
    rm -f "$METER_STATE"
    kill "$METER_PID" 2>/dev/null
    wait "$METER_PID" 2>/dev/null || true
    METER_PID=''
    if [ "$#" -ge 2 ]; then
        meter_draw 0 "$1" "$2" "${3:-}"
    elif [ "${tot:-0}" -gt 0 ] 2>/dev/null; then
        meter_draw 0 "$tot" "$tot" ""
    fi
    printf '\n'
}

# ─── the build's progress bar ──────────────────────────────────────────────────
# Turns `podman build`'s output into one line that moves (issue #23). What it replaces was
# not a design decision anybody made -- it was podman's stdout, and on a cold build that is
# thousands of lines of echoed shell, of which the parts a student can act on are none.
# Even a fully cached build printed 76.
#
# THE OUTPUT IS NOT DISCARDED. It is teed to $BUILD_LOG first and this reads the same
# stream, so a failure is still diagnosable from podman's own words -- and since those words
# are no longer on the screen, err.build-failed now carries the tail of that log INSIDE the
# STOP box. Hiding the output without that change would have made the launcher tell a stuck
# student to read something that is not there.
#
# `STEP i/N:` is podman's own numbering, so the total comes from podman rather than from a
# count of Containerfile lines that would drift the moment one is added.
#
# NOT A TERMINAL -> no carriage returns, one line per step. A \r-redrawn bar in a CI log or
# a `| tee build.txt` is an unreadable single line thousands of columns long, and this is
# the exact path a student uses when staff ask them to send the output.
build_progress() {
    local tty=0
    [ -t 1 ] && tty=1
    LC_ALL=C awk -v tty="$tty" -v esc="$ESC" -v statef="$METER_STATE" '
        function rep(s, n,  o) { o = ""; while (n-- > 0) o = o s; return o }
        # On a terminal this RECORDS rather than draws: meter_animate owns the line, so that
        # it keeps moving between steps instead of freezing for the length of one. close()
        # after every write, not fflush -- awk appends to an open handle, so without the
        # close the file would grow and the animator would keep reading the first, stalest
        # line forever.
        function state(c, t, l) {
            printf "%d %d %s\n", c, t, l > statef
            close(statef)
        }
        function draw(  filled) {
            if (tot <= 0) return
            if (tty) { state(cur, tot, label); return }
            filled = int(width * cur / tot + 0.5)
            printf "  [%s%s]  %d/%d\n", rep("█", filled), rep("░", width - filled), cur, tot
            fflush()
        }
        BEGIN { width = 40; cur = 0; tot = 0; pulled = 0; label = "" }
        # Pulling the base image happens BEFORE step 1 and is the slowest part of a cold
        # build on slow wifi, so it gets a note rather than sitting behind an empty bar. One
        # note, not one per blob: podman emits a line per layer per percentage.
        #
        # ON A TERMINAL THIS IS A LABEL, NOT A LINE. Printed as its own line with a trailing
        # newline, it stranded the note on one row and left the bar to start on the row below
        # -- so a cold build showed two rows where the bar is meant to be one. It is now
        # handed to the meter, which shows it beside the animation until a bar exists and then
        # replaces it. Piped, there is nothing to overdraw, so it stays a plain line.
        /^(Trying to pull|Getting image source signatures|Copying blob|Copying config)/ {
            if (!pulled) {
                pulled = 1
                label = "Downloading the base image..."
                if (tty) state(0, 0, label)
                else     printf "  Downloading the base image...\n"
                fflush()
            }
            next
        }
        /^STEP [0-9]+\/[0-9]+:/ {
            s = $2; sub(/:$/, "", s); split(s, a, "/")
            # PLUS ONE on a terminal: creating the container is the slowest single step of a
            # build and used to sit outside the meter, so the bar completed and the student
            # then waited on an unmetered line (issue #24). It is step n+1 now. Piped, there
            # is no meter for it to be part of, so the count stays what podman reported.
            #
            # NOTE FOR THE NEXT EDITOR: this whole awk program is inside a single-quoted
            # shell string, so an apostrophe in a comment here ENDS it and the launcher stops
            # parsing. Write "does not" rather than "doesn t".
            cur = a[1] + 0; tot = a[2] + (tty ? 1 : 0)
            # The note has served its purpose once a step exists to report.
            label = ""
            draw()
            next
        }
        # No newline here on a terminal: meter_stop owns ending the line, because the meter
        # outlives this awk -- the container-creation step is still to come.
        END { fflush() }
    '
}

# Student-facing prose lives in messages.txt so it can be reworded without touching
# logic. msg <key> [NAME=value ...]
msg() {
    local key="$1"; shift
    local out kv n v ph head tail
    [ -f "$MESSAGES" ] || { printf '(messages.txt missing)\n'; return 1; }
    out="$(awk -v k="[[$key]]" '
        $0 == k { found = 1; next }
        /^\[\[.*\]\]$/ { if (found) exit }
        found { print }
    ' "$MESSAGES")"
    if [ -z "$out" ]; then printf '(missing message: %s)\n' "$key"; return 1; fi
    for kv in "$@"; do
        n="${kv%%=*}"; v="${kv#*=}"
        ph="{{$n}}"
        # Substitution is done by literal split-and-rejoin. Both obvious alternatives are
        # wrong here, and both fail in ways that only show up in an error path:
        #
        #   sed "s|{{$n}}|$v|g"  — sed's replacement text cannot contain a newline, and
        #       err.create-failed interpolates raw podman output, which is always
        #       multi-line. It printed "unterminated `s' command" and returned nothing, so
        #       die() drew an EMPTY red STOP box: the student got a blank banner at the
        #       exact moment they most needed the diagnosis.
        #
        #   ${out//"$ph"/$v}  — bash 5.2 and newer expand `&` in the replacement to the
        #       matched text, the way sed does, while bash 3.2 treats it literally. Any
        #       podman message containing & would therefore render differently on Linux
        #       than on macOS, which is worse than a bug that is wrong everywhere.
        #
        # `head` accumulates what is already substituted and `tail` is what is left to
        # scan, so a value that itself contains {{NAME}} is copied through instead of
        # being rescanned forever.
        head=''; tail="$out"
        while :; do
            case "$tail" in
                *"$ph"*) head="$head${tail%%"$ph"*}$v"; tail="${tail#*"$ph"}" ;;
                *)       break ;;
            esac
        done
        out="$head$tail"
    done
    printf '%s\n' "$out"
}

# ─── portable timeout ──────────────────────────────────────────────────────────
# GNU `timeout` is NOT on stock macOS, so this is hand-rolled with zero dependencies.
# Every podman probe goes through it: after a Mac wakes from sleep, `podman info` HANGS
# rather than fails (containers/podman#21675), and an unguarded probe makes the launcher
# look frozen with no output at all.
# RT_SPIN turns the wait into something visible: set it to a label and run_timeout animates
# a spinner beside that label until the command returns. Empty for every probe, which is
# almost all of them -- a spinner on a 20-second `podman inspect` that normally takes 40ms
# would be noise. `podman run` is the one that needed it (issue #24): it is allowed 180
# seconds, it says nothing for all of them, and the last line a student saw before the
# silence was "Setting up the course container..." -- which is what an interrupted command
# looks like.
#
# The poll loop was already here, at 10 Hz, so the spinner costs one printf per two ticks
# and no extra process. The frame is picked with a `case`, not `cut -c`, because a
# subprocess every 0.2s for three minutes is 900 of them for four characters of output.
RT_OUT=''
RT_SPIN=''
run_timeout() {                       # run_timeout SECS CMD...  -> RT_OUT, returns rc
    local secs="$1"; shift
    local tmp pid i rc frame
    tmp="$(mktemp "${TMPDIR:-/tmp}/cs193v.XXXXXX")" || return 125
    ( "$@" >"$tmp" 2>&1 ) & pid=$!
    i=0; rc=124; frame=0
    if [ -n "$RT_SPIN" ]; then
        # Drawn once up front rather than only from inside the loop, so a command that
        # returns immediately still announces itself instead of flashing nothing.
        if [ -t 1 ]; then printf '  %s  %s' "$(meter_glyph 0)" "$RT_SPIN"
        else printf '%s\n' "$RT_SPIN"; fi
    fi
    while [ "$i" -lt "$((secs * 10))" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then wait "$pid"; rc=$?; break; fi
        if [ -n "$RT_SPIN" ] && [ -t 1 ] && [ "$((i % 2))" -eq 0 ]; then
            # Same braille frames as the meter, so the two never look like different
            # programs. meter_glyph is the single definition of them.
            printf '\r  %s  %s' "$(meter_glyph "$frame")" "$RT_SPIN"
            frame=$(( (frame + 1) % 8 ))
        fi
        sleep 0.1
        i=$((i + 1))
    done
    # Leave the line clean either way: the caller prints its own outcome next, and a
    # half-drawn spinner frame ahead of it would look like part of the message.
    [ -n "$RT_SPIN" ] && [ -t 1 ] && printf '\r  %s%s[K\n' "$RT_SPIN" "$ESC"
    if [ "$rc" -eq 124 ]; then kill -9 "$pid" 2>/dev/null; wait "$pid" 2>/dev/null; fi
    RT_OUT="$(cat "$tmp")"
    rm -f "$tmp"
    return "$rc"
}

pm()  { run_timeout 20 podman "$@"; }     # a podman call that should be quick
pmq() { run_timeout 20 podman "$@" >/dev/null 2>&1; }

# ─── arrow-key menu ────────────────────────────────────────────────────────────
# Never [y/N]: students do not know that convention this early in the quarter. The
# default is always the SAFE option and is visually highlighted rather than signalled by
# capitalisation. Falls back to the default when there is no tty.
MENU_CHOICE=0
menu() {                              # menu DEFAULT_INDEX opt1 opt2 ...
    local def="$1"; shift
    local opts n sel i key rest
    opts=( "$@" ); n=${#opts[@]}; sel="$def"

    if [ ! -t 0 ] || [ ! -t 1 ]; then
        MENU_CHOICE="$def"
        printf '  (not a terminal; choosing "%s")\n' "${opts[$def]}"
        return 0
    fi

    while :; do
        i=0
        while [ "$i" -lt "$n" ]; do
            if [ "$i" -eq "$sel" ]; then
                printf '  %s▸ %s%s\n' "$C_CYAN" "${opts[$i]}" "$C_OFF"
            else
                printf '    %s\n' "${opts[$i]}"
            fi
            i=$((i + 1))
        done
        printf '\n  %s(use the up and down arrow keys, then press Enter)%s' "$C_DIM" "$C_OFF"

        IFS= read -rsn1 key
        if [ "$key" = "$ESC" ]; then IFS= read -rsn2 rest; key="$key$rest"; fi

        printf '\r%s[K' "$ESC"
        printf '%s[%dA%s[J' "$ESC" "$((n + 1))" "$ESC"

        case "$key" in
            "${ESC}[A"|k|K) sel=$(( (sel + n - 1) % n )) ;;
            "${ESC}[B"|j|J) sel=$(( (sel + 1) % n )) ;;
            ''|"$(printf '\n')") break ;;
            [1-9]) if [ "$key" -le "$n" ]; then sel=$((key - 1)); break; fi ;;
        esac
    done
    printf '  %s▸ %s%s\n\n' "$C_CYAN" "${opts[$sel]}" "$C_OFF"
    MENU_CHOICE="$sel"
}

confirm() {                           # confirm "no-text" "yes-text"  -> 0 if yes
    menu 0 "$1" "$2"
    [ "$MENU_CHOICE" -eq 1 ]
}

# ─── small utilities ───────────────────────────────────────────────────────────
version_lt() {                        # version_lt A B -> prints yes if A < B
    awk -v a="$1" -v b="$2" 'BEGIN{
        na = split(a, A, "."); nb = split(b, B, ".")
        for (i = 1; i <= 3; i++) {
            x = (i <= na ? A[i] + 0 : 0); y = (i <= nb ? B[i] + 0 : 0)
            if (x < y) { print "yes"; exit }
            if (x > y) { print "no";  exit }
        }
        print "no" }'
}

sha_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    else shasum -a 256 | awk '{print $1}'; fi
}

# podman forces TERM=xterm and does not copy the client's value
# (containers/podman#25683), which costs 256-colour support. But the image has a limited
# terminfo set, so forwarding an exotic TERM verbatim would leave a full-screen editor
# unable to start. Whitelist, and fall back to a safe 256-colour entry.
safe_term() {
    case "${TERM:-}" in
        xterm|xterm-256color|xterm-color|screen|screen-256color|tmux|tmux-256color|\
        vt100|vt220|linux|ansi|dumb|rxvt|rxvt-unicode-256color)
            printf '%s' "$TERM" ;;
        '') printf 'xterm-256color' ;;
        *)  printf 'xterm-256color' ;;    # kitty, ghostty, alacritty, wezterm, foot...
    esac
}

platform() {
    case "$(uname -s)" in
        Darwin) printf 'macos' ;;
        Linux)  if grep -qi microsoft /proc/version 2>/dev/null; then printf 'wsl'
                else printf 'linux'; fi ;;
        *)      printf 'other' ;;
    esac
}

has_machine() {                       # is a podman machine in play (macOS)?
    [ "$(platform)" = macos ] || return 1
    pmq machine list --format '{{.Name}}'
}

# ─── developer instance ────────────────────────────────────────────────────────
# CS193V_INSTANCE gives one computer several INDEPENDENT installations. It suffixes the
# container name, the dev image tag and all five volume names TOGETHER, which is the point:
# suffixing only some of them is worse than suffixing none, because `--rebuild --logout` in one
# instance would still destroy the other instance's logins.
#
# This exists because two people developing the container on the same machine otherwise
# share every one of them silently: the container `cs193v`, the image `localhost/cs193v:local`,
# and the volumes cs193v-claude and friends. The failure is not a clean collision but a slow
# one — whoever runs `--rebuild` last owns the container the other is about to shell into.
#
# A student never sets it. With it unset every name is byte-identical to what it was
# before, which is what keeps this from being a behaviour change for anyone but us.
#
# Deliberately NOT suffixed: MOUNT_DST, the workspace path, and the cs193v.dir label.
# Those are already per-directory, and ensure_container's owner-dir check keys off
# cs193v.dir, so two checkouts are distinguishable even with no instance set.
INSTANCE="${CS193V_INSTANCE:-}"
case "$INSTANCE" in
    '') : ;;
    # Anything outside this set would produce an invalid container or volume name, and
    # podman's own error for that names neither CS193V_INSTANCE nor this script. A literal
    # string rather than a messages.txt key, matching CS193V_BUILD_RAW: that catalogue is for
    # student-facing prose, and no student ever sets this.
    *[!A-Za-z0-9_-]*)
        die "CS193V_INSTANCE=$INSTANCE is not usable as a name.
Use only letters, digits, hyphens and underscores." ;;
    *)  NAME="$NAME-$INSTANCE"
        IMAGE="$IMAGE-$INSTANCE" ;;
esac

# ─── the tunnel's runtime paths ────────────────────────────────────────────────
# In TMPDIR, not .config/, for two reasons. A unix socket path is capped near 104 bytes on
# macOS and 108 on Linux, and this launcher already expects deep course directories with
# spaces in them (see the cs193v.dir label) -- so a socket under $DIR could simply be too
# long to bind. And these are per-boot runtime state, not configuration: leaving a stale
# socket in the student's course directory would be clutter that outlives its meaning.
#
# Keyed by a hash of $DIR so two checkouts never share a socket even with no instance set,
# which matters because the control socket IS the tunnel's identity for -O check/exit.
# run_timeout already uses ${TMPDIR:-/tmp}, so this is an existing idiom rather than a new
# assumption about the platform.
TUNNEL_ID="$(printf '%s\n' "$DIR" "$INSTANCE" | sha_stdin | cut -c1-12)"
# The build's output, teed here so a failure can be classified from podman's own words --
# see build_image. Keyed by TUNNEL_ID like the tunnel's files, so two instances on one
# machine do not overwrite each other's, and overwritten rather than appended so it cannot
# grow without bound. Not cleaned up on exit deliberately: after a failed build it is the
# thing to ask a student for, and the next build truncates it anyway.
BUILD_LOG="${TMPDIR:-/tmp}/cs193v-build-$TUNNEL_ID.log"
# Staff get podman's raw output, students get build_progress. An environment variable rather
# than a verb: there used to be a --dev-build for this, and it earned its keep back when it
# also dropped you into a shell -- but `./cs193v --rebuild && ./cs193v` is that, and a whole
# verb whose only remaining job is choosing an output format is a verb too many. A progress
# bar is still the wrong instrument for debugging a build that HANGS, which is the one thing
# $BUILD_LOG cannot be read for afterwards, so the capability stays.
BUILD_RAW="${CS193V_BUILD_RAW:-}"
# Set by build_image on success, read by verb_rebuild: the success box belongs to a run that
# actually built something, not to every recreate. See verb_rebuild.
BUILT=''
# Where the progress meter's reader and its animator meet. Keyed by TUNNEL_ID like the rest,
# so two instances on one machine do not redraw each other's bar. See meter_start.
METER_STATE="${TMPDIR:-/tmp}/cs193v-meter-$TUNNEL_ID"
METER_PID=''
TUNNEL_CTL="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.ctl"
TUNNEL_PID="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.pid"
TUNNEL_LOG="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.log"

# ─── argument files ────────────────────────────────────────────────────────────
ARGS=()
load_args() {
    local f line word
    ARGS=()
    [ -f "$ARGS_FILE" ] || die "$(msg err.no-args-file FILE="$ARGS_FILE")"
    for f in "$ARGS_FILE" "$LOCAL_ARGS_FILE"; do
        [ -f "$f" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%%#*}"
            # trim both ends without bash 4 features
            line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            [ -z "$line" ] && continue
            for word in $line; do
                # The volume names live in container.args, not up here, so the instance
                # suffix has to be applied as they are read. `cs193v-claude:/path` becomes
                # `$NAME-claude:/path`, and since NAME is plain "cs193v" when no instance
                # is set, this is a no-op for a student. Matching on the trailing colon is
                # what keeps it off `--hostname cs193v-development`, the only other word
                # here that starts with the same eight characters.
                case "$word" in
                    cs193v-*:*) word="$NAME-${word#cs193v-}" ;;
                esac
                ARGS[${#ARGS[@]}]="$word"
            done
        done < "$f"
    done
}

# The flags the launcher itself contributes: identity, the workspace mount, and the
# labels that make drift detectable.
RUN_ARGS=()
build_run_args() {
    local relabel=''
    # Relabel narrowly, and only where SELinux is actually enforcing. Never :Z, and
    # never on a home or system directory: it walks every inode and can break unrelated
    # host services.
    if command -v getenforce >/dev/null 2>&1; then
        [ "$(getenforce 2>/dev/null)" = "Enforcing" ] && relabel=',z'
    fi

    RUN_ARGS=( --name "$NAME" --detach )
    RUN_ARGS[${#RUN_ARGS[@]}]="--label"
    RUN_ARGS[${#RUN_ARGS[@]}]="cs193v.confighash=$(config_hash)"
    RUN_ARGS[${#RUN_ARGS[@]}]="--label"
    RUN_ARGS[${#RUN_ARGS[@]}]="cs193v.dir=$DIR"
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$WORKSPACE,dst=$MOUNT_DST,rw$relabel"
    # The tunnel's key material, read-only. Added here rather than in container.args because
    # the paths are absolute and machine-specific -- the same reason local.args exists.
    #
    # Appended one element at a time, NOT via $(some_function) with word splitting: the
    # course directory is allowed to contain spaces (see the cs193v.dir label) and a split
    # would silently tear such a path in half, exactly as it would for the workspace mount
    # immediately above.
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$TUNNEL_KEY.pub,dst=$TUNNEL_AUTH_KEYS_DST,ro"
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$TUNNEL_HOST_KEY,dst=$TUNNEL_HOST_KEY_DST,ro"
    local a
    # ${arr[@]+"${arr[@]}"}, not "${arr[@]}": expanding an EMPTY array under `set -u` is a
    # fatal "unbound variable" on bash < 4.4, which is every Mac. A container.args holding
    # only comments is exactly the mis-edited-file support case, and it must produce our
    # error message rather than a raw bash one. The guard still preserves elements
    # containing spaces, which matters for --label cs193v.dir=/home/me/My Course/cs193v.
    for a in ${ARGS[@]+"${ARGS[@]}"}; do RUN_ARGS[${#RUN_ARGS[@]}]="$a"; done
}

# Everything that would require a different container if it changed. `podman start`
# reuses the container's STORED config and ignores the image digest, the port list,
# keep-id and --memory alike — so without this, "exists -> start" would permanently
# freeze each student's flags at whatever they were on first run, and edits to
# container.args would never reach anyone.
config_hash() {
    # IMAGE is hashed, and it is a constant, so every caller agrees by construction rather
    # than by remembering to resolve it first. It did not use to be: verb_doctor called
    # load_args but never resolved the image, so it hashed IMAGE="" while the launch path and
    # --dev-print-command hashed the resolved image — and doctor therefore called EVERY
    # container stale and sent people chasing a recreate prompt that never appears
    # (ERRORS.md B14). The image pin was the only thing that could make those two answers
    # differ; with it gone, that class of bug cannot come back.
    # MOUNT_DST is hashed as well as WORKSPACE. It used to be a constant baked into
    # build_run_args and never hashed at all — so when the mount moved from /workspaces to
    # ~/projects, every container already on a student's machine would have kept the old
    # path with no recreate prompt, and the docs would have described a directory nobody
    # was standing in.
    # The tunnel's mount destinations are hashed for exactly the reason MOUNT_DST is: they
    # are decided here rather than in container.args, so nothing else would notice if they
    # moved, and a container created without them cannot serve a tunnel at all -- sshd would
    # have no authorized_keys and no host key. Without this, a student whose container
    # predates the tunnel would get no recreate prompt and a tunnel that simply never works.
    { printf '%s\n' "$IMAGE" "$WORKSPACE" "$MOUNT_DST"
      printf '%s\n' "$TUNNEL_AUTH_KEYS_DST" "$TUNNEL_HOST_KEY_DST"
      printf '%s\n' ${ARGS[@]+"${ARGS[@]}"}; } | sha_stdin
}

# ─── preflight ─────────────────────────────────────────────────────────────────
preflight() {
    if [ "$(id -u)" -eq 0 ]; then die "$(msg err.running-as-root)"; fi

    if ! command -v podman >/dev/null 2>&1; then
        die "$(msg err.no-podman)"
    fi

    # The tunnel needs the ssh CLIENT on the host -- not a server. macOS ships it and so does
    # essentially every Linux; the realistic gap is a minimal WSL distro. Checked here rather
    # than at first use so the diagnosis arrives before a container exists, and names the
    # package rather than leaving a student to decode "ssh: command not found".
    if ! command -v ssh >/dev/null 2>&1 || ! command -v ssh-keygen >/dev/null 2>&1; then
        die "$(msg err.no-ssh)"
    fi

    if ! run_timeout 10 podman --version; then
        die "$(msg err.podman-hangs)"
    fi
    local ver
    ver="$(printf '%s' "$RT_OUT" | awk '{print $NF}')"
    if [ "$(version_lt "$ver" "$MIN_PODMAN")" = yes ]; then
        die "$(msg err.podman-too-old FOUND="$ver" NEED="$MIN_PODMAN")"
    fi

    if ! pm info --format '{{.Host.Security.Rootless}}'; then
        die "$(msg err.podman-unreachable)"
    fi
    if [ "$RT_OUT" != "true" ]; then
        die "$(msg err.rootful)"
    fi

    if ! grep -q "^$(id -un):" /etc/subuid 2>/dev/null; then
        case "$(platform)" in
            linux|wsl) die "$(msg err.no-subuid USER="$(id -un)")" ;;
        esac
    fi

    [ -d "$WORKSPACE" ] || mkdir -p "$WORKSPACE" || die "$(msg err.no-workspace DIR="$WORKSPACE")"
}

# ─── container state ───────────────────────────────────────────────────────────
state() {                             # -> absent | created | exited | running | ...
    if pm inspect "$NAME" --format '{{.State.Status}}'; then printf '%s' "$RT_OUT"
    else printf 'absent'; fi
}

label_of() { pm inspect "$NAME" --format "{{index .Config.Labels \"$1\"}}" && printf '%s' "$RT_OUT"; }
# The image's own labels, as against label_of's container labels. Used for
# cs193v.buildhash; see build_hash.
image_label_of() { pm image inspect "$1" --format "{{index .Labels \"$2\"}}" && printf '%s' "$RT_OUT"; }

# A fingerprint of the RECIPE: the Containerfile plus every file COPY reaches. Baked into
# the image as a label at build time and compared against the on-disk files at launch, so
# a student whose course files have moved on gets offered a rebuild.
#
# This is the replacement for the digest pin. A pinned image announced a new version by
# its digest changing; with the image built on the student's own machine there is no
# digest to change -- podman assigns a new image ID on every build, including rebuilds of
# identical input, so the image ID says "rebuilt", not "out of date". The recipe is the
# only thing that actually moves when staff ship a fix.
#
# Hashed from INSIDE $PRIVATE with relative paths, deliberately: hashing absolute paths
# would make the value depend on where the student put their course folder, so moving or
# renaming it would look like an update and prompt a pointless rebuild.
#
# files/ is the whole of the rest of the build context -- `COPY files/` is the only COPY
# in the Containerfile -- so the Containerfile plus that tree covers it.
#
# NAMES ARE HASHED AS WELL AS CONTENTS, in one sorted list, so that adding an empty file or
# renaming an existing one changes the value. Contents alone would miss both, and a rename
# is exactly the kind of edit that changes what the image contains.
#
# Written to spawn a fixed handful of processes rather than one per file, because this runs
# on EVERY launch: the obvious `while read f; do cat "$f"; done` form measured 88 ms against
# a launcher whose whole overhead is ~511 ms (ERRORS.md D9), and this measures 14 ms for the
# same result. `tr | xargs -0`, not a bare `xargs`, so a future filename containing a space
# is hashed rather than silently split -- and -0 rather than GNU's -d, which macOS lacks.
build_hash() {
    local list
    list="$( cd "$PRIVATE" 2>/dev/null && find Containerfile files -type f 2>/dev/null | LC_ALL=C sort )"
    { printf '%s\n' "$list"
      ( cd "$PRIVATE" 2>/dev/null && printf '%s\n' "$list" | tr '\n' '\0' | xargs -0 cat 2>/dev/null )
    } | sha_stdin
}

# Has the recipe moved since the image was built? TRUE means "the files on disk no longer
# describe the image you have", which is the ONE question that distinguishes a rebuild that
# must build from one that only has to recreate a container.
#
# TWO CALLERS AND THEY MUST AGREE: verb_rebuild uses it to decide whether to build at all, and
# ensure_container uses it to decide whether to offer. Written once for that reason -- the two
# answering differently is exactly the shape of ERRORS.md B14, where doctor and the launch path
# hashed different things and doctor called every container stale.
#
# EVERY "return 1" HERE MEANS "DO NOT NAG", and each is a separate unknown rather than a no:
#   * no Containerfile -- nothing to compare against.
#   * no image -- a different problem, and not this function's to report.
#   * no label -- an image built before the label existed, or by a bare `podman build`, which
#     CLAUDE.md warns staff off precisely because it produces one of these. An unknown answer
#     must not turn into a rebuild prompt; it self-corrects on the first real build.
recipe_moved() {
    [ -f "$CONTAINERFILE" ] || return 1
    pmq image exists "$IMAGE" || return 1
    local have
    have="$(image_label_of "$IMAGE" cs193v.buildhash)"
    [ -n "$have" ] || return 1
    [ "$have" != "$(build_hash)" ]
}

# The image has to exist before a container can be made from it, and "nobody has built it on
# this computer yet" is a different problem from anything podman would say when asked to run
# a tag that is not there.
#
# ONE CALL SITE, and it is the bare launch. Every other path that creates a container goes
# through verb_rebuild, which BUILDS a missing image rather than refusing -- so this is not the
# general guard it used to be, it is specifically the answer to "the shortest command must not
# silently start a four-minute build". A student who typed `./cs193v` gets told what to run;
# a student who typed the verb that builds gets a build.
require_image() {
    pmq image exists "$IMAGE" || die "$(msg err.no-image)"
}

# `podman build`, plus the label that makes staleness detectable.
#
# Deliberately NOT wrapped in run_timeout, unlike run. run_timeout exists to stop a SILENT
# hang, and a build is the opposite of silent -- podman streams every step. A fixed timeout
# here would instead kill a build that is merely slow, which on the weakest machine a student
# might own is the normal case, and it would do it after the student had already waited out
# most of it.
build_image() {
    [ -f "$CONTAINERFILE" ] || die "$(msg err.no-containerfile FILE="$CONTAINERFILE")"
    local nocache='' attempt=1 tries=3 hash
    # --no-cache retries once only. The retry below is worth having because podman keeps
    # every completed layer, so a second attempt resumes at the step that failed -- and
    # --no-cache is precisely the flag that throws that away, so retrying it would mean
    # re-running a twenty-minute build from zero. It is a staff verb regardless.
    [ "${1:-}" = "--no-cache" ] && { nocache='--no-cache'; tries=1; }
    hash="$(build_hash)"
    info "$(msg status.building IMAGE="$IMAGE")"
    # Started before podman, with no total yet: on a cold build the base-image pull comes
    # first and there is no step count to show until STEP 1 arrives. build_progress fills
    # both in as it reads.
    [ -n "$BUILD_RAW" ] || meter_start 0 ""

    # THE RETRY LIVES HERE, not in the installer, and that placement is the point. This
    # build reaches seven separate network origins -- the Ubuntu archive, NodeSource,
    # cli.github.com, npm, the Playwright CDN, PyPI and the tldr pages -- and several of
    # its steps fail hard on purpose rather than shipping a quietly degraded image (see
    # the tldr layer). Those assertions were written when ONE CI machine ran this build;
    # now every student does, on dorm wifi, so a transient failure is routine rather than
    # exceptional and recovering from it must be automatic.
    #
    # Retrying here rather than in the installer means the student sees the red STOP box
    # at most once. An installer-side loop would print it on every intermediate attempt,
    # and STOP is supposed to mean "stop and contact staff" -- three of them followed by
    # success would teach a student to ignore the one banner that must never be ignored.
    while :; do
        # TEE, so the output is readable afterwards and a failure can be classified from
        # podman's own words. What has changed (issue #23) is who reads it: it used to go
        # straight to the terminal, on the grounds that the step-by-step lines were the only
        # progress a student had. They were also thousands of lines of echoed shell that no
        # student can act on, so the stream now goes through build_progress, which renders
        # the one thing in it that is progress.
        #
        # $BUILD_RAW is the staff escape hatch, set by CS193V_BUILD_RAW. Staff debugging a
        # build need podman's words as they arrive, and a progress bar is the wrong instrument
        # for that; it is also what makes hiding the output from a student affordable.
        #
        # PIPESTATUS because the pipeline's own status is the LAST stage's, which is tee's
        # or awk's and always 0. Bash 3.2 has it, so this stays macOS-safe.
        # shellcheck disable=SC2086
        if [ -n "$BUILD_RAW" ]; then
            podman build $nocache \
                    --label "cs193v.buildhash=$hash" \
                    -t "$IMAGE" -f "$CONTAINERFILE" "$PRIVATE" 2>&1 | tee "$BUILD_LOG"
        else
            podman build $nocache \
                    --label "cs193v.buildhash=$hash" \
                    -t "$IMAGE" -f "$CONTAINERFILE" "$PRIVATE" 2>&1 \
                | tee "$BUILD_LOG" | build_progress
        fi
        # The meter deliberately stays RUNNING on success: create_container is the next
        # step and shares this bar (issue #24), so the line is closed there rather than here.
        #
        # BUILT is what earns the success box. verb_rebuild recreates the container whether or
        # not it built anything, so without this every two-second recreate would end in
        # "Build Successful!" and tell a student to enter an environment they are already
        # being handed.
        [ "${PIPESTATUS[0]}" -eq 0 ] && { BUILT=1; return 0; }

        # OUT OF DISK IS READ FROM PODMAN'S MESSAGE, not inferred from free space, and that
        # distinction was measured rather than reasoned about. An earlier version asked
        # `podman info` how much room was left and got the WRONG ANSWER every time: by the
        # time a failed build has returned, podman has already rolled back the partial layer
        # and handed the space back, so the machine looks fine at exactly the moment you
        # check. A genuine ENOSPC build then told the student "this is usually a network
        # problem", which is advice to go fix the wrong thing.
        #
        # It also must not be retried: retrying only spends the student's time twice to
        # arrive at the same wall.
        meter_stop
        if grep -qi 'no space left on device' "$BUILD_LOG" 2>/dev/null; then
            die "$(msg err.build-no-disk)"
        fi
        # The failing output goes INSIDE the box now. It used to be left on the screen and
        # pointed at ("Podman's own output is above this box"), which stopped being true the
        # moment build_progress took the screen over. The tail, not the whole log: the last
        # lines are the ones that name the failure, and the box wraps rather than spills.
        [ "$attempt" -ge "$tries" ] &&
            die "$(msg err.build-failed OUT="$(tail -n 12 "$BUILD_LOG" 2>/dev/null)")"
        attempt=$(( attempt + 1 ))
        warn "$(msg warn.build-retry ATTEMPT="$attempt" TRIES="$tries")"
        [ -n "$BUILD_RAW" ] || meter_start 0 ""
    done
}

create_container() {
    # BEFORE podman run, not just before the tunnel starts. The key material is bind-mounted,
    # and podman creates a missing bind-mount source as a DIRECTORY -- so a first run with no
    # keys yet would silently mount a directory over authorized_keys and the host key, and
    # sshd would then fail for a reason with no obvious connection to the cause.
    tunnel_keys
    build_run_args
    # IF A BUILD IS STILL HOLDING THE METER, THIS IS ITS LAST STEP (issue #24). The label
    # goes beside the bar exactly like the base-image note, and the bar completes when podman
    # returns -- so a build shows one moving line from the first pull to a built container.
    #
    # Reached on its own by a bare ./cs193v, and by the --rebuild that had nothing to build,
    # where there is no meter. Those keep a standalone animated line: inventing a "step 24 of
    # 24" for them would be a count of nothing.
    #
    # Read from the meter's own state rather than from a variable, because the step count
    # came from podman and was parsed in a subshell -- the pipeline build_progress runs in.
    local mcur='' mtot=''
    if [ -n "$METER_PID" ] && [ -f "$METER_STATE" ]; then
        IFS=' ' read -r mcur mtot _ < "$METER_STATE" 2>/dev/null || true
    fi
    if [ "${mtot:-0}" -gt 0 ] 2>/dev/null; then
        meter_label "${mcur:-0}" "$mtot" "$(msg status.creating)"
        RT_SPIN=''
    else
        # No meter: run_timeout carries the label and animates it itself. Cleared in both
        # directions afterwards -- a stale RT_SPIN would animate the next slow probe.
        RT_SPIN="$(msg status.creating)"
    fi
    if ! run_timeout 180 podman run ${RUN_ARGS[@]+"${RUN_ARGS[@]}"} "$IMAGE"; then
        RT_SPIN=''
        meter_stop
        # Out of disk gets its own message HERE as well as in build_image, because creating
        # the container is a second, separate disk cost and a surprisingly large one:
        # --userns=keep-id makes podman write an ID-MAPPED COPY of every layer, so a
        # successful build is followed by allocating roughly the image's size again
        # (ERRORS.md D-series measured ~1.5 GB at the time; it is ~2.2 GB now). A student
        # who has just watched a four-minute build succeed then gets
        #   "creating an ID-mapped copy of layer ...: lchown ...: no space left on device"
        # which names neither the cause they can act on nor the fact that the build itself
        # was fine. Checked after the failure rather than before it: the cost depends on
        # the image, and refusing pre-emptively would block installs that would have worked.
        case "$RT_OUT" in
            *'no space left on device'*|*'No space left on device'*)
                die "$(msg err.create-no-disk)" ;;
        esac
        # Lost the create race -- not a failure, and it must not read like one.
        #
        # `podman run --name` IS a test-and-set: name uniqueness is enforced under podman's own
        # database lock, so of two simultaneous launches exactly one creates the container and
        # the other arrives here. That makes this the ATOMIC half of refuse_if_session_live for
        # the absent -> running transition, where the state check alone is only a check-then-act.
        #
        # Measured against podman 5.7.0: rc=125 and
        #   Error: creating container storage: the container name "cs193v" is already in use by
        #   <id>. You have to remove that container to be able to reuse that name...
        # Matched on the STRING, not the status: 125 is podman's generic "failed before running
        # the container" code and says nothing about which error it was.
        #
        # Without this the loser dies with err.create-failed and a wall of podman output, for
        # something whose real meaning is "you already have a session open".
        case "$RT_OUT" in
            *'already in use'*) die "$(msg err.session-in-use)" ;;
        esac
        die "$(msg err.create-failed OUT="$RT_OUT")"
    fi
    RT_SPIN=''
    if [ "${mtot:-0}" -gt 0 ] 2>/dev/null; then
        meter_stop "$mtot" "$mtot" "$(msg status.created)"
    else
        info "$(msg status.created)"
    fi
    # Every verb that makes a container funnels through here, so the tunnel is raised in one
    # place rather than at each of the six call sites where one could be forgotten. Failure is
    # deliberately NOT fatal: the container and the shell are still perfectly usable, only the
    # browser-facing ports are missing, and ensure_tunnel has already said so.
    ensure_tunnel || true
}

# The tunnel goes first, always. It holds every course port on the host's loopback, and those
# are bound by a process that outlives the container -- so removing the container without it
# leaves an ssh client holding all 46 ports against a pipe that no longer has anything on the
# far end, and the REPLACEMENT container's tunnel then cannot bind a single one of them. That
# turns a routine --rebuild into a total outage whose cause is invisible.
remove_container() { tunnel_down; pmq rm -f "$NAME"; }

# Base names, not full ones, so the instance suffix is applied in exactly one place and
# cannot drift from the rewrite in load_args. "$NAME-claude" is "cs193v-claude" for a
# student and "cs193v-<instance>-claude" for a developer, matching container.args either way.
remove_volumes() {
    local v
    for v in claude claude-json gh vercel playwright; do
        pmq volume rm "$NAME-$v"
    done
}

# ─── the loopback tunnel ───────────────────────────────────────────────────────
# What this is and why it exists: podman's port forwarder delivers to the container's eth0
# and never touches its lo, so a server bound to the container's own 127.0.0.1 was
# unreachable from the student's browser. Rather than publish ports, the launcher runs an ssh
# CLIENT on the host that binds each course port on the host's loopback and asks an sshd
# INSIDE the container to connect to the container's loopback for each arriving connection.
#
# The transport is a `podman exec` pipe, not a socket: sshd is started in inetd mode (-i), so
# nothing listens anywhere in the system and the only way to reach it is to be able to run
# `podman exec`, which already requires this user's own privileges. That choice is also what
# makes it portable -- `podman exec` is what open_shell already relies on for a shell on all
# three platforms, whereas --network=pasta:--host-lo-to-ns-lo was silently inert on macOS.
#
# One ssh process carries every forward: SSH multiplexes channels over one connection, so a
# new browser connection costs a new channel, not a new `podman exec`. Measured: forwarded
# throughput 322 MB/s and per-connection latency indistinguishable from a published port
# (12.1ms vs 12.6ms), against 158ms per connection for any relay that spawns podman exec
# per connection. That measurement is the whole reason this is ssh and not socat.

# Generated once per machine. Not in the image (that would ship one private key to every
# student) and not per container start (the host key would change on every --rebuild and
# greet students with REMOTE HOST IDENTIFICATION HAS CHANGED for no reason).
tunnel_keys() {
    [ -f "$TUNNEL_KEY" ] || {
        ssh-keygen -q -t ed25519 -N '' -C 'cs193v-tunnel' -f "$TUNNEL_KEY" </dev/null \
            || die "$(msg err.tunnel-keygen)"
    }
    [ -f "$TUNNEL_HOST_KEY" ] || {
        ssh-keygen -q -t ed25519 -N '' -C 'cs193v-tunnel-host' -f "$TUNNEL_HOST_KEY" </dev/null \
            || die "$(msg err.tunnel-keygen)"
    }
    # Pin the container's host key, so StrictHostKeyChecking=yes has something to check and a
    # student never sees an interactive "do you want to continue" prompt. Rewritten every
    # time rather than appended to, so a regenerated host key cannot leave two entries.
    printf '%s %s\n' "$TUNNEL_HOST" "$(cat "$TUNNEL_HOST_KEY.pub")" > "$TUNNEL_KNOWN_HOSTS"
    chmod 600 "$TUNNEL_KEY" "$TUNNEL_HOST_KEY" 2>/dev/null || true
}

# Every port to forward, one per line, from the CS193V_PORTS value in container.args. Derived
# rather than declared a second time: the in-container `ports` command compares listening
# sockets against the same value, and a mismatch would make it give confidently wrong advice.
# The LAST occurrence wins, matching podman's own last--e-wins behaviour, so local.args can
# move one developer's instance out of another's way.
tunnel_ports() {
    local a spec chunk lo hi p
    spec=''
    for a in ${ARGS[@]+"${ARGS[@]}"}; do
        case "$a" in CS193V_PORTS=*) spec="${a#CS193V_PORTS=}" ;; esac
    done
    [ -n "$spec" ] || return 0
    for chunk in $(printf '%s' "$spec" | tr ',' ' '); do
        case "$chunk" in
            *-*) lo="${chunk%%-*}"; hi="${chunk##*-}" ;;
            *)   lo="$chunk"; hi="$chunk" ;;
        esac
        # A malformed range must not spin forever, and must not be silently dropped either:
        # container.args is a file people edit.
        case "$lo$hi" in ''|*[!0-9]*) warn "$(msg warn.tunnel-bad-port CHUNK="$chunk")"; continue ;; esac
        [ "$lo" -le "$hi" ] || { warn "$(msg warn.tunnel-bad-port CHUNK="$chunk")"; continue; }
        p="$lo"
        while [ "$p" -le "$hi" ]; do printf '%s\n' "$p"; p=$((p + 1)); done
    done
}

# Is a tunnel alive for THIS course directory and instance? The control socket is the
# identity, and -O check is the only honest test: a socket file can outlive its process.
tunnel_alive() {
    [ -S "$TUNNEL_CTL" ] || return 1
    run_timeout 10 ssh -S "$TUNNEL_CTL" -O check "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1
}

tunnel_start() {
    local fwd port n
    fwd=''
    n=0
    for port in $(tunnel_ports); do
        fwd="$fwd -L 127.0.0.1:$port:127.0.0.1:$port"
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || { warn "$(msg warn.tunnel-no-ports FILE="$ARGS_FILE")"; return 1; }

    rm -f "$TUNNEL_CTL" "$TUNNEL_PID" "$TUNNEL_LOG"

    # Backgrounded with & and a pidfile rather than `ssh -f`. -f is the idiomatic way to
    # daemonize after authentication, but it forks and the pid we could capture is the parent
    # that immediately exits -- leaving nothing for --reset-tunnel to kill when the tunnel
    # wedges. Polling -O check below recovers the one thing -f was buying, which is finding
    # out synchronously whether authentication actually succeeded.
    #
    # nohup, not setsid: a backgrounded ssh is still in the terminal's session, so closing
    # the window can HUP it -- and setsid(1) DOES NOT EXIST on macOS. The log goes to TMPDIR
    # so nohup never drops a nohup.out in the student's course directory.
    #
    # -F none: ignore the student's own ~/.ssh/config AND the system one, so nothing they
    # have configured for other hosts can redirect or decorate this. NOT
    # ClearAllForwardings, which reads like it would help and would in fact delete every -L
    # below; see the invariants block in container.args.
    #
    # ExitOnForwardFailure is deliberately NOT set. With 46 forwards there are 46 chances one
    # host port is already busy, and either raw behaviour is bad for a novice: the default
    # loses one port silently, and =yes turns one unlucky port into a total outage. Instead
    # every forward is attempted and the failures are read back out of the log below, which
    # is the only way to report what ACTUALLY failed rather than what we predicted would.
    #
    # shellcheck disable=SC2086
    nohup ssh -N -M -S "$TUNNEL_CTL" -F none \
        -i "$TUNNEL_KEY" -o IdentitiesOnly=yes \
        -o "ProxyCommand=podman exec -i $NAME /usr/sbin/sshd -i -f $TUNNEL_SSHD_CONFIG" \
        -o "UserKnownHostsFile=$TUNNEL_KNOWN_HOSTS" -o StrictHostKeyChecking=yes \
        -o ForwardAgent=no -o ForwardX11=no -o PermitLocalCommand=no \
        -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
        $fwd "$TUNNEL_USER@$TUNNEL_HOST" >"$TUNNEL_LOG" 2>&1 </dev/null &
    printf '%s\n' "$!" > "$TUNNEL_PID"

    local i
    i=0
    while [ "$i" -lt 60 ]; do
        tunnel_alive && break
        # If the client is already gone, there is nothing to wait for: report now with the
        # log, rather than spending the remaining thirty seconds on a corpse.
        kill -0 "$(cat "$TUNNEL_PID" 2>/dev/null)" 2>/dev/null || break
        sleep 0.5
        i=$((i + 1))
    done
    if ! tunnel_alive; then
        warn "$(msg warn.tunnel-failed LOG="$TUNNEL_LOG" OUT="$(tail -5 "$TUNNEL_LOG" 2>/dev/null)")"
        return 1
    fi
    tunnel_report_busy_ports
    return 0
}

# Which forwards did not get their host port, according to ssh ITSELF rather than to a guess.
#
# The obvious alternative -- probe each port and see if something is listening -- is wrong in
# exactly the case that matters: a port held by ANOTHER program answers a probe, so a busy
# port would be counted as a working forward and the one thing this report exists to catch
# would be the one thing it missed. Measured: doctor said "46 of 46" while 3005 was squatted.
#
# Reading the log is authoritative because tunnel_start truncates it, so it always describes
# the tunnel that is running now. Both spellings are matched because the wording differs
# between the bind failure and the channel setup that follows it.
#
# Probing would also have connected to every one of the student's own dev servers 46 times
# per doctor run, which would show up in their logs as unexplained requests.
tunnel_busy_ports() {                 # -> space-separated ports ssh could not bind
    [ -f "$TUNNEL_LOG" ] || return 0
    sed -n -e 's/.*cannot listen to port: \([0-9]*\).*/\1/p' \
           -e 's/.*bind \[127\.0\.0\.1\]:\([0-9]*\).*/\1/p' "$TUNNEL_LOG" \
        | sort -u | tr '\n' ' ' | sed 's/ *$//'
}

tunnel_report_busy_ports() {
    local busy
    busy="$(tunnel_busy_ports)"
    [ -n "$busy" ] && warn "$(msg warn.tunnel-ports-busy PORTS="$busy")"
    return 0
}

ensure_tunnel() {
    tunnel_alive && return 0
    tunnel_keys
    tunnel_start || return 1
}

# Paired with remove_container, ALWAYS. A tunnel whose container is gone still holds every
# host port it bound, which would stop the replacement container's tunnel from binding them
# -- turning a routine --rebuild into a total outage with no visible cause.
tunnel_down() {
    if [ -S "$TUNNEL_CTL" ]; then
        run_timeout 10 ssh -S "$TUNNEL_CTL" -O exit "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1
    fi
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID"
}

# The state machine. Everything that can silently give a student the wrong container is
# checked here.
ensure_container() {
    local st want_hash have_hash
    st="$(state)"

    if [ "$st" = absent ]; then
        create_container
        return
    fi

    refuse_if_foreign_dir

    want_hash="$(config_hash)"
    have_hash="$(label_of cs193v.confighash)"

    if [ -n "$have_hash" ] && [ "$have_hash" != "$want_hash" ]; then
        printf '\n'; msg prompt.config-changed
        if confirm "$(msg opt.keep-current)" "$(msg opt.recreate)"; then
            remove_container; create_container; return
        fi
    fi

    # Is the IMAGE itself out of date relative to the course files on disk? This is the
    # question the digest pin used to answer, and it is how a mid-quarter fix reaches a student
    # who never runs --rebuild: staff change the Containerfile, the student's next `./cs193v`
    # notices the recipe moved, and offers to rebuild. It is the ONLY thing that notices, which
    # is why the launcher builds the image itself rather than letting anyone hand it one.
    #
    # IT ASKS HERE AND DOES NOT ASK IN verb_rebuild, which is the same predicate reaching two
    # different conclusions on purpose. Here the student asked for a shell and a build is a
    # four-minute surprise, so it is offered with "keep the current version" as the default.
    # There they typed the verb whose job is to make the container match the recipe, so
    # building is the answer to what they asked rather than an interruption of it.
    if recipe_moved; then
        printf '\n'; msg prompt.image-stale
        if confirm "$(msg opt.keep-current-version)" "$(msg opt.rebuild-now)"; then
            build_image; remove_container; create_container; return
        fi
    fi

    case "$st" in
        running) : ;;
        *) info "$(msg status.starting)"
           pmq start "$NAME" || { remove_container; create_container; return; } ;;
    esac

    # Reached only when the container was already there -- created-and-tunnelled paths above
    # all return. An existing container very often has no tunnel: the host rebooted, the
    # student logged out and back in, or podman was restarted. So this is where "the container
    # is fine but nothing reaches my server" gets fixed, and it is why ensure_tunnel has to be
    # idempotent and cheap rather than something only the create path does.
    ensure_tunnel || true
}

# ─── the session's lifetime ────────────────────────────────────────────────────
# ONE session at a time, and it ends when the terminal does. Issue #41.
#
# The design here used to be the exact opposite, and it is worth knowing what went and why,
# because the deletion is most of this change. The container outlived every window; tmux ran
# with `destroy-unattached off` so a session survived its client; cs193v-shell reattached to
# whichever session had no client; and because closing a window does NOT kill the tmux client
# inside the container -- conmon keeps the exec pty open and tmux reports the session attached
# forever, measured, see ERRORS.md D1 -- the launcher had to stamp each session with the host
# pid that attached it and prune the ghosts before every launch.
#
# All of that is gone -- the liveness check, the pruning, the owner stamp, the client pid the
# stamp needed, and the warning about having too many windows open. What makes the replacement
# this much smaller is that the container now STOPS, so there is never an orphaned session to
# reason about and never more than one client to count. 10-static.sh asserts each of those
# names is absent, so this paragraph deliberately does not spell them out: the launcher's own
# documentation of a ban is the classic thing that matches the ban's own grep.

# The status cs193v-shell exits with when it loses the session-claim race. A CONTRACT BETWEEN
# TWO FILES -- see the claim block in files/cs193v-shell -- and 10-static.sh asserts that both
# spell it the same, because nothing else would notice them drifting apart and the symptom
# would be a lost race printing that script's "fault in the container image" box.
RACE_LOST_STATUS=3
TEARDOWN_DONE=''

# What ends the session: `exit` from the last tab, the window closing, and Ctrl-C alike. All
# three arrive here the same way, as the podman exec child terminating with a signal pending
# that we trapped -- which is why there is one teardown and not three.
#
# THE TUNNEL GOES FIRST, ALWAYS, for the reason remove_container spells out at length: an ssh
# client that outlives its container keeps all 46 host ports bound on the host's loopback
# against a pipe with nothing on the far end, so the NEXT tunnel can bind none of them and the
# student's next launch silently has no forwarding at all.
#
# TWO TIMEOUTS, TWO JOBS, and conflating them is the easy mistake here:
#   * `-t 3` is PODMAN's own SIGTERM-then-SIGKILL grace on PID 1. The default is 10, and
#     files/entrypoint.sh traps TERM and exits immediately, so the default would spend seven
#     of those seconds waiting on a process that exits in milliseconds.
#   * pmq is the outer bound on podman ITSELF hanging -- a slept Mac, a wedged VM -- which is
#     precisely what pm/pmq exist for, so this needs no fourth hand-rolled number.
#   * `-i` so an already-gone container is not an error. That really happens: a --rebuild run
#     from another window removes the container this shell was attached to.
#
# Worth knowing rather than assuming, because the flag name invites the wrong belief: podman
# TERMs ONLY PID 1. Every other process in the container is killed by the cgroup teardown, so
# no student process gets a clean shutdown whether -t is 3 or 10, and an unsaved nano buffer is
# lost either way. Making that work would mean TERMing the container's own processes before the
# stop; deliberately not done, see .private/README.md.
stop_container() {
    # Sampled ONCE, up front, so the message and the action cannot disagree: nothing announces
    # that it is stopping a container which is not running. That used to matter most for a verb
    # cancelled at a prompt before it built anything; --rebuild no longer prompts, but the
    # sampling stays because shell_teardown reaches here on paths where the container may
    # already have gone -- see the unconditional tunnel_down below.
    local was_running
    was_running=''
    [ "$(state)" = running ] && was_running=1

    [ -n "$was_running" ] && note "$(msg status.stopping)"
    # UNCONDITIONAL, even when the container has already gone: a --rebuild run from another
    # window can have removed it out from under this shell, and an ssh client that outlives its
    # container still holds all 46 host ports against a pipe with nothing on the far end. That
    # is the failure remove_container documents, and skipping this on the "nothing to do" path
    # is how it would come back.
    tunnel_down
    [ -n "$was_running" ] && pmq stop -t 3 -i "$NAME"
    return 0
}

# The trapped wrapper. Separate from stop_container because the once-guard is only needed on
# this path: HUP runs the handler and EXIT then runs it again, and a second `podman stop` would
# print a second "stopping" line at the student for something already done. The maintenance
# verbs and --stop call stop_container directly, each exactly once.
shell_teardown() {
    [ -n "$TEARDOWN_DONE" ] && return 0
    TEARDOWN_DONE=1
    stop_container
}

# Refuse to disturb a session that is already open, and name the one way out of it.
#
# `state` = running IS the whole test, and it is deliberately no smarter than that. The
# alternative considered was a host-side registry of live clients so that several windows could
# share one container; it needs the same liveness question answered and it fails WORSE. A wrong
# answer there locks a student out of their own container, where a wrong answer here merely
# leaves one running -- which both the next launch and --stop recover from. See
# .private/README.md for the whole comparison.
#
# This is a check-then-act, so it is racy on its own, and it is NOT what carries the guarantee.
# It exists to produce a good message before any work happens. The rule is made true one layer
# down by an atomic claim: podman's own container-name uniqueness for absent -> running, and
# tmux's session namespace for exited -> running, since `podman start` is idempotent and
# reports nothing. Both measured; see the same README section.
refuse_if_session_live() {
    [ "$(state)" = running ] || return 0
    die "$(msg err.session-in-use)"
}

# A container created from a DIFFERENT copy of the course directory. Without this check, a
# student who downloads a fresh copy after breaking something silently gets the old container
# with the old mount, and their edits appear to vanish.
#
# THIS MUST BE ASKED BEFORE refuse_if_session_live, and getting that order wrong is a mistake
# #41 made once already: the session refusal only knows that SOMETHING is running, so on a
# machine with two copies of the course directory it answered "you already have a session open
# in another window" -- true, but it buried the one fact the student had to know, and its advice
# (`--stop`, then launch again) would have walked them straight back into the wrong container.
# Ownership is the more specific diagnosis, so it wins. 30-launcher-shim.sh's foreign-dir group
# is the regression test.
refuse_if_foreign_dir() {
    local owner_dir
    owner_dir="$(label_of cs193v.dir)"
    [ -n "$owner_dir" ] || return 0
    [ "$owner_dir" = "$DIR" ] && return 0
    die "$(msg err.other-directory INUSE="$owner_dir" YOURS="$DIR")"
}

open_shell() {
    # Declared BEFORE the exec below, not at the point of use: `local rc` is itself a command
    # and would reset $? to 0 before we could read the child's status.
    local rc
    # Refuse, rather than hang, when there is no terminal to open a shell on.
    #
    # `podman exec -it` allocates a pty, and a pty NEVER delivers EOF the way a pipe does —
    # so with a redirected stdin the container's `bash -l` waits forever for input that
    # cannot arrive, and the launcher looks wedged with no output. Redirecting from
    # /dev/null does not help; only sending a literal `exit` does. Measured: see
    # ERRORS.md B13.
    #
    # Checked here rather than in the dispatcher on purpose. Everything up to this point —
    # preflight, the drift prompts, creating or starting the container — is useful and
    # idempotent, so a script that gets this far has still done real work and the message
    # can say so.
    if [ ! -t 0 ]; then
        # ...but it does not get to leave a container running with nothing attached to it,
        # which is the exact state #41 exists to prevent. So the work is undone before the
        # message, and err.needs-a-terminal says "set up" rather than "up and running".
        shell_teardown
        die "$(msg err.needs-a-terminal)"
    fi

    # LAST, so it covers everything printed on the way here and the warnings are still the
    # newest thing on screen while the student reads them. One line further down the student is
    # inside tmux, whose alternate screen erases all of it. See warn().
    acknowledge_warnings

    # THE TRAP, AND NOT `exec`. This is the line the whole of #41 rests on.
    #
    # `exec` replaced this process with podman, so no process survived the shell to stop
    # anything and the container simply stayed up forever. The launcher now stays resident for
    # the length of the session and tears it down afterwards.
    #
    # HUP IS TRAPPED EXPLICITLY, and that is not redundant with EXIT: bash's default action for
    # SIGHUP is to die WITHOUT running the EXIT trap, so closing the window -- the one case this
    # exists for -- would leave the container up.
    #
    # FOREGROUND, not backgrounded-and-waited. Backgrounding raises the question of whether
    # `podman exec -it` takes SIGTTIN on its first read from the tty; it should not, because job
    # control is off in a non-interactive shell so the child stays in the terminal's foreground
    # process group -- but that is an assumption worth not needing. Foregrounded, the same
    # SIGHUP that closes the window kills the child AND is pending for us, so bash runs the
    # handler as soon as it reaps it.
    trap shell_teardown EXIT HUP INT TERM

    # cs193v-shell puts the student inside tmux; see files/cs193v-shell. CS193V_CONTAINER is
    # passed because its failure path has to tell a student the exact `podman exec` line to
    # run, and nothing inside the container can work out the container's name --
    # CS193V_INSTANCE may have suffixed it, and the hostname is cs193v-development either way.
    podman exec -it \
        -w "$MOUNT_DST" \
        -e "TERM=$(safe_term)" \
        -e "COLORTERM=${COLORTERM:-}" \
        -e "CS193V_CONTAINER=$NAME" \
        "$NAME" cs193v-shell
    rc=$?

    # A lost claim race is not a fault -- it is the refusal arriving one layer down. Two
    # launches both found a stopped container, both started it (podman start is idempotent and
    # says nothing), and tmux handed the single session to whichever asked first. The loser
    # reports it with the SAME message as the state check, so a student never has to care which
    # layer caught them.
    #
    # The trap is cleared FIRST. The winner owns this container, and letting our teardown run
    # would stop it out from under their session -- turning a harmless race into the one
    # failure this whole mechanism exists to prevent.
    if [ "$rc" = "$RACE_LOST_STATUS" ]; then
        TEARDOWN_DONE=1
        trap - EXIT HUP INT TERM
        die "$(msg err.session-in-use)"
    fi
    return "$rc"
}

# ─── verbs ─────────────────────────────────────────────────────────────────────
verb_ports() {
    [ "$(state)" = running ] || die "$(msg err.not-running)"
    exec podman exec -it -e "TERM=$(safe_term)" "$NAME" ports
}

verb_doctor() {
    printf '%sCS193V container report%s\n' "$C_CYAN" "$C_OFF"
    printf '%s\n' "-------------------------------------------------------------"
    printf '  %-16s %s\n' "platform" "$(platform) / $(uname -m)"
    printf '  %-16s %s\n' "course dir" "$DIR"

    if command -v podman >/dev/null 2>&1 && run_timeout 10 podman --version; then
        printf '  %-16s %s\n' "podman" "$(printf '%s' "$RT_OUT" | awk '{print $NF}')"
    else
        printf '  %-16s %s\n' "podman" "NOT FOUND or not responding"
        return 1
    fi

    if has_machine; then
        pm machine list --format '{{.Name}} {{.Running}}'
        printf '  %-16s %s\n' "machine" "${RT_OUT:-none}"
    fi

    if pm info --format '{{.Host.MemTotal}} {{.Host.CPUs}} {{.Host.RootlessNetworkCmd}}'; then
        printf '  %-16s %s\n' "podman sees" "$RT_OUT"
    else
        printf '  %-16s %s\n' "podman info" "TIMED OUT (a Mac that has slept can do this)"
    fi

    # The image, and whether it still matches the recipe it was built from. This is the
    # replacement for "what digest are you on?" -- the first question in any support thread
    # about behaviour that staff cannot reproduce, and the one a locally built image would
    # otherwise have no answer to.
    load_args
    if pmq image exists "$IMAGE"; then
        printf '  %-16s %s\n' "image" "$IMAGE (built here)"
        pm image inspect "$IMAGE" --format '{{.Created}}'
        printf '  %-16s %s\n' "image built" "${RT_OUT:-?}"
        local hb
        hb="$(image_label_of "$IMAGE" cs193v.buildhash)"
        if [ ! -f "$CONTAINERFILE" ]; then
            printf '  %-16s %s\n' "image recipe" "cannot check — no $CONTAINERFILE"
        elif [ -z "$hb" ]; then
            printf '  %-16s %s\n' "image recipe" "not recorded (built by hand, or before this was tracked)"
        elif [ "$hb" = "$(build_hash)" ]; then
            printf '  %-16s %s\n' "image recipe" "matches Containerfile ($(printf '%s' "$hb" | cut -c1-12))"
        else
            printf '  %-16s %s\n' "image recipe" "STALE — run ./cs193v --rebuild"
        fi
    else
        printf '  %-16s %s\n' "image" "$IMAGE — NOT BUILT; run ./cs193v --rebuild"
    fi

    local st; st="$(state)"
    printf '  %-16s %s\n' "container" "$st"
    # What "running" MEANS changed with #41, and doctor is where a student or a TA reads it. Every
    # ordinary way of finishing now stops the container, so `exited` is the healthy resting state
    # and must not look like a fault -- while `running` means somebody has a window open, or a
    # window was force-quit and no trap ran.
    #
    # DELIBERATELY NOT GUESSED AT. The obvious thing is to ask tmux whether a client is attached,
    # and it does not work: conmon keeps a dead session's pty open, so tmux reports a client
    # indefinitely after the window is gone (measured; ERRORS.md D1). A `list-clients` check would
    # therefore answer "attached" in exactly the case worth reporting. Deciding it host-side means a
    # `ps` scan for our own exec process, which is a heuristic this launcher does not otherwise need.
    #
    # So both readings are printed and the student picks -- which is the same choice
    # err.session-in-use makes, and for the same reason: they know whether they have a window open,
    # and no test here can.
    case "$st" in
        exited)  printf '  %-16s %s\n' "" "normal — nothing is open right now" ;;
        running) printf '  %-16s %s\n' "" "a terminal window has this open. If you have none"
                 printf '  %-16s %s\n' "" "open, one was force-quit — run: cs193v --stop" ;;
    esac
    if [ "$st" != absent ]; then
        pm inspect "$NAME" --format '{{.State.StartedAt}}'
        printf '  %-16s %s\n' "started" "$RT_OUT"
        local hv hw; hv="$(label_of cs193v.confighash)"; hw="$(config_hash)"
        if [ "$hv" = "$hw" ]; then printf '  %-16s %s\n' "config" "matches container.args"
        else printf '  %-16s %s\n' "config" "STALE — run cs193v and accept the recreate prompt"; fi
        pm inspect "$NAME" --format "{{range .Mounts}}{{if eq .Destination \"$MOUNT_DST\"}}{{.Source}}{{end}}{{end}}"
        printf '  %-16s %s\n' "workspace" "${RT_OUT:-?}"
    fi

    if [ "$st" = running ]; then
        pm exec "$NAME" sh -c 'echo "$(id -u):$(id -g)"'
        printf '  %-16s %s (host is %s:%s)\n' "in-container uid" "$RT_OUT" "$(id -u)" "$(id -g)"
        pm exec "$NAME" sh -c 'cat /sys/fs/cgroup/memory.max 2>/dev/null'
        printf '  %-16s %s\n' "memory limit" "${RT_OUT:-unknown}"
        pm exec "$NAME" sh -c 'ps -eo stat --no-headers | grep -c Z'
        printf '  %-16s %s\n' "zombies" "${RT_OUT:-0}"
        tmux_doctor
        tunnel_doctor
        check_clock
    fi
    printf '%s\n' "-------------------------------------------------------------"
    printf '%s\n' "Paste all of the above when asking course staff for help."
}

# tmux is the landing point, so "what is my session doing" is now a support question. A
# student who says "my tabs vanished" is describing session state that nothing else here shows.
#
# Sessions and their window counts, plus the clients attached to each. WHAT THESE NUMBERS MEAN
# INVERTED WITH #41, and the old reading is now the diagnosis rather than the normal case:
# there is exactly one session, it has exactly one client, and it lives only as long as the
# terminal does. A session with 0 clients used to be "waiting to be picked back up by the next
# ./cs193v"; now nothing picks it up, and seeing one means a window was force-quit and the
# container outlived it. Two clients on one session is no longer reachable at all.
tmux_doctor() {
    local out
    if pm exec "$NAME" tmux -L cs193v list-sessions \
           -F '#{session_name} #{session_windows}w #{session_attached} attached' 2>/dev/null; then
        out="$RT_OUT"
    else
        printf '  %-16s none (nobody is in the container right now)\n' "tmux sessions"
        return 0
    fi
    if [ -z "$out" ]; then
        printf '  %-16s none (nobody is in the container right now)\n' "tmux sessions"
        return 0
    fi
    printf '  %-16s %s\n' "tmux sessions" "$(printf '%s\n' "$out" | head -1)"
    printf '%s\n' "$out" | tail -n +2 | while IFS= read -r line; do
        [ -n "$line" ] && printf '  %-16s %s\n' "" "$line"
    done
}

# The tunnel's state is now the ONLY place host-side forwarding is visible, which makes this
# load-bearing for support rather than decorative. It replaced a `podman port` count, and the
# difference matters: the in-container `ports` command reads /proc/net/tcp and so cannot see
# whether a forward exists on the host at all. When a student says "ports says OK but my
# browser cannot reach it", this report is the answer, and nothing else is.
tunnel_doctor() {
    local want busy nbusy port pid
    if tunnel_alive; then
        pid="$(cat "$TUNNEL_PID" 2>/dev/null)"
        printf '  %-16s up (pid %s)\n' "tunnel" "${pid:-?}"
    else
        printf '  %-16s %sDOWN%s — run: cs193v --reset-tunnel\n' "tunnel" "$C_YEL" "$C_OFF"
        return 0
    fi

    want=0
    for port in $(tunnel_ports); do want=$((want + 1)); done
    busy="$(tunnel_busy_ports)"
    nbusy=0
    for port in $busy; do nbusy=$((nbusy + 1)); done

    if [ -z "$busy" ]; then
        printf '  %-16s %s of %s forwarded\n' "tunnel ports" "$want" "$want"
    else
        printf '  %-16s %s of %s forwarded  %sNOT:%s %s\n' \
            "tunnel ports" "$((want - nbusy))" "$want" "$C_YEL" "$C_OFF" "$busy"
        printf '  %-16s another program on this computer holds those\n' ""
    fi
}

# The container CANNOT fix its own wall clock: Linux time namespaces virtualise only
# CLOCK_MONOTONIC and CLOCK_BOOTTIME, never CLOCK_REALTIME; setting the clock needs
# CAP_SYS_TIME, which is not in podman's default set; and the kernel checks that
# capability against the INITIAL user namespace anyway. So detection here, remedy in
# the VM. Symptoms all look like network faults: TLS "certificate not yet valid", apt
# complaining about future-dated release files, auth failures.
check_clock() {
    local hs cs skew
    hs="$(date +%s)"
    pm exec "$NAME" date +%s || return 0
    cs="$RT_OUT"
    case "$cs" in ''|*[!0-9]*) return 0 ;; esac
    skew=$(( cs - hs )); [ "$skew" -lt 0 ] && skew=$(( -skew ))
    if [ "$skew" -le 5 ]; then
        printf '  %-16s %ss\n' "clock skew" "$skew"
        return 0
    fi
    printf '  %-16s %ss  %sPROBLEM%s\n' "clock skew" "$skew" "$C_YEL" "$C_OFF"
    has_machine || return 0
    printf '\n'; msg prompt.clock-drift SKEW="$skew"
    if confirm "$(msg opt.leave-clock)" "$(msg opt.restart-machine)"; then
        info "$(msg status.restarting-machine)"
        run_timeout 120 podman machine stop || true
        run_timeout 180 podman machine start || warn "$(msg warn.machine-restart-failed)"
        # Restarting the machine kills the tunnel with it: its transport is a `podman exec`
        # into a VM that just went away. Without this, the clock fix would silently cost the
        # student every forwarded port, and the next symptom would look unrelated to the
        # prompt they just accepted.
        tunnel_down
        ensure_tunnel || true
    fi
}

# THE ONE VERB THAT MAKES A CONTAINER MATCH THE RECIPE. It replaced four -- --build,
# --rebuild, --full-rebuild and --dev-build -- which between them named two operations and
# three presentation choices, and differed by a line or two each.
#
# WHAT DECIDES WHETHER IT BUILDS IS THE RECIPE HASH, NOT THE FLAG THE STUDENT PICKED, and that
# is the whole idea. The two old verbs were a question put to the person least able to answer
# it: "has staff changed the Containerfile since your image was built?" is not something a
# student knows, and picking wrong was silent either way -- --rebuild left them on a stale
# image, --build spent minutes rebuilding one that was already current. recipe_moved knows.
# So the cheap path stays cheap without being a separate command:
#
#   recipe unchanged  ->  recreate only, ~2s, no network, no disk    (the old --rebuild)
#   recipe moved      ->  build, then recreate                       (the old --build)
#   no image at all   ->  build; this is the installer's first run
#   --no-cache        ->  build regardless, staff and the release gate
#
# NO PROMPT, unlike ensure_container's use of the same predicate, and the asymmetry is
# deliberate -- see the comment there. This is also why the verb is safe for the installer to
# call with no tty (install-cs193v.sh): nothing here waits on a keypress.
#
# --logout is a MODIFIER rather than the old --full-rebuild verb, and it carries no confirm.
# The prompt --full-rebuild had existed because its name did not say it logged you out; this
# name says so. Worth knowing that this is the only irreversible thing the launcher does: the
# claude, gh and vercel volumes go, and re-logging in is real work for a student.
#
# THE STOP AND THE SUCCESS BOX LIVE HERE NOW, not in dispatch. They sat out there because
# --dev-build shared this verb's body and then went straight into a shell, so a stop inside
# would have torn down the container it was about to hand you (issues #22, #41). With that verb
# gone, no path creates a container and leaves it running, and dispatch is a plain table again.
verb_rebuild() {
    local nocache='' wipe=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-cache) nocache='--no-cache' ;;
            --logout)   wipe=1 ;;
            # Strict, where the old --build silently ignored a stray argument: build_image only
            # ever looked for --no-cache, so `--build --logout` would have quietly built and
            # kept the volumes. With two modifiers that both matter, a typo has to be loud.
            *)          usage; exit 2 ;;
        esac
        shift
    done

    preflight; refuse_if_session_live; load_args

    if [ -n "$nocache" ] || ! pmq image exists "$IMAGE" || recipe_moved; then
        build_image "$nocache"
    elif [ -n "$wipe" ]; then
        # TWO KEYS, because status.rebuilding promises that logins are kept and that promise is
        # false here. Printed ONLY on the no-build branches: build_image starts the progress
        # meter and create_container closes it (issue #24), so a line here on the build branch
        # would land in the middle of a live bar.
        info "$(msg status.rebuilding-logout)"
    else
        info "$(msg status.rebuilding)"
    fi

    remove_container
    [ -n "$wipe" ] && remove_volumes
    create_container
    stop_container

    # THE LOGOUT IS REPORTED WHETHER OR NOT A BUILD HAPPENED, which is why this is not one
    # if/elif chain ending in the box: a --rebuild --logout that also built would otherwise
    # finish on "Build Successful!" and never mention that the student is now logged out.
    if [ -n "$wipe" ]; then
        info "$(msg status.full-rebuilt)"
    elif [ -z "$BUILT" ]; then
        info "$(msg status.rebuilt)"
    fi
    [ -n "$BUILT" ] && msg status.build-succeeded | celebrate "Build Successful!"
    return 0
}

# Stop the container by hand. The unified answer to "the container is busy", which is why every
# refusal in this script names it.
#
# It exists as a student-facing verb rather than as advice to run `podman stop` because the
# student who needs it is the one whose terminal was force-quit or whose machine crashed: they
# have a container running with nothing attached to it, `./cs193v` refuses, and this is the one
# command that gets them back to a state where launching works. Advice to run a raw podman
# command would be the only place in the course that asks that of them.
#
# Prompted, because it can throw away work: anything running in a session belonging to another
# window dies with the container, and a student who mis-reads a refusal should not be one
# keystroke from stopping the session they are actually using.
verb_stop() {
    preflight; load_args
    if [ "$(state)" != running ]; then
        info "$(msg status.already-stopped)"
        return 0
    fi
    printf '\n'; msg prompt.stop
    if ! confirm "$(msg opt.cancel)" "$(msg opt.stop-go)"; then
        info "$(msg status.cancelled)"; return 0
    fi
    stop_container
    info "$(msg status.stopped)"
}

# The escape hatch for a tunnel that has stopped answering. Its whole reason for existing is
# the case where the tunnel is STUCK, so nothing in it may depend on the tunnel being healthy
# -- that is the difference between this and tunnel_down.
#
# Worth saying plainly, because the symptom is easy to misread: a wedged tunnel does NOT stop
# the container from starting. podman starts it regardless. What a stale tunnel blocks is the
# NEXT tunnel binding the host ports it is still holding, so the symptom is "my browser cannot
# reach my server", not "the container will not start".
verb_reset_tunnel() {
    preflight; load_args; require_image
    info "$(msg status.tunnel-resetting)"

    # 1. The clean way first, but TIME-BOXED. A wedged ssh may never answer -O exit, and
    #    waiting forever for it is precisely the failure this verb exists to break out of.
    if [ -S "$TUNNEL_CTL" ]; then
        run_timeout 10 ssh -S "$TUNNEL_CTL" -O exit "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1 || true
    fi

    # 2. Then force. SIGTERM, a moment to land, then SIGKILL -- a process stopped with SIGSTOP
    #    will never handle a TERM, and that is a realistic way to arrive here.
    local pid
    pid="$(cat "$TUNNEL_PID" 2>/dev/null)"
    case "${pid:-}" in
        ''|*[!0-9]*) : ;;
        *) if kill -0 "$pid" 2>/dev/null; then
               kill "$pid" 2>/dev/null || true
               sleep 1
               kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
           fi ;;
    esac

    # 3. A leftover socket makes the next -O check report a dead tunnel as live, which would
    #    make ensure_tunnel decide there was nothing to do.
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID" "$TUNNEL_LOG"

    # 4. Only now is it meaningful to ask who still holds the ports. Anything left is NOT ours
    #    -- it is another program on the student's computer -- and naming it is the difference
    #    between a fixable problem and a mystery.
    if [ "$(state)" != running ]; then
        warn "$(msg warn.tunnel-reset-not-running)"
        return 0
    fi
    ensure_tunnel || return 1
    info "$(msg status.tunnel-reset)"
}

verb_print_command() {
    load_args
    build_run_args
    printf 'podman run'
    local a
    for a in ${RUN_ARGS[@]+"${RUN_ARGS[@]}"}; do printf ' %s' "$a"; done
    printf ' %s\n' "$IMAGE"
}

usage() {
    msg help.usage
}

# ─── dispatch ──────────────────────────────────────────────────────────────────
#
# THE INVARIANT THIS ENFORCES: a running container implies an open terminal. Issue #41.
#
# Which is why every maintenance verb ends in stop_container and not one of them leaves a
# container up for the next command. They are not sessions -- nobody is attached when they
# finish -- so leaving one running would break the invariant that makes the refusal above them
# honest and `doctor` readable: with this, "running" always means "somebody is in there", and a
# running container with nothing attached is a force-quit leftover rather than one of four
# ordinary outcomes nobody can tell apart.
#
# THE STOP AND THE SUCCESS BOX USED TO LIVE HERE and now do not, which is worth a line because
# it was deliberate in both directions. They were hoisted out of the verbs because --dev-build
# shared verb_build's body and then opened a shell, so a stop inside would have torn down the
# container it was about to hand you (issues #22, #41). With --dev-build and --build both gone
# there is no such path left: verb_rebuild is the only verb that creates a container, so it owns
# its own stop and dispatch is a plain table.
#
# ports, doctor and --reset-tunnel take no reference and stop nothing. --reset-tunnel especially:
# its whole purpose is fixing the tunnel WHILE a session is live.
case "${1:-}" in
    # refuse_if_foreign_dir FIRST: "this container belongs to a different copy of the course
    # directory" is a more specific diagnosis than "something is already running", and losing it
    # behind the session refusal would send a student to --stop and then straight back into the
    # wrong container. See the comment on the function.
    '')                  preflight; refuse_if_foreign_dir; refuse_if_session_live
                         load_args; require_image; ensure_container; open_shell ;;
    ports)               preflight; verb_ports ;;
    doctor)              verb_doctor ;;
    --stop)              verb_stop ;;
    --reset-tunnel)      verb_reset_tunnel ;;
    # "$@" rather than "${1:-}": --logout and --no-cache are independent and may be given
    # together, in either order.
    --rebuild)           shift; verb_rebuild "$@" ;;
    --dev-print-command) verb_print_command ;;
    -h|--help|help)      usage ;;
    *)                   usage; exit 2 ;;
esac
