#!/usr/bin/env bash
#
# CS193V container launcher.
#
# ONE script for macOS, native Ubuntu, and Windows (inside the WSL2 CS193V distro).
# There is no PowerShell twin: every supported platform has bash.
#
# MUST STAY BASH 3.2 COMPATIBLE — macOS ships bash 3.2. That means:
#   no associative arrays, no mapfile/readarray, no ${var,,}, no `read -t 0.5`,
#   no |& , no &>> .
# VERIFICATION.md §A.1 greps for all of these.
#
# It lives OUTSIDE the directory it mounts, so the container cannot see or rewrite it.
# That replaces the devcontainer's read-only .devcontainer bind mount, and closes a hole
# that trick leaves open: that mount and the writable workspace are two mounts of the
# SAME filesystem with files owned by the agent's own uid, so link(2) — which checks
# write permission only on the destination — yields a writable second name for the same
# inode, which the host then reads on the next rebuild.

set -u

# ─── where we are ──────────────────────────────────────────────────────────────
# Resolved from our own location, not the working directory, so `cs193v` works from
# anywhere and always mounts its own sibling projects/.
SELF="$0"
while [ -L "$SELF" ]; do
    _link="$(readlink "$SELF")"
    case "$_link" in
        /*) SELF="$_link" ;;
        *)  SELF="$(dirname "$SELF")/$_link" ;;
    esac
done
DIR="$(cd -- "$(dirname -- "$SELF")" && pwd -P)"

# The student's course directory holds only what they use: the launcher and projects/.
# Flag files live in .config/, and everything needed to build or maintain the image --
# including the message catalogue, which is script config rather than something a student
# reads -- lives in .private/. See issue #16.
CONFIG="$DIR/.config"
ARGS_FILE="$CONFIG/container.args"
LOCAL_ARGS_FILE="$CONFIG/local.args"
MESSAGES="$DIR/.private/messages.txt"
WORKSPACE="$DIR/projects"
# Build and maintenance files live in .private/, so a student's course directory holds only
# what they actually use: the launcher, the two flag files, messages.txt and projects/.
# See issue #16.
PRIVATE="$DIR/.private"
CONTAINERFILE="$PRIVATE/Containerfile"

# ─── the tunnel's files ────────────────────────────────────────────────────────
# Key material lives beside local.args in .config/, git-ignored, generated once per machine.
# The private halves NEVER enter the container; the public half and the host key are
# bind-mounted read-only, so a compromised container cannot alter who may log in.
TUNNEL_KEY="$CONFIG/tunnel-key"
TUNNEL_HOST_KEY="$CONFIG/tunnel-host-key"
TUNNEL_KNOWN_HOSTS="$CONFIG/tunnel-known-hosts"
# The name the tunnel connects to. Never resolved -- ProxyCommand replaces the connection
# entirely -- but it IS the key that known_hosts is looked up under, so it has to be stable.
TUNNEL_HOST="cs193v-tunnel"
# And the account inside the container, which MUST be stated explicitly. ssh otherwise
# defaults to the login name on the HOST -- so it would try to log in as whatever the
# student's macOS or Windows account is called, and sshd would refuse it (AllowUsers student,
# and the key is student's). The failure is a bare "Permission denied (publickey)" with
# nothing pointing at the cause, and it would happen on every machine whose user is not
# called "student" -- which is all of them.
TUNNEL_USER="student"
# Where the container's sshd finds its host key and config. Must match files/sshd_config's
# HostKey line and the Containerfile's install path.
TUNNEL_HOST_KEY_DST="/etc/ssh/cs193v_host_ed25519_key"
TUNNEL_SSHD_CONFIG="/etc/ssh/cs193v_sshd_config"
TUNNEL_AUTH_KEYS_DST="/home/student/.ssh/authorized_keys"

NAME="cs193v"
# NAME and IMAGE are not final: CS193V_INSTANCE suffixes both. See "developer
# instance" below.
# Where the student's projects/ directory appears inside the container. Under $HOME rather
# than at the root: the host directory is called projects/, so calling it anything else
# inside is a name mismatch a student has to hold in their head for ten weeks, and a
# top-level /workspaces is not where a Unix user looks for their own files. Defined once —
# the Containerfile's WORKDIR and pre-created directory must match it, which
# 10-static.sh :: launcher:mount-destination-matches-WORKDIR asserts.
MOUNT_DST="/home/student/projects"
# The one image this launcher runs, and the one it builds. There is deliberately no way to
# point it somewhere else -- no flag, no environment variable, no line in container.args.
# .private/Containerfile is the distribution and every student builds it; see
# .config/container.args and README.md's "How the image reaches a student".
IMAGE="localhost/cs193v:local"
# ─── the oldest podman the course works with, per platform ─────────────────────
# TWO FLOORS, and install-cs193v.sh carries the same pair for the same reasons -- the long form
# of the argument lives there. In brief: on Linux the floor decides which DISTROS work, and 4.9.0
# is measured (Ubuntu 24.04 LTS and everything on it, Debian 13 stable, Ubuntu 25.x, Fedora GA);
# on a Mac it decides nothing about distros and lowering it would admit the pre-5.0 `podman
# machine`, which nothing can test. 25-installer.sh asserts both copies agree and that the macOS
# floor is never the lower of the two.
MIN_PODMAN_LINUX="4.9.0"
MIN_PODMAN_MACOS="5.7.0"

# ─── the shared presentation layer ─────────────────────────────────────────────
# Colours, box(), die(), the arrow-key menu, msg(), run_timeout() and the spinner glyphs live
# in .private/files/cs193v-ui.sh, because the CONTAINER needs them too: setup-git, and any
# future setup-*, source the copy the Containerfile installs at /etc/cs193v/ui.sh. One
# definition beats one per script, which is what it was on its way to becoming.
#
# GUARDED, because this is the one dependency the launcher cannot degrade around. A missing
# messages.txt costs a message and msg() says which one; a missing ui.sh costs box(), so die()
# cannot draw the box that would report it. Hence a plain printf, and the only student-facing
# text in this file that is not in messages.txt -- reaching msg() means having read the file
# that is missing.
UI="$PRIVATE/files/cs193v-ui.sh"
if [ ! -r "$UI" ]; then
    printf 'cs193v: cannot read %s\n' "$UI" >&2
    printf 'The course files are incomplete. Please download and unpack them again.\n' >&2
    exit 1
fi
# SCRIPTDIR rather than a bare relative path: shellcheck resolves `source=` against
# the working directory, so `shellcheck -x /path/to/cs193v` from anywhere else would
# stop following this file and report every variable it defines as unused.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=.private/files/cs193v-ui.sh
. "$UI"

# A warning has to be ACKNOWLEDGED, not merely printed. The launcher's last act is
# `exec podman exec -it ... cs193v-shell`, and cs193v-shell attaches tmux, which switches
# the terminal to its alternate screen -- so every line printed beforehand is wiped from
# view before a student has read a word of it. The dev-image advisory, "the tunnel did not
# come up" and "these ports were already in use" were all displayed and none of them was
# readable: the student got a banner, a shell prompt, and no idea why their browser cannot
# reach their server. Issue #19.
#
# So warn() records, and open_shell waits for ENTER before the exec when anything was
# recorded. die() needs nothing of the sort -- it exits, so nothing ever starts tmux, and
# the red box stays on screen. Nor do the verbs: --rebuild, --stop and friends return to
# the student's own shell with their output intact.
#
# The record is a FILE rather than a variable, and the case that forced it has since gone: the
# tunnel used to expand a declared port list inside a command substitution and warn about a
# malformed entry from in there -- a subshell, where an assignment would be discarded on return,
# losing exactly the record that decides whether the student gets a chance to read it. No warn()
# is called from a subshell today.
#
# KEPT AS A FILE ANYWAY, because a variable would buy nothing and cost the property: warn() is
# called from four places now and there is no rule stopping a fifth from being inside `$( )`,
# where the failure would be silent and would look like the warning simply not mattering. $$ stays
# the parent shell's pid inside a subshell, so both halves agree on the path either way.
# macOS sets TMPDIR WITH A TRAILING SLASH, and eleven paths below are built as
# "${TMPDIR:-/tmp}/name" -- so every one of them printed a doubled slash there. POSIX treats
# /a//b as /a/b so nothing broke, but the paths are printed to STUDENTS: `cs193v doctor` and the
# tunnel diagnostic both name the supervisor log, which read
#   /var/folders/zx/ryk5x1bj42v547kwj7shw4k00000gn/T//cs193v-ba58b5c99df0.sup.log
# in the very output a student is told to paste when asking for help. Stripped once, here, rather
# than at each use. Safe by specification: POSIX requires consumers to accept TMPDIR either way.
TMPDIR="${TMPDIR%/}"

WARN_ACK="${TMPDIR:-/tmp}/cs193v-warned.$$"
# Pids are reused, so a file left behind by a crash could otherwise make a launch with
# nothing to say stop and ask to be acknowledged.
rm -f "$WARN_ACK"
# meter_kill, not just rm: an animator left running would draw its next frame over
# whatever came after it -- a STOP box, a shell prompt -- 100ms after the launcher stopped
# caring. See meter_stop.
#
# A named function rather than an inline trap body so the two teardowns that install their own
# handlers can CALL it instead of shadowing it. Bash keeps exactly one EXIT trap, so a second
# `trap ... EXIT` silently drops whatever the first one did -- and both of those handlers run at
# moments when the animator may still be alive.
#
# WAITED FOR after the kill, so that the animator's TERM handler gets to run: it parks the
# cursor below the block, which is what keeps a Ctrl-C during a build from putting the shell
# prompt through the middle of one. Without the wait the prompt races the park and usually wins.
# Bounded by a single frame, and only reached when a meter was actually running.
#
# cursor_show unconditionally, not only when the meter was running: this is the last chance to
# undo cursor_hide, and getting it wrong costs the student an invisible cursor in every command
# they run afterwards. Showing a cursor that was never hidden does nothing. Being in here rather
# than in the trap body is what extends both of those to shell_teardown and rebuild_interrupted
# -- the two handlers above, either of which can fire with a live animator and a hidden cursor.
transient_cleanup() {
    rm -f "$WARN_ACK" "$METER_STATE"
    # run_timeout's scratch files, which only it can name. A Ctrl-C inside a probe -- or inside
    # the three minutes of `podman run` -- otherwise leaves one in TMPDIR per call.
    rt_cleanup
    if [ -n "${METER_PID:-}" ]; then
        kill "$METER_PID" 2>/dev/null
        wait "$METER_PID" 2>/dev/null
    fi
    cursor_show
    :
}
trap transient_cleanup EXIT

warn() {
    printf '%s%s%s\n' "$C_YEL" "$*" "$C_OFF" >&2
    # An unwritable TMPDIR must not turn a warning into a failure: the student still sees
    # the text, they just do not get stopped for it.
    { : >> "$WARN_ACK"; } 2>/dev/null || true
}

# Hold the screen so anything warn() printed survives what comes next. See warn().
acknowledge_warnings() {
    local _ack
    [ -e "$WARN_ACK" ] || return 0
    rm -f "$WARN_ACK"
    # open_shell has already refused a non-terminal stdin, so this cannot normally fire --
    # but a prompt nobody can answer would turn "we printed a warning" into "the launcher
    # hangs", which is a worse bug than the one being fixed.
    [ -t 0 ] || return 0
    printf '\n'
    note "$(msg prompt.acknowledge-warnings)"
    IFS= read -r _ack || true
}

# The build's output box: the last few lines podman printed, under the meter's caption row,
# redrawn three times a second while a build runs (issue #23 left the screen with nothing on it
# that moves on a human timescale during the four minutes when apt, npm and Chromium are the
# ones doing the work).
#
# NOT box(), and not a mode added to it. That one wraps a long line rather than cutting it, is
# as tall as whatever it is handed, and is duplicated verbatim into install-cs193v.sh with
# 20-messages.sh rendering both copies to assert they still match -- so teaching it a
# truncating fixed-height mode would put back the duplication issue #21 removed and would
# change a renderer that 26 messages depend on. The requirements here are the opposite ones:
# the height is fixed by the geometry rather than by the content, because a box that changed
# height between frames would move the rows above it, and for the same reason a long line has
# to be cut rather than allowed to become two rows.
#
# PRINTABLE ASCII ONLY, which is what keeps this cheap enough to run three times a second: with
# no multibyte characters in the body, awk's length() IS the display width and substr() cannot
# slice a character in half, so none of box()'s dw()/dsub() arithmetic is needed here. It costs
# a stray checkmark out of npm; it buys a box that cannot be broken by whatever seven
# third-party tools decide to print into it. The ellipsis is the one exception -- a single
# column, appended after the text has already been cut to fit.
#
# THE ESCAPE SEQUENCES GO FIRST, before the ASCII filter. Their parameters are printable ASCII,
# so filtering first would delete the ESC and leave a literal "[1;32mdone" on the screen.
#
# The apostrophe rule from build_progress applies: this is a single-quoted shell string, so an
# apostrophe in a comment below ENDS it. Write "does not" rather than "doesn t".
meter_tail_box() {                    # -> the whole box, one printf-ready blob, or nothing
    [ "$METER_ROWS" -gt 0 ] || return 0
    # tail -n 40 rather than -n $METER_ROWS: the filter below drops blank lines, commit ids and
    # our own notes, and a burst of those would leave the box half empty if it were fed exactly
    # as many lines as it has rows. tail seeks from the end, so the size of the log is free.
    tail -n 40 "$METER_LOG" 2>/dev/null | LC_ALL=C awk -v rows="$METER_ROWS" \
            -v w="$METER_BOX_W" -v dim="$C_DIM" -v off="$C_OFF" -v esc="$ESC" '
        function rule(n,  s) { s = ""; while (n-- > 0) s = s "━"; return s }
        # Cut to fit or padded to exactly the text field, so every row is the same width as the
        # lid no matter what it holds.
        function body(t,  pad, n) {
            if (length(t) > lim) return substr(t, 1, lim - 1) "…"
            pad = ""; n = lim - length(t); while (n-- > 0) pad = pad " "
            return t pad
        }
        BEGIN { lim = w - 4; k = 0 }
        {
            t = $0
            gsub(esc "\\[[0-9;?]*[A-Za-z]", "", t)     # colour, cursor moves, erases
            gsub(esc ".", "", t)                       # anything else two characters long
            # A self-overwriting progress line arrives as ONE record with carriage returns in
            # it, and only its last segment was ever on a screen.
            n = split(t, seg, "\r")
            if (n > 1) { t = ""; for (i = n; i >= 1; i--) if (seg[i] != "") { t = seg[i]; break } }
            gsub(/\t/, " ", t)                         # a tab has no width inside a box
            gsub(/[^ -~]/, "", t)                      # space through tilde: printable ASCII
            # A BLANK LINE GETS A ROW like any other, rather than being swallowed to save one.
            # podman emits them between some steps, and the box is a window onto the log: a
            # student comparing a row here with the file staff asked them to send should be able
            # to count lines. Consequence worth knowing: a line that was ONLY a colour sequence,
            # or only characters the filter above removes, arrives here empty and now spends a row
            # too. Rare enough in build output to be the honest trade.
            #
            # THE ONE EXCLUSION IS OURS RATHER THAN PODMANS. build_note_fold appends these to the
            # same log while the meter is still running, and they are addressed to staff -- they
            # report that this launcher has lost track of which Containerfile instruction a step
            # is, which is neither something a student can act on nor something podman said.
            #
            # No apostrophe in that sentence, and none anywhere below: this whole awk program is a
            # single-quoted shell string, so one ENDS it. It cost a syntax error to relearn.
            #
            # AND THE BLANK LINE IN FRONT OF IT GOES TOO. The note begins with a newline on
            # purpose -- podman does not always end its last line with one, and without it the
            # note would be glued onto the end of podman output in the log staff read -- so that
            # separator belongs to our text, not to the build. Left in, it is the NEWEST line by
            # the time build_note_fold runs, so the box would end on a blank row and give up a row
            # of real content on every build where the label check fires. Only ever removed when a
            # note line is what follows it, so a blank line podman actually printed is untouched.
            if (t ~ /^cs193v:/) {
                if (k > 0 && keep[k] == "") k--
                next
            }
            # COMMIT IDS ARE NOT DROPPED, and that is a decision rather than an omission. They
            # are 22 of the 134 lines of a warm build and they cost half the window -- with them
            # in, the eight rows reach back to STEP 22 instead of STEP 19 -- but this box is a
            # window onto what podman said, not an edited version of it, and a student comparing
            # it with a log staff asked them to send should find the same lines in both. If it is
            # ever reconsidered, note that podman prints them TWO ways: "--> <hash>" between
            # steps and the finished image id on a line of its own at the end.
            keep[++k] = t
        }
        # Padded out to `rows` even when fewer lines survived, so the height of the box never
        # depends on what the log happened to contain.
        #
        # EVERY GLYPH COMES OUT OF A printf, the same way box() does it, rather than being
        # concatenated into a string first. 20-messages.sh greps both scripts for box characters
        # outside a printf and calls what it finds hand-drawn art -- which is the bug that grew
        # back four times before issue #21, and the rule is worth keeping even though this is a
        # second renderer rather than a fifth copy of the first.
        #
        # The rows go out as one stream separated by \r\n, with no trailing separator: the caller
        # captures the lot and prints it as the tail of a single frame.
        END {
            printf "  %s┏%s┓%s%s[K", dim, rule(w - 2), off, esc
            first = (k > rows ? k - rows + 1 : 1)
            for (i = 0; i < rows; i++) {
                j = first + i
                printf "\r\n  %s┃ %s ┃%s%s[K", dim, body(j <= k ? keep[j] : ""), off, esc
            }
            printf "\r\n  %s┗%s┛%s%s[K", dim, rule(w - 2), off, esc
        }
    '
}

# ─── the progress meter ────────────────────────────────────────────────────────
# One line that moves, shared by everything slow enough to need it.
#
# WHY THIS IS A BACKGROUND PROCESS AND NOT JUST A printf. The bar advances when podman
# finishes a step, and the slow steps -- Playwright, Chromium, the apt layers -- hold a
# single frame for minutes. Drawing only on step boundaries therefore means a meter that
# sits perfectly still for minutes, which reads as a hang: exactly the impression this
# feature exists to remove. Something has to redraw while nothing is happening.
#
# It cannot be done in the reader. build_progress is an awk blocked on `read` between STEP
# lines -- no code of ours runs while it waits, so it cannot animate. So the reader only
# records state and an animator owns the line, ten frames a second, until it is told to stop.
#
# The two halves meet through a FILE rather than a variable because the animator is a
# background subshell: an assignment in either one is invisible to the other. Written whole
# on every update and re-read on every frame, so a torn read costs one frame and fixes
# itself 100ms later rather than corrupting anything.
METER_W=40

meter_write() {                       # meter_write CUR TOTAL RETRY LABEL
    printf '%s %s %s %s\n' "$1" "$2" "${3:--}" "$4" > "$METER_STATE" 2>/dev/null || true
}

# TWO ROWS, and the second one is why there are cursor moves in here at all. Everything the
# meter has to say no longer fits on one line: 40 cells of bar, a count, a step name and a
# retry marker come to about 105 columns, and a wrapped line breaks \r redrawing outright --
# the bar smears across two rows and never recovers. Splitting it puts the fixed-width
# furniture on one row and the prose on another, and leaves room to say more later.
#
# Row 1:  <glyph> [####....]  7/24                    (retrying: 1/2)
# Row 2:       Installing the Vercel CLI...
# Rows 3+:     a box holding the last few lines podman printed. See meter_tail_box.
#
# The marker is right-aligned at the terminal edge, so it is beside the block rather than
# jostling the label whose length changes at every step.
METER_W=40
METER_COLS=80
METER_LINES=24

# The output box, in body rows and display columns. Zero rows means no box at all, which is
# what a short or narrow terminal, a non-terminal stdout and every caller other than the build
# gets -- the block is then exactly the two rows it was before.
#
# EIGHT ROWS, so the whole block is twelve: half of a default 80x24 terminal, which leaves a
# dozen rows of what came before it still readable, and visibly less than the `tail -n 12` the
# STOP box shows if the build then fails. Eight lines is also enough to hold a coherent chunk
# of apt or npm output rather than a strobing single line.
METER_ROWS_MAX=8
METER_ROWS=0
METER_BOX_W=0
METER_H=2
# The file the box tails, set by meter_start. Empty for every meter that is not a build.
METER_LOG=''
# Which row of the block the cursor is on, 0 before anything is drawn. The whole block is
# addressed relative to this, so it is the one piece of state a frame needs from the last one.
METER_ROW=0

# Row 1 is 52 columns of furniture, so a full-width bar plus a 17-column marker fits an
# 80-column terminal with room to spare and nothing shrinks there. Below that the BAR gives
# way rather than the words: a count and a step name a student can read out to staff are
# worth more than the last ten cells of a bar.
#
# THE BOX SHRINKS RATHER THAN WRAPS, and it stops three columns short of BOX_W's own width
# rather than two: a box drawn to the last cell of a row leaves some terminals holding a
# pending wrap, and the next frame's cursor move would then land a row low and smear the block
# permanently. Same reason meter_mark stops one short. Below 44 columns there is no useful text
# field left, and below twelve lines the block would be the whole screen, so the box goes and
# the two rows carry on alone.
meter_fit() {
    METER_COLS="$(tput cols 2>/dev/null || printf '%s' "${COLUMNS:-80}")"
    case "$METER_COLS" in ''|*[!0-9]*) METER_COLS=80 ;; esac
    METER_LINES="$(tput lines 2>/dev/null || printf '%s' "${LINES:-24}")"
    case "$METER_LINES" in ''|*[!0-9]*) METER_LINES=24 ;; esac
    METER_W=40
    if [ "$METER_COLS" -lt 72 ]; then
        METER_W=$(( METER_COLS - 32 ))
        [ "$METER_W" -lt 10 ] && METER_W=10
    fi
    METER_ROWS=0
    METER_BOX_W=$(( METER_COLS - 3 ))
    [ "$METER_BOX_W" -gt "$BOX_W" ] && METER_BOX_W="$BOX_W"
    if [ -n "$METER_LOG" ] && [ "$METER_BOX_W" -ge 44 ]; then
        METER_ROWS=$(( METER_LINES - 8 ))
        [ "$METER_ROWS" -gt "$METER_ROWS_MAX" ] && METER_ROWS="$METER_ROWS_MAX"
        [ "$METER_ROWS" -lt 4 ] && METER_ROWS=0
    fi
    # How tall the block is: the two rows, plus a lid and a floor around any body rows. Every
    # relative cursor move in the meter is derived from this and METER_ROW, so the formula lives
    # here once rather than at each of the places that step through the block.
    METER_H=2
    [ "$METER_ROWS" -gt 0 ] && METER_H=$(( METER_ROWS + 4 ))
    return 0
}

meter_bar() {                         # meter_bar CUR TOTAL -> [████░░░░]
    local cur="$1" tot="$2" filled n bar='' pad=''
    filled=$(( METER_W * cur / tot ))
    [ "$filled" -gt "$METER_W" ] && filled="$METER_W"
    [ "$filled" -lt 0 ] && filled=0
    # BRACED, and load-bearing rather than style -- this is issue #120. Bash 3.2, which is every
    # Mac, is not multibyte-aware when it decides where a variable name ends, so under a UTF-8
    # locale `"$bar█"` parses the block's leading byte as part of the NAME and dies with
    # `bar<byte>: unbound variable` under set -u. The student sees that line once per frame of the
    # build meter and no progress bar at all. Measured: fine under LC_ALL=C, fatal under
    # en_US.UTF-8, which is the default.
    n="$filled";                  while [ "$n" -gt 0 ]; do bar="${bar}█"; n=$((n - 1)); done
    n=$(( METER_W - filled ));    while [ "$n" -gt 0 ]; do pad="${pad}░"; n=$((n - 1)); done
    printf '[%s%s]' "$bar" "$pad"
}

# The retry marker, right-aligned against the terminal edge. Padded rather than positioned
# with ESC[<col>G, and the width is COMPUTED rather than measured: row 1 holds multibyte
# glyphs and possibly a colour escape, so ${#row} would count neither in screen columns.
meter_mark() {                        # meter_mark RETRY W1 -> padding + (retrying: n/m)
    local retry="$1" w1="$2" mark n pad=''
    [ -n "$retry" ] && [ "$retry" != '-' ] || return 0
    mark="(retrying: $retry)"
    # One column short of the edge on purpose: writing the last cell makes some terminals
    # set a pending wrap, and a wrapped row 1 would put the cursor move on the wrong line.
    n=$(( METER_COLS - w1 - ${#mark} - 1 ))
    [ "$n" -lt 2 ] && n=2
    while [ "$n" -gt 0 ]; do pad="$pad "; n=$((n - 1)); done
    printf '%s%s' "$pad" "$mark"
}

# One frame, the whole block. METER_ROW says which row the cursor is resting on, so a frame
# begins by stepping back up to row 1 -- and a METER_ROW of 0 opens the block by drawing it
# rather than by redrawing over it, which is what the first frame does.
#
# RELATIVE MOVES AND A PLAIN \n, never absolute positioning. When the block sits at the
# bottom of the screen the terminal scrolls, and every row travels up together -- absolute
# coordinates would keep pointing at where the block used to be.
#
# IT ENDS WITH ESC[J, erasing whatever is below the last row. That is what makes the region
# self-healing: a resize that shrinks the box, and the closing frame that draws none at all,
# would otherwise leave the rows it used to occupy stranded underneath. Nothing below the block
# is ever lost to it, because the block is the last thing printed until it is finished with.
#
# METER_ROW is updated AFTER each write rather than once at the end, because bash defers a trap
# until the current builtin has finished -- so the TERM handler in meter_animate always sees
# where the cursor really is. The box goes out as a single printf, so a signal arriving inside
# that one write is the only case it can be wrong about, and then only about how far down to
# park a cursor nobody is reading.
meter_draw() {                        # meter_draw FRAME CUR TOTAL RETRY LABEL [BOX]
    local frame="$1" cur="$2" tot="$3" retry="$4" label="$5" boxblob="${6:-}"
    local g count w1
    g="$(meter_glyph "$frame")"
    [ "$METER_ROW" -gt 1 ] && printf '\r%s[%dA' "$ESC" $(( METER_ROW - 1 ))
    if [ "${tot:-0}" -gt 0 ] 2>/dev/null; then
        count="$cur/$tot"
        # 2 indent + glyph + space + bracketed bar + 2 + the count.
        w1=$(( 8 + METER_W + ${#count} ))
        printf '\r  %s %s  %s%s%s[K' "$g" "$(meter_bar "$cur" "$tot")" "$count" \
               "$(meter_mark "$retry" "$w1")" "$ESC"
    else
        printf '\r  %s%s%s[K' "$g" "$(meter_mark "$retry" 3)" "$ESC"
    fi
    METER_ROW=1
    # Indented to sit under the bar rather than under the glyph, so the moving cell stays the
    # leftmost thing in the block and the words line up with what they describe.
    printf '\r\n     %s%s[K' "$label" "$ESC"
    METER_ROW=2
    # Already a blob of complete rows, separated the same way these two are. Empty whenever
    # there is no box -- a short terminal, a narrow one, or any meter that is not a build.
    if [ -n "$boxblob" ]; then
        printf '\r\n%s' "$boxblob"
        METER_ROW="$METER_H"
    fi
    printf '%s[J' "$ESC"
}

# Where the cursor is parked when the block is being abandoned mid-flight rather than finished:
# just below it, so that a shell prompt lands under an intact block instead of through the
# middle of one. Only Ctrl-C arrives here, by way of the EXIT trap killing the animator; before
# this the prompt landed on whichever row the last frame happened to stop on, which was survivable
# while the block was two rows tall and is not now.
meter_park() {
    local n=$(( METER_H - METER_ROW ))
    # Skipped rather than emitted with a zero: ESC[0B moves down a row on most terminals rather
    # than nowhere at all.
    [ "$n" -gt 0 ] && printf '\r%s[%dB' "$ESC" "$n"
    printf '\r\n'
}

# The animator. Stops when the state file goes away, which is how meter_stop ends it without
# depending on a signal arriving.
#
# ON THE WAY OUT IT LEAVES THE CURSOR ON ROW 1. That is meter_stop's precondition, and it is
# what lets the parent shell stop knowing how tall the block is -- which it cannot know: the
# height comes from the terminal size, WINCH is handled here, and the parent is blocked inside
# podman for the whole four minutes during which a student might resize the window.
#
# THE BOX IS REFRESHED EVERY THIRD FRAME, not every frame. The spinner has to move at 10 Hz to
# read as motion, but eight lines of log replaced ten times a second read as a blur rather than
# as text, and every refresh is a tail and an awk. Three a second is legible and nearly free.
meter_animate() {
    local i=0 t=0 cur tot retry label box=''
    # A resize changes where the marker belongs, how wide the bar and the box may be, and how
    # many rows the box may have. Re-measured on the signal rather than once per frame, which
    # would fork tput ten times a second for an event that happens approximately never. The box
    # is re-rendered in the handler too, so its width can never lag the geometry it is drawn to.
    trap 'meter_fit; box="$(meter_tail_box)"' WINCH
    trap 'meter_park; exit 0' TERM
    while [ -f "$METER_STATE" ]; do
        cur=''; tot=''; retry=''; label=''
        IFS=' ' read -r cur tot retry label < "$METER_STATE" 2>/dev/null || true
        [ "$(( t % 3 ))" -eq 0 ] && box="$(meter_tail_box)"
        meter_draw "$i" "${cur:-0}" "${tot:-0}" "${retry:--}" "${label:-}" "$box"
        i=$(( (i + 1) % 8 )); t=$(( t + 1 ))
        sleep 0.1
    done
    [ "$METER_ROW" -gt 1 ] && printf '\r%s[%dA' "$ESC" $(( METER_ROW - 1 ))
    printf '\r'
}

# Nothing animates when stdout is not a terminal: \r cannot overdraw a pipe or a log file,
# and ten frames a second of it would be thousands of columns of noise in the file staff ask
# a student to send. Callers print plainly in that case.
# THE FIRST FRAME IS DRAWN HERE, in the foreground, before the animator exists. Every later
# frame begins by moving the cursor up a row, so the two rows have to be on the screen before
# anything can redraw them -- and if the animator owned the opening frame, a meter_stop that
# arrived before its first tick would step up into whatever was printed above and overwrite
# it. Drawing it synchronously makes that race impossible rather than unlikely.
meter_start() {                       # meter_start TOTAL LABEL [LOG]
    [ -t 1 ] || return 0
    # Set before meter_fit, which only looks for room for a box when there is something to put
    # in it, and before the fork, so that the animator inherits it. Every caller but the build
    # leaves it empty and gets the two-row block unchanged.
    METER_LOG="${3:-}"
    meter_fit
    METER_ROW=0
    cursor_hide
    meter_write "0" "${1:-0}" '-' "${2:-}"
    # NO BOX ON THE OPENING FRAME. The log does not exist yet at this point -- build_image has
    # just removed it and tee has not created it -- so there is nothing to put in one. The
    # animator adds it a tenth of a second later and the block grows by ten rows, which needs no
    # special handling because every move a frame makes is relative to where the cursor is.
    meter_draw 0 0 "${1:-0}" '-' "${2:-}"
    meter_animate &
    METER_PID=$!
}

meter_label() {                       # meter_label CUR TOTAL LABEL  -- update in place
    [ -n "$METER_PID" ] || return 0
    # No retry: the only caller is the container-creation step, which is reached solely after
    # a build has succeeded, so a marker still standing there would be describing the past.
    meter_write "$1" "$2" '-' "$3"
}

# Leaves the block finished rather than mid-frame. The outcome is required, because the glyph
# column is the one place that says which way it went and a spinner frame left in it reads as
# a build still running.
#
# SUCCESS COLLAPSES THE BLOCK to its one finished line: the caption row is erased and the
# cursor left on it, so the next thing printed starts on a clean row. FAILURE KEEPS BOTH
# ROWS, because the caption names the step that failed and it belongs directly above the STOP
# box -- and the bar stays where it stopped. Filling it to tot/tot, which this used to do,
# drew a completed build immediately above the words "the build failed".
#
# THE OUTPUT BOX GOES ON BOTH PATHS. It is scaffolding for a build that is happening, and by
# here one is not: on success the block collapses past it to a single line, and on failure the
# same lines are about to be repeated inside the STOP box, wrapped rather than cut and with the
# rest of the log behind them. Two boxes saying nearly the same thing is worse than one.
meter_stop() {                        # meter_stop ok|bad [CUR TOTAL LABEL]
    [ -n "$METER_PID" ] || return 0
    local outcome="$1"; shift
    local cur='' tot='' retry='' label=''
    [ -f "$METER_STATE" ] && IFS=' ' read -r cur tot retry label < "$METER_STATE" 2>/dev/null
    rm -f "$METER_STATE"
    # WAITED FOR, NOT KILLED. The animator leaves its loop when the state file goes -- that is
    # what the loop condition is for -- and on the way out it puts the cursor on row 1, which is
    # what the drawing below assumes. Killing it instead left the cursor wherever that frame had
    # reached, and the ESC[1A that used to be here assumed it was the end of row 2: a one-row
    # error when it was wrong, which was survivable while the block was two rows tall and is an
    # eleven-row one now. Costs at most one frame, 100 ms.
    wait "$METER_PID" 2>/dev/null || true
    METER_PID=''
    METER_ROW=1
    if [ "$#" -ge 2 ]; then cur="$1"; tot="$2"; label="${3:-$label}"; fi
    cur="${cur:-0}"; tot="${tot:-0}"
    # Before the final frame, not after: whatever the caller prints next -- a STOP box, a
    # success box, a shell -- must have the cursor back, and on the failure path the very next
    # thing is a die() that never returns here.
    cursor_show
    if [ "$outcome" = bad ]; then
        # Drawn with no box, and meter_draw ends with ESC[J -- which is what takes the live one
        # off the screen ahead of the STOP box.
        meter_draw bad "$cur" "$tot" '-' "$label"
        printf '\n'
        return 0
    fi
    if [ "$tot" -gt 0 ] 2>/dev/null; then
        printf '\r  %s %s  %s/%s  %s%s[K' "$(meter_glyph ok)" "$(meter_bar "$cur" "$tot")" \
               "$cur" "$tot" "$label" "$ESC"
    else
        printf '\r  %s  %s%s[K' "$(meter_glyph ok)" "$label" "$ESC"
    fi
    # ESC[J rather than ESC[K, and it does both jobs: it erases the caption row from the cursor
    # onwards AND every row below, which is where the box was. The cursor is left on the blank
    # caption row, so whatever prints next -- the success box, a shell -- starts on a clean row.
    printf '\r\n%s[J' "$ESC"
}

# ─── reading the Containerfile's steps ─────────────────────────────────────────
# Where the meter's side text comes from. Each `####> text` line in the Containerfile labels
# the instruction below it and every instruction after that until the next marker, so ~13
# markers name all 23 steps.
#
# WHY THE LAUNCHER PARSES THE FILE AT ALL, rather than reading the labels out of the build
# output: podman does not emit comments. A real build log is `STEP`, `--> Using cache`, `-->`
# and `COMMIT`, nothing else, so a marker cannot reach us through the stream. Nor can an
# `echo` inside a RUN -- a cache hit prints `--> Using cache` and never runs the command, so
# the labels would vanish on exactly the warm builds and retries where a student is most
# likely to be watching.
#
# ONE PARSER, TWO CALLERS. This is awk source shared by build_progress, which needs the table
# in-process to label each step as it arrives, and by --dev-steps, which prints it for the
# tests and for the release gate to diff against real podman. Duplicating it is how the two
# would come to disagree about a continuation line, and a parse that disagrees with podman
# silently names the wrong step for the rest of a build.
#
# COUNTING RULE, which is podman's: one instruction per line that is not blank, not a comment
# and not the continuation of the line above. Comments are stripped BEFORE continuations are
# joined, so a `#` line in the middle of a continued RUN does not end it. A line ending in a
# backslash continues; a backslash followed by a space does not, which is why 10-static.sh
# forbids that and heredocs, whose body lines this would miscount as instructions.
#
# The apostrophe rule from build_progress applies here too -- single-quoted shell string.
CF_PARSE_AWK='
function cf_squeeze(s) {              # podman-insensitive form: whitespace runs -> one space
    gsub(/[ \t]+/, " ", s)
    sub(/^ /, "", s); sub(/ $/, "", s)
    return s
}
# cf_parse(FILE, label, text) -> instruction count, filling label[i] and text[i] 1-based.
function cf_parse(f, label, text,   line, sticky, n, cont, buf) {
    sticky = ""; n = 0; cont = 0; buf = ""
    while ((getline line < f) > 0) {
        sub(/\r$/, "", line)          # a Windows checkout must parse the same as a Unix one
        if (line ~ /^[ \t]*####>/) {
            # Inside a continuation this is just a comment, the same as podman sees it.
            if (!cont) {
                sticky = line
                sub(/^[ \t]*####>[ \t]*/, "", sticky)
                sub(/[ \t]+$/, "", sticky)
            }
            continue
        }
        if (line ~ /^[ \t]*#/) continue
        if (cont) {
            buf = buf line
            cont = (line ~ /\\$/)
            if (cont) sub(/\\$/, "", buf)
            else      text[n] = cf_squeeze(buf)
            continue
        }
        if (line ~ /^[ \t]*$/) continue
        n++
        label[n] = sticky
        buf = line
        cont = (line ~ /\\$/)
        if (cont) sub(/\\$/, "", buf)
        else      text[n] = cf_squeeze(buf)
    }
    close(f)
    # A file that ends mid-continuation still has to yield the text it did read, or the last
    # instruction would compare as empty against podman and blank the labels.
    if (cont) text[n] = cf_squeeze(buf)
    return n
}
'

# ─── the build's progress bar ──────────────────────────────────────────────────
# Turns `podman build`'s output into one line that moves (issue #23). What it replaces was
# not a design decision anybody made -- it was podman's stdout, and on a cold build that is
# thousands of lines of echoed shell, of which the parts a student can act on are none.
# Even a fully cached build printed 76.
#
# THE OUTPUT IS NOT DISCARDED. It is teed to $BUILD_LOG first and this reads the same
# stream, so a failure is still diagnosable from podman's own words -- and since those words
# are no longer on the screen, err.build-failed now carries the tail of that log INSIDE the
# STOP box. Hiding the output without that change would have made the launcher tell a stuck
# student to read something that is not there.
#
# `STEP i/N:` is podman's own numbering, so the total that the bar COMMITS to comes from
# podman rather than from a count of Containerfile lines that would drift the moment one is
# added. The Containerfile count is used before that, as a provisional total, for the one
# stretch where podman has said nothing yet: the base-image download, which is step 1 and the
# slowest part of a cold install. Podman overrides it at STEP 1, so the worst a miscount can
# do is show a wrong denominator during the download and then correct itself.
#
# NOT A TERMINAL -> no carriage returns, one line per step. A \r-redrawn bar in a CI log or
# a `| tee build.txt` is an unreadable single line thousands of columns long, and this is
# the exact path a student uses when staff ask them to send the output.
build_progress() {                    # build_progress [RETRY] [FLOOR]
    local tty=0
    [ -t 1 ] && tty=1
    LC_ALL=C awk -v tty="$tty" -v esc="$ESC" -v statef="$METER_STATE" \
            -v cf="$CONTAINERFILE" -v notef="$BUILD_NOTE" \
            -v retry="${1:--}" -v floor="${2:-0}" -v injected=1 "$CF_PARSE_AWK"'
        function rep(s, n,  o) { o = ""; while (n-- > 0) o = o s; return o }
        # On a terminal this RECORDS rather than draws: meter_animate owns the line, so that
        # it keeps moving between steps instead of freezing for the length of one. close()
        # after every write, not fflush -- awk appends to an open handle, so without the
        # close the file would grow and the animator would keep reading the first, stalest
        # line forever.
        #
        # RETRY IS THE THIRD FIELD, ahead of the label, because the reader is a shell
        # `read -r cur tot retry label` and the last variable is the one that collects the
        # rest of the line -- so the label, which has spaces, has to be last. It is never
        # empty for the same reason: a bare "-" holds the column when there is no retry.
        function state(c, t, r, l) {
            printf "%d %d %s %s\n", c, t, r, l > statef
            close(statef)
        }
        function draw(  filled, mark) {
            if (tot <= 0) return
            if (tty) { state(cur, tot, retry, label); return }
            filled = int(width * cur / tot + 0.5)
            mark = (retry == "-" ? "" : "  (retrying: " retry ")")
            printf "  [%s%s]  %d/%d  %s%s\n", rep("█", filled), rep("░", width - filled),
                                              cur, tot, label, mark
            fflush()
        }
        BEGIN {
            width = 40; cur = 0; tot = 0; pulled = 0; label = ""
            ninstr = cf_parse(cf, cflabel, cftext)
            labels_ok = (ninstr > 0)
            # THE BAR EXISTS FROM THE FIRST FRAME, which is the whole reason the parse
            # happens. podman announces its own step count only after the download, so a
            # total taken from podman alone leaves the longest phase of a cold install with
            # no bar -- which is what this replaced. Plus injected for the LABEL step podman
            # synthesizes from our own --label flag, plus one for creating the container.
            #
            # THIS IS THE ONE LABEL SHOWN BEFORE PODMAN CONFIRMS ANYTHING, and it cannot be
            # otherwise: naming the download means naming it while podman is still silent.
            # If the parse turns out to be wrong, the check below takes every label away at
            # the first STEP line -- so the exposure is bounded by the download itself.
            #
            # STARTS AT floor ON A RETRY, not at 1. This runs again for every attempt, and an
            # opening frame of "1/24, downloading the base image" would rewind the bar and
            # rename the step for the few milliseconds before the first STEP line arrives --
            # brief, but it is the exact impression holding the bar at floor exists to avoid.
            if (tty && ninstr > 0) {
                cur = (floor > 1 ? floor : 1)
                tot = ninstr + injected + 1
                label = cflabel[cur > ninstr ? ninstr : cur]
                state(cur, tot, retry, label)
            }
        }
        # Pulling the base image happens during step 1 -- podman resolves FROM by pulling,
        # and prints this chatter before it prints STEP 1 -- so the label is already right
        # and there is nothing to do here but keep it to ONE note. podman emits a line per
        # layer per percentage otherwise.
        #
        # ON A TERMINAL THERE IS NOTHING TO PRINT AT ALL now: the meter is already showing
        # step 1 of N with this label beside it. Piped, there is no meter and no other output
        # until STEP 1 lands minutes later, so the note stays a plain line there.
        /^(Trying to pull|Getting image source signatures|Copying blob|Copying config)/ {
            if (!pulled) {
                pulled = 1
                if (!tty && label != "") { printf "  %s\n", label; fflush() }
            }
            next
        }
        /^STEP [0-9]+\/[0-9]+:/ {
            s = $2; sub(/:$/, "", s); split(s, a, "/")
            # PLUS ONE on a terminal: creating the container is the slowest single step of a
            # build, so it is step n+1 rather than an unmetered wait after the bar completes
            # (issue #24). Piped, there is no meter, so the count stays what podman reported.
            #
            # NOTE FOR THE NEXT EDITOR: this whole awk program is inside a single-quoted
            # shell string, so an apostrophe in a comment here ENDS it and the launcher stops
            # parsing. Write "does not" rather than "doesn t".
            n = a[1] + 0; tot = a[2] + (tty ? 1 : 0)
            # THE BAR DOES NOT GO BACKWARDS ON A RETRY. A retried build re-runs from step 1
            # and replays every completed step from the layer cache in about a second, so the
            # honest reading is not "we lost that progress" -- the work is done and on disk --
            # it is "we are having another go at the step that failed". floor is that step.
            cur = (n > floor ? n : floor)
            # And the marker goes once the retry has served its purpose.
            if (n > floor) retry = "-"
            # THE LABEL IS ONLY SHOWN WHEN PODMAN CONFIRMS THE STEP. podman echoes the
            # instruction on this line, so the mapping is checkable rather than merely
            # believed: if what it echoes is not the instruction we think step n is, our
            # parse of the Containerfile has drifted and every label after this one would
            # name the wrong thing. A missing label is unhelpful; a wrong one is a lie.
            #
            # Steps past ninstr are skipped, not failed: the last one is the LABEL podman
            # synthesizes from --label, which has no line in the file to match, so checking
            # it would blank the labels on every build there has ever been.
            if (labels_ok && n <= ninstr) {
                got = cf_squeeze(substr($0, index($0, ": ") + 2))
                if (got != cftext[n]) {
                    labels_ok = 0
                    # Leading newline: podman does not always end its last line with one, and
                    # this gets appended to that log rather than to a fresh file.
                    printf "\ncs193v: step %d is not the instruction the launcher parsed, so the\n", n >> notef
                    printf "cs193v: progress labels were switched off for the rest of this build.\n" >> notef
                    printf "cs193v:   podman: %s\n", got       >> notef
                    printf "cs193v:   parsed: %s\n", cftext[n] >> notef
                    close(notef)
                }
            }
            label = ""
            if (labels_ok) label = cflabel[cur > ninstr ? ninstr : cur]
            draw()
            next
        }
        # No newline here on a terminal: meter_stop owns ending the line, because the meter
        # outlives this awk -- the container-creation step is still to come.
        END { fflush() }
    '
}

# ─── podman probes ─────────────────────────────────────────────────────────────
# Everything podman goes through run_timeout, which lives in cs193v-ui.sh. The reason is
# specific to podman rather than general caution: after a Mac wakes from sleep, `podman info`
# HANGS rather than failing (containers/podman#21675), and an unguarded probe makes the
# launcher look frozen with no output at all.
pm()  { run_timeout 20 podman "$@"; }     # a podman call that should be quick
pmq() { run_timeout 20 podman "$@" >/dev/null 2>&1; }

# ─── small utilities ───────────────────────────────────────────────────────────
sha_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
    else shasum -a 256 | awk '{print $1}'; fi
}

# podman forces TERM=xterm and does not copy the client's value
# (containers/podman#25683), which costs 256-colour support. But the image has a limited
# terminfo set, so forwarding an exotic TERM verbatim would leave a full-screen editor
# unable to start. Whitelist, and fall back to a safe 256-colour entry.
safe_term() {
    case "${TERM:-}" in
        xterm|xterm-256color|xterm-color|screen|screen-256color|tmux|tmux-256color|\
        vt100|vt220|linux|ansi|dumb|rxvt|rxvt-unicode-256color)
            printf '%s' "$TERM" ;;
        '') printf 'xterm-256color' ;;
        *)  printf 'xterm-256color' ;;    # kitty, ghostty, alacritty, wezterm, foot...
    esac
}

platform() {
    case "$(uname -s)" in
        Darwin) printf 'macos' ;;
        Linux)  if grep -qi microsoft /proc/version 2>/dev/null; then printf 'wsl'
                else printf 'linux'; fi ;;
        *)      printf 'other' ;;
    esac
}

min_podman() {                        # min_podman -> the floor for THIS platform
    case "$(platform)" in
        macos) printf '%s' "$MIN_PODMAN_MACOS" ;;
        *)     printf '%s' "$MIN_PODMAN_LINUX" ;;
    esac
}

has_machine() {                       # is a podman machine in play (macOS)?
    [ "$(platform)" = macos ] || return 1
    pmq machine list --format '{{.Name}}'
}

# ─── developer instance ────────────────────────────────────────────────────────
# CS193V_INSTANCE gives one computer several INDEPENDENT installations. It suffixes the
# container name, the dev image tag and all six volume names TOGETHER, which is the point:
# suffixing only some of them is worse than suffixing none, because `--rebuild --logout` in one
# instance would still destroy the other instance's logins.
#
# This exists because two people developing the container on the same machine otherwise
# share every one of them silently: the container `cs193v`, the image `localhost/cs193v:local`,
# and the volumes cs193v-claude and friends. The failure is not a clean collision but a slow
# one — whoever runs `--rebuild` last owns the container the other is about to shell into.
#
# A student never sets it. With it unset every name is byte-identical to what it was
# before, which is what keeps this from being a behaviour change for anyone but us.
#
# Deliberately NOT suffixed: MOUNT_DST, the workspace path, and the cs193v.dir label.
# Those are already per-directory, and ensure_container's owner-dir check keys off
# cs193v.dir, so two checkouts are distinguishable even with no instance set.
INSTANCE="${CS193V_INSTANCE:-}"
case "$INSTANCE" in
    '') : ;;
    # Anything outside this set would produce an invalid container or volume name, and
    # podman's own error for that names neither CS193V_INSTANCE nor this script. A literal
    # string rather than a messages.txt key, matching CS193V_BUILD_RAW: that catalogue is for
    # student-facing prose, and no student ever sets this.
    *[!A-Za-z0-9_-]*)
        die "CS193V_INSTANCE=$INSTANCE is not usable as a name.
Use only letters, digits, hyphens and underscores." ;;
    *)  NAME="$NAME-$INSTANCE"
        IMAGE="$IMAGE-$INSTANCE" ;;
esac

# ─── the tunnel's runtime paths ────────────────────────────────────────────────
# In TMPDIR, not .config/, for two reasons. A unix socket path is capped near 104 bytes on
# macOS and 108 on Linux, and this launcher already expects deep course directories with
# spaces in them (see the cs193v.dir label) -- so a socket under $DIR could simply be too
# long to bind. And these are per-boot runtime state, not configuration: leaving a stale
# socket in the student's course directory would be clutter that outlives its meaning.
#
# Keyed by a hash of $DIR so two checkouts never share a socket even with no instance set,
# which matters because the control socket IS the tunnel's identity for -O check/exit.
# run_timeout already uses ${TMPDIR:-/tmp}, so this is an existing idiom rather than a new
# assumption about the platform.
TUNNEL_ID="$(printf '%s\n' "$DIR" "$INSTANCE" | sha_stdin | cut -c1-12)"
# The build's output, teed here so a failure can be classified from podman's own words --
# see build_image. Keyed by TUNNEL_ID like the tunnel's files, so two instances on one
# machine do not overwrite each other's, and overwritten rather than appended so it cannot
# grow without bound. Not cleaned up on exit deliberately: after a failed build it is the
# thing to ask a student for, and the next build truncates it anyway.
BUILD_LOG="${TMPDIR:-/tmp}/cs193v-build-$TUNNEL_ID.log"
# Anything build_progress needs to tell staff rather than the student -- currently only a
# label/instruction mismatch. A SEPARATE FILE, folded into $BUILD_LOG once podman has
# finished, rather than appended to it directly: tee holds that file open at its own offset
# and does not use O_APPEND, so a concurrent append from awk would be overwritten by tee's
# next write. It cannot go to the screen either, on a terminal that belongs to the meter.
BUILD_NOTE="$BUILD_LOG.note"
# Set CS193V_BUILD_RAW=1 for podman's raw output instead of build_progress. Staff only, and it
# earns its keep on a build that HANGS -- the one failure $BUILD_LOG cannot be read for
# afterwards, because a bar shows nothing and the log is never written.
BUILD_RAW="${CS193V_BUILD_RAW:-}"
# Set by build_image on success, read by verb_rebuild: only a run that really built celebrates.
BUILT=''
# Where the progress meter's reader and its animator meet. Keyed by TUNNEL_ID like the rest,
# so two instances on one machine do not redraw each other's bar. See meter_start.
METER_STATE="${TMPDIR:-/tmp}/cs193v-meter-$TUNNEL_ID"
METER_PID=''
TUNNEL_CTL="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.ctl"
TUNNEL_PID="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.pid"
TUNNEL_LOG="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.log"
# The port supervisor: the bash loop that reads frames from the watcher inside the container and
# asks the master to open and close forwards. Keyed by the same TUNNEL_ID as everything above, so
# two instances on one machine never touch each other's.
#
# PIDFILE, not PID: the variable holds a PATH. ($TUNNEL_PID above is the same shape and the older
# name; the test suite already spells its own copy FWD_PIDFILE.)
TUNNEL_SUP_PIDFILE="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.sup.pid"
TUNNEL_SUP_LOG="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.sup.log"
# Written by the supervisor once the watcher's handshake has been ACCEPTED, which is a different
# moment from "the process started" -- the pidfile is written on entry so a stop always has
# something to kill, so it cannot also mean "this thing works".
TUNNEL_SUP_READY="${TMPDIR:-/tmp}/cs193v-$TUNNEL_ID.sup.ready"
# Ticks, not seconds, for everything the supervisor counts -- see the loop for why.
TUNNEL_SUP_LINGER=5
TUNNEL_SUP_COOLDOWN=30
TUNNEL_SUP_SILENCE=5
TUNNEL_SUP_SILENCE_MAX=6

# ─── argument files ────────────────────────────────────────────────────────────
ARGS=()
load_args() {
    local f line word
    ARGS=()
    [ -f "$ARGS_FILE" ] || die "$(msg err.no-args-file FILE="$ARGS_FILE")"
    for f in "$ARGS_FILE" "$LOCAL_ARGS_FILE"; do
        [ -f "$f" ] || continue
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%%#*}"
            # NOTHING LEFT BUT WHITESPACE -> there is no argument on this line. Asked HERE,
            # ahead of the trim, because the trim is a subshell and a sed: container.args is
            # 239 lines of which 228 are a comment or blank, and paying that for each of them
            # cost ~700ms of the launcher's ~1.8s startup. Issue #57, measured with
            # `strace -e trace=execve` -- 239 sed execs per launch, now 11.
            #
            # A WHITESPACE TEST RATHER THAN `[ -z ]`, and the difference is not style. `[ -z ]`
            # moved up here skips only the already-empty lines, so it holds only while the
            # comments start in column 1: indent that 228-line block and every line is
            # whitespace-rather-than-empty and all 239 seds come back. This asks the question
            # the code actually means, so the answer does not depend on how the file is laid out.
            #
            # THE TRIM STAYS, and here is the trap for whoever next tries to replace it with
            # parameter expansion. Default IFS is space, tab and newline ONLY, so \r, \v and \f
            # are NOT field separators -- the sed is what takes the \r off every line of a CRLF
            # local.args, and an untrimmed "\r" line splits into ONE field, a bare \r, which
            # then reaches the podman run line. A bash trim has to cover [[:space:]], not just
            # space and tab. See VERIFICATION.md §1.3: a POSIX class in a `case` bracket has to be
            # cleared on a real bash 3.2 by hand, because A.1's grep cannot see it.
            #
            # This also retires the `[ -z "$line" ] && continue` that used to sit below the trim:
            # every line reaching it now holds a non-whitespace character, so the trim cannot
            # return empty and the test could never fire.
            case "$line" in *[![:space:]]*) ;; *) continue ;; esac
            # trim both ends without bash 4 features
            # LC_ALL=C, like the four awk calls elsewhere in this file. container.args is the
            # one file a STUDENT edits, and BSD sed under a UTF-8 locale rejects a non-UTF-8
            # byte with "RE error: illegal byte sequence" and emits NOTHING for that line -- so
            # `--label caf<e9>=1` written by a Latin-1 editor vanished silently, which is the
            # exact failure 16-args-parse.sh:163 says must not happen. Per-invocation, not
            # exported: forcing the locale run-wide would break the box-art comparisons.
            line="$(printf '%s' "$line" | LC_ALL=C sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            for word in $line; do
                # The volume names live in container.args, not up here, so the instance
                # suffix has to be applied as they are read. `cs193v-claude:/path` becomes
                # `$NAME-claude:/path`, and since NAME is plain "cs193v" when no instance
                # is set, this is a no-op for a student. Matching on the trailing colon is
                # what keeps it off `--hostname cs193v-development`, the only other word
                # here that starts with the same eight characters.
                case "$word" in
                    cs193v-*:*) word="$NAME-${word#cs193v-}" ;;
                esac
                ARGS[${#ARGS[@]}]="$word"
            done
        done < "$f"
    done
}

# The flags the launcher itself contributes: identity, the workspace mount, and the
# labels that make drift detectable.
RUN_ARGS=()
build_run_args() {
    local relabel=''
    # Relabel narrowly, and only where SELinux is actually enforcing. Never :Z, and
    # never on a home or system directory: it walks every inode and can break unrelated
    # host services.
    if command -v getenforce >/dev/null 2>&1; then
        [ "$(getenforce 2>/dev/null)" = "Enforcing" ] && relabel=',z'
    fi

    RUN_ARGS=( --name "$NAME" --detach )
    RUN_ARGS[${#RUN_ARGS[@]}]="--label"
    RUN_ARGS[${#RUN_ARGS[@]}]="cs193v.confighash=$(config_hash)"
    RUN_ARGS[${#RUN_ARGS[@]}]="--label"
    RUN_ARGS[${#RUN_ARGS[@]}]="cs193v.dir=$DIR"
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$WORKSPACE,dst=$MOUNT_DST,rw$relabel"
    # The tunnel's key material, read-only. Added here rather than in container.args because
    # the paths are absolute and machine-specific -- the same reason local.args exists.
    #
    # Appended one element at a time, NOT via $(some_function) with word splitting: the
    # course directory is allowed to contain spaces (see the cs193v.dir label) and a split
    # would silently tear such a path in half, exactly as it would for the workspace mount
    # immediately above.
    #
    # $relabel ON THESE TWO AS WELL, AND THE TUNNEL DOES NOT WORK WITHOUT IT (#107). sshd reads
    # both files, and on an SELinux host a bind mount keeps its label from the host -- podman
    # changes nothing by default -- so a fresh checkout's ordinary user_home_t left them
    # unreadable inside the container:
    #
    #     cat: /home/student/.ssh/authorized_keys: Permission denied
    #     cat: /etc/ssh/cs193v_host_ed25519_key: Permission denied
    #
    # A STUDENT NEVER SAW A PERMISSION ERROR. sshd cannot load a host key, so it hangs up
    # ("Connection closed by UNKNOWN port 65535") and the launcher reports the tunnel not coming
    # up -- "your browser will not be able to reach servers running inside it" -- on a container
    # that started perfectly. Every port a student binds was unreachable, which is the one thing
    # this whole design exists to deliver.
    #
    # STILL NARROW, by the rule stated above: these are two FILES, so there is no tree to walk
    # and nothing of the student's is relabelled but the key material the container is meant to
    # read. Both are git-ignored, so the relabel touches nothing tracked.
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$TUNNEL_KEY.pub,dst=$TUNNEL_AUTH_KEYS_DST,ro$relabel"
    RUN_ARGS[${#RUN_ARGS[@]}]="--mount"
    RUN_ARGS[${#RUN_ARGS[@]}]="type=bind,src=$TUNNEL_HOST_KEY,dst=$TUNNEL_HOST_KEY_DST,ro$relabel"
    local a
    # ${arr[@]+"${arr[@]}"}, not "${arr[@]}": expanding an EMPTY array under `set -u` is a
    # fatal "unbound variable" on bash < 4.4, which is every Mac. A container.args holding
    # only comments is exactly the mis-edited-file support case, and it must produce our
    # error message rather than a raw bash one. The guard still preserves elements
    # containing spaces, which matters for --label cs193v.dir=/home/me/My Course/cs193v.
    for a in ${ARGS[@]+"${ARGS[@]}"}; do RUN_ARGS[${#RUN_ARGS[@]}]="$a"; done
}

# Everything that would require a different container if it changed. `podman start`
# reuses the container's STORED config and ignores the image digest, the port list,
# keep-id and --memory alike — so without this, "exists -> start" would permanently
# freeze each student's flags at whatever they were on first run, and edits to
# container.args would never reach anyone.
config_hash() {
    # IMAGE is hashed, and it is a constant, so every caller agrees by construction rather
    # than by remembering to resolve it first. It did not use to be: verb_doctor called
    # load_args but never resolved the image, so it hashed IMAGE="" while the launch path and
    # --dev-print-command hashed the resolved image — and doctor therefore called EVERY
    # container stale and sent people chasing a recreate prompt that never appears
    # (ERRORS.md B14). The image pin was the only thing that could make those two answers
    # differ; with it gone, that class of bug cannot come back.
    # MOUNT_DST is hashed as well as WORKSPACE. It used to be a constant baked into
    # build_run_args and never hashed at all — so when the mount moved from /workspaces to
    # ~/projects, every container already on a student's machine would have kept the old
    # path with no recreate prompt, and the docs would have described a directory nobody
    # was standing in.
    # The tunnel's mount destinations are hashed for exactly the reason MOUNT_DST is: they
    # are decided here rather than in container.args, so nothing else would notice if they
    # moved, and a container created without them cannot serve a tunnel at all -- sshd would
    # have no authorized_keys and no host key. Without this, a student whose container
    # predates the tunnel would get no recreate prompt and a tunnel that simply never works.
    { printf '%s\n' "$IMAGE" "$WORKSPACE" "$MOUNT_DST"
      printf '%s\n' "$TUNNEL_AUTH_KEYS_DST" "$TUNNEL_HOST_KEY_DST"
      printf '%s\n' ${ARGS[@]+"${ARGS[@]}"}; } | sha_stdin
}

# ─── preflight ─────────────────────────────────────────────────────────────────
preflight() {
    if [ "$(id -u)" -eq 0 ]; then die "$(msg err.running-as-root)"; fi

    if ! command -v podman >/dev/null 2>&1; then
        die "$(msg err.no-podman)"
    fi

    # The tunnel needs the ssh CLIENT on the host -- not a server. macOS ships it and so does
    # essentially every Linux; the realistic gap is a minimal WSL distro. Checked here rather
    # than at first use so the diagnosis arrives before a container exists, and names the
    # package rather than leaving a student to decode "ssh: command not found".
    if ! command -v ssh >/dev/null 2>&1 || ! command -v ssh-keygen >/dev/null 2>&1; then
        die "$(msg err.no-ssh)"
    fi

    if ! run_timeout 10 podman --version; then
        die "$(msg err.podman-hangs)"
    fi
    local ver floor
    ver="$(podman_version_of "$RT_OUT")"
    floor="$(min_podman)"
    if [ "$(version_lt "$ver" "$floor")" = yes ]; then
        die "$(msg err.podman-too-old FOUND="$ver" NEED="$floor")"
    fi

    if ! pm info --format '{{.Host.Security.Rootless}}'; then
        die "$(msg err.podman-unreachable)"
    fi
    if [ "$RT_OUT" != "true" ]; then
        die "$(msg err.rootful)"
    fi

    if ! grep -q "^$(id -un):" /etc/subuid 2>/dev/null; then
        case "$(platform)" in
            linux|wsl) die "$(msg err.no-subuid USER="$(id -un)")" ;;
        esac
    fi

    [ -d "$WORKSPACE" ] || mkdir -p "$WORKSPACE" || die "$(msg err.no-workspace DIR="$WORKSPACE")"
}

# ─── container state ───────────────────────────────────────────────────────────
state() {                             # -> absent | created | exited | running | ...
    if pm inspect "$NAME" --format '{{.State.Status}}'; then printf '%s' "$RT_OUT"
    else printf 'absent'; fi
}

label_of() { pm inspect "$NAME" --format "{{index .Config.Labels \"$1\"}}" && printf '%s' "$RT_OUT"; }
# The image's own labels, as against label_of's container labels. Used for
# cs193v.buildhash; see build_hash.
image_label_of() { pm image inspect "$1" --format "{{index .Labels \"$2\"}}" && printf '%s' "$RT_OUT"; }

# A fingerprint of the RECIPE: the Containerfile plus every file COPY reaches. Baked into
# the image as a label at build time and compared against the on-disk files at launch, so
# a student whose course files have moved on gets offered a rebuild.
#
# This is the replacement for the digest pin. A pinned image announced a new version by
# its digest changing; with the image built on the student's own machine there is no
# digest to change -- podman assigns a new image ID on every build, including rebuilds of
# identical input, so the image ID says "rebuilt", not "out of date". The recipe is the
# only thing that actually moves when staff ship a fix.
#
# Hashed from INSIDE $PRIVATE with relative paths, deliberately: hashing absolute paths
# would make the value depend on where the student put their course folder, so moving or
# renaming it would look like an update and prompt a pointless rebuild.
#
# files/ is the whole of the rest of the build context -- `COPY files/` is the only COPY
# in the Containerfile -- so the Containerfile plus that tree covers it.
#
# NAMES ARE HASHED AS WELL AS CONTENTS, in one sorted list, so that adding an empty file or
# renaming an existing one changes the value. Contents alone would miss both, and a rename
# is exactly the kind of edit that changes what the image contains.
#
# Written to spawn a fixed handful of processes rather than one per file, because this runs
# on EVERY launch: the obvious `while read f; do cat "$f"; done` form measured 88 ms against
# a launcher whose whole overhead is ~511 ms (ERRORS.md D9), and this measures 14 ms for the
# same result. `tr | xargs -0`, not a bare `xargs`, so a future filename containing a space
# is hashed rather than silently split -- and -0 rather than GNU's -d, which macOS lacks.
build_hash() {
    local list
    list="$( cd "$PRIVATE" 2>/dev/null && find Containerfile files -type f 2>/dev/null | LC_ALL=C sort )"
    { printf '%s\n' "$list"
      ( cd "$PRIVATE" 2>/dev/null && printf '%s\n' "$list" | tr '\n' '\0' | xargs -0 cat 2>/dev/null )
    } | sha_stdin
}

# Has the recipe moved since the image was built? TWO CALLERS AND THEY MUST AGREE: verb_rebuild
# decides whether to build, ensure_container whether to offer, so it is written once.
#
# EVERY "return 1" MEANS "DO NOT NAG", and each is an unknown rather than a no:
#   * no Containerfile -- nothing to compare against.
#   * no image -- a different problem, and not this function's to report.
#   * no label -- an image built before the label existed, or by a bare `podman build`. An
#     unknown must not become a rebuild prompt; it self-corrects on the first real build.
recipe_moved() {
    [ -f "$CONTAINERFILE" ] || return 1
    pmq image exists "$IMAGE" || return 1
    local have
    have="$(image_label_of "$IMAGE" cs193v.buildhash)"
    [ -n "$have" ] || return 1
    [ "$have" != "$(build_hash)" ]
}

# The image has to exist before a container can be made from it, and "nobody has built it on
# this computer yet" is a different problem from anything podman would say when asked to run
# a tag that is not there.
#
# ONE CALL SITE, the bare launch, and that is the point: verb_rebuild builds a missing image
# rather than refusing, so this is what stops the shortest command a student can type from
# silently starting a four-minute build. It names the verb to run instead.
require_image() {
    pmq image exists "$IMAGE" || die "$(msg err.no-image)"
}

# The step the last build attempt reached, so a retry can hold the bar there instead of
# rewinding it. Read from the log rather than from the meter, because the meter is only
# running on a terminal and the number is wanted either way.
build_last_step() {                   # -> step number reached, or 0
    local n
    # LC_ALL=C: $BUILD_LOG is podman's output, so it can carry any byte, and a locale error
    # here would silently stop the step counter advancing mid-build.
    n="$(LC_ALL=C sed -n 's/^STEP \([0-9]*\)\/.*/\1/p' "$BUILD_LOG" 2>/dev/null | tail -n 1)"
    case "$n" in ''|*[!0-9]*) printf '0' ;; *) printf '%s' "$n" ;; esac
}

# Whatever build_progress had to say to staff, moved into the log now that tee has let go of
# it. See BUILD_NOTE for why it cannot be written there directly.
build_note_fold() {
    [ -s "$BUILD_NOTE" ] || return 0
    cat "$BUILD_NOTE" >> "$BUILD_LOG" 2>/dev/null || true
    rm -f "$BUILD_NOTE"
}

# `podman build`, plus the label that makes staleness detectable.
#
# Deliberately NOT wrapped in run_timeout, unlike run. run_timeout exists to stop a SILENT
# hang, and a build is the opposite of silent -- podman streams every step. A fixed timeout
# here would instead kill a build that is merely slow, which on the weakest machine a student
# might own is the normal case, and it would do it after the student had already waited out
# most of it.
build_image() {
    [ -f "$CONTAINERFILE" ] || die "$(msg err.no-containerfile FILE="$CONTAINERFILE")"
    local nocache='' attempt=1 tries=3 hash retry='-' floor=0
    # --no-cache retries once only. The retry below is worth having because podman keeps
    # every completed layer, so a second attempt resumes at the step that failed -- and
    # --no-cache is precisely the flag that throws that away, so retrying it would mean
    # re-running a twenty-minute build from zero. It is a staff verb regardless.
    [ "${1:-}" = "--no-cache" ] && { nocache='--no-cache'; tries=1; }
    hash="$(build_hash)"
    info "$(msg status.building IMAGE="$IMAGE")"
    rm -f "$BUILD_NOTE"
    # THE LOG IS CLEARED HERE rather than left for tee to truncate, because the output box opens
    # on the tail of this file and the file deliberately outlives the run that wrote it (see
    # BUILD_LOG). Without this, a student re-running --build after a failure would spend the
    # first moment of the new build watching the last eight lines of the one that just failed.
    # Nothing is lost: tee truncates it milliseconds later anyway.
    rm -f "$BUILD_LOG"
    # Started before podman with no total, and build_progress fills both the total and the
    # first label in from its own parse of the Containerfile within milliseconds of the
    # pipeline coming up. Deliberately not computed here as well: the arithmetic for what the
    # total is -- instructions, plus podman's injected LABEL step, plus creating the
    # container -- belongs in exactly one place.
    #
    # The log is handed over as the box's source. It stays the box's source for the whole life of
    # the meter, so the box is still showing COMMIT and "Successfully tagged" while the last step
    # -- creating the container -- runs. That reads as a build that is done, which it is.
    [ -n "$BUILD_RAW" ] || meter_start 0 "" "$BUILD_LOG"

    # THE RETRY LIVES HERE, not in the installer, and that placement is the point. This
    # build reaches seven separate network origins -- the Ubuntu archive, NodeSource,
    # cli.github.com, npm, the Playwright CDN, PyPI and the tldr pages -- and several of
    # its steps fail hard on purpose rather than shipping a quietly degraded image (see
    # the tldr layer). Those assertions were written when ONE CI machine ran this build;
    # now every student does, on dorm wifi, so a transient failure is routine rather than
    # exceptional and recovering from it must be automatic.
    #
    # Retrying here rather than in the installer means the student sees the red STOP box
    # at most once. An installer-side loop would print it on every intermediate attempt,
    # and STOP is supposed to mean "stop and contact staff" -- three of them followed by
    # success would teach a student to ignore the one banner that must never be ignored.
    while :; do
        # TEE, so the output is readable afterwards and a failure can be classified from
        # podman's own words. What has changed (issue #23) is who reads it: it used to go
        # straight to the terminal, on the grounds that the step-by-step lines were the only
        # progress a student had. They were also thousands of lines of echoed shell that no
        # student can act on, so the stream now goes through build_progress, which renders
        # the one thing in it that is progress.
        #
        # $BUILD_RAW is the staff escape hatch: podman's words as they arrive, which is what
        # debugging a build needs and a progress bar cannot give.
        #
        # PIPESTATUS because the pipeline's own status is the LAST stage's, which is tee's
        # or awk's and always 0. Bash 3.2 has it, so this stays macOS-safe.
        # shellcheck disable=SC2086
        if [ -n "$BUILD_RAW" ]; then
            podman build $nocache \
                    --label "cs193v.buildhash=$hash" \
                    -t "$IMAGE" -f "$CONTAINERFILE" "$PRIVATE" 2>&1 | tee "$BUILD_LOG"
        else
            podman build $nocache \
                    --label "cs193v.buildhash=$hash" \
                    -t "$IMAGE" -f "$CONTAINERFILE" "$PRIVATE" 2>&1 \
                | tee "$BUILD_LOG" | build_progress "$retry" "$floor"
        fi
        # The meter deliberately stays RUNNING on success: create_container is the next
        # step and shares this bar (issue #24), so the line is closed there rather than here.
        #
        # BUILT earns the success box: verb_rebuild recreates whether or not it built, and a
        # two-second recreate must not announce "Build Successful!".
        #
        # build_note_fold on BOTH arms, before anything else looks at the log: a mismatch note
        # is worth having whether the build then succeeded or failed, and on the failing arm the
        # tail that goes inside the STOP box is read from $BUILD_LOG a few lines down.
        if [ "${PIPESTATUS[0]}" -eq 0 ]; then
            build_note_fold
            BUILT=1
            return 0
        fi
        build_note_fold

        # OUT OF DISK IS READ FROM PODMAN'S MESSAGE, not inferred from free space, and that
        # distinction was measured rather than reasoned about. An earlier version asked
        # `podman info` how much room was left and got the WRONG ANSWER every time: by the
        # time a failed build has returned, podman has already rolled back the partial layer
        # and handed the space back, so the machine looks fine at exactly the moment you
        # check. A genuine ENOSPC build then told the student "this is usually a network
        # problem", which is advice to go fix the wrong thing.
        #
        # It also must not be retried: retrying only spends the student's time twice to
        # arrive at the same wall.
        #
        # THE METER IS CLOSED ONLY ON THE WAY TO A BOX, not on every failure, which is the
        # difference between this and what it did before. A retry keeps the same block on the
        # screen and changes what it says; tearing it down and starting another one left a
        # finished-looking bar stranded above three lines of yellow text, once per attempt.
        if grep -qi 'no space left on device' "$BUILD_LOG" 2>/dev/null; then
            meter_stop bad
            die "$(msg err.build-no-disk)"
        fi
        # The failing output goes INSIDE the box now. It used to be left on the screen and
        # pointed at ("Podman's own output is above this box"), which stopped being true the
        # moment build_progress took the screen over. The tail, not the whole log: the last
        # lines are the ones that name the failure, and the box wraps rather than spills.
        if [ "$attempt" -ge "$tries" ]; then
            meter_stop bad
            die "$(msg err.build-failed OUT="$(tail -n 12 "$BUILD_LOG" 2>/dev/null)")"
        fi
        # THE RETRY IS REPORTED BESIDE THE BAR, not underneath it. What was here was three
        # lines of yellow prose per attempt, which scrolled the meter up the screen and put a
        # warning a student cannot act on in front of a build that then went on to succeed.
        # The marker says the same thing in the same place, and it counts RETRIES rather than
        # attempts: tries=3 means two of them.
        #
        # floor holds the bar at the step that failed while podman replays the cached steps
        # ahead of it, which takes about a second and would otherwise look like losing the
        # whole build.
        floor="$(build_last_step)"
        attempt=$(( attempt + 1 ))
        retry="$(( attempt - 1 ))/$(( tries - 1 ))"
    done
}

create_container() {
    # BEFORE podman run, not just before the tunnel starts. The key material is bind-mounted,
    # and podman creates a missing bind-mount source as a DIRECTORY -- so a first run with no
    # keys yet would silently mount a directory over authorized_keys and the host key, and
    # sshd would then fail for a reason with no obvious connection to the cause.
    tunnel_keys
    build_run_args
    # IF A BUILD IS STILL HOLDING THE METER, THIS IS ITS LAST STEP (issue #24). The label
    # goes beside the bar exactly like the base-image note, and the bar completes when podman
    # returns -- so a build shows one moving line from the first pull to a built container.
    #
    # Reached on its own by a bare ./cs193v, and by the --rebuild that had nothing to build,
    # where there is no meter. Those keep a standalone animated line: inventing a "step 24 of
    # 24" for them would be a count of nothing.
    #
    # Read from the meter's own state rather than from a variable, because the step count
    # came from podman and was parsed in a subshell -- the pipeline build_progress runs in.
    local mcur='' mtot=''
    if [ -n "$METER_PID" ] && [ -f "$METER_STATE" ]; then
        IFS=' ' read -r mcur mtot _ < "$METER_STATE" 2>/dev/null || true
    fi
    if [ "${mtot:-0}" -gt 0 ] 2>/dev/null; then
        meter_label "${mcur:-0}" "$mtot" "$(msg status.creating)"
        RT_SPIN=''
    else
        # No meter: run_timeout carries the label and animates it itself. Cleared in both
        # directions afterwards -- a stale RT_SPIN would animate the next slow probe.
        RT_SPIN="$(msg status.creating)"
    fi
    if ! run_timeout 180 podman run ${RUN_ARGS[@]+"${RUN_ARGS[@]}"} "$IMAGE"; then
        RT_SPIN=''
        meter_stop bad
        # Out of disk gets its own message HERE as well as in build_image, because creating
        # the container is a second, separate disk cost and a surprisingly large one:
        # --userns=keep-id makes podman write an ID-MAPPED COPY of every layer, so a
        # successful build is followed by allocating roughly the image's size again
        # (ERRORS.md D-series measured ~1.5 GB at the time; it is ~2.2 GB now). A student
        # who has just watched a four-minute build succeed then gets
        #   "creating an ID-mapped copy of layer ...: lchown ...: no space left on device"
        # which names neither the cause they can act on nor the fact that the build itself
        # was fine. Checked after the failure rather than before it: the cost depends on
        # the image, and refusing pre-emptively would block installs that would have worked.
        case "$RT_OUT" in
            *'no space left on device'*|*'No space left on device'*)
                die "$(msg err.create-no-disk)" ;;
        esac
        # Lost the create race -- not a failure, and it must not read like one.
        #
        # `podman run --name` IS a test-and-set: name uniqueness is enforced under podman's own
        # database lock, so of two simultaneous launches exactly one creates the container and
        # the other arrives here. That makes this the ATOMIC half of refuse_if_session_live for
        # the absent -> running transition, where the state check alone is only a check-then-act.
        #
        # Measured against podman 5.7.0: rc=125 and
        #   Error: creating container storage: the container name "cs193v" is already in use by
        #   <id>. You have to remove that container to be able to reuse that name...
        # Matched on the STRING, not the status: 125 is podman's generic "failed before running
        # the container" code and says nothing about which error it was.
        #
        # Without this the loser dies with err.create-failed and a wall of podman output, for
        # something whose real meaning is "you already have a session open".
        case "$RT_OUT" in
            *'already in use'*) die "$(msg err.session-in-use)" ;;
        esac
        die "$(msg err.create-failed OUT="$RT_OUT")"
    fi
    RT_SPIN=''
    if [ "${mtot:-0}" -gt 0 ] 2>/dev/null; then
        meter_stop ok "$mtot" "$mtot" "$(msg status.created)"
    else
        info "$(msg status.created)"
    fi
    # NO TUNNEL HERE. Creating a container is not what makes one wanted -- opening a session is
    # -- and since #41 the only verb that creates one stops it again on the next line. A tunnel
    # raised here would be bound for a container nobody is in, and torn down having served
    # nothing. See the dispatch, which is where it is raised now.
}

# The tunnel goes first, always. It holds every course port on the host's loopback, and those
# are bound by a process that outlives the container -- so removing the container without it
# leaves an ssh client holding all 46 ports against a pipe that no longer has anything on the
# far end, and the REPLACEMENT container's tunnel then cannot bind a single one of them. That
# turns a routine --rebuild into a total outage whose cause is invisible.
remove_container() { tunnel_down; pmq rm -f "$NAME"; }

# Base names, not full ones, so the instance suffix is applied in exactly one place and
# cannot drift from the rewrite in load_args. "$NAME-claude" is "cs193v-claude" for a
# student and "cs193v-<instance>-claude" for a developer, matching container.args either way.
remove_volumes() {
    local v
    for v in claude claude-json codex gh vercel playwright git; do
        pmq volume rm "$NAME-$v"
    done
}

# ─── the loopback tunnel ───────────────────────────────────────────────────────
# What this is and why it exists: podman's port forwarder delivers to the container's eth0
# and never touches its lo, so a server bound to the container's own 127.0.0.1 was
# unreachable from the student's browser. Rather than publish ports, the launcher runs an ssh
# CLIENT on the host that binds each course port on the host's loopback and asks an sshd
# INSIDE the container to connect to the container's loopback for each arriving connection.
#
# The transport is a `podman exec` pipe, not a socket: sshd is started in inetd mode (-i), so
# nothing listens anywhere in the system and the only way to reach it is to be able to run
# `podman exec`, which already requires this user's own privileges. That choice is also what
# makes it portable -- `podman exec` is what open_shell already relies on for a shell on all
# three platforms, whereas --network=pasta:--host-lo-to-ns-lo was silently inert on macOS.
#
# One ssh process carries every forward: SSH multiplexes channels over one connection, so a
# new browser connection costs a new channel, not a new `podman exec`. Measured: forwarded
# throughput 322 MB/s and per-connection latency indistinguishable from a published port
# (12.1ms vs 12.6ms), against 158ms per connection for any relay that spawns podman exec
# per connection. That measurement is the whole reason this is ssh and not socat.

# Generated once per machine. Not in the image (that would ship one private key to every
# student) and not per container start (the host key would change on every --rebuild and
# greet students with REMOTE HOST IDENTIFICATION HAS CHANGED for no reason).
tunnel_keys() {
    [ -f "$TUNNEL_KEY" ] || {
        ssh-keygen -q -t ed25519 -N '' -C 'cs193v-tunnel' -f "$TUNNEL_KEY" </dev/null \
            || die "$(msg err.tunnel-keygen)"
    }
    [ -f "$TUNNEL_HOST_KEY" ] || {
        ssh-keygen -q -t ed25519 -N '' -C 'cs193v-tunnel-host' -f "$TUNNEL_HOST_KEY" </dev/null \
            || die "$(msg err.tunnel-keygen)"
    }
    # Pin the container's host key, so StrictHostKeyChecking=yes has something to check and a
    # student never sees an interactive "do you want to continue" prompt. Rewritten every
    # time rather than appended to, so a regenerated host key cannot leave two entries.
    printf '%s %s\n' "$TUNNEL_HOST" "$(cat "$TUNNEL_HOST_KEY.pub")" > "$TUNNEL_KNOWN_HOSTS"
    chmod 600 "$TUNNEL_KEY" "$TUNNEL_HOST_KEY" 2>/dev/null || true
}

# Is a tunnel alive for THIS course directory and instance? The control socket is the
# identity, and -O check is the only honest test: a socket file can outlive its process.
tunnel_alive() {
    [ -S "$TUNNEL_CTL" ] || return 1
    run_timeout 10 ssh -S "$TUNNEL_CTL" -O check "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1
}

# THE MASTER STARTS WITH NO -L FLAGS AT ALL, which is the shape of the whole change: it comes up
# carrying nothing and the supervisor adds forwards to it, one per port, as things inside the
# container start listening. `ssh -f -N -M -S` with no forwards is a mux socket and nothing else,
# which is exactly what is wanted -- there is nothing to bind at startup, so there is no startup
# bind failure to report either.
tunnel_start() {
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID" "$TUNNEL_LOG"

    # -f, WHICH THIS USED TO REFUSE. The refusal was right about its reason and wrong about the
    # conclusion, so both halves are worth recording. -f daemonizes after authentication, and
    # the pid we could capture from it is the parent that immediately exits -- so writing $!
    # into the pidfile would record a DEAD number, and tunnel_kill_pid, which checks that the
    # pid still looks like our own tunnel before killing it, would then decline to kill
    # anything while doctor reported "up (pid <dead>)". --reset-tunnel would silently do
    # nothing to a wedged master. That is a real trap, not a stylistic preference.
    #
    # What it missed is that the pid need not come from $! at all: the master will say. See
    # tunnel_record_pid, which reads it out of the -O check below that runs anyway.
    #
    # And what the & + poll cost is issue #38: `-O check` answering tells you WHETHER
    # authentication succeeded but not WHEN, so a tunnel that came up in 60ms still paid a flat
    # 500ms sleep -- on every launch, since #41 takes the tunnel down with the terminal. This is
    # also the one wait in the launcher that could not be polled cheaply, because the probe is a
    # whole ssh process rather than a builtin.
    #
    # -f IS ALSO STRICTLY MORE HONEST than the poll it replaces. ssh forks only after it has
    # authenticated AND set its forwarding up, whereas -O check answering proves only that the
    # mux socket is listening. That used to matter because the master bound a whole declared list
    # at startup and the report on it could run while those binds were still in progress; the
    # master carries no forwards at startup now, so the ordering hazard is gone with them.
    #
    # TIME-BOXED, because -f in the foreground is a wait with no ceiling of its own: a wedged
    # `podman exec` in the ProxyCommand would hang here forever, which is the failure
    # run_timeout exists to prevent everywhere else.
    #
    # -E, not a shell redirect, and that is required rather than tidier: run_timeout owns the
    # command's stdout and stderr and deletes the file it points them at, so a master that
    # survived the fork would be writing its ServerAlive failures into a deleted inode --
    # costing doctor exactly the wedged-tunnel diagnostics it exists to print. -E is ssh's own
    # log, opened by ssh and kept across the fork. It appends, which the rm -f above makes
    # equivalent to truncating, so the log always describes the tunnel that is running now.
    #
    # nohup STILL EARNS ITS PLACE, and for a reason -f makes easy to get wrong: -f detaches the
    # MASTER (daemon(3) calls setsid), but the ProxyCommand `podman exec` was forked before
    # that and keeps the old process group. Without nohup's inherited SIG_IGN, closing the
    # window would HUP the tunnel's transport out from under a master that survived. setsid(1)
    # remains not an option -- it DOES NOT EXIST on macOS. The log goes to TMPDIR so nohup
    # never drops a nohup.out in the student's course directory.
    #
    # -F none: ignore the student's own ~/.ssh/config AND the system one, so nothing they
    # have configured for other hosts can redirect or decorate this. NOT ClearAllForwardings,
    # which reads like it would help and would in fact delete forwards the supervisor later adds;
    # see the invariants block in container.args.
    #
    # NO -L FLAGS HERE AT ALL. The master comes up carrying nothing and the supervisor adds a
    # forward per port as things start listening inside the container, so there is no startup bind
    # to fail and nothing for ExitOnForwardFailure to decide about. A forward that cannot take its
    # host port now fails on its own, mid-session, and is reported per-port rather than inferred
    # from this command's exit status.
    #
    # TWO QUESTIONS, ONE REPORT. ssh's own status answers "did it get as far as backgrounding
    # itself"; tunnel_alive answers "is a master listening on our socket now", which is the only
    # thing that makes the tunnel usable, and which also fills RT_OUT with the pid. Either
    # failing means the same thing to a student and gets the same message -- the log is where
    # the difference between them is written down.
    #
    if ! run_timeout 30 nohup ssh -f -N -M -S "$TUNNEL_CTL" -E "$TUNNEL_LOG" -F none \
           -i "$TUNNEL_KEY" -o IdentitiesOnly=yes \
           -o "ProxyCommand=podman exec -i $NAME /usr/sbin/sshd -i -f $TUNNEL_SSHD_CONFIG" \
           -o "UserKnownHostsFile=$TUNNEL_KNOWN_HOSTS" -o StrictHostKeyChecking=yes \
           -o ForwardAgent=no -o ForwardX11=no -o PermitLocalCommand=no \
           -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
           "$TUNNEL_USER@$TUNNEL_HOST" </dev/null || ! tunnel_alive; then
        warn "$(msg warn.tunnel-failed LOG="$TUNNEL_LOG" OUT="$(tail -5 "$TUNNEL_LOG" 2>/dev/null)")"
        return 1
    fi
    tunnel_record_pid
    return 0
}

# The master's own pid, asked of the master. `ssh -O check` answers "Master running (pid=N)",
# run_timeout leaves that in RT_OUT, and tunnel_alive has just run one -- so this costs nothing
# and is the thing that lets tunnel_start use -f at all. Not anchored to the end of the line:
# ssh terminates that message with \r\n.
#
# THE FALLBACK IS THE IDENTITY TEST tunnel_kill_pid ALREADY TRUSTS -- our control socket is on
# the master's command line and on nothing else's -- so an ssh that ever stops saying it costs a
# fork here rather than a broken --reset-tunnel.
#
# Writing nothing is better than writing a guess: doctor prints "up (pid ?)" for an empty
# pidfile, and tunnel_kill_pid declines a pid it cannot identify. A wrong number, by contrast,
# is a signal sent to whatever now owns it.
tunnel_record_pid() {
    local pid
    pid="$(printf '%s' "$RT_OUT" | LC_ALL=C sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -1)"
    if [ -z "$pid" ]; then
        pid="$(ps -Ao pid=,args= 2>/dev/null | grep -F "$TUNNEL_CTL" | grep -v ' grep ' \
               | awk 'NR == 1 { print $1 }')"
    fi
    case "${pid:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    printf '%s\n' "$pid" > "$TUNNEL_PID"
    return 0
}

# ─── dynamic port forwarding: the supervisor ───────────────────────────────────
# WHAT THIS IS. cs193v-portwatch inside the container reports, once a second, every port something
# is listening on and what kind of address it is bound to. This loop reads those frames, decides
# which of them this computer can actually make reachable, and asks the ssh master to open or
# close the corresponding forward. The container never asks for a port; it says what it sees, and
# every decision is taken here.
#
# `ssh -O forward` IS A CONTROL CLIENT, NOT A TUNNEL. It hands the running master a message over
# $TUNNEL_CTL and exits -- no new connection, no new authentication, no new podman exec. A port
# costs one fork and one listening socket, and a browser connection to it costs a channel on the
# connection that already exists.

# The lowest port an unprivileged process on THIS machine may bind. Read once: it is a host fact
# the container cannot know, which is why the container reports low ports rather than filtering
# them and this side decides. Linux exposes it; macOS has no equivalent and is fixed at 1024.
TUNNEL_DYN_FLOOR=1024
tunnel_dyn_read_floor() {
    local v
    [ -r /proc/sys/net/ipv4/ip_unprivileged_port_start ] || return 0
    read -r v < /proc/sys/net/ipv4/ip_unprivileged_port_start 2>/dev/null || return 0
    case "$v" in ''|*[!0-9]*) return 0 ;; esac
    [ "${#v}" -le 5 ] || return 0
    [ "$v" -ge 1 ] && [ "$v" -le 65535 ] && TUNNEL_DYN_FLOOR="$v"
    return 0
}

# 0 bound | 1 the host port is busy | 2 the master is gone | 3 the master is not answering
#
# </dev/null IS LOAD-BEARING: this runs inside the supervisor's `while read` loop, and without it
# ssh inherits that stdin and eats the watcher's stream.
#
# run_timeout 5 is a BACKSTOP, not a mechanism. A healthy -O forward is a fork plus a unix-socket
# round trip -- 15-40ms. Ten seconds was copied from tunnel_alive, which runs once at startup;
# here it would cost that per port per tick.
#
# THE SECOND [ -S ] IS THE ONE DOING WORK. The first is a cheap racy pre-check; the second is what
# separates "the host port is taken" from "the master went away while we were asking".
tunnel_dyn_forward() {                # tunnel_dyn_forward PORT
    [ -S "$TUNNEL_CTL" ] || return 2
    run_timeout 5 ssh -S "$TUNNEL_CTL" -O forward \
        -L "127.0.0.1:$1:127.0.0.1:$1" "$TUNNEL_USER@$TUNNEL_HOST" </dev/null
    case "$?" in
        0)   return 0 ;;
        124) return 3 ;;              # run_timeout's timeout convention
    esac
    [ -S "$TUNNEL_CTL" ] || return 2
    return 1
}

tunnel_dyn_cancel() {                 # tunnel_dyn_cancel PORT
    [ -S "$TUNNEL_CTL" ] || return 0
    run_timeout 5 ssh -S "$TUNNEL_CTL" -O cancel \
        -L "127.0.0.1:$1:127.0.0.1:$1" "$TUNNEL_USER@$TUNNEL_HOST" </dev/null || true
    return 0
}

# Pure and local: the validated record plus one host fact. Nothing refused is ever handed to
# tunnel_dyn_forward -- we already know port 80 cannot be bound and a ::1 bind cannot be reached,
# so asking ssh would cost a fork to learn what we knew and would blur "the host cannot" into
# "the host is contended".
tunnel_dyn_classify() {               # tunnel_dyn_classify PORT CLASS -> DYN_WHY ('' = forward it)
    DYN_WHY=''
    case "$2" in
        v6lo|loalt|eth) DYN_WHY="$2"; return 0 ;;
    esac
    [ "$1" -ge "$TUNNEL_DYN_FLOOR" ] || { DYN_WHY=below-floor; return 0; }
    return 0
}

# ─── the supervisor loop ───────────────────────────────────────────────────────
# Runs as its own process (see tunnel_sup_start) reading the watcher's stdout. State is four plain
# strings; the supervisor is a forked child, so these are private to it and there is nothing to be
# gained by scoping them.
#
#   SUP_UP    ' 41573 8123 '   forwarded right now
#   SUP_BUSY  ' 3005:27 '      the host port was refused, with a cooldown in TICKS
#   SUP_GONE  ' 8123:3 '       forwarded but absent from this frame, with a linger in TICKS
#   SUP_MASTER                 the master pid we believe we are talking to
#
# TICKS, NOT SECONDS, for everything counted here: no `date` fork and no dependence on a clock.
# The single exception is the frame-arrival timeout, and it has to be -- ticks are DEFINED by
# frames arriving, so "frames stopped" is the one thing that cannot be measured in them.
#
# SUP_BUSY IS THE ONLY RETRYABLE OUTCOME and therefore the only one that needs state. Every
# refusal reason is a pure function of the frame plus the floor, so it is recomputed each tick and
# stored nowhere -- which means a `v6lo` clears itself the moment the student changes their bind
# address, with no invalidation logic at all.
SUP_UP=' '; SUP_BUSY=' '; SUP_GONE=' '; SUP_MASTER=''; SUP_STATE=healthy; SUP_SILENT=0

sup_log() { printf '%s\n' "$*" >&2; }

# The publish is the only path state takes out of the supervisor. On change only -- per-tick would
# be ~28,800 lines and ~28,800 podman execs a session, and the linger already absorbs the churn
# that would otherwise cause: a crash-looping dev server rebinds the SAME port, which never leaves
# SUP_UP, so nothing publishes at all.
SUP_PUBLISHED=''
sup_publish() {                       # sup_publish REFUSED_LIST
    local up refused sig e
    up=''; refused=''
    for e in $SUP_UP;   do up="$up,$e:lo"; done
    for e in $1;        do refused="$refused,$e"; done
    up="${up#,}"; refused="${refused#,}"
    sig="$SUP_STATE|$up|$refused"
    [ "$sig" = "$SUP_PUBLISHED" ] && return 0
    SUP_PUBLISHED="$sig"
    pmq exec "$NAME" cs193v-portwatch --publish \
        "state=$SUP_STATE" "floor=$TUNNEL_DYN_FLOOR" "up=$up" "refused=$refused" || true
    return 0
}

sup_tick() {                          # sup_tick "port:class port:class ..."
    local frame="$1" e port cls now seen refused='' out c n
    # RE-READ THE MASTER EVERY TICK. One builtin file read, and it is the whole self-heal: a
    # --reset-tunnel in another window replaces the master, every forward it held died with it,
    # but the container's ports are all still listening so the watcher reports no change. Dropping
    # our own state is what makes the next frame rebuild everything. Treating a MISSING pidfile as
    # a change is deliberate -- verb_reset_tunnel removes it before writing the new one, and the
    # obvious "only drop when non-empty" optimisation would leave us believing in forwards held by
    # a master that no longer exists.
    now=''
    [ -r "$TUNNEL_PID" ] && read -r now < "$TUNNEL_PID" 2>/dev/null
    if [ "$now" != "$SUP_MASTER" ]; then
        SUP_MASTER="$now"; SUP_UP=' '; SUP_BUSY=' '; SUP_GONE=' '
        SUP_STATE=healthy
    fi

    # age the cooldowns
    out=' '
    for e in $SUP_BUSY; do
        port="${e%%:*}"; n=$(( ${e#*:} - 1 ))
        [ "$n" -gt 0 ] && out="$out$port:$n "
    done
    SUP_BUSY="$out"

    seen=' '
    for e in $frame; do
        port="${e%%:*}"; cls="${e#*:}"
        seen="$seen$port "
        tunnel_dyn_classify "$port" "$cls"
        if [ -n "$DYN_WHY" ]; then
            refused="$refused $port:$DYN_WHY"
            continue
        fi
        case "$SUP_UP" in *" $port "*) continue ;; esac      # already ours; nothing to do
        case "$SUP_BUSY" in *" $port:"*) refused="$refused $port:busy"; continue ;; esac
        n=0; for c in $SUP_UP; do n=$(( n + 1 )); done
        if [ "$n" -ge "$DYNPORTS_MAX" ]; then
            refused="$refused $port:capped"; continue
        fi
        tunnel_dyn_forward "$port"
        case "$?" in
            0) SUP_UP="$SUP_UP$port " ;;
            1) SUP_BUSY="$SUP_BUSY$port:$TUNNEL_SUP_COOLDOWN "; refused="$refused $port:busy" ;;
            2) SUP_MASTER=''; SUP_UP=' '; SUP_BUSY=' '; SUP_GONE=' '; return 0 ;;
            3) SUP_STATE=master-unresponsive; sup_log "master not answering; not attempting more"; return 0 ;;
        esac
    done
    [ "$SUP_STATE" = master-unresponsive ] && SUP_STATE=healthy

    # LINGER before cancelling. A port that vanishes for a moment is a vite restart, and
    # cancel-then-reforward is visible: the host port is briefly unbound, so a reload racing it
    # gets connection refused on a port that worked a second ago.
    out=' '
    for e in $SUP_GONE; do
        port="${e%%:*}"
        case "$seen" in *" $port "*) continue ;; esac        # came back
        n=$(( ${e#*:} + 1 ))
        if [ "$n" -ge "$TUNNEL_SUP_LINGER" ]; then
            tunnel_dyn_cancel "$port"
            SUP_UP="${SUP_UP/ $port / }"
        else
            out="$out$port:$n "
        fi
    done
    SUP_GONE="$out"
    for e in $SUP_UP; do
        case "$seen" in *" $e "*) continue ;; esac
        case "$SUP_GONE" in *" $e:"*) continue ;; esac
        SUP_GONE="$SUP_GONE$e:1 "
    done

    sup_publish "$refused"
    return 0
}

# The loop itself. Reads the watcher's frames through the host-side gate in cs193v-ui.sh, which is
# the only place bytes the container controls are parsed.
sup_loop() {
    local line rc
    tunnel_dyn_read_floor
    dynports_reset
    # -t: the ONE wall-clock measurement in the design. Six consecutive timeouts is thirty seconds
    # of silence -- thirty missed frames -- and only a deadlocked watcher can produce that, since
    # a dead one closes the pipe and a lid close contributes at most ONE timeout (a frozen read
    # returns once; the next call starts a fresh timer on a woken machine).
    local ready=''
    while :; do
        IFS= read -r -t "$TUNNEL_SUP_SILENCE" -n 64 line
        rc=$?
        if [ "$rc" -gt 128 ]; then
            SUP_SILENT=$(( SUP_SILENT + 1 ))
            if [ "$SUP_SILENT" -ge "$TUNNEL_SUP_SILENCE_MAX" ]; then
                SUP_STATE=broken
                sup_log "no frames for $(( TUNNEL_SUP_SILENCE * TUNNEL_SUP_SILENCE_MAX ))s -- the watcher has stopped"
                sup_publish ''
                return 1
            fi
            continue
        fi
        [ "$rc" -ne 0 ] && { sup_log "the watcher's stream ended"; return 0; }
        SUP_SILENT=0
        dynports_line "$line"
        case "$?" in
            0) [ -n "$ready" ] || { ready=1; : > "$TUNNEL_SUP_READY"; } ;;
            1) sup_tick "$DYNPORTS_FRAME" ;;
            2) SUP_STATE=broken
               sup_log "protocol violation: $DYNPORTS_FATAL"
               sup_publish ''
               return 1 ;;
        esac
        [ -n "${DYNPORTS_WARN:-}" ] && { sup_log "watcher warning: $DYNPORTS_WARN"; DYNPORTS_WARN=''; }
    done
}

# The hidden verb the supervisor process runs as. Its own verb rather than an inline subshell so
# it can be driven directly, and so `ps` shows something a human can recognise.
verb_supervise() {
    load_args
    printf '%s\n' "$$" > "$TUNNEL_SUP_PIDFILE"
    # PROCESS SUBSTITUTION, NOT A PIPELINE, and the difference is the whole of tunnel_sup_stop.
    # `podman exec ... | sup_loop` runs the loop in a SUBSHELL, so $$ above names the parent and
    # killing it leaves the loop running -- measured: one process survived every stop. Read from
    # `< <(...)` instead and the loop IS this process, so the pid in the file is the pid that
    # matters. The reader dying then closes the substitution's pipe, and podman exec exits on its
    # next write.
    sup_loop < <(podman exec "$NAME" cs193v-portwatch --watch 1 2>/dev/null)
}

# Is a supervisor running for THIS instance? Pidfile plus the same argv identity test
# tunnel_kill_pid uses, and for the same reason: pids are reused, the file outlives the process it
# names, and killing a stranger costs whatever that stranger was doing.
tunnel_sup_alive() {
    local pid
    pid="$(cat "$TUNNEL_SUP_PIDFILE" 2>/dev/null)"
    case "${pid:-}" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    case "$(ps -p "$pid" -o args= 2>/dev/null)" in
        *--dev-supervise*) return 0 ;;
    esac
    return 1
}

# IDEMPOTENT, mirroring ensure_tunnel's own `tunnel_alive && return 0`. Two supervisors would both
# drive -O forward and both publish. A plain check-then-act is enough because setup work now
# happens behind the session claim (see open_shell), so the path that used to reach here twice at
# once -- two launchers racing before either had won -- no longer exists.
#
# IT WAITS FOR THE HANDSHAKE rather than forking and hoping. Without the wait a watcher that could
# not start is unreportable: the supervisor would log, mark itself broken and exit with nothing
# said, and the popup cannot help because at this moment we are between the claim and the attach
# with no tmux client attached. With it, the failure goes through warn(), which
# acknowledge_warnings then blocks on before tmux takes the screen.
#
# AND IT DOES NOT ABORT THE LAUNCH. Same posture as `ensure_tunnel || true`: a container whose
# ports are not reachable is still perfectly usable, as long as something said so.
tunnel_sup_start() {
    local i
    tunnel_sup_alive && return 0
    # REAP FIRST. Reaching here means no supervisor of ours is running, so any watcher still
    # looping inside the container is orphaned -- its reader is gone. It does not always notice:
    # its writes go into a pipe buffer that conmon holds open, so the EPIPE that should end it may
    # never arrive. --reset-tunnel is the path that matters, because it never calls tunnel_down
    # and so never reaches tunnel_sup_stop; without this, every reset would leave one behind and
    # start another beside it. Measured: four accumulated across one testing session.
    pmq exec "$NAME" pkill -f "cs193v-portwatch --watch" || true
    rm -f "$TUNNEL_SUP_PIDFILE" "$TUNNEL_SUP_READY" "$TUNNEL_SUP_LOG"
    nohup "$SELF" --dev-supervise >>"$TUNNEL_SUP_LOG" 2>&1 </dev/null &
    i=0
    while [ "$i" -lt 50 ]; do
        [ -f "$TUNNEL_SUP_READY" ] && return 0
        # GIVING UP EARLY NEEDS THE PIDFILE TO EXIST FIRST. "Not alive" means two different things
        # here -- "has not started yet" and "started and died" -- and only the second is a reason
        # to stop waiting. Checking liveness alone fires on the first poll, before the child has
        # written anything, so the launch warns about a supervisor that then comes up and works.
        # Measured: it did exactly that, and the warning was the only sign anything was wrong.
        if [ -s "$TUNNEL_SUP_PIDFILE" ] && ! tunnel_sup_alive; then break; fi
        sleep 0.1
        i=$((i + 1))
    done
    warn "$(msg warn.dynports-failed LOG="$TUNNEL_SUP_LOG" OUT="$(tail -3 "$TUNNEL_SUP_LOG" 2>/dev/null)")"
    tunnel_sup_stop
    return 1
}

tunnel_sup_stop() {
    local pid
    pid="$(cat "$TUNNEL_SUP_PIDFILE" 2>/dev/null)"
    case "${pid:-}" in
        ''|*[!0-9]*) ;;
        *)  case "$(ps -p "$pid" -o args= 2>/dev/null)" in
                *--dev-supervise*)
                    # This pid is the LOOP (see verb_supervise), so killing it takes the host
                    # side down whole: podman exec's next write fails within one tick, because
                    # there is a write every tick. It does NOT reach the watcher inside the
                    # container -- measured -- which is what the reap below is for.
                    kill "$pid" 2>/dev/null || true
                    sleep 1
                    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null ;;
            esac ;;
    esac
    # AND REAP THE WATCHER INSIDE THE CONTAINER. In the ordinary case this is unnecessary --
    # every path that reaches tunnel_down stops the container a moment later and cgroup teardown
    # takes everything with it. --reset-tunnel is the exception: it never calls tunnel_down, so
    # without this a stale watcher would survive each reset and the next one would start another
    # beside it. Measured: four accumulated across a testing session. Cheap, bounded, and only
    # ever kills a process this launcher started.
    pmq exec "$NAME" pkill -f "cs193v-portwatch --watch" || true
    rm -f "$TUNNEL_SUP_PIDFILE" "$TUNNEL_SUP_READY"
    return 0
}

ensure_tunnel() {
    tunnel_alive && { tunnel_sup_start || true; return 0; }
    tunnel_keys
    tunnel_start || return 1
    tunnel_sup_start || true
}

# SIGTERM, a moment to land, then SIGKILL. Shared with --reset-tunnel, which is where this
# escalation was written: a tunnel stopped with SIGSTOP will never handle a TERM, and that is a
# realistic way to arrive at either caller.
tunnel_kill_pid() {
    local pid
    pid="$(cat "$TUNNEL_PID" 2>/dev/null)"
    case "${pid:-}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 0
    # IDENTIFIED BEFORE KILLED. Pids are reused, and this file outlives the process it names --
    # a machine that lost power mid-session leaves one behind, and the number is handed out
    # again within days. So kill only something that still looks like our own tunnel: the
    # control socket being torn down is on its command line, and on nothing else's. Skipping
    # the kill costs 46 ports until --reset-tunnel; killing a stranger's process costs whatever
    # that process was doing.
    case "$(ps -p "$pid" -o args= 2>/dev/null)" in
        *"$TUNNEL_CTL"*) : ;;
        *) return 0 ;;
    esac
    kill "$pid" 2>/dev/null || true
    sleep 1
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    return 0
}

# Paired with remove_container, ALWAYS. A tunnel whose container is gone still holds every
# host port it bound, which would stop the replacement container's tunnel from binding them
# -- turning a routine --rebuild into a total outage with no visible cause.
#
# Since #41 this is the ONE path that gives the 46 ports back -- --rebuild, --stop and the end
# of a session all arrive here -- so it may not settle for asking nicely. The pidfile is the
# only record of who holds those ports, and deleting it without first killing what it names is
# how a wedged master became unfindable: doctor then says DOWN while all 46 are still bound,
# --reset-tunnel has nothing left to force, and the next tunnel binds none of them. Measured,
# with a master stopped by SIGSTOP: --rebuild took 14s, reported `0 of 46 forwarded`, and told
# the student to go looking for another program on their computer.
tunnel_down() {
    # THE SUPERVISOR GOES FIRST, before the master is asked to exit. The other way round it sees
    # the control socket vanish, concludes the master is gone, drops its state and publishes the
    # churn on the way out -- all of it pointless during a teardown.
    tunnel_sup_stop
    # Time-boxed, because a wedged ssh may never answer -O exit -- and the box expiring is
    # itself the signal that asking did not work.
    if [ -S "$TUNNEL_CTL" ] && run_timeout 10 ssh -S "$TUNNEL_CTL" -O exit \
           "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1; then
        :                         # accepted; the master is on its way out under its own power
    else
        tunnel_kill_pid           # wedged, or no socket to ask through
    fi
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID"
}

# The state machine. Everything that can silently give a student the wrong container is
# checked here.
ensure_container() {
    local st want_hash have_hash
    st="$(state)"

    if [ "$st" = absent ]; then
        create_container
        return
    fi

    refuse_if_foreign_dir

    want_hash="$(config_hash)"
    have_hash="$(label_of cs193v.confighash)"

    if [ -n "$have_hash" ] && [ "$have_hash" != "$want_hash" ]; then
        printf '\n'; msg prompt.config-changed
        if confirm "$(msg opt.keep-current)" "$(msg opt.recreate)"; then
            remove_container; create_container; return
        fi
    fi

    # How a mid-quarter fix reaches a student who never runs --rebuild: staff change the
    # Containerfile, and the student's next `./cs193v` notices and offers to rebuild. It is the
    # ONLY thing that notices, which is why the launcher builds the image itself rather than
    # letting anyone hand it one.
    #
    # IT ASKS HERE AND verb_rebuild DOES NOT, on the same predicate, deliberately: this student
    # asked for a shell and a four-minute build is an interruption, so it is offered with "keep
    # the current version" as the default. There, building is what they asked for.
    if recipe_moved; then
        printf '\n'; msg prompt.image-stale
        if confirm "$(msg opt.keep-current-version)" "$(msg opt.rebuild-now)"; then
            build_image; remove_container; create_container; return
        fi
    fi

    # NOTHING IS ANNOUNCED HERE, deliberately (issue #57). This printed "Starting the course
    # container...", which named an implementation detail a student cannot act on at the one moment
    # they are already waiting -- and the launch has said what it is doing before this runs.
    case "$st" in
        running) : ;;
        *) pmq start "$NAME" || { remove_container; create_container; return; } ;;
    esac
}

# ─── the session's lifetime ────────────────────────────────────────────────────
# ONE session at a time, and it ends when the terminal does. Issue #41.
#
# The design here used to be the exact opposite, and it is worth knowing what went and why,
# because the deletion is most of this change. The container outlived every window; tmux ran
# with `destroy-unattached off` so a session survived its client; cs193v-shell reattached to
# whichever session had no client; and because closing a window does NOT kill the tmux client
# inside the container -- conmon keeps the exec pty open and tmux reports the session attached
# forever, measured, see ERRORS.md D1 -- the launcher had to stamp each session with the host
# pid that attached it and prune the ghosts before every launch.
#
# All of that is gone -- the liveness check, the pruning, the owner stamp, the client pid the
# stamp needed, and the warning about having too many windows open. What makes the replacement
# this much smaller is that the container now STOPS, so there is never an orphaned session to
# reason about and never more than one client to count. 10-static.sh asserts each of those
# names is absent, so this paragraph deliberately does not spell them out: the launcher's own
# documentation of a ban is the classic thing that matches the ban's own grep.

# The status cs193v-shell exits with when it loses the session-claim race. A CONTRACT BETWEEN
# TWO FILES -- see the claim block in files/cs193v-shell -- and 10-static.sh asserts that both
# spell it the same, because nothing else would notice them drifting apart and the symptom
# would be a lost race printing that script's "fault in the container image" box.
RACE_LOST_STATUS=3
TEARDOWN_DONE=''

# What ends the session: `exit` from the last tab, the window closing, and Ctrl-C alike. All
# three arrive here the same way, as the podman exec child terminating with a signal pending
# that we trapped -- which is why there is one teardown and not three.
#
# THE TUNNEL GOES FIRST, ALWAYS, for the reason remove_container spells out at length: an ssh
# client that outlives its container keeps all 46 host ports bound on the host's loopback
# against a pipe with nothing on the far end, so the NEXT tunnel can bind none of them and the
# student's next launch silently has no forwarding at all.
#
# TWO TIMEOUTS, TWO JOBS, and conflating them is the easy mistake here:
#   * `-t 3` is PODMAN's own SIGTERM-then-SIGKILL grace on PID 1. The default is 10, and
#     files/entrypoint.sh traps TERM and exits immediately, so the default would spend seven
#     of those seconds waiting on a process that exits in milliseconds.
#   * pmq is the outer bound on podman ITSELF hanging -- a slept Mac, a wedged VM -- which is
#     precisely what pm/pmq exist for, so this needs no fourth hand-rolled number.
#   * `-i` so an already-gone container is not an error. That really happens: a --rebuild run
#     from another window removes the container this shell was attached to.
#
# Worth knowing rather than assuming, because the flag name invites the wrong belief: podman
# TERMs ONLY PID 1. Every other process in the container is killed by the cgroup teardown, so
# no student process gets a clean shutdown whether -t is 3 or 10, and an unsaved nano buffer is
# lost either way. Making that work would mean TERMing the container's own processes before the
# stop; deliberately not done, see .private/README.md.
stop_container() {
    # Sampled ONCE, up front, so the message and the action cannot disagree: nothing announces
    # that it is stopping a container which is not running. shell_teardown reaches here on paths
    # where the container may already have gone -- see the unconditional tunnel_down below.
    local was_running
    was_running=''
    [ "$(state)" = running ] && was_running=1

    [ -n "$was_running" ] && note "$(msg status.stopping)"
    # UNCONDITIONAL, even when the container has already gone: a --rebuild run from another
    # window can have removed it out from under this shell, and an ssh client that outlives its
    # container still holds all 46 host ports against a pipe with nothing on the far end. That
    # is the failure remove_container documents, and skipping this on the "nothing to do" path
    # is how it would come back.
    tunnel_down
    [ -n "$was_running" ] && pmq stop -t 3 -i "$NAME"
    return 0
}

# The trapped wrapper. Separate from stop_container because the once-guard is only needed on
# this path: HUP runs the handler and EXIT then runs it again, and a second `podman stop` would
# print a second "stopping" line at the student for something already done. The maintenance
# verbs and --stop call stop_container directly, each exactly once.
#
# transient_cleanup because installing this on EXIT replaces the trap that would otherwise have
# done it. Nothing depends on that today -- the meter is stopped and the acknowledgement consumed
# long before open_shell -- but a handler that silently drops the animator's kill is a trap in
# both senses.
shell_teardown() {
    [ -n "$TEARDOWN_DONE" ] && return 0
    TEARDOWN_DONE=1
    transient_cleanup
    stop_container
}

# The same job for verb_rebuild's create window: podman run --detach returns, and until
# stop_container runs on the next line there is a container up that nobody is in. Since #41
# `state` = running IS the session test, so a Ctrl-C landing there does not just leave a
# container -- it makes the next `./cs193v` refuse to launch, naming a session that does not
# exist.
#
# Signals only, not EXIT: create_container's own failures (ENOSPC, a podman run that never came
# up) die with nothing running, so EXIT would buy nothing and would shadow transient_cleanup.
# The animator goes FIRST -- it redraws ten times a second and would otherwise paint over the
# "stopping" line -- and the exit then lets the EXIT trap run it again, which is harmless.
#
# The status is passed in rather than fixed at 130, because all three signals arrive here and
# 128+signal is what a caller reads to tell "the student pressed Ctrl-C" from "the window was
# closed". Reporting SIGINT for a SIGHUP would be a small lie told to every script that checks.
rebuild_interrupted() {                # rebuild_interrupted EXIT_STATUS
    # RT_SPIN FIRST, and it is not cosmetic. create_container sets it for `podman run` and clears
    # it on the line after; interrupting in between leaves it set, and run_timeout then prints it
    # to STDOUT on every later call -- including the one inside `$(state)`, whose `[ -t 1 ]` is
    # false because a command substitution's stdout is a pipe. state() then answers "Setting up
    # the course container... running" instead of "running", stop_container decides the container
    # is not up, and the interrupt leaves running exactly what this handler exists to stop.
    RT_SPIN=''
    transient_cleanup
    stop_container
    exit "${1:-130}"
}

# Refuse to disturb a session that is already open, and name the one way out of it.
#
# `state` = running IS the whole test, and it is deliberately no smarter than that. The
# alternative considered was a host-side registry of live clients so that several windows could
# share one container; it needs the same liveness question answered and it fails WORSE. A wrong
# answer there locks a student out of their own container, where a wrong answer here merely
# leaves one running -- which both the next launch and --stop recover from. See
# .private/README.md for the whole comparison.
#
# This is a check-then-act, so it is racy on its own, and it is NOT what carries the guarantee.
# It exists to produce a good message before any work happens. The rule is made true one layer
# down by an atomic claim: podman's own container-name uniqueness for absent -> running, and
# tmux's session namespace for exited -> running, since `podman start` is idempotent and
# reports nothing. Both measured; see the same README section.
refuse_if_session_live() {
    [ "$(state)" = running ] || return 0
    die "$(msg err.session-in-use)"
}

# A container created from a DIFFERENT copy of the course directory. Without this check, a
# student who downloads a fresh copy after breaking something silently gets the old container
# with the old mount, and their edits appear to vanish.
#
# THIS MUST BE ASKED BEFORE refuse_if_session_live, and getting that order wrong is a mistake
# #41 made once already: the session refusal only knows that SOMETHING is running, so on a
# machine with two copies of the course directory it answered "you already have a session open
# in another window" -- true, but it buried the one fact the student had to know, and its advice
# (`--stop`, then launch again) would have walked them straight back into the wrong container.
# Ownership is the more specific diagnosis, so it wins. 30-launcher-shim.sh's foreign-dir group
# is the regression test.
refuse_if_foreign_dir() {
    local owner_dir
    owner_dir="$(label_of cs193v.dir)"
    [ -n "$owner_dir" ] || return 0
    [ "$owner_dir" = "$DIR" ] && return 0
    die "$(msg err.other-directory INUSE="$owner_dir" YOURS="$DIR")"
}

open_shell() {
    # Declared BEFORE the exec below, not at the point of use: `local rc` is itself a command
    # and would reset $? to 0 before we could read the child's status.
    local rc
    # Refuse, rather than hang, when there is no terminal to open a shell on.
    #
    # `podman exec -it` allocates a pty, and a pty NEVER delivers EOF the way a pipe does —
    # so with a redirected stdin the container's `bash -l` waits forever for input that
    # cannot arrive, and the launcher looks wedged with no output. Redirecting from
    # /dev/null does not help; only sending a literal `exit` does. Measured: see
    # ERRORS.md B13.
    #
    # Checked here rather than in the dispatcher on purpose. Everything up to this point —
    # preflight, the drift prompts, creating or starting the container — is useful and
    # idempotent, so a script that gets this far has still done real work and the message
    # can say so.
    if [ ! -t 0 ]; then
        # ...but it does not get to leave a container running with nothing attached to it,
        # which is the exact state #41 exists to prevent. So the work is undone before the
        # message, and err.needs-a-terminal says "set up" rather than "up and running".
        shell_teardown
        die "$(msg err.needs-a-terminal)"
    fi

    # ─── 1. CLAIM THE SESSION, BEFORE ANY SETUP WORK ───────────────────────────
    # The launcher's `state` check is a check-then-act and `podman start` is idempotent and
    # silent, so this is the FIRST point at which we know we own the session. Everything that
    # touches a shared resource -- the tunnel and its host ports -- happens after it.
    #
    # `podman run --name` uniqueness is atomic too, but it only covers absent -> running, which
    # happens once in a container's lifetime. Since #41 `exited` is the resting state, so every
    # launch after the first takes `podman start` and tmux's session namespace is the only claim
    # that fires. See files/cs193v-shell.
    #
    # NO -it AND NO TRAP YET. This exec needs no pty, and a launch that loses here must not tear
    # anything down -- the winner owns the container. Not installing the trap until after we win
    # is what makes that true by construction; it used to need TEARDOWN_DONE and an explicit
    # `trap -` on the losing path.
    #
    # CS193V_COLS / CS193V_LINES: `tmux new-session -d` takes the size as arguments and cannot
    # read it from a tty it does not have. Without these every session would be created 80x24
    # and the banner would be laid out for it -- which matters more here than it did when claim
    # and attach were one exec, because cs193v-welcome now prints during the tunnel setup below.
    # CLAMPED, NOT JUST CHECKED FOR DIGITS, and 0 is the case that matters. A pty with no real
    # terminal behind it -- `script -q -c ... /dev/null`, which is how the suite drives a launch --
    # reports `0 0` from `stty size`. Both are numeric, so a digits-only guard passes them through,
    # and `tmux new-session -x 0` then fails with "width too small": the session is never created,
    # cs193v-shell prints its fault box, and the launch dies. Measured; it is what 70-sighup.sh and
    # 80-launcher-live.sh caught. The floor is below any usable terminal and above tmux's minimum.
    local cols lines
    cols=''; lines=''
    read -r lines cols < <(stty size 2>/dev/null) || true
    case "${cols:-}" in ''|*[!0-9]*) cols=0 ;; esac
    case "${lines:-}" in ''|*[!0-9]*) lines=0 ;; esac
    [ "$cols" -ge 20 ] || cols=80
    [ "$lines" -ge 5 ] || lines=24

    podman exec \
        -w "$MOUNT_DST" \
        -e "CS193V_CONTAINER=$NAME" \
        -e "CS193V_COLS=$cols" \
        -e "CS193V_LINES=$lines" \
        "$NAME" cs193v-shell --claim
    rc=$?

    # A lost claim race is not a fault -- it is the refusal arriving one layer down. Two launches
    # both found a stopped container, both started it, and tmux handed the single session to
    # whichever asked first. The loser reports it with the SAME message as the state check, so a
    # student never has to care which layer caught them.
    if [ "$rc" = "$RACE_LOST_STATUS" ]; then
        die "$(msg err.session-in-use)"
    fi
    # ANY OTHER FAILURE TEARS DOWN, and that is not symmetric with the line above. A lost race
    # must NOT stop the container -- the winner is in it. A broken claim (tmux missing, terminfo
    # gone; cs193v-shell has already printed its own box) leaves a container running with nobody
    # attached, which is the state #41 exists to prevent, and no trap is installed yet to catch
    # it. Same reasoning as the no-terminal path above.
    if [ "$rc" -ne 0 ]; then
        shell_teardown
        return "$rc"
    fi

    # ─── 2. NOW THE TRAP, AND NOT `exec` ───────────────────────────────────────
    # This is the line the whole of #41 rests on. `exec` replaced this process with podman, so no
    # process survived the shell to stop anything and the container simply stayed up forever. The
    # launcher now stays resident for the length of the session and tears it down afterwards.
    #
    # HUP IS TRAPPED EXPLICITLY, and that is not redundant with EXIT: bash's default action for
    # SIGHUP is to die WITHOUT running the EXIT trap, so closing the window -- the one case this
    # exists for -- would leave the container up.
    #
    # INSTALLED HERE rather than before the claim: from this point on we own a session, so dying
    # for any reason must take the container down with us.
    trap shell_teardown EXIT HUP INT TERM

    # ─── 3. SETUP WORK, now that it is provably ours ───────────────────────────
    # The tunnel lives here rather than in the dispatcher because it must come after the claim,
    # and the claim is here. `|| true` for the reason it always had: a container with no
    # browser-facing ports is perfectly usable, and ensure_tunnel has already said so.
    ensure_tunnel || true

    # LAST BEFORE THE ATTACH, so it covers everything printed on the way here -- including
    # anything the tunnel warned about -- and the warnings are still the newest thing on screen
    # while the student reads them. One line further down the student is inside tmux, whose
    # alternate screen erases all of it. See warn().
    acknowledge_warnings

    # ─── 4. ATTACH ─────────────────────────────────────────────────────────────
    # FOREGROUND, not backgrounded-and-waited. Backgrounding raises the question of whether
    # `podman exec -it` takes SIGTTIN on its first read from the tty; it should not, because job
    # control is off in a non-interactive shell so the child stays in the terminal's foreground
    # process group -- but that is an assumption worth not needing. Foregrounded, the same
    # SIGHUP that closes the window kills the child AND is pending for us, so bash runs the
    # handler as soon as it reaps it.
    #
    # CS193V_CONTAINER is passed because cs193v-shell's failure path has to tell a student the
    # exact `podman exec` line to run, and nothing inside the container can work out the
    # container's name -- CS193V_INSTANCE may have suffixed it, and the hostname is
    # cs193v-development either way.
    podman exec -it \
        -w "$MOUNT_DST" \
        -e "TERM=$(safe_term)" \
        -e "COLORTERM=${COLORTERM:-}" \
        -e "CS193V_CONTAINER=$NAME" \
        "$NAME" cs193v-shell --attach
    rc=$?
    return "$rc"
}

# ─── verbs ─────────────────────────────────────────────────────────────────────
verb_doctor() {
    printf '%sCS193V container report%s\n' "$C_CYAN" "$C_OFF"
    printf '%s\n' "-------------------------------------------------------------"
    printf '  %-16s %s\n' "platform" "$(platform) / $(uname -m)"
    printf '  %-16s %s\n' "course dir" "$DIR"

    if command -v podman >/dev/null 2>&1 && run_timeout 10 podman --version; then
        printf '  %-16s %s\n' "podman" "$(podman_version_of "$RT_OUT")"
    else
        printf '  %-16s %s\n' "podman" "NOT FOUND or not responding"
        return 1
    fi

    if has_machine; then
        pm machine list --format '{{.Name}} {{.Running}}'
        printf '  %-16s %s\n' "machine" "${RT_OUT:-none}"
    fi

    # TWO CALLS, AND THE SPLIT IS LOAD-BEARING. .Host.RootlessNetworkCmd does not exist before
    # podman 5.x -- measured: podman 4.9.3 answers `can't evaluate field RootlessNetworkCmd in
    # type *define.HostInfo` -- and a Go template that names a missing STRUCT field fails the
    # whole call rather than substituting an empty string. So on any 4.9.x machine, which the
    # Linux floor now admits, this printed "TIMED OUT (a Mac that has slept can do this)" on a
    # Linux box that had not timed out and was not a Mac. The fields that exist everywhere are
    # asked for together; the one that does not is asked for on its own and simply omitted when
    # podman has never heard of it.
    if pm info --format '{{.Host.MemTotal}} {{.Host.CPUs}}'; then
        local seen="$RT_OUT"
        if pm info --format '{{.Host.RootlessNetworkCmd}}'; then seen="$seen $RT_OUT"; fi
        printf '  %-16s %s\n' "podman sees" "$seen"
    else
        printf '  %-16s %s\n' "podman info" "TIMED OUT (a Mac that has slept can do this)"
    fi

    # The image, and whether it still matches the recipe it was built from. This is the
    # replacement for "what digest are you on?" -- the first question in any support thread
    # about behaviour that staff cannot reproduce, and the one a locally built image would
    # otherwise have no answer to.
    load_args
    if pmq image exists "$IMAGE"; then
        printf '  %-16s %s\n' "image" "$IMAGE (built here)"
        pm image inspect "$IMAGE" --format '{{.Created}}'
        printf '  %-16s %s\n' "image built" "${RT_OUT:-?}"
        local hb
        hb="$(image_label_of "$IMAGE" cs193v.buildhash)"
        if [ ! -f "$CONTAINERFILE" ]; then
            printf '  %-16s %s\n' "image recipe" "cannot check — no $CONTAINERFILE"
        elif [ -z "$hb" ]; then
            printf '  %-16s %s\n' "image recipe" "not recorded (built by hand, or before this was tracked)"
        elif [ "$hb" = "$(build_hash)" ]; then
            printf '  %-16s %s\n' "image recipe" "matches Containerfile ($(printf '%s' "$hb" | cut -c1-12))"
        else
            printf '  %-16s %s\n' "image recipe" "STALE — run ./cs193v --rebuild"
        fi
    else
        printf '  %-16s %s\n' "image" "$IMAGE — NOT BUILT; run ./cs193v --rebuild"
    fi

    local st; st="$(state)"
    printf '  %-16s %s\n' "container" "$st"
    # What "running" MEANS changed with #41, and doctor is where a student or a TA reads it. Every
    # ordinary way of finishing now stops the container, so `exited` is the healthy resting state
    # and must not look like a fault -- while `running` means somebody has a window open, or a
    # window was force-quit and no trap ran.
    #
    # DELIBERATELY NOT GUESSED AT. The obvious thing is to ask tmux whether a client is attached,
    # and it does not work: conmon keeps a dead session's pty open, so tmux reports a client
    # indefinitely after the window is gone (measured; ERRORS.md D1). A `list-clients` check would
    # therefore answer "attached" in exactly the case worth reporting. Deciding it host-side means a
    # `ps` scan for our own exec process, which is a heuristic this launcher does not otherwise need.
    #
    # So both readings are printed and the student picks -- which is the same choice
    # err.session-in-use makes, and for the same reason: they know whether they have a window open,
    # and no test here can.
    case "$st" in
        exited)  printf '  %-16s %s\n' "" "normal — nothing is open right now" ;;
        running) printf '  %-16s %s\n' "" "a terminal window has this open. If you have none"
                 printf '  %-16s %s\n' "" "open, one was force-quit — run: cs193v --stop" ;;
    esac
    if [ "$st" != absent ]; then
        pm inspect "$NAME" --format '{{.State.StartedAt}}'
        printf '  %-16s %s\n' "started" "$RT_OUT"
        local hv hw; hv="$(label_of cs193v.confighash)"; hw="$(config_hash)"
        if [ "$hv" = "$hw" ]; then printf '  %-16s %s\n' "config" "matches container.args"
        else printf '  %-16s %s\n' "config" "STALE — run cs193v and accept the recreate prompt"; fi
        pm inspect "$NAME" --format "{{range .Mounts}}{{if eq .Destination \"$MOUNT_DST\"}}{{.Source}}{{end}}{{end}}"
        printf '  %-16s %s\n' "workspace" "${RT_OUT:-?}"
    fi

    if [ "$st" = running ]; then
        pm exec "$NAME" sh -c 'echo "$(id -u):$(id -g)"'
        printf '  %-16s %s (host is %s:%s)\n' "in-container uid" "$RT_OUT" "$(id -u)" "$(id -g)"
        pm exec "$NAME" sh -c 'cat /sys/fs/cgroup/memory.max 2>/dev/null'
        printf '  %-16s %s\n' "memory limit" "${RT_OUT:-unknown}"
        # SPLIT BY PARENT, because the bare count this replaced needed a footnote in three
        # documents. A zombie is its PARENT's business: PID 1 collects the ones reparented onto
        # it, and one whose parent is alive and is not PID 1 -- sshd holds exactly one for the
        # tunnel's whole life -- is not reachable by any init, ours or catatonit's. So the number
        # a TA should read is the first one, and "0 unreaped" means healthy with nothing to
        # remember. Growth in the second is worth mentioning to staff; a steady 1 is not.
        #
        # The ps runs bare and the split happens HERE, so there is no awk quoted inside an
        # `sh -c` inside a `podman exec` to get wrong.
        pm exec "$NAME" ps -eo ppid,stat --no-headers
        printf '  %-16s %s\n' "zombies" "$(printf '%s\n' "${RT_OUT}" \
            | awk 'NF >= 2 { seen++ }
                   $2 ~ /Z/ { t++; if ($1 == 1) n++ }
                   END { if (seen == 0) print "unknown"
                         else printf "%d unreaped, %d held by a live parent", n+0, t-n+0 }')"
        tmux_doctor
        tunnel_doctor
        check_clock
    fi
    printf '%s\n' "-------------------------------------------------------------"
    printf '%s\n' "Paste all of the above when asking course staff for help."
}

# tmux is the landing point, so "what is my session doing" is now a support question. A
# student who says "my tabs vanished" is describing session state that nothing else here shows.
#
# Sessions and their window counts, plus the clients attached to each. WHAT THESE NUMBERS MEAN
# INVERTED WITH #41, and the old reading is now the diagnosis rather than the normal case:
# there is exactly one session, it has exactly one client, and it lives only as long as the
# terminal does. A session with 0 clients used to be "waiting to be picked back up by the next
# ./cs193v"; now nothing picks it up, and seeing one means a window was force-quit and the
# container outlived it. Two clients on one session is no longer reachable at all.
tmux_doctor() {
    local out
    if pm exec "$NAME" tmux -L cs193v list-sessions \
           -F '#{session_name} #{session_windows}w #{session_attached} attached' 2>/dev/null; then
        out="$RT_OUT"
    else
        printf '  %-16s none (nobody is in the container right now)\n' "tmux sessions"
        return 0
    fi
    if [ -z "$out" ]; then
        printf '  %-16s none (nobody is in the container right now)\n' "tmux sessions"
        return 0
    fi
    printf '  %-16s %s\n' "tmux sessions" "$(printf '%s\n' "$out" | head -1)"
    printf '%s\n' "$out" | tail -n +2 | while IFS= read -r line; do
        [ -n "$line" ] && printf '  %-16s %s\n' "" "$line"
    done
}

# The tunnel's state is the ONLY place host-side forwarding is visible, which makes this
# load-bearing for support rather than decorative. It replaced a `podman port` count, and the
# difference matters: nothing inside the container can see whether a forward exists on the host
# at all, so when a student's server is listening on a forwarded port and their browser still
# cannot reach it, this report is the answer, and nothing else is.
tunnel_doctor() {
    local pid state ports n up
    if tunnel_alive; then
        pid="$(cat "$TUNNEL_PID" 2>/dev/null)"
        printf '  %-16s up (pid %s)\n' "tunnel" "${pid:-?}"
    else
        printf '  %-16s %sDOWN%s — run: cs193v --reset-tunnel\n' "tunnel" "$C_YEL" "$C_OFF"
        return 0
    fi

    # THERE IS NO "N OF N" ANY MORE, and its absence is the point rather than a loss. The
    # denominator used to be the length of a declared list, which made "46 of 46" a sentence
    # about a config file; what a student needs to know is which of the ports they are actually
    # using is reachable, and that is a runtime fact with a reason attached to each entry.
    #
    # THE ONE CASE NOTHING ELSE CATCHES is a perfectly healthy container with no supervisor
    # running, so that is checked first and separately -- the state file would otherwise be read
    # as authoritative while nothing was maintaining it.
    if ! tunnel_sup_alive; then
        printf '  %-16s %snot running%s — run: cs193v --reset-tunnel\n' \
               "dynamic ports" "$C_YEL" "$C_OFF"
        return 0
    fi

    # `pm`, NOT `pmq`, and RT_OUT rather than a command substitution: pmq sends stdout to
    # /dev/null, so reading it this way always saw an empty file and doctor silently printed no
    # dynamic line at all. run_timeout leaves the output in RT_OUT, which is how every other
    # probe in this report reads its answer.
    ports=''
    pm exec "$NAME" cat /tmp/cs193v/ports && ports="$RT_OUT"
    # AND IF THAT READ FAILS, SAY NOTHING EXTRA. verb_doctor has already run four probes through
    # this same container by the time it reaches here, each of which renders visibly empty when
    # podman is not answering. A fifth line saying so would be noise on top of a diagnosis the
    # student already has.
    [ -n "$ports" ] || return 0

    state="$(printf '%s\n' "$ports" | awk -F'\t' '$1=="state"{print $2; exit}')"
    case "${state:-}" in
        ''|healthy) ;;
        *) printf '  %-16s %s%s%s — %s\n' "dynamic ports" "$C_YEL" "$state" "$C_OFF" \
                  "$(printf '%s\n' "$ports" | awk -F'\t' '$1=="reason"{print $2; exit}')" ;;
    esac

    up="$(printf '%s\n' "$ports" | awk -F'\t' '$1=="up"{printf "%s ", $2}')"
    n="$(printf '%s\n' "$ports" | awk -F'\t' '$1=="up"' | wc -l | tr -d ' ')"
    if [ "$n" -gt 0 ]; then
        printf '  %-16s %s forwarded: %s\n' "dynamic ports" "$n" "${up% }"
    else
        printf '  %-16s nothing is listening inside the container yet\n' "dynamic ports"
    fi

    # ONE LINE PER REASON, not one per port, and the reason carries the advice. Which of them is
    # retryable is the distinction that shapes what a student should do -- "quit that program"
    # versus "bind 127.0.0.1 instead" -- so it lives here, in the message, rather than as a column
    # in the state file that every reader would have to interpret for itself.
    printf '%s\n' "$ports" | awk -F'\t' '$1=="refused"{n[$3]++; p[$3]=p[$3] " " $2}
        END{for (r in n) printf "%s\t%d\t%s\n", r, n[r], substr(p[r], 2)}' |
    while IFS="$(printf '\t')" read -r reason count plist; do
        case "$reason" in
            busy)        why="another program on this computer holds those" ;;
            capped)      why="too many ports are already forwarded" ;;
            v6lo)        why="only reachable over IPv6 — bind 127.0.0.1 or 0.0.0.0 instead" ;;
            loalt)       why="bound to another loopback address — bind 127.0.0.1 instead" ;;
            eth)         why="bound to the container's network interface, not its loopback" ;;
            below-floor) why="below the lowest port this computer lets a program open" ;;
            *)           why="refused" ;;
        esac
        printf '  %-16s %s%s %s:%s %s — %s\n' "dynamic ports" \
               "$C_YEL" "$count" "$reason" "$C_OFF" "$plist" "$why"
    done
}

# The container CANNOT fix its own wall clock: Linux time namespaces virtualise only
# CLOCK_MONOTONIC and CLOCK_BOOTTIME, never CLOCK_REALTIME; setting the clock needs
# CAP_SYS_TIME, which is not in podman's default set; and the kernel checks that
# capability against the INITIAL user namespace anyway. So detection here, remedy in
# the VM. Symptoms all look like network faults: TLS "certificate not yet valid", apt
# complaining about future-dated release files, auth failures.
check_clock() {
    local hs cs skew
    hs="$(date +%s)"
    pm exec "$NAME" date +%s || return 0
    cs="$RT_OUT"
    case "$cs" in ''|*[!0-9]*) return 0 ;; esac
    skew=$(( cs - hs )); [ "$skew" -lt 0 ] && skew=$(( -skew ))
    if [ "$skew" -le 5 ]; then
        printf '  %-16s %ss\n' "clock skew" "$skew"
        return 0
    fi
    printf '  %-16s %ss  %sPROBLEM%s\n' "clock skew" "$skew" "$C_YEL" "$C_OFF"
    has_machine || return 0
    printf '\n'; msg prompt.clock-drift SKEW="$skew"
    if confirm "$(msg opt.leave-clock)" "$(msg opt.restart-machine)"; then
        info "$(msg status.restarting-machine)"
        run_timeout 120 podman machine stop || true
        run_timeout 180 podman machine start || warn "$(msg warn.machine-restart-failed)"
        # Restarting the machine kills the tunnel with it: its transport is a `podman exec`
        # into a VM that just went away. Without this, the clock fix would silently cost the
        # student every forwarded port, and the next symptom would look unrelated to the
        # prompt they just accepted.
        tunnel_down
        ensure_tunnel || true
    fi
}

# The only verb that creates a container. What decides whether it BUILDS first is the recipe
# hash, not a flag:
#
#   recipe unchanged  ->  recreate only, ~2s, no network, no disk
#   recipe moved      ->  build, then recreate
#   no image at all   ->  build; this is the installer's first run
#   --no-cache        ->  build regardless, for staff and the release gate
#
# It prompts for nothing, which is what lets install-cs193v.sh call it with no tty; note that
# ensure_container ASKS on the same predicate -- see the comment there.
#
# --logout also deletes every volume, which now includes the git one -- so it takes away the
# identity and the credential helper setup-git configured along with the tokens themselves. That
# is the right reading of "log out" rather than an oversight: leaving the credential helper line
# behind would point git at a token that no longer exists. It is the only irreversible thing the
# launcher does.
verb_rebuild() {
    local nocache='' wipe=''
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-cache) nocache='--no-cache' ;;
            --logout)   wipe=1 ;;
            # Strict: with two modifiers that both matter, a typo has to be loud.
            *)          usage; exit 2 ;;
        esac
        shift
    done

    preflight; refuse_if_session_live; load_args

    if [ -n "$nocache" ] || ! pmq image exists "$IMAGE" || recipe_moved; then
        build_image "$nocache"
    elif [ -n "$wipe" ]; then
        # TWO KEYS: status.rebuilding promises logins are kept, which is false here. Printed only
        # on the no-build branches -- build_image owns the progress meter until create_container
        # closes it (issue #24), so a line here would land in the middle of a live bar.
        info "$(msg status.rebuilding-logout)"
    else
        info "$(msg status.rebuilding)"
    fi

    remove_container
    [ -n "$wipe" ] && remove_volumes
    # Cleared on the line after stop_container rather than left installed: past there is nothing
    # running to clean up, and an interrupt during the success box should behave like an
    # interrupt anywhere else. Same shape as open_shell's handoff.
    trap 'rebuild_interrupted 130' INT
    trap 'rebuild_interrupted 143' TERM
    trap 'rebuild_interrupted 129' HUP
    create_container
    stop_container
    trap - INT TERM HUP

    # Not one if/elif chain ending in the box: the logout has to be reported whether or not a
    # build happened, or a --logout that also built would never mention it.
    if [ -n "$wipe" ]; then
        info "$(msg status.full-rebuilt)"
    elif [ -z "$BUILT" ]; then
        info "$(msg status.rebuilt)"
    fi
    [ -n "$BUILT" ] && msg status.build-succeeded | celebrate "Build Successful!"
    return 0
}

# Stop the container by hand. The unified answer to "the container is busy", which is why every
# refusal in this script names it.
#
# It exists as a student-facing verb rather than as advice to run `podman stop` because the
# student who needs it is the one whose terminal was force-quit or whose machine crashed: they
# have a container running with nothing attached to it, `./cs193v` refuses, and this is the one
# command that gets them back to a state where launching works. Advice to run a raw podman
# command would be the only place in the course that asks that of them.
#
# Prompted, because it can throw away work: anything running in a session belonging to another
# window dies with the container, and a student who mis-reads a refusal should not be one
# keystroke from stopping the session they are actually using.
verb_stop() {
    preflight; load_args
    if [ "$(state)" != running ]; then
        info "$(msg status.already-stopped)"
        return 0
    fi
    printf '\n'; msg prompt.stop
    if ! confirm "$(msg opt.cancel)" "$(msg opt.stop-go)"; then
        info "$(msg status.cancelled)"; return 0
    fi
    stop_container
    info "$(msg status.stopped)"
}

# The escape hatch for a tunnel that has stopped answering. Its whole reason for existing is
# the case where the tunnel is STUCK, so nothing in it may depend on the tunnel being healthy
# -- that is the difference between this and tunnel_down.
#
# Worth saying plainly, because the symptom is easy to misread: a wedged tunnel does NOT stop
# the container from starting. podman starts it regardless. What a stale tunnel blocks is the
# NEXT tunnel binding the host ports it is still holding, so the symptom is "my browser cannot
# reach my server", not "the container will not start".
verb_reset_tunnel() {
    preflight; load_args; require_image
    info "$(msg status.tunnel-resetting)"

    # 1. The clean way first, but TIME-BOXED. A wedged ssh may never answer -O exit, and
    #    waiting forever for it is precisely the failure this verb exists to break out of.
    if [ -S "$TUNNEL_CTL" ]; then
        run_timeout 10 ssh -S "$TUNNEL_CTL" -O exit "$TUNNEL_USER@$TUNNEL_HOST" >/dev/null 2>&1 || true
    fi

    # 2. Then force, UNCONDITIONALLY -- the difference between this verb and tunnel_down, which
    #    forces only when the clean way did not work. Here the clean way answering proves
    #    nothing: this is the escape hatch, and it is used by someone who has already decided
    #    the tunnel is lying to them.
    tunnel_kill_pid

    # 3. A leftover socket makes the next -O check report a dead tunnel as live, which would
    #    make ensure_tunnel decide there was nothing to do.
    rm -f "$TUNNEL_CTL" "$TUNNEL_PID" "$TUNNEL_LOG"

    # 4. Only now is it meaningful to ask who still holds the ports. Anything left is NOT ours
    #    -- it is another program on the student's computer -- and naming it is the difference
    #    between a fixable problem and a mystery.
    if [ "$(state)" != running ]; then
        warn "$(msg warn.tunnel-reset-not-running)"
        return 0
    fi
    ensure_tunnel || return 1
    info "$(msg status.tunnel-reset)"
}

verb_print_command() {
    load_args
    build_run_args
    printf 'podman run'
    local a
    for a in ${RUN_ARGS[@]+"${RUN_ARGS[@]}"}; do printf ' %s' "$a"; done
    printf ' %s\n' "$IMAGE"
}

# The args files' parse, one word per line. The seam 16-args-parse.sh drives.
#
# WHY NOT --dev-print-command, which already prints every one of these words: it joins them
# with spaces, so `--label a="x y"` and the two words `--label` `a="x` print the same thing,
# and a word that is a bare \r is invisible in it entirely. Nearly everything load_args can
# get wrong is a WORD BOUNDARY, and that verb is the one thing that cannot show one. Same
# argument as verb_dev_steps below, one layer down.
#
# ONE WORD PER LINE NEEDS NO NUL DELIMITER, which is worth stating because it looks unsafe:
# load_args reads with `read`, which splits its input on newlines, so no word in ARGS can
# contain one. Nor can a word be empty -- word splitting on whitespace IFS drops empty fields.
#
# Plain strings rather than messages.txt keys, like the other --dev verbs: that catalogue is
# for students.
verb_dev_args() {
    load_args
    local a
    # ${ARGS[@]+"..."}, for the reason build_run_args spells out: expanding an EMPTY array
    # under `set -u` is fatal on bash 3.2, and an args file of nothing but comments is exactly
    # the case this verb exists to let a test ask about.
    for a in ${ARGS[@]+"${ARGS[@]}"}; do printf '%s\n' "$a"; done
}

# The tunnel's own facts: which host ports it forwards, and the files that identify it. The seam
# tests/lib/assert.sh reads, and the answer to issue #46.
#
# NO PORTS ARE PRINTED HERE ANY MORE, and nothing replaced them: there is no declared list to
# expand, and which ports are forwarded right now is a fact about what is listening inside the
# container. /tmp/cs193v/ports is where that lives, a test reads it the same way `doctor` and
# `shortlink` do, and a second copy on this side would be a second thing to keep true.
#
# THE PATHS ARE HERE BECAUSE "IS THIS LISTENER MINE" HAS NO OTHER CHEAP ANSWER, and that
# question is the other half of #46: count_forwards used to count any listener on those ports, so
# a colleague's tunnel satisfied the gate for an instance holding none of them. TUNNEL_ID hashes
# the course directory and the instance, so a test cannot derive these names -- and with the
# control socket in hand a test can apply tunnel_kill_pid's own identity test, which is the only
# honest one available: our socket is on our master's command line and on nothing else's.
#
# TAB-SEPARATED KEY AND VALUE, repeated for `port`, like --dev-args prints one word per line: a
# path can contain a space and a key cannot contain a tab, so the split is unambiguous. warn()
# writes to stderr, so a malformed range in the args file cannot corrupt this.
#
# Plain strings rather than messages.txt keys, like the other --dev verbs: that catalogue is
# for students.
verb_dev_tunnel() {
    load_args
    printf 'ctl\t%s\n'  "$TUNNEL_CTL"
    printf 'pid\t%s\n'  "$TUNNEL_PID"
    printf 'log\t%s\n'  "$TUNNEL_LOG"
    # NOT one of the tunnel's files, and here anyway: it is keyed by the same TUNNEL_ID, and the
    # release gate has to be able to find OUR build's log. It used to glob TMPDIR for the newest
    # cs193v-build-*.log, which is per-machine and therefore a colleague's as often as ours (#74).
    printf 'buildlog\t%s\n' "$BUILD_LOG"
    printf 'suppid\t%s\n' "$TUNNEL_SUP_PIDFILE"
    printf 'suplog\t%s\n' "$TUNNEL_SUP_LOG"
}

# What the meter thinks the build is going to do, as a table: index, label, instruction text.
# The seam the parser is tested through -- buried inside build_progress it could only be
# reached by running a whole build, which is the wrong granularity for "does a comment inside
# a continuation end it". 15-containerfile-parse.sh drives this with fixture Containerfiles,
# and 00-release-gates.sh diffs it against the STEP lines of a real podman build, which is the
# only check that can prove the parse and podman agree.
#
# Plain strings rather than messages.txt keys, like the other --dev verbs: that catalogue is
# for students.
verb_dev_steps() {
    local f="${1:-$CONTAINERFILE}"
    [ -f "$f" ] || die "$(msg err.no-containerfile FILE="$f")"
    LC_ALL=C awk -v cf="$f" "$CF_PARSE_AWK"'
        BEGIN {
            n = cf_parse(cf, label, text)
            for (i = 1; i <= n; i++) printf "%d\t%s\t%s\n", i, label[i], text[i]
        }
    '
}

usage() {
    msg help.usage
}

# ─── dispatch ──────────────────────────────────────────────────────────────────
#
# THE INVARIANT THIS ENFORCES: a running container implies an open terminal. Issue #41.
#
# Which is why verb_rebuild ends in stop_container rather than leaving one up for the next
# command. Nobody is attached when it finishes, so "running" always means "somebody is in
# there", and a running container with nothing attached is a force-quit leftover.
#
# doctor and --reset-tunnel take no reference and stop nothing. --reset-tunnel especially:
# its whole purpose is fixing the tunnel WHILE a session is live.
#
# The same invariant decides where the TUNNEL is raised, and it is NOT raised here. It is raised
# inside open_shell, after the session claim -- see the numbered blocks there. The predicate that
# matters is "we own the session", not "a container exists", and only the claim establishes it: a
# launch that is going to lose the race would otherwise bind host ports it then abandons. That was
# already wasteful and became worse once a port supervisor rode alongside the tunnel.
#
# The predicate has been wrong twice before, each time by being too weak. It used to be raised in
# create_container and again at the end of ensure_container -- two sites both spelling "a container
# exists", so --rebuild made one, stopped it on the next line, and left a tunnel holding all its
# host ports (which CS193V_INSTANCE does NOT namespace, see CLAUDE.md) for a container nobody could
# be in. Moving it to this arm fixed that and left the weaker half: this arm is where a session
# BEGINS, but not where one is WON. Failure is still deliberately not fatal: the container and the
# shell are perfectly usable, only the browser-facing ports are missing, and ensure_tunnel says so.
case "${1:-}" in
    # ANNOUNCED BEFORE THE FIRST PROBE, and the order is the whole of issue #57. Everything on this
    # arm is silent when it succeeds, and it is not quick: preflight's single `podman info` measures
    # 536-1222 ms by itself (ERRORS.md D11) and the probes behind it take the rest of a second -- so
    # a student typed a command and watched nothing happen for long enough to wonder whether they
    # had typed it wrong. `info` rather than anything animated: it reaches a redirected log and a
    # piped transcript as well as a terminal, and it leaves no frame clock, no cursor state and
    # nothing that has to be taken down before the next thing printed.
    #
    # refuse_if_foreign_dir FIRST of the checks: "this container belongs to a different copy of the
    # course directory" is a more specific diagnosis than "something is already running", and
    # losing it behind the session refusal would send a student to --stop and then straight back
    # into the wrong container. See the comment on the function.
    '')                  info "$(msg status.entering)"
                         preflight; refuse_if_foreign_dir; refuse_if_session_live
                         load_args; require_image; ensure_container
                         open_shell ;;
    doctor)              verb_doctor ;;
    --stop)              verb_stop ;;
    --reset-tunnel)      verb_reset_tunnel ;;
    # "$@", not "${1:-}": the two modifiers are independent and may be given together.
    --rebuild)           shift; verb_rebuild "$@" ;;
    --dev-print-command) verb_print_command ;;
    # No preflight here either, and 16-args-parse.sh asserts it by counting podman calls: the
    # args files are all this reads, and the unit tier drives it with no podman running.
    --dev-args)          verb_dev_args ;;
    # No preflight, for the same reason and asserted the same way: 16-args-parse.sh counts podman
    # calls, and this verb reads the args files and does string arithmetic on TMPDIR paths. It is
    # what the test suite derives the forwarded port list from, so it must be answerable on a
    # machine with no podman at all -- the unit tier's whole promise.
    --dev-tunnel)        verb_dev_tunnel ;;
    # The port supervisor's own process. Not for people: tunnel_sup_start runs it, and it is a
    # verb rather than an inline subshell so `ps` shows something recognisable and so the suite
    # can drive it directly.
    --dev-supervise)     verb_supervise ;;
    # No preflight: this one reads the Containerfile and nothing else, which is what lets the
    # unit tier drive it with no podman on PATH at all.
    --dev-steps)         shift; verb_dev_steps "${1:-}" ;;
    -h|--help|help)      usage ;;
    *)                   usage; exit 2 ;;
esac
