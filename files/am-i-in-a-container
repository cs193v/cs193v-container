#!/bin/sh
#
# The milestone check the install guides point students at. Kept deliberately simple and
# with the same shape as the devcontainer's `am-i-in-a-dev-container`, so the guides read
# the same way.

echo "Yes, you are inside the CS193V container!"
echo
echo "  projects  : $HOME/projects   (this is your projects/ folder on your own computer)"
echo "  user      : $(id -un) (uid $(id -u))"
if [ -n "${CS193V_PORTS:-}" ]; then
    echo "  ports     : $CS193V_PORTS"
    echo "              run 'ports' to check whether a server is reachable"
fi
if [ -n "${CS193V_MEMORY_MB:-}" ]; then
    echo "  memory    : ${CS193V_MEMORY_MB} MB limit"
fi
