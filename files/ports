#!/usr/bin/env python3
"""
ports — is my dev server reachable from my browser, and if not, why?

Reads the kernel's own socket table (/proc/net/tcp and /proc/net/tcp6), decodes which
address each listener is bound to, and compares that against the ports this container
actually publishes to the host.

It exists because a fixed published range has exactly two failure modes and BOTH are
invisible from inside:

  1. A server bound to the container's 127.0.0.1 is unreachable from the host browser.
     The container is a separate machine, so "only this machine" excludes your browser.
     Podman's port forwarder delivers to the container's eth0, never its loopback — so
     the connection is refused while the server's log cheerfully prints
     "Local: http://localhost:5173/". The log is a lie, not a hint.

  2. A server on a port outside the published set is unreachable no matter what it is
     bound to. vite's auto-increment walks 5173 -> 5174 -> 5175 when a port is busy, and
     `python -m http.server` defaults to 8000, so this happens by accident constantly.

The published set arrives as CS193V_PORTS at container-create time, because ports are
frozen when the container is created and cannot be added to a running one.
"""

import os
import sys

TCP_LISTEN = "0A"  # st == 0x0A means LISTEN


def parse_ranges(spec):
    """'3000-3009,8888' -> [(3000, 3009), (8888, 8888)]"""
    out = []
    for chunk in spec.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        if "-" in chunk:
            lo, _, hi = chunk.partition("-")
            out.append((int(lo), int(hi)))
        else:
            out.append((int(chunk), int(chunk)))
    return out


def published(port, ranges):
    return any(lo <= port <= hi for lo, hi in ranges)


def decode_v4(hexaddr):
    """/proc/net/tcp stores IPv4 little-endian: '0100007F' -> 127.0.0.1"""
    octets = [int(hexaddr[i:i + 2], 16) for i in (6, 4, 2, 0)]
    return ".".join(str(o) for o in octets)


def listeners():
    """-> set of (port, bound_address, is_wildcard)"""
    found = set()
    for path, v6 in (("/proc/net/tcp", False), ("/proc/net/tcp6", True)):
        try:
            with open(path) as fh:
                lines = fh.read().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            f = line.split()
            if len(f) < 4 or f[3] != TCP_LISTEN:
                continue
            local, _, port_hex = f[1].rpartition(":")
            port = int(port_hex, 16)
            if v6:
                wildcard = set(local) == {"0"}
                shown = "::" if wildcard else "[" + local + "]"
            else:
                shown = decode_v4(local)
                wildcard = shown == "0.0.0.0"
            found.add((port, shown, wildcard))
    return found


def suggest(port, ranges):
    """What to advise for a port outside the published set.

    A port just past the end of a range is almost always an auto-increment overflow
    (vite walks 5173 -> 5174 -> ... and can step past 5179), so point back at that
    range. A port nowhere near anything was chosen freely, so don't invent false
    precision about which range is "nearest" — say to pick from the published list.
    """
    if not ranges:
        return "the published list below"
    lo, hi = min(ranges, key=lambda r: min(abs(port - r[0]), abs(port - r[1])))
    if min(abs(port - lo), abs(port - hi)) > 20:
        return "any published range (listed below)"
    return "%d-%d" % (lo, hi) if lo != hi else str(lo)


def main():
    spec = os.environ.get("CS193V_PORTS", "")
    if not spec:
        sys.stderr.write(
            "CS193V_PORTS is not set, so I do not know which ports this container\n"
            "publishes. That variable is set when the container is created, so this\n"
            "usually means the container predates it — try:  cs193v --rebuild\n"
        )
        return 2
    ranges = parse_ranges(spec)

    rows = sorted(listeners())
    # Collapse the dual-stack case: a wildcard IPv6 listener also accepts IPv4.
    by_port = {}
    for port, shown, wildcard in rows:
        prev = by_port.get(port)
        if prev is None or (wildcard and not prev[1]):
            by_port[port] = (shown, wildcard)

    print("  %-6s %-12s %-14s %s" % ("PORT", "BOUND TO", "STATUS", "WHAT TO DO"))
    print("  " + "-" * 74)

    problems = 0
    if not by_port:
        print("  (nothing is listening inside the container)")

    for port in sorted(by_port):
        shown, wildcard = by_port[port]
        pub = published(port, ranges)
        if pub and wildcard:
            status, advice = "OK", "http://localhost:%d/" % port
        elif pub and not wildcard:
            problems += 1
            status = "UNREACHABLE"
            advice = "bound to %s only; restart it with --host 0.0.0.0" % shown
        elif wildcard:
            problems += 1
            status = "NOT PUBLISHED"
            advice = "restart it on a port in %s" % suggest(port, ranges)
        else:
            problems += 1
            status = "NOT PUBLISHED"
            advice = ("two problems: restart it on %s, with --host 0.0.0.0"
                      % suggest(port, ranges))
        print("  %-6d %-12s %-14s %s" % (port, shown, status, advice))

    print("  " + "-" * 74)
    print("  published: " + ", ".join("%d-%d" % (a, b) if a != b else str(a)
                                      for a, b in ranges))
    if problems:
        print()
        print("  Why 0.0.0.0: this container is a separate machine from your browser.")
        print("  127.0.0.1 means \"only this machine\", which excludes your browser.")
        print("  0.0.0.0 means \"any interface\", which is what lets it through.")
        print("  Your own machine is still the only one that can reach it: the host")
        print("  side of every published port is pinned to 127.0.0.1.")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
