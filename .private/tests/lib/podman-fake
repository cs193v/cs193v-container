#!/bin/sh
#
# A fake `podman`, for testing the launcher's state machine without creating anything.
#
# Put its directory first on PATH and $CS193V_SHIM points at the same directory, which
# holds both its configuration and its recorded state. Every invocation is appended to
# $CS193V_SHIM/argv.log, one line, tab-separated, so a test can assert on what the
# launcher actually asked podman to do.
#
# It is a state machine on purpose, not a stub: `run` flips state to running and stores
# the labels and image it was handed, and `rm` flips it back to absent. That is what makes
# VERIFICATION.md §A.10's idempotency property ("20 invocations, still exactly one
# container") and §2.5's config-drift trap testable with no container in sight — the
# second invocation reads back the hash the first one wrote.
#
# Configuration files, all optional (defaults in get()):
#   version          what `podman --version` prints        [podman version 5.7.0]
#   hang             if present, every call sleeps forever  (the woken-Mac case)
#   rootless         .Host.Security.Rootless                [true]
#   info_rc          exit code for `podman info`            [0]
#   state            absent | created | running | exited    [absent]
#   label_hash       the cs193v.confighash label            [] (empty until a run)
#   label_dir        the cs193v.dir label                   [] (empty until a run)
#   image_exists     yes | no, for `podman image exists`    [yes]
#   image_buildhash  the cs193v.buildhash image label       [] (unlabelled). A successful
#                    `build` overwrites it with the label it was handed, so "the image
#                    matches the current recipe" is arranged by building.
#   image_created    .Created for `podman image inspect`    [2026-08-04T00:00:00Z]
#   run_rc           exit code for `podman run`             [0]
#   run_delay        seconds `podman run` takes             [0]
#   run_hold         present = `podman run` blocks, container already up, until this file
#                    is removed  [absent]
#   build_out        whole `podman build` output, verbatim  [a realistic STEP i/N run]
#   build_steps      how many STEPs the default emits       [23]
#   build_rc         exit code for `podman build`           [0]
#   build_die_at     stop after this many STEPs and fail,
#                    on the FIRST build only                [0] (0 = never)
#   build_delay      seconds to pause between output lines   [0] (0 = all at once)
#   started_at       .State.StartedAt                       [2026-08-04T00:00:00Z]
#   memory_max       what the in-container cgroup read prints [4294967296]
#   graph_alloc      .Store.GraphRootAllocated              [107374182400 = 100 GiB]
#   graph_used       .Store.GraphRootUsed                   [10737418240  = 10 GiB]
#                    Together these decide check_disk's low-disk warning. Set alloc to ''
#                    or a non-number to drive its silent early returns.
#   machine_list     `podman machine list --format {{.Name}}`  [] (no machine exists)
#   machine_mem      .Resources.Memory, MB                  [16384]
#   machine_disk     .Resources.DiskSize, GB                [64 = MAC_VM_DISK_GB, so
#                    nothing needs growing unless a test says so]
#   machine_init_rc  exit code for `machine init`           [0]
#   machine_set_rc   exit code for `machine set`            [0]
#   machine_start_rc exit code for `machine start`          [0]
#   machine_stop_rc  exit code for `machine stop`           [0]
#   exec_out         what `podman exec ... sh -c` prints    []
#   top_out          what `podman top` prints               []
#   port_out         what `podman port` prints              []

SHIM="${CS193V_SHIM:?podman-fake needs CS193V_SHIM}"

printf '%s\n' "$*" >> "$SHIM/argv.log"

get() {                               # get KEY DEFAULT
    if [ -f "$SHIM/$1" ]; then cat "$SHIM/$1"; else printf '%s' "$2"; fi
}

[ -f "$SHIM/hang" ] && { while :; do sleep 5; done; }

# `podman --version` is checked before anything else and must stay cheap.
case "${1:-}" in
    --version) get version "podman version 5.7.0"; echo; exit 0 ;;
esac

STATE="$(get state absent)"

# ─── inspect ───────────────────────────────────────────────────────────────────
# Called as: podman inspect NAME --format FMT
fmt_container() {                     # fmt_container FORMAT
    case "$1" in
        *'.State.Status'*)      printf '%s\n' "$STATE" ;;
        *'cs193v.confighash'*)  get label_hash ''; echo ;;
        *'cs193v.dir'*)         get label_dir ''; echo ;;
        *'.State.StartedAt'*)   get started_at '2026-08-04T00:00:00Z'; echo ;;
        *'.Mounts'*)            get mounts_out ''; echo ;;
        *)                      echo '' ;;
    esac
}

case "${1:-}" in
    inspect)
        # A container that does not exist must make inspect FAIL — that is precisely how
        # the launcher's state() distinguishes absent from present.
        [ "$STATE" = absent ] && { echo "Error: no such object: \"${2:-}\"" >&2; exit 125; }
        shift
        FMT=''
        while [ "$#" -gt 0 ]; do
            case "$1" in --format) shift; FMT="${1:-}" ;; --format=*) FMT="${1#--format=}" ;; esac
            shift
        done
        fmt_container "$FMT"
        exit 0
        ;;

    image)
        case "${2:-}" in
            exists)
                [ "$(get image_exists yes)" = yes ] && exit 0 || exit 1 ;;
            inspect)
                shift 2
                FMT=''
                while [ "$#" -gt 0 ]; do
                    case "$1" in --format) shift; FMT="${1:-}" ;; --format=*) FMT="${1#--format=}" ;; esac
                    shift
                done
                case "$FMT" in
                    *buildhash*) get image_buildhash ''; echo ;;
                    *'.Created'*) get image_created '2026-08-04T00:00:00Z'; echo ;;
                    *'.User'*) echo student ;;
                    *)         echo '' ;;
                esac
                exit 0 ;;
        esac
        exit 0
        ;;

    info)
        RC="$(get info_rc 0)"
        [ "$RC" -ne 0 ] && { echo "Error: cannot connect to podman" >&2; exit "$RC"; }
        FMT=''
        shift
        while [ "$#" -gt 0 ]; do
            case "$1" in --format) shift; FMT="${1:-}" ;; --format=*) FMT="${1#--format=}" ;; esac
            shift
        done
        case "$FMT" in
            *Rootless*)       get rootless true; echo ;;
            # doctor asks for three values at once; write_local_args asks for MemTotal
            # alone and does arithmetic on it, so the two must not be conflated.
            *MemTotal*CPUs*)  printf '%s 4 pasta\n' "$(get mem_total 8589934592)" ;;
            *MemTotal*)       get mem_total 8589934592; echo ;;
            # check_disk's two Store fields, asked for together in one --format. Nothing
            # else in the repo reads Store, so this arm cannot reach the launcher suites.
            # The defaults describe a machine with room, which is the ordinary case and
            # makes every installer run here exercise check_disk's ok branch for free.
            *GraphRoot*)      printf '%s %s\n' "$(get graph_alloc 107374182400)" \
                                                "$(get graph_used 10737418240)" ;;
            *)                echo '' ;;
        esac
        exit 0
        ;;

    run)
        # Record what we were told, so the next invocation sees a consistent container.
        # This is what makes drift detection and idempotency observable.
        for a in "$@"; do
            case "$a" in
                cs193v.confighash=*) printf '%s' "${a#cs193v.confighash=}" > "$SHIM/label_hash" ;;
                cs193v.dir=*)        printf '%s' "${a#cs193v.dir=}"        > "$SHIM/label_dir" ;;
            esac
            LAST="$a"
        done
        printf '%s' "${LAST:-}" > "$SHIM/last_image"
        # Creating a container is the slowest single step of a real build and the meter counts
        # it as one, so anything asserting what that step LOOKS like needs it to take long
        # enough to be drawn. Returning instantly leaves a window of about zero milliseconds
        # for a display that redraws ten times a second, which is a coin toss rather than a test.
        #
        # A DURATION, unlike run_hold below, and the two are not redundant: run_hold aims at the
        # window between "there is a container" and stop_container, which needs the CLI held open
        # after the state flips; this one aims at the meter's last STEP, which needs `run` to be
        # slow BEFORE anything about it is observable.
        rd="$(get run_delay 0)"
        [ "$rd" != 0 ] && sleep "$rd"
        RC="$(get run_rc 0)"
        if [ "$RC" -ne 0 ]; then
            # Deliberately multi-line: this is the shape of output that broke msg().
            get run_err 'Error: preparing container failed
level=error msg="cannot set up pasta"' >&2
            echo >&2
            exit "$RC"
        fi
        printf 'running\n' > "$SHIM/state"
        # run_hold holds `podman run` open AFTER the container is up, which is the shape a real
        # detached run has: the container is running before the CLI returns. It exists so a test
        # can aim at verb_rebuild's create window -- the moment between "there is a container" and
        # stop_container -- which is otherwise milliseconds wide and cannot be hit on purpose.
        #
        # A FILE to delete rather than a number of seconds to sleep: the test then decides when
        # the window closes instead of guessing a duration that is too short on a loaded machine
        # and wasted time on an idle one.
        while [ -f "$SHIM/run_hold" ]; do sleep 0.1; done
        echo "0123456789abcdef"
        exit 0
        ;;

    rm)      printf 'absent\n' > "$SHIM/state"; rm -f "$SHIM/label_hash" "$SHIM/label_dir"; echo cs193v; exit 0 ;;
    start)   printf 'running\n' > "$SHIM/state"; echo cs193v; exit 0 ;;
    stop)    printf 'exited\n'  > "$SHIM/state"; echo cs193v; exit 0 ;;
    volume)  echo ''; exit 0 ;;
    top)     get top_out ''; echo; exit 0 ;;
    port)    get port_out ''; echo; exit 0 ;;
    ps)      [ "$STATE" = running ] && echo "0123456789ab"; exit 0 ;;
    build)
        # Real podman output shape, because the launcher now PARSES this rather than
        # passing it through: a `STEP i/N:` line per instruction carrying the whole
        # command, cache-hit lines, then COMMIT. A stub that printed only the last line
        # would let a broken progress renderer pass.
        #
        # build_out overrides it wholesale (for the pull-progress and malformed-output
        # cases); build_steps sets how many steps the default emits.
        # build_delay makes the output arrive SLOWLY, one line per delay. Without it every
        # line is available at once and a build finishes in milliseconds -- which cannot show
        # whether anything animates while a step is in progress, because no step ever is.
        #
        delay="$(get build_delay 0)"
        # WHICH ATTEMPT THIS IS. build_rc is one value for the whole shim, so with it alone a
        # build either always fails or always succeeds -- and the retry display is precisely
        # the case where the first attempt must fail and the second must not. Counted here
        # rather than passed in, because the launcher decides how many times to try.
        attempt=1
        [ -f "$SHIM/build_attempts" ] && attempt=$(( $(cat "$SHIM/build_attempts") + 1 ))
        echo "$attempt" > "$SHIM/build_attempts"
        die_at="$(get build_die_at 0)"
        if [ -f "$SHIM/build_out" ]; then
            if [ "$delay" = 0 ]; then
                cat "$SHIM/build_out"
            else
                while IFS= read -r bl; do printf '%s\n' "$bl"; sleep "$delay"; done < "$SHIM/build_out"
            fi
        else
            n="$(get build_steps 23)"
            i=1
            while [ "$i" -le "$n" ]; do
                echo "STEP $i/$n: RUN set -eux; apt-get install -y package-number-$i && echo done"
                # Stop mid-build on the first attempt only, the way a dropped connection does.
                # ANNOUNCED FIRST, THEN FAILED, because that is podman's order and the launcher
                # depends on it: the step that failed is the LAST STEP line in the log, which is
                # what it reads to hold the bar there while the retry replays the cache. Failing
                # before the line was printed made the number one too low and cleared the retry
                # marker the instant the retry began.
                if [ "$attempt" = 1 ] && [ "$die_at" != 0 ] && [ "$i" = "$die_at" ]; then
                    echo "error: build failed: network is unreachable" >&2
                    exit 1
                fi
                echo "--> Using cache 4ec498e1806de291e7859998e9c4e251296ffece50ec40bc11e5b81e3f5$i"
                # A CACHE HIT COSTS NO TIME, and on a retry that is the point: the steps the
                # first attempt completed replay instantly and the delay applies only from the
                # step that failed onward, which is what makes the bar race back up to where
                # it stopped rather than crawling there.
                if [ "$delay" != 0 ] && { [ "$die_at" = 0 ] || [ "$i" -ge "$die_at" ]; }; then
                    sleep "$delay"
                fi
                i=$((i + 1))
            done
            echo "COMMIT localhost/cs193v:local"
            echo "Successfully tagged localhost/cs193v:local"
        fi
        # THE RECIPE LABEL IS RECORDED, exactly as `run` records the container's labels and
        # for the same reason: the next invocation has to see a consistent image. A real build
        # stamps cs193v.buildhash onto what it produces, so a test arranges "this image matches
        # the recipe on disk" by building rather than by computing the launcher's hash a second
        # time. Only on success -- a failed build produces no image to label.
        #
        # DOWN HERE RATHER THAN AT THE TOP OF THIS ARM, which is where it started, because
        # build_die_at exits from the middle of the loop above: stamping before the output meant
        # an attempt that then died still labelled an image it never produced, so the next
        # invocation's staleness check read a recipe match that no build had earned.
        if [ "$(get build_rc 0)" -eq 0 ]; then
            for a in "$@"; do
                case "$a" in
                    cs193v.buildhash=*)
                        printf '%s' "${a#cs193v.buildhash=}" > "$SHIM/image_buildhash" ;;
                esac
            done
        fi
        exit "$(get build_rc 0)"
        ;;
    # The macOS virtual machine. `machine` used to answer every subcommand with an empty
    # line, which read as "no machine exists" -- so DO_MACHINE_RESIZE could not be set and
    # neither grow_machine_disk nor grow_machine_disk_when_stopped could run at all.
    #
    # The DEFAULTS keep that same starting position: machine_list empty means nothing exists,
    # which is what every test written before this arm assumed. machine_mem and machine_disk
    # are only read once a list has been arranged, and default to a machine that needs
    # nothing done to it, so arranging a list does not silently also arrange a resize.
    #
    # `.Resources.Memory` is MB and `.Resources.DiskSize` is GB -- podman's own inconsistency,
    # which the installer's comment at grow_machine_disk records. Answered in those units here
    # so a test reads the same numbers a Mac would show.
    machine)
        shift
        MSUB="${1:-}"
        MFMT=''
        for a in "$@"; do
            case "$a" in --format=*) MFMT="${a#--format=}" ;; esac
        done
        [ "$MFMT" = '' ] && { PREV=''
            for a in "$@"; do [ "$PREV" = --format ] && MFMT="$a"; PREV="$a"; done; }
        case "$MSUB" in
            list)
                # Nothing, not an empty line: the installer asks `| grep -q .`, and while a
                # bare newline does not match `.` either, printing nothing is what "no
                # machines" actually looks like.
                V="$(get machine_list '')"
                [ -n "$V" ] && printf '%s\n' "$V"
                exit 0 ;;
            inspect)
                case "$MFMT" in
                    *DiskSize*) printf '%s\n' "$(get machine_disk 64)" ;;
                    *Memory*)   printf '%s\n' "$(get machine_mem 16384)" ;;
                    *)          printf '\n' ;;
                esac
                exit 0 ;;
            init)
                RC="$(get machine_init_rc 0)"
                [ "$RC" -ne 0 ] && echo "Error: machine init failed" >&2
                exit "$RC" ;;
            set)
                RC="$(get machine_set_rc 0)"
                [ "$RC" -ne 0 ] && echo "Error: cannot change a running machine" >&2
                exit "$RC" ;;
            start) exit "$(get machine_start_rc 0)" ;;
            stop)  exit "$(get machine_stop_rc 0)" ;;
            *)     echo ''; exit 0 ;;
        esac
        ;;
    exec)
        # The launcher's doctor/check_clock use `podman exec NAME sh -c '...'`. Answer the
        # handful of probes it makes; anything else is empty.
        for a in "$@"; do LASTARG="$a"; done
        case "${LASTARG:-}" in
            *'id -u'*)        echo "1000:1000" ;;
            *memory.max*)     get memory_max '4294967296'; echo ;;
            *'grep -c Z'*)    echo 0 ;;
            *)                case "$*" in
                                  *'date +%s'*) get container_date "$(date +%s)"; echo ;;
                                  *) get exec_out ''; echo ;;
                              esac ;;
        esac
        exit 0
        ;;
esac

exit 0
