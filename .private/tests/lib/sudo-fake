#!/bin/sh
#
# A fake `sudo`. It RECORDS AND IT NEVER EXECUTES, and that second half is the point rather
# than a simplification.
#
# course-install.sh reaches the host through six privileged calls -- `apt-get update`,
# `apt-get install`, `usermod --add-subuids`, `installer -pkg`, and the `sed`/`tee` into
# /etc/wsl.conf -- and every one of them goes through this one name. So a fake sudo that
# never execs makes the whole shim tier structurally unable to change the machine, which is
# a stronger statement than any assertion about what it happened to do.
#
# SEVEN NAMES, NOT SIX, since #226: `sudo -n true` and `sudo -v` also arrive here. Those two
# are QUESTIONS rather than commands -- one asks whether root can be had without prompting,
# the other asks for the password and runs nothing -- and exit 0 is the right answer to both
# on a machine that is pretending to have working sudo. `shim_set sudo_fail '-n true'` and
# `-v` are what drive the refusals; 10-static.sh's SUDO_CMD deliberately excludes both from
# what it calls a privileged call, for the same reason.
#
# THE FILE NAME IN THE FIRST PARAGRAPH USED TO BE install-cs193v.sh, and #221 moved every one
# of these calls into course-install.sh -- the bootstrap now runs no sudo at all.
#
# A fake that sometimes exec'd would be one negated test away from running the real thing,
# so there is no exec branch at all and 10-static.sh asserts there is none. When a case
# wants the EFFECT of a privileged command, that is what the fixture-container tier is for.
#
# It also matters that this is on PATH for every shim run rather than only the cases that
# want it: the developer running the suite has no passwordless sudo, so a call that escaped
# would fail with "no tty present" in a piped run -- but a PTY-driven case really would sit
# there prompting for their password, with keystrokes the test is feeding going into it.
#
# Configuration, all optional:
#   sudo_fail   newline-separated substrings; any invocation whose argv contains one exits 1
#               (e.g. "apt-get update", "usermod", "installer -pkg"). []
#
# Every invocation is appended to $CS193V_SHIM/sudo.log, one line, so a test can assert on
# what the installer WOULD have run.

SHIM="${CS193V_SHIM:?sudo-fake needs CS193V_SHIM}"

printf '%s\n' "$*" >> "$SHIM/sudo.log"

if [ -f "$SHIM/sudo_fail" ]; then
    # `|| [ -n "$pat" ]` because shim_set writes with printf and no trailing newline, so
    # read returns the last (and usually only) line with a FALSE status -- the loop body
    # never ran, every configured failure silently did nothing, and the case asserting a
    # refusal saw a success.
    while IFS= read -r pat || [ -n "$pat" ]; do
        [ -n "$pat" ] || continue
        case " $* " in
            *"$pat"*)
                echo "sudo-fake: refusing '$pat' as configured" >&2
                exit 1 ;;
        esac
    done < "$SHIM/sudo_fail"
fi

exit 0
