#!/bin/sh
#
# A fake `shortlink`, for driving setup-git with no forwarded port and no container.
#
# Same arrangement as lib/gh-fake: put its directory first on PATH, point $CS193V_SGSHIM at it,
# and every invocation is appended to $CS193V_SGSHIM/argv.log so a test can assert on what it was
# asked for. That log is where the prefilled token parameters are now checked from — once the
# URL is shortened they are no longer on the student's screen, which is the entire point.
#
# WHY A FAKE AND NOT THE REAL ONE. This suite runs on the HOST, including a TA's Mac, where
# /usr/local/bin/shortlink does not exist. The real thing would also have to bind a real port on
# whatever machine the suite is running on, which would make the widest-row assertion depend on
# what else that machine happens to be doing. What is under test here is setup-git's side of the
# seam: that it asks, and that it prints the answer. The redirect itself is 50-image.sh's.
#
# Configuration files, both optional:
#   sl_url        what to print instead of the built-in short URL
#   sl_rc         exit non-zero without printing, to stand in for a missing port  [absent]

SHIM="${CS193V_SGSHIM:?shortlink-fake needs CS193V_SGSHIM}"
printf '%s\n' "shortlink $*" >> "$SHIM/argv.log"

url=''
slug='magic-link'
while [ "$#" -gt 0 ]; do
    case "$1" in
        --timeout) shift ;;
        -*)        : ;;
        *)         if [ -z "$url" ]; then url="$1"; else slug="$1"; fi ;;
    esac
    shift
done

if [ -f "$SHIM/sl_rc" ]; then
    printf '%s\n' "$url"
    exit "$(cat "$SHIM/sl_rc")"
fi

if [ -f "$SHIM/sl_url" ]; then
    cat "$SHIM/sl_url"
else
    printf 'http://localhost:8084/%s\n' "$slug"
fi
