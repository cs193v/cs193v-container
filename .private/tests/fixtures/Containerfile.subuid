# A machine whose account has no subuid range, and nothing else wrong with it.
#
# THE SAME DIGEST .private/Containerfile PINS, so this shares its base layer with
# localhost/cs193v:local and costs nothing extra on a machine that has already built the
# course image.
FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03

# sudo IS NOT IN THE UBUNTU BASE IMAGE -- measured, not assumed, and it matters: all four of
# the installer's privileged calls go through that one name, so a fixture without it tests
# only that the call fails to start. openssh-client is missing too, and its absence would
# add a second consent item and a second apt install that this fixture is not about. curl is
# missing too, and fetch_files needs it even for a file:// URL -- without it the download
# step dies before this fixture's actual claim can be reached.
RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo openssh-client curl \
 && rm -rf /var/lib/apt/lists/*

# uid 1000 with passwordless sudo -- what a student's laptop looks like, and the only shape
# that works at all: cs193v:1043 refuses to run as root, so a root-only fixture could never
# reach build_image.
#
# THE BASE IMAGE ALREADY HAS A uid 1000 -- Ubuntu has shipped an `ubuntu` user there since
# 24.04, and useradd refuses with "UID 1000 is not unique". It has to be 1000 rather than any
# free uid: --userns=keep-id:uid=1000 maps whoever runs the launcher to exactly that.
RUN if id -u 1000 >/dev/null 2>&1; then userdel -r "$(id -un 1000)" >/dev/null 2>&1 || true; fi \
 && useradd -m -u 1000 -s /bin/bash student \
 && printf 'student ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/student \
 && chmod 0440 /etc/sudoers.d/student

# THE POINT OF THIS FIXTURE. student has no subuid range, which is what makes DO_SUBUID true
# and lets `sudo usermod --add-subuids 200000-265535` really execute against a real
# /etc/subuid. No PATH shim can do that: 25-installer.sh reaches the branch only by faking
# `id` to name an account that does not exist, which guarantees the command never runs.
RUN : > /etc/subuid && : > /etc/subgid

# A FAKE podman, not a real one, and deliberately so. This fixture's claim is about
# /etc/subuid; a real podman would add several hundred MB and minutes to the build and
# change nothing it asserts. The fixtures whose claim IS podman install the real thing.
COPY podman-fake /usr/local/bin/podman
RUN chmod +x /usr/local/bin/podman && mkdir -p /var/tmp/shim /var/tmp/report && chmod 1777 /var/tmp/shim /var/tmp/report
ENV CS193V_SHIM=/var/tmp/shim

USER student
WORKDIR /home/student
