# A machine that can run the course container: the only fixture where podman is real AND the
# launcher is allowed to reach `podman build`.
#
# WHAT THIS FIXTURE PAYS TO EXIST, recorded here because it is the honest limit of what a
# green nested case proves. The harness runs it with --cap-add=SYS_ADMIN, which podman's
# defaults do not include and which .config/container.args forbids for the COURSE container.
# Measured by differential, not guessed: with SYS_ADMIN the unprivileged inner user gets
# `rootless=true`; with podman's defaults alone newuidmap fails "write to uid_map failed:
# Operation not permitted". It is not simulating anything a student has -- a real laptop user
# creates unprivileged user namespaces natively -- it is paying for this fixture being a
# container pretending to be a laptop. Nothing here reaches the container a student runs:
# that one's flags come from $DIR/.config/container.args (cs193v:40), which the installer
# unpacks and this fixture never edits. The nested case asserts that boundary rather than
# asserting it in a comment.
FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03

# podman and its rootless prerequisites, plus what the installer and launcher need:
# uidmap for newuidmap/newgidmap, fuse-overlayfs for a store that cannot use kernel overlay,
# openssh-client because the launcher's preflight refuses without ssh AND ssh-keygen, curl for
# fetch_files, and ca-certificates because the inner build really reaches the network.
#
# passt IS NAMED EXPLICITLY, and its absence was a real infidelity rather than an oversight in
# passing. Ubuntu's podman only RECOMMENDS passt, so --no-install-recommends here dropped the
# thing rootless podman configures its network with -- and the installer a student runs does
# NOT pass that flag (installer:513), so a student gets pasta and this fixture did not. The
# inner build then died with "could not find pasta". slirp4netns is the older fallback.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      sudo curl ca-certificates openssh-client podman uidmap fuse-overlayfs \
      passt slirp4netns \
 && rm -rf /var/lib/apt/lists/*

# cgroupfs IN CONFIG, NOT ON A FLAG, and that is the whole reason this file exists rather than
# a longer podman command line. There is no systemd user session in here, so the systemd cgroup
# manager cannot work -- and the launcher never passes --cgroup-manager, so a flag the harness
# adds would not reach the podman the launcher actually runs. Configuration is the only channel.
RUN mkdir -p /etc/containers \
 && printf '[engine]\ncgroup_manager = "cgroupfs"\n' > /etc/containers/containers.conf

# uid AND gid 2, NOT 1000, and the reason is a chain worth writing down because every link
# was measured rather than reasoned:
#
#   apt's http method drops to the _apt user, whose group is nogroup = 65534, and calls
#   setgroups(). To MAP container gid 65534 the subgid range needs at least 65534 ids -- it is
#   not enough for the range's numbers to span 65534, which is what a first attempt asserted.
#   The outer container's userns window is 65536 ids (container 1..65536). And podman refuses
#   outright a range that contains the user's own uid or gid ("includes the user UID"). So the
#   largest usable block is 65536 minus wherever the user sits, and only uid/gid <= 2 leaves
#   65534 of them. Measured: at uid 1000 the course build dies three steps in with "Failed to
#   setgroups"; at uid/gid 2 with 3:65534 it gets through apt.
#
# It costs nothing in fidelity. The launcher only refuses uid 0 (cs193v:1043); every other uid
# is equivalent to it, and the course container's own student is uid 1000 whatever this is,
# because --userns=keep-id:uid=1000 maps the INVOKING uid to 1000 inside.
RUN oldu="$(getent passwd 2 | cut -d: -f1)"; [ -n "$oldu" ] && userdel "$oldu" >/dev/null 2>&1; \
    oldg="$(getent group 2 | cut -d: -f1)";  [ -n "$oldg" ] && groupdel "$oldg" >/dev/null 2>&1; \
    groupadd -g 2 student \
 && useradd -m -u 2 -g 2 -s /bin/bash student \
 && printf 'student ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/student \
 && chmod 0440 /etc/sudoers.d/student

# THE RANGE MUST LIE INSIDE THE OUTER CONTAINER'S MAPPING, which is the constraint that
# actually binds and is not the one the plan started with. The outer rootless podman maps
# container uid 0 -> host 1000 and container uids 1..65536 -> host 100000..165535, so an inner
# range has to fit in 1..65536. The installer's own `usermod --add-subuids 200000-265535` is
# entirely OUTSIDE that window and could never work here whatever the totals add up to -- so
# this is pre-seeded and setup_subuid is not what puts it there.
#
# AND IT MUST COVER gid 65534. apt's http method drops privileges to the _apt user, whose
# group is nogroup = 65534, and calls setgroups(); a gid outside the mapped range makes that
# EINVAL, which surfaces as "Failed to setgroups" and "Method http has died unexpectedly"
# three steps into the course build. Measured, after a 32768-id range starting at 10000
# covered only 10000..42767 and died exactly there. 10000..65535 covers it and still fits
# inside the outer container's 1..65536 window, which is the other half of the constraint.
RUN printf 'student:3:65534\n' > /etc/subuid \
 && printf 'student:3:65534\n' > /etc/subgid

# Rootless podman wants a runtime dir of its own; without one it warns and falls back.
RUN mkdir -p /run/user/2 && chown student:student /run/user/2 && chmod 700 /run/user/2
ENV XDG_RUNTIME_DIR=/run/user/2

# A build-time stamp the probes echo back, so an assertion can prove it ran INSIDE the fixture
# and not on the host -- a probe that answers about the host answers happily.
RUN printf 'nested-fixture-%s\n' "$(date -u +%s)" > /etc/cs193v-fixture-id

# THE GRAPH ROOT'S MOUNT TARGET, pre-created and student-owned. podman copies the image's
# ownership onto an empty named volume at first mount, so a target that does not exist (or is
# root-owned) gives the inner podman a store it cannot write. Same reasoning container.args
# gives for the seven credential volumes, one level in.
RUN mkdir -p /home/student/.local/share/containers \
 && chown -R student:student /home/student/.local

RUN mkdir -p /var/tmp/shim /var/tmp/report && chmod 1777 /var/tmp/shim /var/tmp/report

USER student
WORKDIR /home/student
