# A machine that can EXECUTE install-cs193v-windows.cmd, on Linux, with no Windows anywhere.
#
# WHAT THIS BUYS. The .cmd consumes only exit codes and two single lines of stdout, so every one
# of its decisions is reachable with fakes -- wine supplies a real cmd.exe to take them. That is
# the same split lib/sandbox.sh draws for the .sh installer: this reaches every DECISION and no
# EFFECT. Whether WSL really installs stays in MANUAL.md, where it already was.
#
# WHY WINE IS TRUSTWORTHY ENOUGH. wine's own programs/cmd/tests/*.cmd.exp files hold
# Windows-VERIFIED expected output, with @todo_wine@ marking every line wine knowingly gets
# wrong. All 29 markers in test_builtins.cmd.exp were enumerated, and none touches delayed
# expansion, !errorlevel!, `if errorlevel N` (including negatives), goto/labels, %~dp0, `for /f`
# backticks, or redirection parsing. Debian's 10.0~repack-12 patch series touches nothing under
# programs/cmd, so Ubuntu ships upstream 10.0 verbatim.
#
# WHERE IT IS NOT, and what covers that instead: wine reads LF-only batch natively
# (batch.c:259-266) and accepts `::` inside a parenthesized block, both of which real cmd.exe
# gets WRONG. Those are false negatives no run here can catch, so 25-installer.sh asserts them
# statically. See lib/cmdlint.sh.
#
# COST. libwine is ~1.15 GB installed and pulls gstreamer/avcodec/X11/wayland, so this image is
# LARGE: 3.45 GB, measured with `podman images` on 2026-08-26. The comment here used to say
# ~2.2 GB, which had drifted -- the base image and wine's dependency closure both move under it,
# so this number is worth re-reading rather than trusting. It is content-hash cached by
# fixture_build like every other fixture, and the tier it serves is not in DEFAULT_TIERS, so a
# normal run never builds it.
FROM docker.io/library/ubuntu:26.04

# --no-install-recommends is load-bearing, not tidiness: it keeps i386 multiarch out entirely.
# wine32 is only a Suggests of wine64, and cmd.exe has a 64-bit build, so nothing here needs it.
#
# gcc-mingw-w64-x86-64 is a BUILD-TIME dependency only -- the fakes are compiled below and the
# compiler is then dead weight, but removing it would invalidate nothing and save little against
# libwine, so it stays rather than adding an apt-get remove nobody can verify.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      wine64 gcc-mingw-w64-x86-64 \
 && rm -rf /var/lib/apt/lists/*

# ubuntu:26.04 already ships a uid-1000 user named "ubuntu". Reusing it avoids a second home
# directory, and wine needs a writable $HOME for its prefix.
USER ubuntu
# PATH CARRIES WINE'S OWN BINDIR, and that is a fix rather than tidiness. Ubuntu installs
# `wineserver` to /usr/lib/x86_64-linux-gnu/wine/ and puts only `wine64` on the default PATH, so
# the two `wineserver` calls below would resolve to NOTHING -- exit 127. Not hypothetical: they
# used to read `-k 2>/dev/null;`, which hid the 127 behind its own redirect and behind the `;`
# after it, so the flush they exist to force had never once run (#126). The guard step below is
# what stops it going quiet again.
#
# `=n` ON THE FOUR FAKED PROGRAMS IS LOAD-BEARING, and it is not obvious. wine ships BUILTIN
# implementations of reg and net, and its loader prefers a builtin over a real PE sitting in
# system32 -- so copying the fakes there was not enough on its own. Measured: with the fakes in
# place but no override, `%SystemRoot%\System32\reg.exe query "HKU\S-1-5-19"` ran WINE'S reg,
# answered `reg: Invalid system key`, exited 1, and never touched argv.log. The whole tier read as
# "the installer is not Administrator" -- 97 failures whose cause was entirely in the harness.
# `n` means native, i.e. the file on disk. wsl.exe and powershell.exe are listed for the same
# reason even though wine has no builtin for them today; a future wine that gained one would
# reintroduce exactly this, silently.
ENV WINEPREFIX=/home/ubuntu/.wine \
    WINEDEBUG=-all \
    WINEDLLOVERRIDES="mscoree,mshtml=d;reg.exe,net.exe,wsl.exe,powershell.exe=n" \
    XDG_RUNTIME_DIR=/tmp/xdg \
    DISPLAY= \
    PATH=/usr/lib/x86_64-linux-gnu/wine:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ...and it must STAY resolvable, asserted here rather than hoped for. A silent 127 is exactly
# what made the layer below look like it worked for as long as it did, so this fails the build
# the day the path moves instead of leaving a race to lose later.
RUN command -v wineserver

# THE FAKES, compiled here rather than at run time.
#
# They must be real PE executables and not batch shims for one measured reason: the .cmd names
# `wsl.exe` WITH the suffix, so a wsl.cmd is never found.
#
# THEY ARE STAGED HERE AND INSTALLED INTO system32 FURTHER DOWN, not left for lib/wine.sh to drop
# beside the .cmd. That is issue #125: the installer used to name every program without a path, so
# a copy in the download folder was what cmd.exe found -- and this harness RELIED on exactly that
# to be found itself. Now that the installer names %SYS32%\wsl.exe, the fakes have to live where
# that resolves, or --tier windows tests nothing. Overwriting wine's own net.exe and where.exe on
# the way is a bonus rather than the mechanism: wine's `net session` answers with a usage banner
# and EXIT 0, i.e. it reports every user as an Administrator.
#
# hostile.exe IS DELIBERATELY NOT INSTALLED INTO system32. It is the planted binary for the case
# that asserts a copy in the download folder never runs, so it must only ever appear where
# lib/wine.sh puts it.
#
# The sources live under fixtures/ and not lib/ because fixture_build's build context IS the
# fixtures directory; putting them in lib/ would put them outside it.
COPY win-fakes/ /tmp/win-fakes/
RUN mkdir -p /home/ubuntu/shim \
 && cd /tmp/win-fakes \
 && for f in wsl net powershell reg hostile; do \
      x86_64-w64-mingw32-gcc -O1 -Wall -Wextra -o "/home/ubuntu/shim/$f.exe" "fake-$f.c"; \
    done \
 && ls -1 /home/ubuntu/shim

# Boot the prefix ONCE, here. Measured on this machine: creating a prefix costs 10.6 s and a warm
# `wine64 cmd /c` costs 127 ms. Debian patches wineserver's idle timeout to 0
# (debianization/wineserver-persistence.patch), so every invocation re-boots -- baking the prefix
# is what keeps that 127 ms instead of 10.6 s, and it also means each throwaway container starts
# from an IDENTICAL C:\, which is what makes wine's statefulness harmless here.
RUN mkdir -p /tmp/xdg && chmod 700 /tmp/xdg \
 && wine64 wineboot --init >/dev/null 2>&1 || true \
 && wine64 cmd /c "exit /b 0" </dev/null >/dev/null 2>&1 || true \
 && timeout 30 wineserver -w \
 && test -d /home/ubuntu/.wine/drive_c/windows/system32

# %TEMP% MUST EXIST AND BE WRITABLE. The installer no longer writes a scratch file there --
# stage two is downloaded inside the distro now, so the %TEMP%\cs193v-linuxpath.txt hop and its
# :noscratch arm are both gone -- and this layer is KEPT anyway, deliberately. A real Windows
# machine always has TEMP; a harness without it tests a machine no student has, and the next
# line of batch that reaches for it would fail here for a reason belonging to the harness.
# Removing it would buy nothing and cost the debugging session below all over again.
#
# wine does NOT inherit TEMP from the Unix environment -- it reads it from the registry, and a
# bare prefix leaves it EMPTY, which made `> "%TEMP%\file"` expand to the drive root and fail
# with "Access denied". A real Windows machine always has both the variable and the directory, so
# a harness without them tests a machine no student has: the first run of this suite reported the
# installer could not find the WSL path when the truth was that the harness had no temp directory.
# Both halves are needed -- the variable alone gives "Invalid name" if the directory is absent.
# THE WAIT IS LOAD-BEARING, not hygiene. wine keeps the registry in the wineserver process and
# writes user.reg on the way out (close_socket_timeout), so a regedit import in one build step is
# simply lost when the layer commits -- the import appeared to work, and TEMP was still empty in
# the next step. `wineserver -w` blocks on the lock the server holds for its whole lifetime, so it
# returns strictly AFTER that write and the grep below reads the file back the way a test run
# will. NOT `-k` and NOT a `sleep`, which are both #126: `-k` exits 1 once the server has already
# gone -- on Ubuntu the idle timeout is patched to 0, so that is the normal case by the time the
# shell can exec it -- and escalates to a SIGKILL no flush survives. The `sleep 1` it stood beside
# was not merely load-sensitive, it was UNDERSIZED: the flush lands about 1.5 s after regedit
# exits, so 20 imports in a row lost 12 of them on an idle machine, and 0 with the wait (measured
# 2026-09-03). `timeout` bounds the wait because nothing else does: fixture_build's `podman build`
# is the one podman call in the suite with no watchdog.
RUN mkdir -p /home/ubuntu/.wine/drive_c/users/ubuntu/Temp \
 && wine64 regedit /S /tmp/win-fakes/wine-temp.reg >/dev/null 2>&1 \
 && timeout 30 wineserver -w \
 && grep -q 'users..ubuntu..Temp' /home/ubuntu/.wine/user.reg

# THE FAKES GO WHERE %SYS32% RESOLVES, and this layer is LAST on purpose. Every wine invocation
# above -- wineboot, the warm cmd, regedit -- runs against an untouched system32; doing this
# earlier would mean wine's own tooling booting a prefix whose reg.exe had already been replaced by
# a fake that answers one question and exit 120 to everything else.
#
# WindowsPowerShell\v1.0 DOES NOT EXIST IN A WINE PREFIX and has to be created, which is the one
# piece of real-Windows layout the installer now depends on that wineboot does not provide.
#
# The `test -s` lines are the guard. A `cp` that silently landed nowhere would leave the whole
# tier resolving to wine's own builtins, and since those answer plausibly rather than failing --
# `net session` exits 0 for everyone -- the suite would go green having tested nothing.
RUN sys32=/home/ubuntu/.wine/drive_c/windows/system32 \
 && mkdir -p "$sys32/WindowsPowerShell/v1.0" \
 && cp /home/ubuntu/shim/powershell.exe "$sys32/WindowsPowerShell/v1.0/powershell.exe" \
 && for f in wsl net reg; do cp "/home/ubuntu/shim/$f.exe" "$sys32/$f.exe"; done \
 && test -s "$sys32/wsl.exe" \
 && test -s "$sys32/reg.exe" \
 && test -s "$sys32/WindowsPowerShell/v1.0/powershell.exe" \
 && test ! -e "$sys32/hostile.exe"

# ...AND THE FAKE MUST BE WHAT ACTUALLY RUNS, asserted here rather than discovered as 97 failures
# in 27-installer-windows.sh. Being ON DISK in system32 is not sufficient: wine prefers its own
# builtin reg over the file, so this is the guard for the WINEDLLOVERRIDES `=n` above. It asks the
# question the installer asks, by the path the installer uses, and reads argv.log back -- if wine's
# builtin answered instead, the log is empty and the build fails here, where the cause is legible.
# `wineserver -w` for the same reason as the layer above: the fake writes through wine, and this
# needs to read it back after the server has flushed.
RUN mkdir -p /tmp/bcheck \
 && CS193V_FAKE_DIR='Z:\tmp\bcheck' \
    wine64 cmd /c '%SystemRoot%\System32\reg.exe query "HKU\S-1-5-19"' </dev/null >/dev/null 2>&1 \
 ; timeout 30 wineserver -w \
 && grep -q 'reg.exe query' /tmp/bcheck/argv.log \
 && rm -rf /tmp/bcheck

WORKDIR /work
