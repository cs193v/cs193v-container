# A WSL-looking machine, with everything the installer needs except systemd in wsl.conf.
#
# WSL is detected by `grep -qi microsoft /proc/version` (installer:306) and the effect is two
# file edits, so the whole arm is reachable on Linux with one bind mount and no Windows at
# all -- which is the surprise worth writing down, because it looks like it needs Windows.
#
# The wsl.conf STATE is arranged at boot by /work/run.sh rather than baked here, so one image
# serves all four states. The cost: /etc/wsl.conf appears in `podman diff` whatever the
# installer did with it, so the CONTENT report is what distinguishes the four and the path
# list only ever says "and nothing else".
FROM ubuntu:26.04@sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03

# sudo is not in the ubuntu base image, and neither is openssh-client or curl. All three
# absences would otherwise add consent items and apt installs this fixture is not about.
RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo openssh-client curl \
 && rm -rf /var/lib/apt/lists/*

# The base image already has a uid 1000 (Ubuntu ships `ubuntu` there since 24.04), and it
# has to be 1000: --userns=keep-id:uid=1000 maps whoever runs the launcher to exactly that.
RUN if id -u 1000 >/dev/null 2>&1; then userdel -r "$(id -un 1000)" >/dev/null 2>&1 || true; fi \
 && useradd -m -u 1000 -s /bin/bash student \
 && printf 'student ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/student \
 && chmod 0440 /etc/sudoers.d/student

# student HAS a subuid range here, unlike Containerfile.subuid. This fixture is about
# /etc/wsl.conf, and a missing range would add a second consent item and a second host
# change to every assertion made against it.
RUN printf 'student:200000:65536\n' > /etc/subuid \
 && printf 'student:200000:65536\n' > /etc/subgid

# A fake podman: this fixture's claim is about /etc/wsl.conf, not about podman.
COPY podman-fake /usr/local/bin/podman
RUN chmod +x /usr/local/bin/podman && mkdir -p /var/tmp/shim /var/tmp/report && chmod 1777 /var/tmp/shim /var/tmp/report
ENV CS193V_SHIM=/var/tmp/shim

USER student
WORKDIR /home/student
