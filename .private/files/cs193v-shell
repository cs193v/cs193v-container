#!/bin/bash
#
# The CS193V landing point. `./cs193v` runs this instead of `bash -l`.
#
# Three jobs:
#
#   1. Put the student inside tmux, so the course title bar and the tab bar are always on
#      screen. See /etc/cs193v/tmux.conf for what that configuration is and why.
#
#   2. Own exactly ONE session, and claim it atomically. Issue #41 made the container's life
#      the terminal's life, so there is never a session to reattach to: closing the window
#      stops the container and everything in it. This script used to do the opposite -- hunt
#      for a session with no client and adopt it -- and that whole mechanism is gone.
#
#      The claim matters because it is the only race-free part of the one-session rule. The
#      launcher checks `podman ps` first, but that is a check-then-act, and `podman start` is
#      idempotent and reports nothing -- so two launches that both find a stopped container
#      both start it and both arrive here. `new-session` on a name that exists fails, the tmux
#      server handles one command at a time, and the session lives inside the container where
#      it cannot go stale across a stop. So tmux, not the launcher, is what makes it true.
#
#   3. Fail LOUDLY if tmux will not start, rather than limping into a bare shell that
#      silently is not the environment the course documents.
#
# Runs as `student` under `podman exec -it`, with the working directory set to
# ~/projects by the launcher.

set -u

CONF=/etc/cs193v/tmux.conf
SOCKET=cs193v
# ONE session, one fixed name. It used to be cs193v-1, cs193v-2, ... allocated by counting up
# until an unused name was found, because several windows could share a container. They cannot
# now, so the counting loop is gone and the name IS the lock -- see job 2 above.
SESSION=cs193v

# What we exit with when another window got the session first. A CONTRACT WITH THE LAUNCHER,
# which turns it into err.session-in-use; 10-static.sh asserts both files spell it the same,
# because nothing else would notice them drifting and the symptom would be a lost race printing
# the "fault in the container image" box below -- alarming, and wrong.
RACE_LOST_STATUS=3

# The container name, for the diagnostic instructions in the failure path. The launcher
# passes it because CS193V_INSTANCE can suffix it and nothing inside the container can
# work it out -- the hostname is `cs193v-development` regardless.
CONTAINER="${CS193V_CONTAINER:-cs193v}"

# A DEDICATED SOCKET, not tmux's default.
#
# It makes "the server cs193v-shell talks to" and "the server started with our locked-down
# config" the same thing by construction. On the default socket they can come apart: a tmux
# server started by anything else -- a staff `podman exec -it ... bash -l` session, a
# student experimenting -- would be running stock tmux with all 70 prefix bindings, and we
# would attach a student to it and hand them an environment that is not the one documented.
#
# The cost is that a student who types plain `tmux` gets a separate, stock tmux server.
# That is the right answer anyway: they asked for tmux, not for the course's tmux.
#
# The tab-label hook does not need to know about this. tmux exports $TMUX into every pane
# and a bare `tmux` inside a pane follows it to the right server.
tm() { tmux -L "$SOCKET" -f "$CONF" "$@"; }

# ─── the loud failure ──────────────────────────────────────────────────────────
# ASCII only, and no reliance on terminfo. A broken locale or a missing tmux-256color
# terminfo entry are two of the likelier reasons to be in here, so the error must not
# depend on the machinery that just failed.
fail() {
    exec >&2
    printf '\n'
    printf '  +--------------------------------------------------------------+\n'
    printf '  |  CS193V: could not start your development environment        |\n'
    printf '  +--------------------------------------------------------------+\n'
    printf '\n'
    printf '  %s\n' "$1"
    printf '\n'
    printf '  This is a fault in the container image, not something you did.\n'
    printf '  Please send this whole message to the course staff.\n'
    if [ -n "${2:-}" ]; then
        printf '\n  What tmux said:\n\n'
        printf '%s\n' "$2" | sed 's/^/      /'
    fi
    printf '\n  To collect a report to send them, on your own computer:\n'
    printf '\n      ./cs193v doctor\n'
    printf '\n  And to get a plain shell in the container for a closer look:\n'
    printf '\n      podman exec -it %s bash -l\n' "$CONTAINER"
    printf '\n'
    exit 1
}

command -v tmux >/dev/null 2>&1 \
    || fail "tmux is not installed in this image."
[ -r "$CONF" ] \
    || fail "the tmux configuration is missing or unreadable at $CONF."

# ─── the clean break ───────────────────────────────────────────────────────────
# 2J clears the visible screen; 3J clears the SCROLLBACK too, which is what "prior commands
# are no longer visible" actually requires. Done on the host terminal, before tmux takes the
# alternate screen -- so entering the container is still the clean break it was before tmux, and
# there is nothing of the student's own session left behind tmux when it exits. cs193v-welcome
# repeats it inside the pane, which is a harmless no-op on a fresh tab and is what the non-tmux
# path needs.
#
# IN --attach, NOT --claim, for the same reason it used to sit after the claim rather than before
# it: a launch that loses the race must not wipe the scrollback of the terminal the student typed
# in and then show them a refusal in an empty screen. Only clear once we know we are going in.
# It would be a no-op in --claim anyway -- that exec has no tty, so `[ -t 1 ]` is false.
clean_break() { [ -t 1 ] && printf '\033[2J\033[3J\033[H'; return 0; }

# ─── claim the session ─────────────────────────────────────────────────────────
# SPLIT FROM THE ATTACH, and run by the launcher as its own `podman exec` BEFORE it raises the
# tunnel. The launcher's `state` check is a check-then-act and `podman start` is idempotent, so
# this claim is the only thing that actually decides who owns the session. Doing it first is the
# point: a launch that is going to lose no longer binds host ports and starts a port supervisor
# it will then abandon.
#
# The two halves were ALREADY two tmux commands -- see the -d note below -- so the split only
# moves them into separate execs. `new-session` without -d never returns, so this is the only
# shape in which its failure can be inspected, and its failure is the whole point here: it is
# how a lost race announces itself.
#
# -x/-y are not optional with -d. A detached session is created at tmux's default 80x24 and only
# resized when a client attaches, so anything the first window prints before then is laid out for
# 80 columns and does not reflow afterwards. That matters MORE after the split than before it:
# the gap between claim and attach is no longer microseconds but however long raising the tunnel
# takes, and `cs193v-welcome` prints its banner into the detached session during it.
#
# CS193V_COLS / CS193V_LINES COME FROM THE LAUNCHER, and must: `tput` reads the terminal, the
# claim exec has no tty, and without them every session would be created at 80x24 -- exactly what
# -x/-y exist to prevent. The tput fallback is for a hand-run with no launcher in front of it.
#
# The first window runs the banner and then becomes the login shell. This is what confines the
# banner to tab one: every LATER tab is created by tmux itself from the default command, which
# is a plain login shell with no banner in it.
#
# No -n flag. Passing -n would set the window name AND switch automatic-rename off, pinning the
# label forever so the tab could never track the running process.
do_claim() {
    local errfile said
    errfile="$(mktemp "${TMPDIR:-/tmp}/cs193v-shell.XXXXXX")" || errfile=/dev/null
    if tm new-session -d -s "$SESSION" \
          -x "${CS193V_COLS:-$(tput cols 2>/dev/null || echo 80)}" \
          -y "${CS193V_LINES:-$(tput lines 2>/dev/null || echo 24)}" \
          'cs193v-welcome; exec bash -l' 2>"$errfile"; then
        rm -f "$errfile"
        return 0
    fi
    # LOST THE RACE, which is not a fault and must not be reported as one.
    #
    # Checked BEFORE the fail box, which says "this is a fault in the container image, not
    # something you did" -- true for a missing terminfo, alarming nonsense for a student who
    # opened a second window. Measured against tmux 3.6: rc=1, and the message on stderr is
    # exactly `duplicate session: cs193v`.
    #
    # Silent on purpose. The launcher owns this message, because host-facing prose lives in
    # messages.txt where it can be reworded, and the container cannot see that file.
    if grep -q 'duplicate session' "$errfile" 2>/dev/null; then
        rm -f "$errfile"
        exit "$RACE_LOST_STATUS"
    fi
    said="$(cat "$errfile" 2>/dev/null)"
    rm -f "$errfile"
    fail "tmux could not create your session." "$said"
}

# ─── attach to it ──────────────────────────────────────────────────────────────
do_attach() {
    local errfile rc
    errfile="$(mktemp "${TMPDIR:-/tmp}/cs193v-shell.XXXXXX")" || errfile=/dev/null
    clean_break
    # `=` is tmux's exact-match prefix, kept even with a single fixed name so that a session a
    # student made by hand called `cs193v-notes` can never be captured by a prefix match.
    tm attach-session -t "=$SESSION" 2>>"$errfile"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        fail "tmux exited with status $rc without giving you a shell." "$(cat "$errfile" 2>/dev/null)"
    fi
    rm -f "$errfile"
    # tmux has restored the host terminal from the alternate screen by now, so this lands on
    # the student's own shell rather than in a pane that is disappearing.
    cs193v-goodbye
}

# ─── dispatch ──────────────────────────────────────────────────────────────────
# A bare invocation composes both halves rather than being a third code path: 60-container.sh
# drives this script directly, and a staff member debugging by hand should keep working.
case "${1:-}" in
    --claim)  do_claim ;;
    --attach) do_attach ;;
    '')       do_claim; do_attach ;;
    *)        fail "cs193v-shell: unknown argument '$1'." ;;
esac
