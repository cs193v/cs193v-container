#!/bin/bash
#
# cs193v-portwatch — tells the host which ports are listening in here.
#
# Runs INSIDE the container, as the student, started by the launcher as one long-lived
# `podman exec`. Its stdout is the host supervisor's input; see the frame parser in
# /etc/cs193v/ui.sh (dynports_line) for the other end of the protocol.
#
# WHAT THIS IS FOR. The host cannot see what is listening in here: /proc/net/tcp is per network
# namespace and the container has its own. There is also no kernel notification for a socket
# entering LISTEN -- inotify does not cover sockets, sock_diag netlink is dump-only, and the eBPF
# hook that would work needs capabilities this container deliberately does not have. So: poll in
# here, ship the answer out, and let the host decide what to do about it.
#
# IT REPORTS, IT DOES NOT DECIDE. Everything below emits observations -- a port and the class of
# address it is bound to. Whether any of them get forwarded is the host's business, and the host
# has facts this side cannot know (which host ports are free, and how low a port an unprivileged
# ssh client may bind). That split is the whole security story: what leaves here is a list of
# integers and a word from a five-item vocabulary.
#
# BASH 3.2 PARSEABLE, even though the image ships bash 5. 18-portwatch-fuzz.sh sources this file
# to drive pw_scan_text directly, and the TAs run the unit tier on Macs. So: no `declare -A`, no
# `mapfile`, no `${var,,}`.

set -u

PW_STATE_DIR=/tmp/cs193v-volatile
PW_STATE="$PW_STATE_DIR/ports"
PW_PROTO='cs193v-portwatch 1'
PW_MAX=128
PW_INTERVAL_DEFAULT=1

# ─── the address classifier ────────────────────────────────────────────────────
# /proc/net/tcp gives the local address as little-endian hex, so 127.0.0.1 is 0100007F: the LAST
# byte pair is the FIRST octet. That is what makes the 127.x test a suffix match.
#
# FIVE CLASSES, NOT FOUR, and the fifth was found by reading real kernel output rather than by
# reasoning. This machine had systemd-resolved listening on 127.0.0.53 and 127.0.0.54. A
# four-class table sends those to `eth`, and the host would then tell a student their server was
# "bound to the container's network interface, not its loopback" -- which is FALSE; 127.0.0.53 is
# loopback. It is simply not the address the tunnel connects to, which is literally 127.0.0.1.
# The outcome was right by accident and the diagnosis was a lie, which this project treats as the
# worse of the two.
pw_v4class() {                        # 8 hex chars, little-endian -> PW_C
    case "$1" in
        0100007F|0100007f) PW_C=lo ;;
        00000000)          PW_C=any ;;
        *7F|*7f)           PW_C=loalt ;;
        *)                 PW_C=eth ;;
    esac
}

# A v6 address is four 32-bit words, each little-endian, printed as 32 hex characters.
#
# THE V4-MAPPED ARM IS THE ONE THAT WAS DERIVED RATHER THAN OBSERVED, and it has since been
# checked against a real kernel: a dual-stack listener on ::ffff:127.0.0.1 prints
# `0000000000000000FFFF00000100007F`, so the last eight characters are the IPv4 address in the
# same little-endian form /proc/net/tcp uses and handing them to pw_v4class is right. Verified end
# to end -- classified `lo`, forwarded, HTTP 200 from the host. 60-container.sh keeps it that way.
pw_v6class() {                        # 32 hex chars -> PW_C
    case "$1" in
        00000000000000000000000000000000)                   PW_C=any ;;
        00000000000000000000000001000000)                   PW_C=v6lo ;;
        0000000000000000FFFF0000*|0000000000000000ffff0000*) pw_v4class "${1:24:8}" ;;
        *)                                                  PW_C=eth ;;
    esac
}

# Reachability order, used to merge a port that appears more than once -- dual-stack,
# SO_REUSEPORT, or one process on lo and another on eth0. The host's only question is "can the
# tunnel reach it", so the most reachable binding wins. Observed live: cups on 631 as both
# 127.0.0.1 and ::1, which must report as `lo`.
pw_rank() { case "$1" in any) PW_R=4 ;; lo) PW_R=3 ;; loalt) PW_R=2 ;; eth) PW_R=1 ;; *) PW_R=0 ;; esac; }

# ─── the scan ──────────────────────────────────────────────────────────────────
# TAKES TEXT, does not read /proc itself, so the fuzzer can drive it with synthetic kernel output
# from a host that has no container.
#
# SLURPED BY THE CALLER, not streamed. Measured, 1000 ticks: `ss -Hltn` 9.6ms, `while read` on the
# procfs file 2.8ms, `raw=$(</proc/net/tcp)` 0.86ms. `ss` is 11x and is out of the hot loop -- it
# stays installed because agent-notes.md teaches it for diagnosis. `while read` is 3x because bash
# reads SPECIAL files a byte at a time to avoid over-consuming; the sys-time column shows it.
#
# THOSE NUMBERS ARE FOR AN EMPTY TABLE, and the table is not the listeners (#337). /proc/net/tcp
# lists EVERY socket in the netns -- ESTABLISHED, and TIME_WAIT for 60 s after each close -- and a
# Playwright run leaves ~6-11 lines per test, so ten workers keep thousands in it. `ss -l` asks the
# kernel for listeners only and never sees the rest; /proc hands us all of them. So the comparison
# above was of fixed costs, and what #337 hit was growth. Whether the growth ever justifies `ss`
# is #344, with the measurements it needs.
#
# LINEAR IN THE TABLE, which the loop was not (#337). It used to take one line off the front per
# iteration -- `${raw%%$'\n'*}`, then `${raw#*$'\n'}` -- and each of those copies everything after
# it, and under the image's en_US.UTF-8 converts it to wide characters as well. A tick cost the
# SQUARE of the table: 6.5 s at 1000 lines in the container, 25.7 s at 2000, 20.7 s at 935 while
# ten Chromiums competed for the CPU. Past one second the watcher never rested; past thirty the
# supervisor declared it dead for the rest of the session. Now the text is split ONCE, into an
# array, and each line is word-split on its own. Measured on the 3.2 macOS ships, same answers:
# 0.025 s at 1000 lines, 0.06 s at 4000, 0.35 s at 16000 -- and an idle tick is cheaper too.
#
# WHAT THE SPLIT OWES THE CALLER, three things, all scoped to this function:
#   * IFS is local, set explicitly for each of its two jobs. The old loop word-split with whatever
#     IFS it was handed, so a caller's `IFS=:` cut every row at its colons.
#   * set -f while it runs, restored only if it was off. The old per-line `set -- $line` globbed,
#     so a lone `*` field became every file in the working directory and the row was dropped.
#   * LC_ALL=C, local. The input is ASCII hex, so C is also what `[!0-9A-Fa-f]` and `${#}` should
#     mean, and it is ~1.7x cheaper per line. Not the test-environment LC_ALL=C that
#     .private/tests/MANUAL.md warns against: it ends at this function's return.
# THE `*0A*` SKIP decides nothing. A row whose fourth field is 0A contains `0A`, so it cannot drop
# a listener; it only spares ~95% of lines the word split. The state test below still decides.
PW_SET=''
PW_RAW_LAST=''
PW_SORTED_LAST=''
pw_scan_text() {                      # pw_scan_text V4TEXT V6TEXT -> PW_SET
    local v4="$1" v6="$2" which raw line addr hexport port cur curr newr best noglob=''
    local IFS LC_ALL=C
    local -a lines
    case "$-" in *f*) noglob=1 ;; *) set -f ;; esac

    best=' '
    for which in 4 6; do
        if [ "$which" = 4 ]; then raw="$v4"; else raw="$v6"; fi
        IFS=$'\n'
        # shellcheck disable=SC2206   # splitting on newlines is the point, under set -f
        lines=( $raw )
        IFS=$' \t\n'
        for line in ${lines[@]+"${lines[@]}"}; do
            case "$line" in *0A*) ;; *) continue ;; esac
            # shellcheck disable=SC2086
            set -- $line
            [ "$#" -ge 4 ] || continue
            [ "${4:-}" = 0A ] || continue          # 0A = TCP_LISTEN, and nothing else counts:
                                                   # an ESTABLISHED socket's local port is a
                                                   # connection, not a server.
            case "$2" in *:*) ;; *) continue ;; esac
            addr="${2%%:*}"; hexport="${2#*:}"
            case "$hexport" in ''|*[!0-9A-Fa-f]*) continue ;; esac
            [ "${#hexport}" -eq 4 ] || continue
            port=$(( 16#$hexport ))
            [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || continue
            case "${#addr}" in
                8)  case "$addr" in *[!0-9A-Fa-f]*) continue ;; esac; pw_v4class "$addr" ;;
                32) case "$addr" in *[!0-9A-Fa-f]*) continue ;; esac; pw_v6class "$addr" ;;
                *)  continue ;;
            esac
            case "$best" in
                *" $port:"*)
                    cur="${best#* $port:}"; cur="${cur%% *}"
                    pw_rank "$cur"; curr=$PW_R
                    pw_rank "$PW_C"; newr=$PW_R
                    if [ "$newr" -gt "$curr" ]; then
                        best="${best/ $port:$cur / }"
                        best="$best$port:$PW_C "
                    fi ;;
                *)  best="$best$port:$PW_C " ;;
            esac
        done
    done
    [ -n "$noglob" ] || set +f

    best="${best# }"; best="${best% }"

    # SORTED, BUT ONLY WHEN THE SET CHANGES. Ascending numeric order makes a frame byte-stable
    # tick to tick, so "did anything change" is a string compare and a log diffs cleanly --
    # /proc's own order is by hash bucket and relying on it would be accidental correctness. The
    # sort is a fork, though, and the tick budget is ~2ms, so it runs only when the merged set
    # differs from last tick's. A steady container pays for it once. (Re-measured for #337, in the
    # container: a scan of a quiet 21-line table is 0.67 ms, where the quadratic loop took 4.4.)
    if [ "$best" = "$PW_RAW_LAST" ]; then
        PW_SET="$PW_SORTED_LAST"
        return 0
    fi
    PW_RAW_LAST="$best"
    if [ -z "$best" ]; then
        PW_SORTED_LAST=''
    else
        PW_SORTED_LAST="$(printf '%s\n' $best | sort -t: -k1,1n | tr '\n' ' ')"
        PW_SORTED_LAST="${PW_SORTED_LAST% }"
    fi
    PW_SET="$PW_SORTED_LAST"
    return 0
}

# ─── the writeback: argv in, state file out ────────────────────────────────────
# The host runs `cs193v-portwatch --publish state=... floor=... up=... refused=...` whenever what it
# decided changes, and this side writes the file. THE HOST DECIDES, THIS SIDE RECORDS: nothing here
# asks for a port, and the argv carries only outcomes the host has already committed to.
#
# STATE IS PASSED AS ARGUMENTS, never on stdin, and the values are validated even though the host
# built them. Not because the host is untrusted, but because a bug there would otherwise write
# nonsense into a file that three readers believe -- --show, doctor over podman exec, and
# shortlink, which consults it before printing a URL a student is about to click. All three read it
# through pw_state_parse (doctor and shortlink by way of --state), so what the writer refuses to
# write, every reader refuses to read.
PW_CLASSES='lo any v6lo eth loalt'
PW_REASONS='busy v6lo loalt eth below-floor capped'
PW_STATES='healthy master-unresponsive broken'
PW_TAB=$'\t'

PWP_STATE=''; PWP_FLOOR=''; PWP_UP=''; PWP_REFUSED=''; PWP_ERR=''
PW_PAIRS=''

# A REFUSAL NAMES WHAT IT REFUSED the way the host's gate does (quoted() and dynports_fatal in
# cs193v-ui.sh): REASON: VALUE, the value through printf %q. doctor puts the reader's on a student's
# screen, so nothing from outside reaches it unquoted -- %q writes an ESC as \E, never the byte --
# and a \r, a tab and an ESC stay three different things, where the `?` this replaced made them one.
# Under LC_ALL=C, or in a UTF-8 locale %q would write an é raw and the cut would count characters.
#
# CUT TO PW_VALUE_MAX BYTES BEFORE QUOTING, since a value has no length of its own and doctor gives
# the reason one row. A cut after could split an escape like \303 and misreport the byte. Quoted,
# a byte is at most four, so a reason stays short. printf -v, so no fork.
PW_VALUE_MAX=32
pw_refuse() {                         # pw_refuse REASON VALUE -> 1 with PWP_ERR
    local v="$2" q cut='' LC_ALL=C
    [ "${#v}" -le "$PW_VALUE_MAX" ] ||
        { cut=" (the first $PW_VALUE_MAX of ${#v} bytes)"; v="${v:0:PW_VALUE_MAX}"; }
    printf -v q '%q' "$v"
    PWP_ERR="$1: $q$cut"
    return 1
}

# A WORD IS IN A VOCABULARY WHEN IT EQUALS ONE OF ITS WORDS. Not a substring match: " $vocab "
# contains " busy v6lo ", so `busy v6lo` passed for one reason, and the writer then rendered it as
# two lines its own reader refused.
pw_word() {                           # pw_word WORD VOCAB -> 0 if WORD is one of VOCAB's words
    local w IFS=' '
    for w in $2; do [ "$w" = "$1" ] && return 0; done
    return 1
}

# A PORT, by the rules the host's own gate applies, and for the same reason: digits first, length
# before any arithmetic, 10# to force base ten, then a canonicality compare so a non-canonical
# spelling is refused rather than quietly normalised. ONE CHECK FOR EVERY PORT, the floor's
# included: the reader used to take any run of digits for a floor, so it read floors the writer
# could never have written (#406).
pw_port() {                           # pw_port VALUE NOUN -> 0, or 1 with PWP_ERR
    case "$1" in ''|*[!0-9]*) pw_refuse "non-decimal $2" "$1"; return 1 ;; esac
    [ "${#1}" -le 5 ] || { pw_refuse "over-long $2" "$1"; return 1; }
    [ "$(( 10#$1 ))" = "$1" ] || { pw_refuse "non-canonical $2" "$1"; return 1; }
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ] || { pw_refuse "$2 out of range" "$1"; return 1; }
    return 0
}

# One port:word entry, as a list carries it and as a file line does.
pw_entry() {                          # pw_entry PORT WORD VOCAB -> 0, or 1 with PWP_ERR
    pw_word "$2" "$3" || { pw_refuse "unknown value" "$2"; return 1; }
    pw_port "$1" port
}

# ONE SPLIT, OWING ITS CALLER TWO THINGS: IFS only for the split, and no globbing while it runs,
# restored only if it was off. Without set -f a lone `*` would split into every file in the working
# directory.
PW_ITEMS=()
pw_split() {                          # pw_split SEP TEXT -> PW_ITEMS
    local IFS="$1" noglob=''
    case "$-" in *f*) noglob=1 ;; *) set -f ;; esac
    # shellcheck disable=SC2206   # splitting is the point, under set -f
    PW_ITEMS=( $2 )
    [ -n "$noglob" ] || set +f
}

# A comma-separated list of port:word, as --publish is given it.
#
# SPLIT ONCE, not peeled an entry at a time: each peel copied the rest of the list, and the whole
# list was checked before pw_lists counted it, so one long argument cost the square of its length
# -- 1.8 s at 2000 entries and 30 s at 8000, measured. And it stops past PW_MAX, as the reader does,
# since pw_lists refuses the list whatever follows.
#
# A COMMA ADDED TO THE END: a split drops one trailing empty field, so `3000:lo,` read as
# `3000:lo`. With it, every empty entry, at the end or anywhere else, is one the loop sees and
# refuses. Added to the value pw_split is handed, not written into a split as `( $1, )`: only what
# an expansion produced is split, so a comma typed there would have stayed on the last entry.
pw_pairs() {                          # pw_pairs VALUE VOCAB -> PW_PAIRS, or 1 with PWP_ERR
    local item n=0 out=''
    PW_PAIRS=''
    [ -n "$1" ] || return 0
    pw_split , "$1,"
    for item in ${PW_ITEMS[@]+"${PW_ITEMS[@]}"}; do
        case "$item" in *:*) ;; *) pw_refuse "no colon in entry" "$item"; return 1 ;; esac
        pw_entry "${item%%:*}" "${item#*:}" "$2" || return 1
        out="$out $item"
        n=$(( n + 1 ))
        [ "$n" -le "$PW_MAX" ] || break
    done
    PW_PAIRS="${out# }"
    return 0
}

# WHAT THE HOST CAN SEND, which is narrower than the vocabularies, checked at both ends so the file
# can hold nothing else. sup_publish writes every up entry as `$port:lo`. It adds a port to its list
# only when the port is not already there, and refuses each record of a frame at most once. And it
# forwards at most DYNPORTS_MAX ports, from frames of at most that many records, which 10-static.sh
# holds equal to PW_MAX. A port in BOTH lists is allowed, because the host can publish one (#517).
pw_lists() {                          # pw_lists UP REFUSED -> 0, or 1 with PWP_ERR
    pw_list "$1" up lo && pw_list "$2" refused
}
pw_list() {                           # pw_list LIST NOUN [WORD] -> 0, or 1 with PWP_ERR
    local e port n=0 seen=' ' IFS=$' \t\n'
    for e in $1; do
        n=$(( n + 1 ))
        [ "$n" -le "$PW_MAX" ] || { PWP_ERR="more than $PW_MAX $2 entries"; return 1; }
        [ -z "${3:-}" ] || [ "${e#*:}" = "$3" ] || { pw_refuse "$2 entry not on $3" "$e"; return 1; }
        port="${e%%:*}"
        case "$seen" in *" $port "*) pw_refuse "duplicate $2 port" "$port"; return 1 ;; esac
        seen="$seen$port "
    done
    return 0
}

# WHAT KEEPS THE FILE WELL-FORMED IS THE VOCABULARIES, not an escaping pass. Every value below is
# matched whole against a closed set or a digits-only pattern, so a tab or newline cannot survive
# to reach the tab-separated, line-oriented file -- it fails the vocabulary first. This was
# measured: a dedicated control-character check sat here and mutation testing could not make it
# fire, because the vocabulary always got there first. It was removed rather than kept as
# decoration. WHOLE is the word that matters: a match inside the space-joined list let a space
# through, and the file split there.
#
# THE ONE-OF-EACH CHECKS HERE ARE NOT FOR A MESSAGE, as the reader's were. Nothing compares an
# argument list against a rendering of itself, so without them a second state= would simply win.
#
# THE COROLLARY IS THE THING TO REMEMBER: a future key whose value is free text would have no such
# protection, and would need its own escaping before it is written.
pw_publish_parse() {                  # key=value ... -> PWP_*, or 2 with PWP_ERR
    local a k v seen_state='' seen_floor='' seen_up='' seen_ref=''
    PWP_STATE=''; PWP_FLOOR=''; PWP_UP=''; PWP_REFUSED=''; PWP_ERR=''
    for a in "$@"; do
        case "$a" in *=*) ;; *) pw_refuse "not key=value" "$a"; return 2 ;; esac
        k="${a%%=*}"; v="${a#*=}"
        case "$k" in
            state)
                [ -z "$seen_state" ] || { PWP_ERR="duplicate state"; return 2; }; seen_state=1
                pw_word "$v" "$PW_STATES" || { pw_refuse "unknown state" "$v"; return 2; }
                PWP_STATE="$v" ;;
            floor)
                [ -z "$seen_floor" ] || { PWP_ERR="duplicate floor"; return 2; }; seen_floor=1
                pw_port "$v" floor || return 2
                PWP_FLOOR="$v" ;;
            up)
                [ -z "$seen_up" ] || { PWP_ERR="duplicate up"; return 2; }; seen_up=1
                pw_pairs "$v" "$PW_CLASSES" || return 2
                PWP_UP="$PW_PAIRS" ;;
            refused)
                [ -z "$seen_ref" ] || { PWP_ERR="duplicate refused"; return 2; }; seen_ref=1
                pw_pairs "$v" "$PW_REASONS" || return 2
                PWP_REFUSED="$PW_PAIRS" ;;
            *)  pw_refuse "unknown key" "$k"; return 2 ;;
        esac
    done
    # ALL FOUR KEYS, because the host always sends all four. up= and refused= may be empty, but
    # they are there; a publish without one came from something other than the launcher.
    [ -n "$PWP_STATE" ]  || { PWP_ERR="no state given"; return 2; }
    [ -n "$seen_floor" ] || { PWP_ERR="no floor given"; return 2; }
    [ -n "$seen_up" ]    || { PWP_ERR="no up given"; return 2; }
    [ -n "$seen_ref" ]   || { PWP_ERR="no refused given"; return 2; }
    pw_lists "$PWP_UP" "$PWP_REFUSED" || return 2
    return 0
}

# Tab-separated, one record per line, repeated keys rather than comma-joined lists -- the same
# idiom verb_dev_tunnel uses, so the suite parses it with the awk one-liner it already has and no
# second format enters the project.
#
# ONE RENDERER FOR BOTH ENDS. The writer prints it and the reader compares against it, so a file the
# reader accepts is, byte for byte, one the writer could have written (#406). printf -v, so the
# reader's comparison costs no fork.
PW_RENDERED=''
pw_state_text() {                     # pw_state_text STATE FLOOR UP REFUSED -> PW_RENDERED
    local e line out IFS=$' \t\n'
    printf -v out 'state\t%s\nfloor\t%s\n' "$1" "$2"
    for e in $3; do printf -v line 'up\t%s\t%s\n'      "${e%%:*}" "${e#*:}"; out="$out$line"; done
    for e in $4; do printf -v line 'refused\t%s\t%s\n' "${e%%:*}" "${e#*:}"; out="$out$line"; done
    PW_RENDERED="$out"
    return 0
}

PWS_STATE=''; PWS_FLOOR=''; PWS_UP=''; PWS_REFUSED=''; PWS_ERR=''
# THE READER REFUSES A MALFORMED FILE RATHER THAN HALF-READING IT. This file is written by us, so
# a bad one means our own writer is broken -- and the readers act on it: shortlink decides whether
# to print a short URL, doctor tells a student what is reachable. Half of a broken file is worse
# than none of it.
#
# AND IT ACCEPTS ONLY WHAT THE WRITER WRITES, exactly: every value passes the writer's own checks,
# and then the whole file must be what pw_state_text renders from them (#406, #411).
pw_state_parse() {                    # pw_state_parse TEXT -> PWS_*, or 2 with PWS_ERR
    local raw="$1" line k a b n=0 nup=0 nref=0 LC_ALL=C
    PWS_STATE=''; PWS_FLOOR=''; PWS_UP=''; PWS_REFUSED=''; PWS_ERR=''
    [ -n "$raw" ] || { PWS_ERR="empty state file"; return 2; }
    # ONE SPLIT rather than peeling a line at a time: each peel copies the rest of the text, which
    # is quadratic in the file. Blank lines vanish in the split, and the comparison at the end is
    # what refuses them.
    pw_split $'\n' "$raw"
    for line in ${PW_ITEMS[@]+"${PW_ITEMS[@]}"}; do
        n=$(( n + 1 ))
        k=''; a=''; b=''
        IFS="$PW_TAB" read -r k a b <<<"$line"
        # THE STATE FIRST AND THE FLOOR SECOND, as the writer puts them. A line that is neither where
        # it should be, a second of either, or a key the writer never writes, ends the parse: the
        # comparison below refuses the file at that line or before it (#411), and reading on would
        # only spend time on a file already refused.
        case "$k" in
            state)
                [ "$n" -eq 1 ] || break
                pw_word "$a" "$PW_STATES" || { pw_refuse "unknown state" "$a"; PWS_ERR="$PWP_ERR"; return 2; }
                PWS_STATE="$a" ;;
            floor)
                [ "$n" -eq 2 ] || break
                pw_port "$a" floor || { PWS_ERR="$PWP_ERR"; return 2; }
                PWS_FLOOR="$a" ;;
            # ONE ENTRY A LINE, so never the writer's list parser: a comma is just another byte of a
            # word that is not in the vocabulary. Handed to pw_pairs, one line held thousands of
            # entries, and peeling them was quadratic before the cap could count them.
            up|refused)
                [ -n "$a" ] && [ -n "$b" ] || { PWS_ERR="$k needs a port and a word"; return 2; }
                if [ "$k" = up ]; then pw_entry "$a" "$b" "$PW_CLASSES"; else pw_entry "$a" "$b" "$PW_REASONS"; fi \
                    || { PWS_ERR="$PWP_ERR"; return 2; }
                if [ "$k" = up ]; then
                    PWS_UP="$PWS_UP $a:$b"; nup=$(( nup + 1 ))
                else
                    PWS_REFUSED="$PWS_REFUSED $a:$b"; nref=$(( nref + 1 ))
                fi
                # PAST THE CAP, pw_lists refuses the file whatever follows, so stop here: a file
                # naming every port costs PW_MAX lines of this, not 65,535.
                [ "$nup" -le "$PW_MAX" ] && [ "$nref" -le "$PW_MAX" ] || break ;;
            *)  break ;;
        esac
    done
    PWS_UP="${PWS_UP# }"; PWS_REFUSED="${PWS_REFUSED# }"
    pw_lists "$PWS_UP" "$PWS_REFUSED" || { PWS_ERR="$PWP_ERR"; return 2; }
    # THE SHAPE, BY CONSTRUCTION. Every value read has passed the writer's checks by now. What is
    # left is the bytes around them: extra fields, runs of tabs (read takes a run as one), blank
    # lines, the order, a missing, repeated or unknown line, the final newline. The reader missed
    # most of those while it had a check per defect, so instead the file is rendered again from what
    # was read, and must be identical. Those checks are gone, since all they added was a name for
    # the defect, and the line number below is enough to find it in the file.
    pw_state_text "$PWS_STATE" "$PWS_FLOOR" "$PWS_UP" "$PWS_REFUSED"
    [ "$PW_RENDERED" = "$raw" ] || { pw_first_difference "$raw" "$PW_RENDERED"; return 2; }
    return 0
}

# Which line of a refused file is the first not to be what the writer writes, counting every
# physical line, blank ones included. Only ever runs on a refusal, so its cost is no one's tick.
pw_first_difference() {               # pw_first_difference RAW WANT -> PWS_ERR
    local raw="$1" want="$2" done='' line n=0 nl=$'\n' LC_ALL=C
    while [ -n "$want" ]; do
        line="${want%%$'\n'*}"; want="${want#*$'\n'}"
        n=$(( n + 1 ))
        case "$raw" in
            "$done$line$nl"*) done="$done$line$nl" ;;
            "$done$line")     PWS_ERR="no newline at the end of line $n"; return 0 ;;
            *)                PWS_ERR="line $n differs from what --publish writes"; return 0 ;;
        esac
    done
    PWS_ERR="line $(( n + 1 )) differs from what --publish writes"
    return 0
}

# THE FILE, EXACTLY. $(cat) strips the trailing newline the writer always writes, and drops any NUL
# (silently, on bash 3.2), so a reader handed its output would be judging some other file. One
# builtin read up to a NUL that should never be there: no fork, the newline kept, and a NUL found is
# the read succeeding.
PW_FILE=''
pw_state_read() {                     # pw_state_read -> 0 with PW_FILE, 3 empty, 4 none, 5 with PWS_ERR
    local rc='' LC_ALL=C
    PW_FILE=''; PWS_ERR=''
    [ -e "$PW_STATE" ] || return 4
    [ -f "$PW_STATE" ] || { PWS_ERR="the state file is not a regular file"; return 5; }
    { IFS= read -r -d '' PW_FILE; rc=$?; } 2>/dev/null < "$PW_STATE"
    [ -n "$rc" ] || { PWS_ERR="cannot read the state file"; return 5; }
    [ "$rc" -ne 0 ] || { PWS_ERR="NUL byte in the state file"; return 5; }
    [ -n "$PW_FILE" ] || return 3
    return 0
}

# THE ONE READING, which --state and --show both make: pw_state_read, then the reader.
pw_state_load() {                     # pw_state_load -> 0 with PW_FILE and PWS_*, 3, 4, or 5 with PWS_ERR
    pw_state_read || return
    pw_state_parse "$PW_FILE" || return 5
}

# ─── modes ─────────────────────────────────────────────────────────────────────
pw_scan_now() { pw_scan_text "$(</proc/net/tcp)" "$(</proc/net/tcp6)"; }

pw_once() { pw_scan_now; printf '%s\n' "$PW_SET"; }

# --watch: the long-lived loop the supervisor reads. One frame per tick, always the full set --
# no deltas and no separate heartbeat, because the report IS the heartbeat. That is what lets the
# supervisor drop all its state when the ssh master is replaced and simply rebuild from the next
# frame; under on-change reporting it would wait for a container-side change that might never come
# and silently lose a server that was already running.
#
# EVERY WRITE IS `|| exit 0`. When the host end goes away the write fails, or SIGPIPE ends us --
# either is a clean exit, and because there is a write every tick it happens within one interval.
# That is what makes killing the supervisor enough to take this down too.
pw_emit() { printf '%s\n' "$1" || exit 0; }

# THE TICK TIMER IS A FIFO, NOT `sleep`. Measured: a sleep fork is 4.9ms against 0.2ms for a
# read that times out -- five times the entire rest of the tick, which is ~1.9ms (and less since
# #337, whose scan of a quiet table is under a millisecond). At 1 Hz for ten weeks on a laptop
# that is worth three lines. Holding BOTH ends open means no EOF, so the read blocks the whole
# interval instead of returning immediately.
#
# AND THERE IS NO `sleep` FALLBACK. An earlier draft carried one, copying run_timeout's mkfifo
# degradation in cs193v-ui.sh -- but that guards the HOST's TMPDIR, which on WSL can be a DrvFs
# mount with no fifo support. This fifo is in the container's per-boot tmpfs (#370), which does
# mknod like any Linux filesystem. The constraint does not transfer, and the fallback would have
# added the one failure shape this loop otherwise cannot have: `sleep` inherits stdout, so a
# watcher killed mid-sleep leaves a child holding the pipe open -- silence at the supervisor
# rather than EOF. Failing loudly here is better than degrading into that.
pw_watch() {
    local iv="${1:-$PW_INTERVAL_DEFAULT}" fifo="$PW_STATE_DIR/tick" n e
    case "$iv" in ''|*[!0-9]*) iv=$PW_INTERVAL_DEFAULT ;; esac
    [ "$iv" -ge 1 ] || iv=$PW_INTERVAL_DEFAULT

    mkdir -p "$PW_STATE_DIR" 2>/dev/null
    # TRUNCATED BEFORE THE HANDSHAKE, so the file EXISTS for as long as a watcher is running, even
    # before the first publish. That is shortlink's signal: an empty file means a tunnel is coming
    # up and is worth waiting for, a missing one means nothing will ever write here. It used to be
    # what kept a restarted container from serving the previous boot's answer too, but only when a
    # watcher started; the directory is a tmpfs now (#370, container.args "Per-boot state"), so a
    # new boot begins with no file whether or not a watcher ever starts.
    : > "$PW_STATE" 2>/dev/null

    rm -f "$fifo" 2>/dev/null
    if ! mkfifo "$fifo" 2>/dev/null; then
        pw_emit "ERR cannot-create-tick-fifo"
        return 1
    fi
    exec 3<>"$fifo" || { pw_emit "ERR cannot-open-tick-fifo"; return 1; }
    rm -f "$fifo" 2>/dev/null

    pw_emit "$PW_PROTO"
    while :; do
        pw_scan_now
        n=0
        for _ in $PW_SET; do n=$(( n + 1 )); done
        # OVER THE CAP: truncate and warn, do NOT stop. A container with more listeners than we
        # will report is the world being unusual, not our code being wrong, so by the failure
        # classes this is a WARN and not an ERR -- and it clears itself when the count drops.
        # Sorted already, so the 128 we keep are the lowest and the choice is deterministic:
        # an unstable pick would make the host cancel and re-forward a set that had not changed.
        if [ "$n" -gt "$PW_MAX" ]; then
            pw_emit "WARN too-many-listeners $n"
            PW_SET="$(printf '%s\n' $PW_SET | head -n "$PW_MAX" | tr '\n' ' ')"
            PW_SET="${PW_SET% }"
            n=$PW_MAX
        fi
        pw_emit "BEGIN $n"
        for e in $PW_SET; do pw_emit "$e"; done
        pw_emit "END"
        read -t "$iv" -u 3 _ 2>/dev/null || true
    done
}

# --publish: the host telling us what it decided. Arguments, never stdin, and never a request --
# the container does not ask for ports, it is told what happened to the ones it reported.
pw_publish() {
    if ! pw_publish_parse "$@"; then
        # For whoever ran it by hand. The supervisor's pmq sends stderr nowhere, and logs only the
        # exit status.
        printf 'cs193v-portwatch: %s\n' "${PWP_ERR:-bad arguments}" >&2
        return 2
    fi
    mkdir -p "$PW_STATE_DIR" 2>/dev/null
    # Written .tmp then moved, so a reader never sees half a file. shortlink polls this while
    # deciding whether the URL it is about to print is reachable.
    pw_state_text "$PWP_STATE" "$PWP_FLOOR" "$PWP_UP" "$PWP_REFUSED"
    printf '%s' "$PW_RENDERED" > "$PW_STATE.tmp" 2>/dev/null || return 1
    mv -f "$PW_STATE.tmp" "$PW_STATE" 2>/dev/null || return 1
    return 0
}

# --state: the file itself, for doctor and shortlink, which read it through this rather than
# directly so that every reader refuses what this one does (#516). Byte for byte, and only a file
# pw_state_parse accepts; never part of one. 0 printed; 3 empty, which is a watcher that has
# started and published nothing yet; 4 no file, which is no tunnel at all; 5 anything else, with
# the reason on stderr.
pw_state_cat() {
    local rc
    pw_state_load; rc=$?
    case "$rc" in
        0) printf '%s' "$PW_FILE" ;;
        5) printf 'cs193v-portwatch: %s\n' "${PWS_ERR:-unreadable}" >&2 ;;
    esac
    return "$rc"
}

# --show: for a student, or for an agent answering "why can't my browser reach this?". This is
# the thing that used to be impossible: before the writeback, nothing inside the container could
# see whether a port was forwarded on the host at all.
pw_show() {
    local e port why rc
    pw_state_load; rc=$?
    if [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; then
        printf 'No forwarding information yet.\n'
        printf 'The launcher publishes it a moment after your container starts.\n'
        return 0
    fi
    if [ "$rc" -ne 0 ]; then
        printf 'The forwarding information is unreadable (%s).\n' "${PWS_ERR:-malformed}"
        printf 'Tell course staff; run ./cs193v doctor on your own computer.\n'
        return 1
    fi
    case "$PWS_STATE" in
        healthy) : ;;
        # The supervisor's word for a master whose control socket has gone (#338), or that has kept
        # it and stopped answering (#266). The remedy is on the student's own computer, not in
        # here, so say so rather than print the state's name.
        master-unresponsive)
            printf 'The tunnel to your own computer has stopped.\n'
            printf 'On your own computer, run: cs193v --reset-tunnel\n\n' ;;
        *) printf 'Port forwarding is not healthy right now: %s\n\n' "$PWS_STATE" ;;
    esac
    if [ -n "$PWS_UP" ]; then
        printf 'Reachable from your browser at http://localhost:PORT\n'
        for e in $PWS_UP; do printf '  %s\n' "${e%%:*}"; done
    else
        printf 'Nothing of yours is reachable from your browser right now.\n'
    fi
    if [ -n "$PWS_REFUSED" ]; then
        printf '\nNot reachable, and why:\n'
        for e in $PWS_REFUSED; do
            port="${e%%:*}"; why="${e#*:}"
            case "$why" in
                busy)        printf '  %-6s another program on your own computer is using that port\n' "$port" ;;
                v6lo)        printf '  %-6s bound to ::1 only; bind 127.0.0.1 or 0.0.0.0 instead\n' "$port" ;;
                loalt)       printf '  %-6s bound to another 127.x address; bind 127.0.0.1 instead\n' "$port" ;;
                eth)         printf '  %-6s bound to this container network only, not its loopback\n' "$port" ;;
                below-floor) printf '  %-6s below the lowest port your computer will open\n' "$port" ;;
                capped)      printf '  %-6s too many ports open at once; close one\n' "$port" ;;
                *)           printf '  %-6s %s\n' "$port" "$why" ;;
            esac
        done
    fi
    return 0
}

# --fault: deliberately malformed output, so the supervisor's fatal path can be exercised. The
# never-fail-silently rule is only worth anything if something proves the loud failure happens,
# and nothing else can make a correct watcher emit a bad frame.
pw_fault() {
    case "${1:-}" in
        handshake)    pw_emit "cs193v-portwatch 99" ;;
        nested-begin) pw_emit "$PW_PROTO"; pw_emit "BEGIN 1"; pw_emit "BEGIN 1" ;;
        bad-count)    pw_emit "$PW_PROTO"; pw_emit "BEGIN 3"; pw_emit "3000:lo"; pw_emit "END" ;;
        bad-record)   pw_emit "$PW_PROTO"; pw_emit "BEGIN 1"; pw_emit "3000:wat"; pw_emit "END" ;;
        octal)        pw_emit "$PW_PROTO"; pw_emit "BEGIN 1"; pw_emit "03000:lo"; pw_emit "END" ;;
        stray)        pw_emit "$PW_PROTO"; pw_emit "3000:lo" ;;
        err)          pw_emit "$PW_PROTO"; pw_emit "ERR deliberate-fault" ;;
        *) printf 'cs193v-portwatch: unknown fault %s\n' "${1:-}" >&2; return 2 ;;
    esac
    return 0
}

pw_usage() {
    cat <<'USAGE'
usage: cs193v-portwatch [--once | --watch [SECONDS] | --publish KEY=VALUE... | --state | --show]

Reports which ports are listening in this container so the launcher on your own
computer can make them reachable from your browser.

  --once      print the current set and exit
  --watch     stream it, one frame per second, until the reader goes away
  --publish   record what the launcher decided (the launcher calls this)
  --state     print that record exactly, if it is valid: exit 0, or 3 if it is
              empty, 4 if there is none, 5 if it is invalid (doctor and
              shortlink read it this way)
  --show      what is reachable from your browser, and why anything is not
USAGE
}

pw_main() {
    case "${1:---show}" in
        --once)    pw_once ;;
        --watch)   shift; pw_watch "${1:-}" ;;
        --publish) shift; pw_publish "$@" ;;
        --state)   pw_state_cat ;;
        --show)    pw_show ;;
        --fault)   shift; pw_fault "${1:-}" ;;
        -h|--help) pw_usage ;;
        *) printf 'cs193v-portwatch: unknown argument %s\n\n' "$1" >&2; pw_usage >&2; return 2 ;;
    esac
}

case "${CS193V_PORTWATCH_SOURCED:-}" in
    '') pw_main "$@" ;;
esac
