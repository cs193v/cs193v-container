# ═══════════════════════════════════════════════════════════════════════════════
#  sshd config for the CS193V loopback tunnel.
#
#  This sshd NEVER LISTENS ON ANYTHING. The launcher starts it per session with
#
#      podman exec -i <container> /usr/sbin/sshd -i -f /etc/ssh/cs193v_sshd_config
#
#  so its "connection" is the stdin/stdout of that podman exec pipe (`-i` is inetd mode).
#  There is no socket, on either side, anywhere in the system. The only way to reach it is
#  to be able to run `podman exec`, which already requires the host user's own privileges,
#  so this adds no reachable attack surface at all.
#
#  Passed with `-f` rather than editing /etc/ssh/sshd_config or dropping a file into
#  /etc/ssh/sshd_config.d/: the config in use is then provably this one, with no dependence
#  on Include ordering or on sshd's first-value-wins precedence, and a future Ubuntu change
#  to its own sshd_config cannot quietly alter our behaviour.
#
#  Measured on OpenSSH 10.2p1: `sshd -i` works UNPRIVILEGED, as `student`, even though 9.8
#  split sshd into sshd/sshd-session and 10.0 added sshd-auth. No `-u 0` is needed.
# ═══════════════════════════════════════════════════════════════════════════════

# Per-machine, generated by the launcher into .config/ and bind-mounted READ-ONLY. Not baked
# into the image, which would ship one private key to every student; and not generated per
# container start, which would change it on every --rebuild and greet students with
# OpenSSH's REMOTE HOST IDENTIFICATION HAS CHANGED banner — the most alarming message it
# emits — for no reason.
HostKey /etc/ssh/cs193v_host_ed25519_key

# Also bind-mounted READ-ONLY, so the container cannot alter who may log in even if it is
# compromised. Verified: writes fail with EROFS and unlink fails with EPERM.
#
# Deliberately ONE path, not OpenSSH's default pair of `authorized_keys authorized_keys2`.
# A writable second file would let the container grant inbound access to itself, and in this
# design that buys a student nothing anyway: with no listening socket there is no route to
# use an extra key.
AuthorizedKeysFile /home/student/.ssh/authorized_keys

# ─── the direction invariant, enforced by the SERVER ───────────────────────────
# `local` permits -L (the host asks the container to connect to the container's own
# loopback) and FORBIDS -R (the container asking the host to open a listening port).
#
# This is the whole security argument of the design, so it is enforced here rather than
# trusted to the flags the launcher happens to pass: a client-side promise is only as good
# as the client, and this file is what makes the promise structural. Verified: an attempted
# -R is refused with "administratively prohibited" and creates zero listeners.
AllowTcpForwarding local

# And the tunnel may only reach the container's OWN loopback — never the dorm network, the
# LAN, or the internet by using the container as a proxy. Verified: forwarding to an
# off-box address is refused at channel-open with "administratively prohibited", while the
# container's own direct egress to that same address still works.
PermitOpen 127.0.0.1:*

# ─── everything optional is off ────────────────────────────────────────────────
# The client is the party we care about protecting here: it runs as the student's own host
# user, and it is talking to a server inside a container that a compromised agent could in
# principle control. So every feature that would let the server ask the client for anything
# is refused at both ends.
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no

# ─── authentication ────────────────────────────────────────────────────────────
# Keys only, one account only. There is no password on the student account to guess, but
# saying so explicitly means a future base-image change cannot quietly enable a fallback.
AllowUsers student
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no

# UsePAM would need root for the session stack, and this sshd deliberately runs as the
# unprivileged student. Nothing here needs a PAM session: no shell is allocated, since the
# launcher connects with -N and only ever asks for port forwards.
UsePAM no

# Nothing should print on a connection that carries no shell. A banner or motd here would be
# pure noise in the launcher's log.
PrintMotd no
PrintLastLog no
Banner none
