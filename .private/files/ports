#!/usr/bin/env python3
"""
ports — is my dev server reachable from my browser, and if not, why?

Reads the kernel's own socket table (/proc/net/tcp and /proc/net/tcp6), decodes which
address each listener is bound to, and compares that against the ports the launcher
forwards from the student's own computer into this container.

WHAT CHANGED, AND WHY THIS FILE IS SHORTER THAN IT WAS

The launcher used to publish ports with `podman run -p`, and podman's forwarder delivers to
the container's eth0 and never touches its lo. So a server bound to the container's
127.0.0.1 was unreachable from the browser, and the fix was to make every student start
every server with `--host 0.0.0.0`. That was the single biggest failure mode this command
existed to explain.

It is gone. The launcher now runs an ssh client on the student's computer that forwards each
course port into THIS container's own loopback, so binding 127.0.0.1 works, and binding
0.0.0.0 still works too (0.0.0.0 includes lo). The bind address is no longer something a
student has to get right, so this command no longer diagnoses it.

WHAT IS LEFT

  1. A server on a port outside the forwarded set is unreachable no matter what it is bound
     to. vite's auto-increment walks 5173 -> 5174 -> 5175 when a port is busy, and
     `python -m http.server` defaults to 8000, so this still happens by accident constantly.

  2. A server bound ONLY to ::1, the IPv6 loopback. The forward's far end is 127.0.0.1, so
     an IPv6-only listener is still refused. This is rarer than it sounds in this image and
     the old docstring here overstated it: it claimed a server told to bind "localhost"
     lands on ::1, and that is NOT true here, because /etc/hosts maps localhost to
     127.0.0.1 only and has no `::1 localhost` line. Measured in the shipped image:
     `python3 -m http.server --bind localhost` and node's `listen(port, "localhost")` both
     bind 127.0.0.1. Reaching ::1 takes asking for it explicitly.

  3. Two failure modes this command CANNOT see, which is the honest limit of it. A forward
     may be missing because something else on the student's computer already had that port,
     or the tunnel may be down altogether. Both are facts about the HOST, and this command
     reads /proc inside the container. So an OK here means "nothing is wrong on this side",
     which is why the closing advice points at `cs193v doctor`, which runs on the host and
     can see the other half.

The forwarded set arrives as CS193V_PORTS at container-create time. It is the same single
declaration the launcher parses to build the forwards, so the two cannot disagree.
"""

import os
import sys

TCP_LISTEN = "0A"  # st == 0x0A means LISTEN


def parse_ranges(spec):
    """'3000-3009,8888' -> [(3000, 3009), (8888, 8888)]"""
    out = []
    for chunk in spec.split(","):
        chunk = chunk.strip()
        if not chunk:
            continue
        if "-" in chunk:
            lo, _, hi = chunk.partition("-")
            out.append((int(lo), int(hi)))
        else:
            out.append((int(chunk), int(chunk)))
    return out


def published(port, ranges):
    return any(lo <= port <= hi for lo, hi in ranges)


def decode_v4(hexaddr):
    """/proc/net/tcp stores IPv4 little-endian: '0100007F' -> 127.0.0.1"""
    octets = [int(hexaddr[i:i + 2], 16) for i in (6, 4, 2, 0)]
    return ".".join(str(o) for o in octets)


def decode_v6(hexaddr):
    """/proc/net/tcp6 stores IPv6 as four little-endian 32-bit words.

    '00000000000000000000000001000000' -> '::1'

    This has to produce a real address, not the raw hex, because ::1 is now the ONLY bind
    address the tunnel cannot reach — so this is the one row where the address itself is the
    diagnosis, and printing 32 hex digits at a student would fail at exactly the job that
    still matters. (This docstring used to claim binding "localhost" lands on ::1 and that
    it was the most common failure. Measured in the shipped image, it does not: /etc/hosts
    maps localhost to 127.0.0.1 with no `::1 localhost` line.) ::ffff:a.b.c.d is unwrapped to
    its IPv4 form because that is what a dual-stack listener on an IPv4 address looks like
    here, and it IS reachable, so it must not be mistaken for the IPv6-only case.
    """
    try:
        words = [hexaddr[i:i + 8] for i in range(0, 32, 8)]
        # Each 32-bit word is little-endian; the sequence of words is not.
        raw = b"".join(int(w, 16).to_bytes(4, "little") for w in words)
    except (ValueError, IndexError):
        return hexaddr
    try:
        import socket
        if raw[:12] == b"\x00" * 10 + b"\xff\xff":
            return socket.inet_ntop(socket.AF_INET, raw[12:])
        return socket.inet_ntop(socket.AF_INET6, raw)
    except (OSError, ValueError):
        return hexaddr


# A listener on a privileged port is never a student's dev server: no forwarded port is
# below 3000, and an unprivileged ssh client could not bind one on the host side anyway.
# Reporting systemd-resolved on :53 as a problem would be noise indistinguishable from a
# real diagnosis.
PRIVILEGED = 1024


def listeners(paths=None):
    """-> set of (port, bound_address, is_wildcard)

    `paths` is injectable so the parser can be tested against captured /proc fixtures
    rather than only whatever happens to be listening on the machine running the tests.
    """
    if paths is None:
        paths = (("/proc/net/tcp", False), ("/proc/net/tcp6", True))
    found = set()
    for path, v6 in paths:
        try:
            with open(path) as fh:
                lines = fh.read().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            f = line.split()
            if len(f) < 4 or f[3] != TCP_LISTEN:
                continue
            local, _, port_hex = f[1].rpartition(":")
            port = int(port_hex, 16)
            if v6:
                shown = decode_v6(local)
                # "::" accepts every interface; so does a dual-stack socket that reports
                # an unwrapped 0.0.0.0.
                wildcard = shown in ("::", "0.0.0.0")
            else:
                shown = decode_v4(local)
                wildcard = shown == "0.0.0.0"
            found.add((port, shown, wildcard))
    return found


def suggest(port, ranges):
    """What to advise for a port outside the forwarded set.

    A port just past the end of a range is almost always an auto-increment overflow
    (vite walks 5173 -> 5174 -> ... and can step past 5179), so point back at that
    range. A port nowhere near anything was chosen freely, so don't invent false
    precision about which range is "nearest" — say to pick from the forwarded list.
    """
    if not ranges:
        return "one of the forwarded ranges below"
    lo, hi = min(ranges, key=lambda r: min(abs(port - r[0]), abs(port - r[1])))
    if min(abs(port - lo), abs(port - hi)) > 20:
        return "one of the forwarded ranges below"
    return "%d-%d" % (lo, hi) if lo != hi else str(lo)


def main():
    spec = os.environ.get("CS193V_PORTS", "")
    if not spec:
        sys.stderr.write(
            "CS193V_PORTS is not set, so I do not know which ports reach your browser.\n"
            "That variable is set when the container is created, so this usually means\n"
            "the container predates it — try:  cs193v --rebuild\n"
        )
        return 2
    ranges = parse_ranges(spec)

    rows = sorted(listeners())
    # Collapse the dual-stack case: a wildcard IPv6 listener also accepts IPv4.
    by_port = {}
    for port, shown, wildcard in rows:
        prev = by_port.get(port)
        if prev is None or (wildcard and not prev[1]):
            by_port[port] = (shown, wildcard)

    # BOUND TO is 15 wide so a full IPv4 address and the common IPv6 forms fit without
    # pushing the later columns out of line.
    print("  %-6s %-15s %-14s %s" % ("PORT", "BOUND TO", "STATUS", "WHAT TO DO"))
    print("  " + "-" * 78)

    problems = 0
    if not by_port:
        print("  (nothing is listening inside the container)")

    for port in sorted(by_port):
        # The wildcard flag is deliberately NOT unpacked here. It used to decide the verdict --
        # wildcard meant reachable and loopback meant refused -- and that is exactly the rule
        # the tunnel retired. It survives in listeners() only to collapse the dual-stack case
        # above, where a wildcard IPv6 row should win over an IPv4 one for the same port.
        shown = by_port[port][0]
        pub = published(port, ranges)
        # An IPv6-loopback-only listener. The forward's far end is 127.0.0.1, so this one is
        # still refused -- the only bind address left that does not work.
        v6_only = shown == "::1"
        if pub and not v6_only:
            status, advice = "OK", "http://localhost:%d/" % port
        elif pub and v6_only:
            problems += 1
            status = "UNREACHABLE"
            advice = "bound to ::1 (IPv6) only; restart it on 127.0.0.1 or 0.0.0.0"
        elif port < PRIVILEGED:
            # Listed for completeness, but not counted: a student cannot have started this
            # and it could not be forwarded anyway. Counting it would make the exit status
            # and the closing explanation fire on a container with no problem at all.
            status = "system"
            advice = "a system service, not one of your servers"
        elif v6_only:
            problems += 1
            status = "NOT FORWARDED"
            advice = ("two problems: restart it on %s, on 127.0.0.1 or 0.0.0.0"
                      % suggest(port, ranges))
        else:
            problems += 1
            status = "NOT FORWARDED"
            advice = "restart it on a port in %s" % suggest(port, ranges)
        print("  %-6d %-15s %-14s %s" % (port, shown, status, advice))

    print("  " + "-" * 78)
    print("  forwarded: " + ", ".join("%d-%d" % (a, b) if a != b else str(a)
                                      for a, b in ranges))
    if problems:
        print()
        print("  Only these ports reach your browser. Your computer forwards each one")
        print("  into this container, so a server on any other port has nothing")
        print("  carrying it out -- the port is what matters, not the bind address.")
    # The limit of what this command can know. Said always, not only on failure, because the
    # case it covers is precisely the one where everything HERE looks fine: `ports` reads
    # /proc inside the container and cannot see whether the host end of a forward exists.
    print()
    print("  If a port says OK and your browser still cannot reach it, the problem is")
    print("  on your own computer, not in here. Run this THERE:  cs193v doctor")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
